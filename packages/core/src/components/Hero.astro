---
/**
 * 首屏 Hero —— 20 套风格差异最大的一块。
 * 差异全部由令牌承担:--ck-hero-bg / --ck-hero-ink / --ck-hero-minh / --ck-hero-deco。
 * --ck-hero-deco 是纯 CSS 渐变与网格,不引入任何图片:
 *   工厂系 = 细竖线栅格;科技系 = 网格 + 辉光;奢华系 = 单点柔光;临床系 = 无装饰。
 * 产品实拍图到位后,在此加一列图片位即可,版式不必重排。
 */
import type { HomeContent, StatItem } from '../types.ts';
import TextureField from './TextureField.astro';

export interface Props {
  hero: HomeContent['hero'];
  /** 询盘页链接(已含语言前缀) */
  ctaHref: string;
  /** 次要按钮链接(通常指向产品目录) */
  ctaSecondaryHref?: string;
  /**
   * 首屏核心数字 —— PDF 定案第 1 屏:「一句话 + 三个核心数字 + 一个行动按钮」。
   * 参照 Intercos 首页数字墙:访客三秒内就该知道这家厂有多大产能。
   * 传超过 3 条也能排,但按定案建议只给 3 条,多了反而稀释。
   */
  highlights?: StatItem[];
  /** 首屏质地场:实拍图到位前先给画面,真图到了把这层换成 <img> 即可 */
  texture?: 'cream' | 'fluid' | 'powder' | 'gel';
  /** 首屏主图。有真图就用图,没有才回落到生成式质地 —— 一个开关,不用改版式 */
  image?: string;
  imageAlt?: string;
}

const { hero, ctaHref, ctaSecondaryHref, highlights = [], texture = 'cream', image, imageAlt } = Astro.props;
---

<section class="hero">
  <div class="deco" aria-hidden="true"></div>
  {/* 右半幅:有实拍图就铺图,没有则用生成式质地兜底 */}
  <div class="texwrap" aria-hidden={image ? undefined : 'true'}>
    {image ? (
      <img class="shot" src={image} alt={imageAlt ?? ''} loading="eager" decoding="async" />
    ) : (
      <TextureField kind={texture} tone="full" />
    )}
  </div>
  <div class="ck-wrap inner">
    {hero.eyebrow && <p class="ck-eyebrow ck-fade-up">{hero.eyebrow}</p>}
    <h1 class="ck-fade-up ck-delay-1">{hero.title}</h1>
    <p class="lead ck-fade-up ck-delay-2">{hero.lead}</p>
    <p class="actions ck-fade-up ck-delay-3">
      <a class="cta" href={ctaHref}>{hero.ctaPrimary}</a>
      {hero.ctaSecondary && ctaSecondaryHref && (
        <a class="ghost" href={ctaSecondaryHref}>{hero.ctaSecondary}</a>
      )}
    </p>

    {highlights.length > 0 && (
      <dl class="hl ck-fade-up ck-delay-3">
        {highlights.map((h) => (
          <div class="hcell">
            <dt class="hv">{h.value}</dt>
            <dd class="hl-lab">{h.label}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--ck-hero-bg);
    color: var(--ck-hero-ink);
    min-height: var(--ck-hero-minh);
    display: grid;
    align-items: center;
    padding-block: var(--ck-section-py);
    overflow: hidden;
  }
  /* 装饰层单独一层,保证文字始终在其上、对比度不受影响 */
  .deco {
    position: absolute;
    inset: 0;
    background: var(--ck-hero-deco);
    background-size: var(--ck-hero-deco-size);
    pointer-events: none;
  }
  /* 质地场:右侧 46% 宽,左缘用遮罩化开,不与文字抢对比度 */
  .texwrap {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(46%, 40rem);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 34%);
    mask-image: linear-gradient(90deg, transparent, #000 34%);
    pointer-events: none;
  }
  @media (max-width: 52rem) {
    /* 窄屏文字要占满,质地退到底部一条,避免压住正文 */
    .texwrap {
      inset: auto 0 0 0;
      width: 100%;
      height: 38%;
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 60%);
      mask-image: linear-gradient(180deg, transparent, #000 60%);
    }
  }
  .shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .inner {
    position: relative;
  }
  h1 {
    margin-top: 0.875rem;
    max-width: 18ch;
    /* 首屏标题用更紧的行高与字距 —— 大字号下默认行高会散,标杆站都收得很紧
       (Intercos 177.8px/字距 4px;KDC-One 80px/字重 300) */
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .lead {
    max-width: var(--ck-maxw-prose);
    margin-block: 1.375rem 2.25rem;
    color: color-mix(in srgb, currentColor 74%, transparent);
    font-size: 1.0625rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .cta {
    display: inline-block;
    padding: 0.9375rem 1.875rem;
    background: var(--ck-accent);
    color: var(--ck-on-accent);
    border-radius: var(--ck-cta-radius);
    text-decoration: none;
    font-weight: var(--ck-cta-weight);
    letter-spacing: var(--ck-cta-tracking);
    text-transform: var(--ck-cta-transform);
    transition: background var(--ck-dur) var(--ck-ease);
  }
  .cta:hover { background: var(--ck-accent-deep); }

  /* 次要按钮:描边式,继承 Hero 前景色,深浅底都成立 */
  .ghost {
    display: inline-block;
    padding: 0.9375rem 1.875rem;
    border: var(--ck-border-w) solid color-mix(in srgb, currentColor 38%, transparent);
    border-radius: var(--ck-cta-radius);
    color: inherit;
    text-decoration: none;
    font-weight: var(--ck-cta-weight);
    letter-spacing: var(--ck-cta-tracking);
    text-transform: var(--ck-cta-transform);
    transition: border-color var(--ck-dur) var(--ck-ease), background var(--ck-dur) var(--ck-ease);
  }
  .ghost:hover {
    border-color: currentColor;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  /* 首屏数字墙:超大字号 + 小标签(PDF 版式规范),继承 Hero 前景色,深浅底都成立。
     宽度收在文字栏内 —— 之前铺满整行会伸到右侧图片区,数字压在图上完全读不清。
     首屏的图是背景,不该有任何文字压在上面。 */
  .hl {
    margin: clamp(2.5rem, 6vh, 4rem) 0 0;
    padding-top: 1.75rem;
    border-top: var(--ck-border-w) solid color-mix(in srgb, currentColor 22%, transparent);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 1.25rem var(--ck-gap);
    /* 与 .lead 同宽:文字区最多占左侧一半,右半留给图 */
    max-width: min(46rem, 52%);
  }
  @media (max-width: 60rem) {
    .hl { max-width: none; }
  }
  .hcell { min-width: 0; }
  .hv {
    font-family: var(--ck-font-head);
    font-size: clamp(1.625rem, 1rem + 2vw, 2.5rem);
    font-weight: var(--ck-weight-head);
    line-height: 1.05;
    letter-spacing: var(--ck-tracking-head);
    font-variant-numeric: tabular-nums;
  }
  .hl-lab {
    margin: 0.4375rem 0 0;
    font-size: var(--ck-small);
    line-height: 1.45;
    color: color-mix(in srgb, currentColor 68%, transparent);
  }
</style>
