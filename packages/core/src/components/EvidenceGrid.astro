---
/**
 * 证据陈列 —— 一句主张 + 一份支撑 + 出处。
 * 依据 PDF 对口腔线的结论:「牙膏功效证明页对标 Boka / Quip / NOBS」——
 * 临床极简流派的核心不是好看,是「每句话都挂得上证据」。
 * 纪律:不写没有支撑的主张;source 缺失时前端显示「待补充」而非静默隐藏,
 *      逼内容侧补齐,避免上线后出现无出处的功效宣称(合规风险)。
 */
import type { EvidenceItem } from '../types.ts';

export interface Props {
  title: string;
  intro?: string;
  items: EvidenceItem[];
  /** 出处缺失时的占位文案(各语言由调用方传入) */
  pendingLabel?: string;
}

const { title, intro, items, pendingLabel = '出处待补充' } = Astro.props;
---

<section class="ev ck-section" aria-label={title}>
  <div class="ck-wrap">
    <header class="head">
      <h2>{title}</h2>
      {intro && <p class="intro">{intro}</p>}
    </header>

    <dl class="list">
      {items.map((e) => (
        <div class="row">
          <dt class="claim">{e.claim}</dt>
          <dd class="proof">
            <span class="p">{e.proof}</span>
            <span class:list={['src', !e.source && 'pending']}>{e.source ?? pendingLabel}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .ev { background: var(--ck-bg); }
  .head { max-width: var(--ck-maxw-prose); }
  .intro { margin-top: 0.875rem; color: var(--ck-ink-soft); }

  .list {
    margin: 2.5rem 0 0;
    border-top: var(--ck-rule-w) solid var(--ck-line-strong);
  }
  /* 表格化陈列:主张在左、证据在右,细线分隔 —— 临床流派的信息密度来源 */
  .row {
    display: grid;
    grid-template-columns: minmax(12rem, 0.9fr) 1.4fr;
    gap: var(--ck-gap);
    padding-block: 1.25rem;
    border-bottom: var(--ck-border-w) solid var(--ck-line);
  }
  .claim {
    font-family: var(--ck-font-head);
    font-weight: var(--ck-weight-head);
    letter-spacing: var(--ck-tracking-head);
  }
  .proof {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    color: var(--ck-ink-soft);
    font-size: var(--ck-small);
  }
  .src {
    font-family: var(--ck-font-mono);
    font-size: 0.75rem;
    color: var(--ck-ink-faint);
  }
  /* 出处缺失时显眼提示,逼内容侧补齐,不让无出处宣称静默上线 */
  .pending {
    color: var(--ck-accent);
    border: 1px dashed currentColor;
    align-self: start;
    padding: 0.125rem 0.375rem;
    border-radius: var(--ck-radius);
  }

  @media (max-width: 44rem) {
    .row { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
