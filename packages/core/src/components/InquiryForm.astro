---
/**
 * 落地页内嵌询盘表单 —— PDF 定案第 7 屏。
 * 原文:「姓名/公司/邮箱/国家/需求,提交即进系统询盘池」。
 *
 * ★ 2026-09-04:action 从 mailto: 换成 /api/inquiry。
 *   mailto 表单在桌面端会弹出访客自己的邮件客户端,在手机上**多半什么都不发生** ——
 *   客户填完点提交、看不到任何回执就走了。inquiries 表建好却一行数据都没有,
 *   后台看起来像「没人询盘」,其实是根本没收到。这是全站最贵的一个洞。
 *   字段名与 /api/inquiry 对齐(name/company/email/country/message),
 *   零 JS 时走浏览器原生 POST,有 JS 时用 fetch 就地给回执,两条路都通。
 *
 * ★ 表单本身零 JS:用原生 required / type=email 做校验,浏览器自带提示,还自带多语言。
 */
import type { InquiryFormLabels } from '../types.ts';

export interface Props {
  title: string;
  intro?: string;
  labels: InquiryFormLabels;
  /** 收件邮箱(当前 mailto 方案的去向) */
  email: string;
  /** 邮件主题,带品牌名便于分拣 */
  subject: string;
}

const { title, intro, labels, email, subject } = Astro.props;
const action = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

<section class="fm ck-section" id="inquiry" aria-label={title}>
  <div class="ck-wrap inner">
    <div class="lead">
      <h2>{title}</h2>
      {intro && <p class="intro">{intro}</p>}
      <p class="note">{labels.privacyNote}</p>
    </div>

    <form class="form" id="inqform" action="/api/inquiry" method="post">
      {/* 蜜罐:真人看不见,机器人会填。名字取 website 而不是 company ——
          company 是真实字段,拿它当蜜罐会把「填了公司名的正常客户」全判成机器人。 */}
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
             style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
      <input type="hidden" name="source" value="form" />
      <div class="row">
        <label class="field">
          <span class="lab">{labels.name}</span>
          <input class="in" type="text" name="name" required autocomplete="name" />
        </label>
        <label class="field">
          <span class="lab">{labels.company}</span>
          <input class="in" type="text" name="company" required autocomplete="organization" />
        </label>
      </div>
      <div class="row">
        <label class="field">
          <span class="lab">{labels.email}</span>
          <input class="in" type="email" name="email" required autocomplete="email" />
        </label>
        <label class="field">
          <span class="lab">{labels.country}</span>
          <input class="in" type="text" name="country" required autocomplete="country-name" />
        </label>
      </div>
      {/* WhatsApp:海外采购最常用的联络方式,留了号码业务员能直接聊,不用等邮件来回。可选,不设门槛。
          标签统一写 WhatsApp 不翻译(同页脚 WeChat 的纪律:它是标识符)。 */}
      <label class="field">
        <span class="lab">WhatsApp <small style="font-weight:400;opacity:.7">(optional)</small></span>
        <input class="in" type="tel" name="whatsapp" autocomplete="tel" inputmode="tel" placeholder="+62 812 3456 7890" maxlength="40" />
      </label>
      <label class="field">
        <span class="lab">{labels.need}</span>
        <textarea class="in ta" name="message" rows="5" required data-prefill-need></textarea>
        {/* AI 客服「转人工」的交接:对话摘要经 sessionStorage 带进来,预填后即清,
            不进 URL(隐私纪律:个人内容不进查询串)。只填空表单,不覆盖人已写的字。
            选品链路带过来的组合(配方号/包材号/市场/诉求)走查询串,那是产品信息不是隐私。 */}
        <script is:inline>
          try {
            const ta = document.querySelector('textarea[data-prefill-need]');
            const s = sessionStorage.getItem('bh-chat-handoff');
            if (ta && s && !ta.value) { ta.value = s; sessionStorage.removeItem('bh-chat-handoff'); }
            const q = new URLSearchParams(location.search);
            const bits = [];
            if (q.get('formula')) bits.push('配方 ' + q.get('formula'));
            if (q.get('pack')) bits.push('包材 ' + q.get('pack'));
            if (q.get('market')) bits.push('目标市场 ' + q.get('market'));
            if (q.get('claim')) bits.push('诉求 ' + q.get('claim'));
            if (ta && bits.length && !ta.value) ta.value = bits.join(' · ') + String.fromCharCode(10, 10);
          } catch {}
        </script>
      </label>
      <p class="act">
        <button class="submit" type="submit">{labels.submit}</button>
        <span class="fb" id="inqfb" role="status" aria-live="polite"></span>
      </p>
    </form>

    {/* 提交回执:B2B 客户填完最怕「不知道有没有发出去」。
        有 JS 就地给回执,没 JS 走原生 POST(接口会 302 回来带 ?sent=1)。 */}
    <script is:inline>
      (function () {
        const f = document.getElementById('inqform');
        if (!f) return;
        const fb = document.getElementById('inqfb');
        const zh = document.documentElement.lang.indexOf('zh') === 0;
        if (new URLSearchParams(location.search).get('sent') === '1' && fb) {
          fb.textContent = zh ? '已收到,我们会尽快回复。' : 'Received. We will get back to you shortly.';
          fb.className = 'fb ok';
        }
        f.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = f.querySelector('.submit');
          btn.disabled = true;
          if (fb) { fb.className = 'fb'; fb.textContent = zh ? '提交中…' : 'Sending…'; }
          try {
            const r = await fetch('/api/inquiry', { method: 'POST', body: new FormData(f) });
            const ok = r.ok;
            if (fb) {
              fb.className = 'fb ' + (ok ? 'ok' : 'err');
              fb.textContent = ok
                ? (zh ? '已收到,我们会尽快回复。' : 'Received. We will get back to you shortly.')
                : (zh ? '提交失败,请改用邮件联系我们。' : 'Could not send — please email us instead.');
            }
            if (ok) f.reset();
          } catch {
            if (fb) { fb.className = 'fb err'; fb.textContent = zh ? '网络异常,请稍后重试。' : 'Network error, please retry.'; }
          } finally {
            btn.disabled = false;
          }
        });
      })();
    </script>
  </div>
</section>

<style>
  .fb { margin-left: .75rem; font-size: var(--ck-small); color: var(--ck-ink-soft); }
  .fb.ok { color: #1D7A46; }
  .fb.err { color: #A02B20; }
  .fm {
    background: var(--ck-surface-alt);
    border-top: var(--ck-border-w) solid var(--ck-line);
  }
  .inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .intro {
    margin-top: 0.875rem;
    color: var(--ck-ink-soft);
    max-width: 72ch;
  }
  .note {
    margin-top: 1.25rem;
    font-size: var(--ck-small);
    color: var(--ck-ink-faint);
    padding-top: 1rem;
    border-top: var(--ck-border-w) solid var(--ck-line);
  }

  .form { display: grid; gap: 1.125rem; }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.125rem;
  }
  .field { display: grid; gap: 0.4375rem; }
  .lab {
    font-size: max(0.6875rem, 14px);
    font-weight: 700;
    letter-spacing: var(--ck-tracking-eyebrow);
    text-transform: var(--ck-eyebrow-transform);
    color: var(--ck-ink-faint);
  }
  .in {
    font: inherit;
    font-size: var(--ck-small);
    color: var(--ck-ink);
    background: var(--ck-surface);
    border: var(--ck-border-w) solid var(--ck-line-strong);
    border-radius: var(--ck-radius);
    padding: 0.6875rem 0.8125rem;
    width: 100%;
    transition: border-color var(--ck-dur) var(--ck-ease);
  }
  .in:focus { border-color: var(--ck-accent); }
  .ta { resize: vertical; min-height: 7rem; }

  .act { margin-top: 0.375rem; }
  .submit {
    font: inherit;
    cursor: pointer;
    padding: 0.9375rem 2rem;
    background: var(--ck-accent);
    color: var(--ck-on-accent);
    border: 0;
    border-radius: var(--ck-cta-radius);
    font-weight: var(--ck-cta-weight);
    letter-spacing: var(--ck-cta-tracking);
    text-transform: var(--ck-cta-transform);
    transition: background var(--ck-dur) var(--ck-ease);
  }
  .submit:hover { background: var(--ck-accent-deep); }

  @media (max-width: 52rem) {
    .inner { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; }
  }
</style>
