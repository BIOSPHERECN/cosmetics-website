---
/**
 * 权益三联 —— 原站会员俱乐部那一屏:整屏背景图 + 55% 墨色遮罩 + 三个描边格。
 *
 * 这里的遮罩是必需的,和首屏那种"局部渐变"不同:
 * 三个格子铺满整幅,文字落在图的任意位置,只能整体压暗才保证每个格子都读得清。
 * 55% 是原站的取值,实测白字在其上对比度足够。
 */
export interface Perk { icon?: string; title: string; note?: string }
export interface Props {
  image?: string;
  items: Perk[];
  /** 遮罩不透明度 0-1 */
  veil?: number;
}
const { image, items = [], veil = 0.55 } = Astro.props;
---

<section class="perks dtc-sec">
  {image && <img class="bg" src={image} alt="" loading="lazy" decoding="async" />}
  <div class="mask" style={`background:rgba(0,4,24,${veil})`}></div>
  <div class="dtc-wrap-mid grid">
    {items.map((p) => (
      <div class="cell">
        {p.icon && <div class="ico" aria-hidden="true">{p.icon}</div>}
        <div class="t">{p.title}</div>
        {p.note && <div class="n">{p.note}</div>}
      </div>
    ))}
  </div>
</section>

<style>
  .perks { position: relative; color: #fff; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mask { position: absolute; inset: 0; }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem;
  }
  .cell {
    border: 1px solid rgb(255 255 255 / 0.25);
    padding: 2rem;
    text-align: center;
    transition: background 0.25s ease;
  }
  .cell:hover { background: rgb(255 255 255 / 0.1); }
  .ico { font-size: 1.5rem; line-height: 1; }
  .t { margin-top: 1rem; font-size: 0.9375rem; font-weight: 700; }
  .n { margin-top: 0.5rem; font-size: 0.8125rem; color: rgb(255 255 255 / 0.7); }
</style>
