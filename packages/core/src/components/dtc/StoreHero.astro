---
/**
 * 店招 —— 阿里工厂店铺最上面那一条。
 *
 * 名臣那页是一张厂区全景铺满宽度,公司名压在上面,
 * 下方再叠一张白色圆角卡把内容托住。这个「卡片上浮」的关系是关键:
 * 它让厂房照片退成背景、把信息推到前面 —— 既撑了场面,又不牺牲可读性。
 *
 * 与首屏轮播(Slideshow)的分工:
 *   Slideshow 是品牌站的开场,负责让人停住;
 *   StoreHero 是工厂店的开场,负责在三秒内回答「你是谁、多大、凭什么」。
 * 两者不该同时出现在一页上。
 */
export interface Badge { text: string; kind?: 'verified' | 'plain' }
export interface Props {
  /** 厂区全景图 */
  image: string;
  alt?: string;
  /** 公司全称 —— 工厂店的主角是公司,不是标语 */
  company: string;
  /** 一句能力概括 */
  tagline?: string;
  /** 资质角标:已核验供应商、经营年限、认证 */
  badges?: Badge[];
  ctaText?: string;
  ctaHref?: string;
  secondText?: string;
  secondHref?: string;
}
const { image, alt = '', company, tagline, badges = [], ctaText, ctaHref, secondText, secondHref, cardRight = false } = Astro.props;
---

<section class:list={['sh', cardRight && 'card-right']}>
  <div class="bg">
    <img src={image} alt={alt || company} fetchpriority="high" decoding="async" />
    {/* 压暗到刚好托得住白字,不再多 —— 遮罩一重,厂房就脏 */}
    <span class="veil" aria-hidden="true"></span>
  </div>

  <div class="dtc-wrap-wide inner">
    <div class="card">
      <h1 class="name">{company}</h1>
      {tagline && <p class="tag">{tagline}</p>}

      {badges.length > 0 && (
        <ul class="badges">
          {badges.map((b) => (
            <li class:list={['badge', b.kind === 'verified' && 'ok']}>
              {b.kind === 'verified' && (
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M8 1.5 9.9 3l2.4-.2.5 2.3 1.7 1.7-1.2 2.1.3 2.4-2.3.6L9.6 14 8 12.8 6.4 14l-1.7-2.1-2.3-.6.3-2.4L1.5 6.8 3.2 5.1l.5-2.3L6.1 3 8 1.5Z" fill="currentColor" opacity=".18"/>
                  <path d="m5.4 8.2 1.9 1.9 3.5-3.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              <span>{b.text}</span>
            </li>
          ))}
        </ul>
      )}

      {(ctaText || secondText) && (
        <div class="acts">
          {ctaText && ctaHref && <a class="dtc-btn primary" href={ctaHref}>{ctaText}</a>}
          {secondText && secondHref && <a class="dtc-btn" href={secondHref}>{secondText}</a>}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* ── Shopify 式分栏店招(创始人终版口径 2026-08-31)──────────────
     「不要虚化,尽可能适合的比例」「随图片比例尽可能全部展示」
     「文字区继续小」「图小一点但塔要全貌」:
     左文右图 —— 图按自身 16:10 比例完整展示(资产同比例=零裁切),
     无虚化无遮罩,圆角落在版心内;文字墨色小巧落纸面;窄屏图上文下。 */
  /* 终排(创始人批注:文字块别占一栏,「放到下面」压图左下角,白底小卡缩一半)——
     图占满版心、16:10 零裁切;小白卡浮在图左下;窄屏卡退到图下方。 */
  /* 创始人终稿:「图片拉满全屏」「别圆角的缩小版」—— 全出血、直角、16:6 */
  .sh {
    position: relative;
    background: var(--dtc-paper);
  }
  .bg { position: relative; }
  .bg img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 6;   /* 创始人定稿:16:6(如 1920×720),出图按此比例零裁切 */
    object-fit: cover;
    border-radius: 0;
    background: var(--dtc-sand);
  }
  .veil { display: none; }
  .inner { position: relative; margin: 1rem 0 0; }
  @media (min-width: 64rem) {
    .inner {
      position: absolute;
      inset-inline-start: clamp(2rem, 5vw, 4.5rem);
      inset-block-end: clamp(2rem, 4.5vw, 4rem);
      margin: 0;
    }
  }
  /* 卡片右置(创始人:「把文字放到右边,就不挡住广州塔」)——
     图主体在左时启用,白卡压在右侧留白区 */
  .card-right .card { margin-inline-start: auto; }

  /* Shopify 式压图文字(创始人:「继续小,太大了!国外独立站 shopify 的风格
     不是你这样的」)—— 白卡整个退场:小字直接压图,靠 veil 渐变保对比;
     徽章半透明小胶囊,按钮小巧。 */
  /* 白底小卡 —— 老卡的一半:38rem→22rem 宽、内距/字号全部减半档 */
  /* 创始人 2026-08-31:「文字的白底太大了,继续砍掉一半」+「图片上的文字最简化」
     —— 22rem 再砍到 16rem;全端只留 名称+一句话+发起询盘,徽章/副按钮退场 */
  .card {
    background: var(--ck-surface);
    border: 1px solid var(--dtc-line);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    box-shadow: 0 12px 32px -22px rgb(0 0 0 / 0.35);
    max-width: 16rem;
    color: var(--dtc-ink);
  }
  .name {
    margin: 0;
    font-size: clamp(0.875rem, 0.8rem + 0.3vw, 1rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .tag {
    margin: 0.25rem 0 0;
    max-width: 40ch;
    font-size: max(0.75rem, 14px);
    line-height: 1.5;
    color: color-mix(in srgb, var(--dtc-ink) 64%, transparent);
  }

  .badges { display: none; }
  .acts .dtc-btn:not(.primary) { display: none; }
  .badges-off { display: flex; flex-wrap: wrap; gap: 0.375rem; margin: 0.875rem 0 0; padding: 0; list-style: none; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.2rem 0.625rem;
    border: 1px solid var(--dtc-line);
    border-radius: 999px;
    font-size: max(0.6875rem, 14px);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--dtc-ink) 72%, transparent);
    background: #fff;
  }
  /* 「已核验」那一枚给绿色 —— 语义色和品牌色分开,
     不然所有角标长得一样,核验过的那条就淹没了 */
  .badge.ok { color: #2f6b4f; border-color: color-mix(in srgb, #2f6b4f 35%, transparent); background: color-mix(in srgb, #2f6b4f 7%, transparent); }
  .badge svg { width: 0.875rem; height: 0.875rem; flex: none; }

  .acts { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-top: 0.75rem; }
  .acts .dtc-btn { margin-top: 0; padding: 0.4375rem 1rem; font-size: max(0.6875rem, 14px); }   /* 再减半档 */
  .acts .dtc-btn { margin-top: 0; }
  .dtc-btn.primary { background: var(--dtc-ink); color: #fff; }
  .dtc-btn.primary:hover { background: color-mix(in srgb, var(--dtc-ink) 85%, #fff); }

  @media (max-width: 48rem) {
    /* 手机:16:6 会缩成细条 —— 改 16:10 保画面体量;
       object-position 偏右锁住广州塔(塔在图右 ~65% 处),裁的是左侧楼群 */
    .bg img { height: auto; aspect-ratio: 16 / 10; object-position: 65% center; }
    .inner { margin-top: -3rem; }
    /* 创始人:「手机端太难看了!就保留 名称+一句话+发起询盘」—— 徽章撤 */
    .badges { display: none; }
    .acts .dtc-btn:not(.primary) { display: none; }
  }
</style>
