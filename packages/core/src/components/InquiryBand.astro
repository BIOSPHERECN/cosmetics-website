---
/**
 * 询盘转化带 —— 5 站唯一的转化目标(B 端询盘,不是成交)。
 * 施工图纪律:全线零支付、零购物车、零促销倒计时;这里只导向询盘页与邮箱。
 */
import type { InquiryCta } from '../types.ts';

export interface Props {
  inquiry: InquiryCta;
  href: string;
  /** 直连邮箱(可选):给不愿填表的采购一条更快的路 */
  email?: string;
}

const { inquiry, href, email } = Astro.props;
---

<section class="band" aria-label={inquiry.title}>
  <div class="ck-wrap inner">
    <div class="txt">
      <h2>{inquiry.title}</h2>
      {inquiry.body && <p class="body">{inquiry.body}</p>}
    </div>
    <div class="acts">
      <a class="cta" href={href}>{inquiry.button}</a>
      {email && <a class="mail" href={`mailto:${email}`}>{email}</a>}
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--ck-band-bg);
    color: var(--ck-band-ink);
    padding-block: var(--ck-section-py);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .txt { max-width: 42rem; }
  .body {
    margin-top: 0.75rem;
    color: color-mix(in srgb, currentColor 72%, transparent);
  }
  .acts {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .cta {
    display: inline-block;
    padding: 0.9375rem 2rem;
    background: var(--ck-accent);
    color: var(--ck-on-accent);
    border-radius: var(--ck-cta-radius);
    text-decoration: none;
    font-weight: var(--ck-cta-weight);
    letter-spacing: var(--ck-cta-tracking);
    text-transform: var(--ck-cta-transform);
    white-space: nowrap;
    transition: background var(--ck-dur) var(--ck-ease);
  }
  .cta:hover { background: var(--ck-accent-deep); }
  .mail {
    font-family: var(--ck-font-mono);
    font-size: var(--ck-small);
    color: color-mix(in srgb, currentColor 70%, transparent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .mail:hover { color: inherit; }
</style>
