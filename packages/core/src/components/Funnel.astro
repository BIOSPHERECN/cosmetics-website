---
/**
 * Funnel —— 3步交互式漏斗组件
 *
 * 版本: v1.0 (2026-10-19)
 * 设计来源: beauty2oem-UI重做/定稿方向.md (09-24 18:50)
 *
 * 核心原则:把复杂留给底层数据库(喂Google和AI抓流量),
 * 把极简留给前端交互(让真人买手30秒内看懂并留资)。
 *
 * 漏斗结构:
 *   第1步:你现在的起点是?(看中爆款/确定品类/只有目标市场)
 *   第2步:产品打算卖到哪里?(北美/东南亚/欧洲/中东/拉美/国内)
 *   第3步:属于哪个大类?(面部护肤/洗发护发/身体防晒/彩妆/口腔)
 *   → 点完3步,原地展开专属方案卡(基底+合规+包材+一键寄样)
 *
 * 铁律1:先给甜头后要电话(点完3步直接展示结果,不卡脖子留资)
 * 铁律2:交互不超过3步,每步有默认值
 * 铁律3:给大买手留快速通道(已有成分表/样品?直接发给工程师)
 *
 * 铁律4(新增):图文版——首屏必须有主视觉图,不是纯文字卡。
 *   图片全部自托管(webp),零外链,系统字体栈。
 *
 * 铁律5(新增):移动端目标长度不超过6000px。
 */

import { localePath } from '@cosmetic/core/i18n';
import { ldJson } from '../content/ldjson.ts';

interface Props {
  /** 语言,如 'zh-cn' / 'en'(由 [...path].astro 传入) */
  locale: string;
}

const { locale } = Astro.props;
const zhPage = String(locale).startsWith('zh');

/** 漏斗选项的i18n(与 beauty2oem-UI重做/定稿方向.md 对齐) */
const L = {
  slogan: zhPage ? '先找到值得做的产品，再由我们把它做出来。' : 'Find a product worth making first. We make it real.',
  subline: zhPage ? '15条自动化产线 · 13,000+成熟基底 · 43国合规前置' : '15 automated production lines · 13,000+ mature formula bases · 43-market compliance pre-check',
  step1: zhPage ? '第1步：你现在的起点是？' : 'Step 1: Where are you starting from?',
  step1opt1: zhPage ? '我看中了一款市面爆款，想做同款/升级款' : 'I found a hit product, want to make a similar/better version',
  step1opt2: zhPage ? '我确定了要做哪个品类，想挑成熟配方基底' : 'I know the category, want to pick a mature formula base',
  step1opt3: zhPage ? '我只有目标国家/渠道，想看最近什么好卖' : 'I only have a target market, want to see what sells',
  step2: zhPage ? '第2步：产品打算卖到哪里？' : 'Step 2: Where will you sell?',
  step3: zhPage ? '第3步：属于哪个大类？' : 'Step 3: Which category?',
  generate: zhPage ? '立即生成我的代工与合规方案' : 'Generate my OEM & compliance plan',
  fastTrack: zhPage ? '已有完整成分表或样品？点此直接传给工程师 →' : 'Already have a full INCI or sample? Send it straight to our engineers →',
  cat护肤: zhPage ? '面部护肤' : 'Facial skincare',
  cat洗护: zhPage ? '洗发护发' : 'Hair care',
  cat身体: zhPage ? '身体防晒' : 'Body & suncare',
  cat彩妆: zhPage ? '彩妆底妆' : 'Color cosmetics',
  cat口腔: zhPage ? '口腔护理' : 'Oral care',
  matchedBase: zhPage ? '为你匹配的在库基底' : 'Matched formula bases',
  compliance: zhPage ? '合规预警' : 'Compliance alert',
  packaging: zhPage ? '适配现货包材' : 'Matched stock packaging',
  requestSample: zhPage ? '一键申请免费样品' : 'Request free samples',
  contactUs: zhPage ? '加微信聊细节' : 'Chat on WhatsApp',
  moq: zhPage ? '现货包材代工：单品 1,000–3,000件起订' : 'Stock packaging OEM: MOQ 1,000–3,000 pcs per SKU',
  sampleTime: zhPage ? '成熟基底打样周期：5–14个工作日' : 'Mature base sampling: 5–14 working days',
  whatWeDo: zhPage ? '我们能做什么' : 'What we can make',
  whyTrust: zhPage ? '凭什么相信我们' : 'Why trust us',
  threeSteps: zhPage ? '三步开始' : 'Three steps to start',
  submit: zhPage ? '提交需求' : 'Submit your inquiry',
  noReg: zhPage ? '不用注册，直接填写。' : 'No registration required.',
  send: zhPage ? '立即询盘' : 'Send inquiry',
  stepDefine: zhPage ? '定方案与寄样' : 'Define & sample',
  stepDefineD: zhPage ? '拆成分 / 配基底 / 核法规，5–14天寄样' : 'Deconstruct formula, match base, check compliance. 5–14 day sampling.',
  stepPack: zhPage ? '定包装与备案' : 'Packaging & registration',
  stepPackD: zhPage ? '选现货包材 / 同步办理目标国通报' : 'Select stock packaging, file target market registration',
  stepMass: zhPage ? '试产与大货' : 'Trial & mass production',
  stepMassD: zhPage ? '小批试产 / QC放行出货' : 'Pilot run, QC release, shipment',
  mNA: zhPage ? '北美 (FDA)' : 'North America (FDA)',
  mSEA: zhPage ? '东南亚 (BPOM/清真)' : 'Southeast Asia (BPOM/Halal)',
  mEU: zhPage ? '欧洲 (CPNP)' : 'Europe (CPNP)',
  mME: zhPage ? '中东 (SFDA)' : 'Middle East (SFDA)',
  mLA: zhPage ? '拉美 (ANVISA)' : 'Latin America (ANVISA)',
  mCN: zhPage ? '国内 / 其他' : 'China / Other',
};

// === 方案数据库(前端静态版,后续可接API) ===
const BASES: Record<string, Array<{code: string; name: string; actives: string}>> = {
  skincare: [
    { code: 'BH-S-001', name: zhPage ? '草本舒缓精华基底' : 'Herbal soothing serum base', actives: zhPage ? '积雪草、泛醇、神经酰胺' : 'Centella, Panthenol, Ceramide' },
    { code: 'BH-S-042', name: zhPage ? '烟酰胺亮肤精华基底' : 'Niacinamide brightening serum base', actives: zhPage ? '烟酰胺 3%、熊果苷' : 'Niacinamide 3%, Arbutin' },
    { code: 'BH-S-089', name: zhPage ? '视黄醇抗老面霜基底' : 'Retinol anti-aging cream base', actives: zhPage ? '视黄醇 0.3%、角鲨烷' : 'Retinol 0.3%, Squalane' },
  ],
  body: [
    { code: 'BH-B-007', name: zhPage ? '草本止痒防晒乳' : 'Herbal anti-itch suncare lotion', actives: zhPage ? '薄荷醇、氧化锌、甘草酸' : 'Menthol, Zinc Oxide, Glycyrrhizin' },
    { code: 'BH-B-012', name: zhPage ? '冰感修护防晒喷雾' : 'Cooling repair suncare spray', actives: zhPage ? '薄荷脑、透明质酸' : 'Menthol, Hyaluronic Acid' },
  ],
  haircare: [
    { code: 'BH-H-005', name: zhPage ? '氨基酸洗发基底' : 'Amino acid shampoo base', actives: zhPage ? '氨基酸表活、生物素' : 'Amino acid surfactant, Biotin' },
    { code: 'BH-H-018', name: zhPage ? '头皮舒缓精华' : 'Scalp soothing essence', actives: zhPage ? '茶树油、吡罗克酮乙醇胺盐' : 'Tea Tree, Piroctone Olamine' },
  ],
  makeup: [
    { code: 'BH-M-003', name: zhPage ? '保湿粉底液基底' : 'Hydrating foundation base', actives: zhPage ? '透明质酸、烟酰胺' : 'Hyaluronic Acid, Niacinamide' },
    { code: 'BH-M-021', name: zhPage ? '哑光唇釉基底' : 'Matte lip tint base', actives: zhPage ? '植物角鲨烷' : 'Plant Squalane' },
  ],
  oral: [
    { code: 'BH-O-002', name: zhPage ? '草本牙膏基底(含氟)' : 'Herbal toothpaste base (fluoride)', actives: zhPage ? '氟化钠、草本提取物' : 'Sodium Fluoride, Herbal extract' },
    { code: 'BH-O-007', name: zhPage ? '洁净牙片基底' : 'Tooth tablet base', actives: zhPage ? '碳酸钙、木糖醇' : 'Calcium Carbonate, Xylitol' },
  ],
};

const COMPLIANCE: Record<string, string> = {
  na: zhPage ? 'FDA: 需完成MoCRA注册(化妆品设施注册+产品列示)；OTC防晒需OTC药案' : 'FDA: MoCRA registration required (facility + product listing); OTC suncare needs OTC drug filing',
  sea: zhPage ? '印尼BPOM Notifkos通报；防晒剂需符合东盟ACD限用表；可配HALAL清真认证' : 'Indonesia BPOM Notifkos; UV filters must meet ASEAN ACD limits; HALAL certification available',
  eu: zhPage ? 'CPNP通报必需；PIF产品信息文件需备；防晒剂需符合EC No 1223/2009' : 'CPNP notification required; PIF file needed; UV filters per EC No 1223/2009',
  me: zhPage ? 'SFDA注册；需HALAL认证；阿拉伯语标签' : 'SFDA registration; HALAL required; Arabic labeling',
  la: zhPage ? '巴西ANVISA通报；西班牙语标签；防晒SPF测试报告' : 'Brazil ANVISA notification; Spanish labels; SPF test report',
  cn: zhPage ? '国产非特殊用途备案 / 特殊用途审批(防晒、美白)；全成分标注' : 'China non-special filing / special-use approval (suncare, whitening); full INCI labeling',
};

const PACKAGING: Record<string, string[]> = {
  skincare: [
    zhPage ? '滴管玻璃瓶 30ml (现货,1,000支起)' : 'Dropper glass bottle 30ml (stock, MOQ 1,000)',
    zhPage ? '真空泵瓶 50ml (现货,1,000支起)' : 'Airless pump bottle 50ml (stock, MOQ 1,000)',
    zhPage ? '膏霜罐 30g (现货,3,000支起)' : 'Cream jar 30g (stock, MOQ 3,000)',
  ],
  body: [
    zhPage ? '防晒软管 100ml (现货,1,000支起)' : 'Suncare tube 100ml (stock, MOQ 1,000)',
    zhPage ? '喷雾瓶 150ml (现货,3,000支起)' : 'Spray bottle 150ml (stock, MOQ 3,000)',
    zhPage ? '泵头瓶 200ml (现货,1,000支起)' : 'Pump bottle 200ml (stock, MOQ 1,000)',
  ],
  haircare: [
    zhPage ? '软管 300ml (现货,1,000支起)' : 'Tube 300ml (stock, MOQ 1,000)',
    zhPage ? '滴管瓶 30ml (现货,1,000支起)' : 'Dropper bottle 30ml (stock, MOQ 1,000)',
  ],
  makeup: [
    zhPage ? '粉底液瓶 30ml (现货,3,000支起)' : 'Foundation bottle 30ml (stock, MOQ 3,000)',
    zhPage ? '唇釉管 5ml (现货,3,000支起)' : 'Lip tint tube 5ml (stock, MOQ 3,000)',
  ],
  oral: [
    zhPage ? '牙膏管 100g (现货,3,000支起)' : 'Toothpaste tube 100g (stock, MOQ 3,000)',
    zhPage ? '压片瓶 60粒 (现货,3,000支起)' : 'Tablet bottle 60ct (stock, MOQ 3,000)',
  ],
};

---

<section class="funnel-hero" aria-labelledby="funnel-title">
  <div class="ck-wrap">
    <p class="brand-tag">BIOSPHERE-AI</p>
    <h1 id="funnel-title">{L.slogan}</h1>
    <p class="subline">{L.subline}</p>

    {/* 漏斗容器 */}
    <div class="funnel" id="funnel">
      {/* 第1步 */}
      <div class="funnel-step" data-step="1">
        <p class="funnel-q">{L.step1}</p>
        <div class="funnel-opts" data-group="start">
          <button class="funnel-opt" data-val="hit" type="button">{L.step1opt1}</button>
          <button class="funnel-opt" data-val="base" type="button">{L.step1opt2}</button>
          <button class="funnel-opt" data-val="trend" type="button">{L.step1opt3}</button>
        </div>
      </div>

      {/* 第2步 */}
      <div class="funnel-step hidden" data-step="2">
        <p class="funnel-q">{L.step2}</p>
        <div class="funnel-opts" data-group="market">
          <button class="funnel-opt" data-val="na" type="button">{L.mNA}</button>
          <button class="funnel-opt" data-val="sea" type="button">{L.mSEA}</button>
          <button class="funnel-opt" data-val="eu" type="button">{L.mEU}</button>
          <button class="funnel-opt" data-val="me" type="button">{L.mME}</button>
          <button class="funnel-opt" data-val="la" type="button">{L.mLA}</button>
          <button class="funnel-opt" data-val="cn" type="button">{L.mCN}</button>
        </div>
      </div>

      {/* 第3步 */}
      <div class="funnel-step hidden" data-step="3">
        <p class="funnel-q">{L.step3}</p>
        <div class="funnel-opts" data-group="category">
          <button class="funnel-opt" data-val="skincare" type="button">{L.cat护肤}</button>
          <button class="funnel-opt" data-val="haircare" type="button">{L.cat洗护}</button>
          <button class="funnel-opt" data-val="body" type="button">{L.cat身体}</button>
          <button class="funnel-opt" data-val="makeup" type="button">{L.cat彩妆}</button>
          <button class="funnel-opt" data-val="oral" type="button">{L.cat口腔}</button>
        </div>
      </div>

      {/* 生成按钮 */}
      <div class="funnel-action hidden" id="funnel-action">
        <button class="cta big" type="button" id="funnel-go">{L.generate}</button>
      </div>

      {/* 快速通道(大买手越狱) */}
      <p class="fast-track">
        <a href={localePath(locale, '/services/product-development/')}>{L.fastTrack}</a>
      </p>
    </div>

    {/* 结果卡(点完3步后原地展开) */}
    <div class="result-card hidden" id="result-card">
      <div class="result-section">
        <h3>{L.matchedBase}</h3>
        <div class="result-items" id="result-bases"></div>
      </div>
      <div class="result-section">
        <h3>{L.compliance}</h3>
        <div class="result-items" id="result-compliance"></div>
      </div>
      <div class="result-section">
        <h3>{L.packaging}</h3>
        <div class="result-items" id="result-packaging"></div>
      </div>
      <div class="result-cta">
        <a class="cta" href="#inquiry" id="result-sample">{L.requestSample}</a>
        <a class="cta outline" href={localePath(locale, '/contact/')}>{L.contactUs}</a>
      </div>
      <p class="moq-note">{L.moq} · {L.sampleTime}</p>
    </div>
  </div>
</section>

<style>
  .funnel-hero {
    background: var(--ck-hero-bg);
    color: var(--ck-hero-ink);
    padding-block: clamp(1.5rem, 4vw, 3.5rem);
  }
  .brand-tag { font-size: var(--ck-small); color: var(--ck-accent); letter-spacing: var(--ck-cta-tracking); text-transform: var(--ck-cta-transform); }
  .funnel-hero h1 { margin-top: 0.5rem; font-size: clamp(1.4rem, 3vw, 2.5rem); max-width: 28ch; }
  .subline { margin-top: 0.75rem; font-size: var(--ck-small); color: color-mix(in srgb, currentColor 70%, transparent); }

  .funnel { margin-top: 2rem; }
  .funnel-step { margin-bottom: 1.25rem; }
  .funnel-step.hidden { display: none; }
  .funnel-q { font-weight: 600; margin-bottom: 0.75rem; font-size: 0.9375rem; }
  .funnel-opts { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .funnel-opt {
    padding: 0.625rem 1rem; border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: var(--ck-radius, 10px); background: transparent; color: inherit;
    font: inherit; font-size: 0.875rem; cursor: pointer; transition: all 0.15s;
  }
  .funnel-opt:hover { border-color: var(--ck-accent); background: color-mix(in srgb, var(--ck-accent) 8%, transparent); }
  .funnel-opt.selected { border-color: var(--ck-accent); background: var(--ck-accent); color: var(--ck-on-accent); font-weight: 600; }

  .funnel-action { margin-top: 1.5rem; }
  .funnel-action.hidden { display: none; }
  .cta.big { padding: 1rem 2.5rem; font-size: 1rem; }
  .cta { display: inline-block; padding: 0.9375rem 2rem; background: var(--ck-accent); color: var(--ck-on-accent); border-radius: var(--ck-cta-radius); border: none; cursor: pointer; font-weight: var(--ck-cta-weight); letter-spacing: var(--ck-cta-tracking); text-transform: var(--ck-cta-transform); text-decoration: none; }
  .cta:hover { background: var(--ck-accent-deep); }
  .cta.outline { background: transparent; border: 1px solid var(--ck-accent); color: var(--ck-accent); }

  .fast-track { margin-top: 1.25rem; font-size: var(--ck-small); }
  .fast-track a { color: color-mix(in srgb, currentColor 70%, transparent); text-decoration: underline; }

  /* 结果卡 */
  .result-card { margin-top: 2rem; padding: 1.5rem; border: 1px solid color-mix(in srgb, currentColor 20%, transparent); border-radius: var(--ck-radius, 10px); background: color-mix(in srgb, currentColor 5%, transparent); }
  .result-card.hidden { display: none; }
  .result-section { margin-bottom: 1.25rem; }
  .result-section h3 { font-size: 0.9375rem; margin-bottom: 0.5rem; color: var(--ck-accent); }
  .result-items { display: grid; gap: 0.5rem; }
  .result-item { padding: 0.625rem 0.875rem; border: 1px solid color-mix(in srgb, currentColor 15%, transparent); border-radius: 8px; font-size: 0.8125rem; line-height: 1.5; }
  .result-cta { display: flex; gap: 0.75rem; margin-top: 1rem; flex-wrap: wrap; }
  .moq-note { margin-top: 0.75rem; font-size: var(--ck-small); color: color-mix(in srgb, currentColor 60%, transparent); }

  /* 移动端适配:首页目标长度不超过6000px */
  @media (max-width: 46rem) {
    .funnel-hero h1 { font-size: clamp(1.25rem, 5vw, 2rem); }
    .funnel-step { margin-bottom: 1rem; }
    .funnel-opt { padding: 0.5rem 0.875rem; font-size: 0.8125rem; }
  }
</style>


{/* 把服务端数据序列化成 JSON 岛,供客户端脚本读取(Astro 的 is:inline 不能访问 frontmatter 变量) */}
<script type="application/json" id="funnel-data" set:html={ldJson({ BASES, COMPLIANCE, PACKAGING })}></script>

<script is:inline>
  (function () {
    var zh = document.documentElement.lang.indexOf('zh') === 0;
    var selections = { start: null, market: null, category: null };

    /* 从 JSON 岛读取服务端序列化的数据(铁律:图文版数据不硬编码在客户端脚本里) */
    var dataEl = document.getElementById('funnel-data');
    var D = { BASES: {}, COMPLIANCE: {}, PACKAGING: {} };
    try { if (dataEl) D = JSON.parse(dataEl.textContent); } catch (_) {}

    var BASES = D.BASES || {};
    var COMPLIANCE = D.COMPLIANCE || {};
    var PACKAGING = D.PACKAGING || {};

    var funnel = document.getElementById('funnel');
    if (!funnel) return;
    var steps = funnel.querySelectorAll('.funnel-step');
    var actionDiv = document.getElementById('funnel-action');
    var goBtn = document.getElementById('funnel-go');
    var resultCard = document.getElementById('result-card');

    // 交互逻辑
    steps.forEach(function (stepEl, idx) {
      var opts = stepEl.querySelectorAll('.funnel-opt');
      opts.forEach(function (opt) {
        opt.addEventListener('click', function () {
          var group = stepEl.querySelector('.funnel-opts').getAttribute('data-group');
          selections[group] = opt.getAttribute('data-val');
          // 标记选中
          opts.forEach(function (o) { o.classList.remove('selected'); });
          opt.classList.add('selected');
          // 显示下一步
          if (idx + 1 < steps.length) {
            steps[idx + 1].classList.remove('hidden');
            steps[idx + 1].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
          // 3步都选完显示生成按钮
          if (selections.start && selections.market && selections.category) {
            actionDiv.classList.remove('hidden');
          }
        });
      });
    });

    // 默认选中示范组合(铁律2:每步有默认值)
    var step1Opts = steps[0].querySelectorAll('.funnel-opt');
    if (step1Opts.length > 1) {
      step1Opts[1].classList.add('selected');
      selections.start = step1Opts[1].getAttribute('data-val');
      steps[1].classList.remove('hidden');
      var step2Opts = steps[1].querySelectorAll('.funnel-opt');
      if (step2Opts.length > 0) {
        step2Opts[1].classList.add('selected');
        selections.market = step2Opts[1].getAttribute('data-val');
        steps[2].classList.remove('hidden');
        var step3Opts = steps[2].querySelectorAll('.funnel-opt');
        if (step3Opts.length > 0) {
          step3Opts[0].classList.add('selected');
          selections.category = step3Opts[0].getAttribute('data-val');
          actionDiv.classList.remove('hidden');
        }
      }
    }

    // 生成结果
    if (goBtn) {
      goBtn.addEventListener('click', function () {
        var cat = selections.category || 'skincare';
        var mkt = selections.market || 'sea';

        // 安全渲染(S6 闸门:禁用 innerHTML,全部走 textContent —— 数据来自静态 JSON,仍防注入)
        function itemBox(text) {
          var box = document.createElement('div');
          box.className = 'result-item';
          box.textContent = text;
          return box;
        }
        function fill(id, makeNodes) {
          var el = document.getElementById(id);
          if (!el) return [];
          el.textContent = '';
          var nodes = makeNodes();
          nodes.forEach(function (n) { el.appendChild(n); });
          return nodes;
        }

        // 填充基底(每项:编号 + 名称 + 活性物)
        var bases = BASES[cat] || BASES.skincare;
        fill('result-bases', function () {
          return bases.map(function (b) {
            return itemBox(b.code + '  ' + b.name + '  ·  ' + (zh ? '活性物：' : 'Actives: ') + b.actives);
          });
        });

        // 填充合规(纯文本,无结构)
        var compliance = COMPLIANCE[mkt] || COMPLIANCE.sea;
        fill('result-compliance', function () { return [itemBox(compliance)]; });

        // 填充包材
        var pkgs = PACKAGING[cat] || PACKAGING.skincare;
        fill('result-packaging', function () {
          return pkgs.map(function (p) { return itemBox(p); });
        });

        // 写入询盘表单的隐藏字段
        var msgField = document.querySelector('textarea[name="message"]');
        if (msgField) {
          var startLabel = { hit: zh ? '看中爆款做同款' : 'Hit product match', base: zh ? '挑成熟基底' : 'Pick mature base', trend: zh ? '看趋势选品' : 'Trend-based selection' };
          var mktLabel = { na: 'NA(FDA)', sea: 'SEA(BPOM)', eu: 'EU(CPNP)', me: 'ME(SFDA)', la: 'LA(ANVISA)', cn: zh ? '国内' : 'China' };
          var catLabel = { skincare: zh ? '面部护肤' : 'Skincare', haircare: zh ? '洗发护发' : 'Haircare', body: zh ? '身体防晒' : 'Body/Suncare', makeup: zh ? '彩妆' : 'Makeup', oral: zh ? '口腔护理' : 'Oral' };
          msgField.value = (zh ? '【漏斗询盘】' : '[Funnel inquiry] ') +
            (zh ? '起点：' : 'Start: ') + (startLabel[selections.start] || '') + ' | ' +
            (zh ? '市场：' : 'Market: ') + (mktLabel[mkt] || '') + ' | ' +
            (zh ? '品类：' : 'Category: ') + (catLabel[cat] || '') + '\n' +
            (zh ? '已看中基底：' : 'Selected bases: ') + bases.map(function (b) { return b.code; }).join(', ');
        }

        resultCard.classList.remove('hidden');
        resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  })();
</script>
