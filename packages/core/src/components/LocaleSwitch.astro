---
/**
 * 语言切换器 —— 全站唯一一处实现,页头 / 报头 / 页脚都用它。
 *
 * 为什么改成下拉:
 *   原来是一排横向互链。三种语言时还行,六种就把页头挤爆了 ——
 *   而且语种只会继续加。横排的宽度随语种数线性增长,下拉不增长,
 *   这是结构性差别,不是审美偏好。国际站(欧莱雅、资生堂、Intercos)
 *   一律是右上角一个下拉,访客的肌肉记忆就长在那儿。
 *
 * 为什么用 <details> 而不是自己写 JS 开合:
 *   原生元素自带键盘可达(Enter/空格开合)、自带 Esc 关闭语义、
 *   自带无障碍角色。自己用 div 造一遍,十有八九漏掉键盘那条。
 *   零 JS 也能开合 —— 下面那点脚本只做两件锦上添花的事:
 *   点外面关掉、记住选择的 cookie。脚本挂了,切语言照样能用。
 *
 * 为什么按钮上写「JP」而地址栏是 /ja/:
 *   ja 是 ISO 639-1 的语言码,Google 的 hreflang 只认它,写 jp 会失效。
 *   但访客眼里日本就是 JP。所以机器读 ja、人看 JP,两边都不将就。
 */
import { LOCALE_GROUPS, LOCALE_LABELS, LOCALE_SHORT, HREFLANG, isRtl, switchLocalePath, t, type Locale } from '../i18n/index.ts';

export interface Props {
  locale: Locale;
  /** 当前路径(含语言前缀),用来生成同页他语链接 */
  path: string;
  /**
   * 展开方向。页头在顶部 → 向下展开;页脚在底部 → 向上展开,
   * 否则菜单会掉到视口外面,得滚动才看得见。
   */
  drop?: 'down' | 'up';
  /** 紧凑档:报头那种细窄条用,字号与内边距收一档 */
  dense?: boolean;
}

const { locale, path, drop = 'down', dense = false } = Astro.props;
const tr = t(locale);
---

<details class:list={['ls', drop === 'up' && 'up', dense && 'dense']}>
  <summary aria-label={tr('lang.label')}>
    {/* 地球仪:全世界通用的「换语言」符号,不用国旗 ——
        国旗代表国家不代表语言(法语不只法国、马来语不只马来西亚),
        而且在某些市场会引出与生意无关的联想。 */}
    <svg class="ls-globe" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M3 12h18M12 3c2.4 2.5 3.6 5.6 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.6-3.6-9S9.6 5.5 12 3z"
            fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
    <span class="ls-now">{LOCALE_SHORT[locale]}</span>
    <svg class="ls-caret" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
      <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </summary>

  <div class="ls-menu">
    {LOCALE_GROUPS.map((g) => (
      <section class="ls-grp">
        {/* 大区标题不是装饰:36 个语种平铺成一列,人只会在里面上下乱扫。
            按大区分组之后,访客先定位「我在哪个洲」,再在 3-16 个里挑 —— 这是能扫完的量。 */}
        <h3 class="ls-gt">{g.group}</h3>
        <ul role="list">
          {g.codes.map((l) => (
            <li>
              <a
                class:list={['ls-item', l === locale && 'on']}
                href={switchLocalePath(path, l)}
                hreflang={HREFLANG[l]}
                data-locale={l}
                lang={HREFLANG[l]}
                dir={isRtl(l) ? 'rtl' : undefined}
                aria-current={l === locale ? 'true' : undefined}
              >
                <span class="ls-name">{LOCALE_LABELS[l]}</span>
                <span class="ls-code">{LOCALE_SHORT[l]}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</details>

<style>
  .ls {
    position: relative;
    flex: none;
  }
  /* 去掉 Safari/Chrome 默认的三角箭头 —— 我们自己画了一个 */
  .ls > summary::-webkit-details-marker { display: none; }
  .ls > summary::marker { content: ''; }

  .ls > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.5625rem;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--ck-ink-soft);
    background: transparent;
    border: var(--ck-border-w) solid var(--ck-line);
    border-radius: var(--ck-radius);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition: color var(--ck-dur) var(--ck-ease), border-color var(--ck-dur) var(--ck-ease);
  }
  .ls > summary:hover { color: var(--ck-ink); border-color: var(--ck-line-strong); }
  .ls > summary:focus-visible {
    outline: 2px solid var(--ck-accent);
    outline-offset: 2px;
  }
  .ls[open] > summary { color: var(--ck-ink); border-color: var(--ck-line-strong); }

  .ls-globe { width: 0.9375rem; height: 0.9375rem; flex: none; opacity: 0.75; }
  .ls-now { font-weight: 600; letter-spacing: 0.02em; }
  .ls-caret {
    width: 0.5rem;
    height: 0.3125rem;
    flex: none;
    opacity: 0.6;
    transition: transform 0.18s var(--ck-ease);
  }
  .ls[open] .ls-caret { transform: rotate(180deg); }

  /* ── 菜单本体 ─────────────────────────────────────────
     贴着切换器的「行末」那一侧展开,不顶出视口。
     用 inset-inline-end 而不是 right —— 阿拉伯语页面整体镜像后切换器在左上角,
     写死 right:0 会让菜单整块掉到视口左外(实测左边界 -702px,只能横向拖才看得见)。 */
  .ls-menu {
    position: absolute;
    top: calc(100% + 0.375rem);
    inset-inline-end: 0;
    z-index: 60;
    /* 三栏并排:36 个语种单栏要 36 行、竖着 1500px,一屏放不下必然滚动;
       分三栏后一屏看得完,眼睛横向扫比纵向滚快得多。 */
    width: min(46rem, calc(100vw - 2.5rem));
    columns: 3;
    column-gap: 1.25rem;
    max-height: min(30rem, 70vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.75rem 0.875rem;
    background: var(--ck-surface);
    border: var(--ck-border-w) solid var(--ck-line);
    border-radius: var(--ck-radius);
    box-shadow: 0 14px 34px -14px rgb(0 0 0 / 0.3);
  }
  .ls-grp {
    /* 一个大区不许被断到两栏里 —— 断了「欧洲」的标题就落在上一栏的末尾,读不通 */
    break-inside: avoid;
    margin-bottom: 0.875rem;
  }
  .ls-gt {
    margin: 0 0 0.25rem;
    padding: 0 0.625rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ck-ink-faint);
  }
  .ls-menu ul { margin: 0; padding: 0; list-style: none; }
  .ls.up .ls-menu {
    top: auto;
    bottom: calc(100% + 0.375rem);
  }

  .ls-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4375rem 0.625rem;
    border-radius: calc(var(--ck-radius) - 2px);
    font-size: 0.8125rem;
    line-height: 1.3;
    text-decoration: none;
    color: var(--ck-ink-soft);
  }
  .ls-item:hover { background: var(--ck-surface-alt); color: var(--ck-ink); }
  .ls-item.on { color: var(--ck-accent); font-weight: 600; }
  .ls-item:focus-visible {
    outline: 2px solid var(--ck-accent);
    outline-offset: -2px;
  }
  .ls-code {
    font-family: var(--ck-font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--ck-ink-faint);
    flex: none;
  }
  .ls-item.on .ls-code { color: var(--ck-accent); }

  /* 手机上三栏挤不下,回单栏;面板改成贴着右边缘的窄条 */
  @media (max-width: 44rem) {
    .ls-menu { columns: 1; width: min(17rem, calc(100vw - 2rem)); }
  }

  /* 紧凑档:报头那条细窄的期次行 */
  .ls.dense > summary {
    padding: 0.125rem 0.375rem;
    font-size: 0.6875rem;
    border-color: transparent;
  }
  .ls.dense > summary:hover { border-color: var(--ck-line); }
  .ls.dense .ls-globe { width: 0.8125rem; height: 0.8125rem; }
</style>

<script is:inline>
  /* 只做两件锦上添花的事;脚本挂了切换器照样能用(<details> 是原生开合)。 */
  (() => {
    /* ① 点到菜单外面就收起来。
          原生 <details> 不会自己关,六个语种的面板一直摊在那儿会挡住内容。 */
    document.addEventListener('click', (e) => {
      document.querySelectorAll('details.ls[open]').forEach((d) => {
        if (!d.contains(e.target)) d.open = false;
      });
    });
    /* Esc 关闭 —— 键盘用户的通用退出手势 */
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('details.ls[open]').forEach((d) => {
        d.open = false;
        d.querySelector('summary')?.focus();
      });
    });

    /* ② 手动选语言 = 明确表态,记一年;中间件读到这个 cookie 就不再按地区自动跳。
          不记的话:海外同事把英文链接发给国内客户,客户点开又被跳成中文 —— 看着像坏了。 */
    /* 存的是**语种码**(zh-cn / pt-br),不是 hreflang 值(zh-CN / pt-BR)——
       两者大小写不一致,靠中间件 toLowerCase 兜底能work但太脆:
       哪天多一个 sr-Latn 这样的写法就对不上了。存什么读什么,不做隐式转换。 */
    document.querySelectorAll('a[data-locale]').forEach((a) => {
      a.addEventListener('click', () => {
        document.cookie = 'bohui_lang=' + a.dataset.locale +
          ';path=/;max-age=31536000;samesite=lax';
      });
    });
  })();
</script>
