---
/**
 * 站点页头 —— 5 站共用一具外壳,风格差异全部由令牌承担。
 * 品牌标识:当前用「字标 + 站内绘制几何符号」占位(零外链、零图片依赖);
 * 创始人提供正式 logo 后,只需替换 <Wordmark> 内的 SVG,不动任何版式。
 * 语言切换:右上角下拉(LocaleSwitch),全站唯一一处实现。
 */
import { t, type Locale } from '../i18n/index.ts';
import LocaleSwitch from './LocaleSwitch.astro';
import CurrencySwitch from './CurrencySwitch.astro';   // 币种切换(2026-09-16):和语言并排,一处实现

export interface Props {
  locale: Locale;
  /** 当前路径(含语言前缀),语言切换器据此生成同页他语链接 */
  path: string;
  /** 拉丁品牌名(字标) */
  siteName: string;
  /** 中文定位(字标下的小字) */
  siteNameZh: string;
  /** 语言切换是否可用(风格实验室内嵌预览时关掉,避免跳出画廊) */
  showLocaleSwitch?: boolean;
  /** 惰性模式:风格实验室的预览页用。导航指向 # 而非真实路径,避免点出 404 */
  inert?: boolean;
  /**
   * 导航树(两级)。由数据库驱动 —— 运营在后台加一个页面,导航自动出现,不用改代码。
   * 不传时退回到只有「联系询盘」的最小导航(静态站与实验室预览用)。
   */
  nav?: NavNode[];
  /** 站点 id。只有 'beauty2oem' 走专用分支(字标、主按钮、AI 客服);其它站不传或传别的,走原路径 */
  brand?: string;
}

export interface NavNode {
  slug: string;
  label: string;
  children?: NavNode[];
}

const { locale, path, siteName, siteNameZh, showLocaleSwitch = true, inert = false, nav, brand } = Astro.props;
/* 09-24 图文版:BEAUTY2OEM 字标(2 绿色放大、OEM 红色、BEAUTY 取 --b2o-beauty)+ 主按钮「提交店铺，拿简报」;样式在 apps/web/src/styles/b2o.css */
const b2o = brand === 'beauty2oem';
/* 品牌标全局单一指向(创始人 2026-10-23):除 beauty2oem 外,所有站点左上角一律渲染
   同一个「公司 logo 锁图(logo.png,内含双环+biosphere 字标)+ AI 文字」组合,拼成 biosphere-AI。
   不再按 brand 分支、也不再显示 siteName/siteNameZh 双行文案 —— 任何页面改此一处即全站生效。 */
const tr = t(locale);

const L = (p: string) => (inert ? '#' : `/${locale}${p}`);
/* 导航项链接:普通 slug 走 /lang/slug/;带查询串的 slug(如 products/?cat=skincare)
   免加尾斜杠 —— 「产品品类」下拉的品类子项就是这种(创始人:「产品品类也下拉分类!」) */
const H = (slug: string) => (inert ? '#' : slug.includes('?') ? `/${locale}/${slug}` : `/${locale}/${slug}/`);

/** 数据库没给导航时的兜底:只放确实存在的页面,绝不放死链 */
const items: NavNode[] = nav?.length
  ? nav.filter((n) => n.slug !== '')
  : [{ slug: 'contact', label: tr('nav.contact') }];
---

<header class="hdr">
  {/* 手机端汉堡开关。必须是 header 第一个孩子:开合状态全靠
      `#mnav-t:checked ~ .bar …` 兄弟组合器传播 —— 不用 :has()。
      教训(2026-08-31 实测)::has 版规则命中、媒体激活、优先级全对,
      浏览器就是不重算样式(:has 状态失效怪癖);兄弟组合器二十年没坏过。 */}
  <input type="checkbox" id="mnav-t" class="mnav-t" aria-label={tr('footer.nav')} />
  {/*
   * 顶部工具条 —— 语言切换单独占一行,而不是挤在主导航那一排。
   *
   * 这不是为了好看,是实测逼出来的:本站一级导航有 8 项(783px),
   * 加字标 170px、语言 89px、询盘按钮 110px,再算两道 39px 的间距,
   * 合计 1247px > 可用的 1199px —— 于是「语言 + 询盘」整块被挤到第二行的**左边**,
   * 正好落在最不该出现的位置。
   *
   * 而且这条只会越来越挤:语种还要加、栏目还要加。
   * 把语言提到独立的一条,主导航就永远不必和它抢宽度 ——
   * 国际站(欧莱雅、资生堂、Intercos)都是这个两层结构,原因是一样的。
   */}
  {showLocaleSwitch && (
    <div class="util">
      <div class="ck-wrap util-in">
        <LocaleSwitch locale={locale} path={path} />
        <CurrencySwitch />
      </div>
    </div>
  )}

  <div class="ck-wrap bar">
    <a class:list={['mark', { 'bio-mark': !b2o }]} href={L('/')} aria-label={siteName}>
      {/* 品牌标:beauty2oem 走专用字标;其余站点一律用公司 logo 锁图 + AI 文字(全局单文件) */}
      {b2o ? <span class="b2o-mark"><b class="m-b">BEAUTY</b><b class="m-2">2</b><b class="m-o">OEM</b></span> : <>
      <img class="glyph" src="/logo.png" alt="biosphere-AI" />
      <span class="ai">AI</span>
      </>}
    </a>

    {/* 两级导航:零 JS,靠 :hover / :focus-within 展开 —— 键盘 Tab 同样能打开 */}
    <nav class="nav" aria-label={tr('footer.nav')}>
      {items.map((n) => (
        n.children?.length ? (
          <div class="grp">
            <a class="link" href={H(n.slug)} aria-haspopup="true">{n.label}</a>
            <ul class="sub">
              {n.children.map((c) => (
                <li><a class="sublink" href={H(c.slug)}>{c.label}</a></li>
              ))}
            </ul>
          </div>
        ) : (
          <a class="link" href={H(n.slug)}>{n.label}</a>
        )
      ))}
      {/* 手机端:语言切换从顶部工具条挪到这里,页头省下 44px */}
      {showLocaleSwitch && (
        <div class="mnav-locale">
          <LocaleSwitch locale={locale} path={path} />
        </div>
      )}
    </nav>

    <div class="right">
      {/* 字体 A- / A+:创始人 2026-09-11「全部页面也要有调整字体大小的 +-」。改 html 的 font-size,全站 rem 一起缩放;记在 localStorage */}
      <div class="fz" aria-label="font size"><button type="button" data-fz="-1" aria-label="A-">A−</button><button type="button" data-fz="1" aria-label="A+">A+</button></div>
      {b2o && <button type="button" class="b2o-ai" data-b2o-ai>AI 客服</button>}
      <a class="cta" href={b2o ? L('/brief/') : L('/contact/')}>{b2o ? '提交店铺，拿简报' : tr('cta.inquiry')}</a>
      {/* 汉堡钮 = 纯 label(点击联动顶部 checkbox),≥52rem 整块隐藏 */}
      <label class="burger" for="mnav-t" aria-hidden="true">
        <span class="bl"></span>
      </label>
    </div>
  </div>
</header>
<script is:inline>
(function(){try{var k='bh-fz',v=parseInt(localStorage.getItem(k)||'0')||0;var ap=function(){document.documentElement.style.fontSize=(100+v*10)+'%';};ap();document.querySelectorAll('.fz button').forEach(function(b){b.addEventListener('click',function(){v=Math.max(-2,Math.min(3,v+parseInt(b.dataset.fz)));localStorage.setItem(k,String(v));ap();});});}catch(e){}})();
</script>

<style>
  .fz { display: inline-flex; gap: .125rem; }
  .fz button { min-width: 2.25rem; min-height: 2.25rem; border: 1px solid var(--ck-line); background: transparent; color: var(--ck-ink-soft); border-radius: var(--ck-radius); font: inherit; font-size: .8125rem; cursor: pointer; }
  .fz button:hover { color: var(--ck-ink); border-color: var(--ck-ink); }
  @media (max-width: 52rem) { .fz { display: none; } }
  .hdr {
    background: var(--ck-bg);
    border-bottom: var(--ck-border-w) solid var(--ck-line);
    /* 吸顶。sticky 而不是 fixed:fixed 会把头部抽出文档流,
       每一页都得手工补一个等高的占位,少补一处就被盖掉一条 ——
       sticky 占着原来的位置,零补丁。通告条(在 header 外)正常滚走,
       导航到顶后钉住。 */
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.5rem;
    flex-wrap: wrap;
  }

  /* ── 字标 ─────────────────────────────── */
  .mark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ck-ink);
    margin-inline-end: auto;
  }
  .glyph {
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    object-fit: contain;
  }

  /* ── 品牌标全局样式:官方 logo 锁图 + 「AI」文字,整体放大 ──
     创始人 2026-10-23:「左上角只用公司 logo 图,文字用 biosphere-AI,
     另外加文字 AI,现在那么小不合适」。logo.png 是透明底双环+biosphere
     字标锁图,「AI」用品牌紫加粗拼出 biosphere-AI。全部站点共用这一套。 */
  .bio-mark { gap: 0.4rem; }
  .bio-mark .glyph { width: auto; height: 3rem; }
  .bio-mark .ai {
    font-family: var(--ck-font-head);
    font-size: 1.625rem;
    font-weight: 800;
    line-height: 1;
    color: #84569f;
    letter-spacing: 0.01em;
  }

  /* ── 主导航 ─────────────────────────────
     ★ align-items: center 不能省 ★
     导航项有两种:带二级菜单的外面裹了一层 .grp,不带的就是裸的 .link。
     flex 默认 align-items: stretch —— 于是 .grp 被拉满高度、里面的链接贴顶,
     而裸链接自己撑高度、文字居中。**实测两者文字中线差 8px**:
     六个导航项三高三低,眼睛读到的就是「导航栏是歪的」。
     盒子中线是齐的(都 135),所以只量盒子永远查不出来 ——
     必须量真实文字框(Range.getClientRects)才看得见。 */
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
    /* 桌面端导航居中(创始人 2026-09-11:「电脑导航栏放到中间,别靠右」):
       字标在左、询盘按钮在右,导航吃掉中间全部空间并居中 */
    flex: 1 1 auto;
    justify-content: center;
  }
  .link {
    font-size: var(--ck-small);
    text-decoration: none;
    color: var(--ck-ink-soft);
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
    transition: color var(--ck-dur) var(--ck-ease), border-color var(--ck-dur) var(--ck-ease);
  }
  .link:hover {
    color: var(--ck-ink);
    border-bottom-color: var(--ck-accent);
  }
  /* 中等宽度(笔记本 1280–1440):10 个导航项 + 字标 + 询盘按钮挤不进一行,
     询盘按钮会掉到第二排 —— 头部又是吸顶的,那一大块一直钉在屏幕上。
     收紧间距和字号让它保持单行;再窄交给 52rem 那条换行规则。
     ★ 这段必须写在 .link 基础规则**之后** ★
     第一版写在之前,同特异度下后写的基础规则赢,媒体查询整段是死的 ——
     产物里看得见、浏览器里不生效,这种最难查。 */
  @media (max-width: 90rem) {
    .nav { gap: 0.875rem; }
    .link { font-size: max(0.8125rem, 14px); }
  }

  /* ── 二级下拉(零 JS)────────────────────────── */
  /* 和裸 .link 用同一种对齐方式,两者文字才落在同一条线上 */
  .grp { position: relative; display: flex; align-items: center; }
  .sub {
    position: absolute;
    top: 100%;
    inset-inline-start: -0.875rem;
    min-width: 13rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--ck-surface);
    border: var(--ck-border-w) solid var(--ck-line);
    border-top: var(--ck-rule-w) solid var(--ck-accent);
    border-radius: var(--ck-radius);
    box-shadow: 0 12px 28px -12px rgb(0 0 0 / 0.25);
    /* 用 visibility 而非 display:none —— 后者会让内部链接对键盘不可达 */
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 20;
  }
  .grp:hover .sub,
  .grp:focus-within .sub {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  .sublink {
    display: block;
    padding: 0.5rem 1.125rem;
    font-size: var(--ck-small);
    color: var(--ck-ink-soft);
    text-decoration: none;
  }
  .sublink:hover { background: var(--ck-surface-alt); color: var(--ck-ink); }

  .right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* 汉堡:桌面/平板整块不存在,只在 ≤52rem 出场。
     checkbox 常驻视觉隐藏(不能 display:none —— 那样键盘就够不到了) */
  .burger { display: none; }
  .mnav-t {
    position: absolute;
    width: 1px; height: 1px;
    margin: 0; padding: 0;
    clip-path: inset(50%);
    opacity: 0;
  }

  /* ── 顶部工具条 ─────────────────────────────
     贴着页面最上沿,底色比页面深一格、字更小 ——
     让它读起来是「工具」而不是「内容」,眼睛会自动略过,
     需要时才在右上角找到它。 */
  .util {
    background: var(--ck-surface-alt);
    border-bottom: var(--ck-border-w) solid var(--ck-line);
  }
  .util-in {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 2.125rem;
    padding-block: 0.25rem;
  }


  .cta {
    display: inline-block;
    padding: 0.5625rem 1.125rem;
    background: var(--ck-accent);
    color: var(--ck-on-accent);
    border-radius: var(--ck-cta-radius);
    text-decoration: none;
    font-size: var(--ck-small);
    font-weight: var(--ck-cta-weight);
    letter-spacing: var(--ck-cta-tracking);
    text-transform: var(--ck-cta-transform);
    white-space: nowrap;
    transition: background var(--ck-dur) var(--ck-ease);
  }
  .cta:hover { background: var(--ck-accent-deep); }

  /* 窄屏:导航换行到第二排,不做汉堡菜单(零 JS 纪律)
   *
   * ★ flex-wrap: wrap 和 white-space: nowrap 这两条缺一不可 ★
   *
   * 实测在 375px 下栽过:这里只写了 width: 100%,没有开换行。
   * 于是 9 个导航项仍然挤在一行里,每项被压到 20–25px 宽,
   * 中文只能**一列一个字竖排** —— 量出来是 20×131、25×159 这种细长条。
   * 移动端导航等于废掉,而移动端多半占一半以上流量。
   *
   * 光加 wrap 还不够:不加 white-space: nowrap,单个词仍可能被拆成两行。
   * 要的是「整项作为一个单位换行」,不是「字符随便折」。
   */
  /* 中窄屏(966px 一类)原来落在 52–90rem 的空档:十个导航项和字标、
     CTA 挤在同一行随机折行 —— 创始人放大浏览的「乱」第一眼就是它。
     78rem 起导航就整行退到第二排,排满一行、左对齐,和内容同轴。 */
  @media (max-width: 78rem) {
    .bar { padding-block: 0.875rem; }
    .nav {
      order: 3;
      width: 100%;
      flex: none;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 0.25rem 1.125rem;
      border-top: var(--ck-border-w) solid var(--ck-line);
      padding-top: 0.5rem;
    }
    .link { white-space: nowrap; }
  }
  /* ── 手机端(≤52rem):汉堡菜单 ──────────────────────────────
   * 创始人实机验收:「导航栏卡死了!字体太大,空间都没了!」
   * 之前的做法是导航换行到第二排 —— 966px 下一行放得下,没问题;
   * 但 375px 下 10 项折成四行、每项还有 44px 触控高,吸顶头部吃掉 1/3 屏,
   * 页面还没开始就结束了。手机端唯一正确答案就是国际站标准的汉堡收纳:
   * 吸顶栏只留「字标 + 询盘 + 汉堡」一行,导航全部进下拉面板。
   * checkbox + :has 实现:零 JS(脚本挂了菜单也能开)、checkbox 可聚焦可空格切换。 */
  @media (max-width: 52rem) {
    .bar {
      flex-wrap: nowrap;
      gap: 0.5rem;
      min-height: 3.5rem;
      padding-block: 0.5rem;
    }
    .right { gap: 0.375rem; }
    /* QA 舰队量出的英文档:CTA「Start an inquiry」199.6px 把汉堡挤出视口 7px。
       字标、CTA、间距各收一档,375px 下英文全套 ≈343px 放得下 */
    .glyph { width: 1.5rem; height: 1.5rem; }
    .bio-mark .glyph { width: auto; height: 2rem; }
    .bio-mark .ai { font-size: 1.25rem; }
    .cta { padding: 0.5rem 0.75rem; font-size: max(0.75rem, 14px); letter-spacing: 0.01em; }

    /* 汉堡本体:44px 触控方块(label 原生联动 checkbox) */
    .burger { display: block; position: relative; width: 2.75rem; height: 2.75rem; flex: none; cursor: pointer; }
    .mnav-t:focus-visible ~ .bar .burger { outline: 2px solid var(--ck-accent); outline-offset: 2px; border-radius: var(--ck-radius); }
    .bl, .bl::before, .bl::after {
      content: '';
      position: absolute;
      inset-inline: 0.625rem;
      height: 2px;
      border-radius: 1px;
      background: var(--ck-ink);
      transition: transform 0.2s var(--ck-ease), opacity 0.2s var(--ck-ease), background 0.2s;
      pointer-events: none;
    }
    .bl { top: calc(50% - 1px); }
    .bl::before { inset-inline: 0; top: -0.4375rem; }
    .bl::after { inset-inline: 0; top: 0.4375rem; }
    .mnav-t:checked ~ .bar .bl { background: transparent; }
    .mnav-t:checked ~ .bar .bl::before { transform: translateY(0.4375rem) rotate(45deg); }
    .mnav-t:checked ~ .bar .bl::after { transform: translateY(-0.4375rem) rotate(-45deg); }

    /* 导航面板:挂在整个页头正下方,展开即全宽下拉;项目一行一个、44px 触控高 */
    .nav {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      width: auto;   /* 压掉 78rem 档的 width:100%,避免与 inset 双重约束 */
      display: block;
      background: var(--ck-bg);
      border-top: var(--ck-border-w) solid var(--ck-line);
      border-bottom: var(--ck-border-w) solid var(--ck-line);
      box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.25);
      padding: 0.25rem 1.25rem 0.625rem;
      max-height: calc(100dvh - 7rem);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-6px);
      transition: opacity 0.2s var(--ck-ease), transform 0.2s var(--ck-ease), visibility 0.2s;
    }
    .mnav-t:checked ~ .bar .nav { visibility: visible; opacity: 1; transform: none; }
    .nav > * + * { border-top: var(--ck-border-w) solid var(--ck-line); }
    .link {
      display: block;
      padding-block: 0.75rem;   /* 44px 触控行 */
      font-size: 0.9375rem;
      border-bottom: none;
      white-space: normal;
    }
    /* 二级:触屏没有 hover,下拉改为面板内缩进平铺,一直可见 */
    .grp { display: block; position: static; }
    .sub {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      min-width: 0;
      padding: 0 0 0.5rem;
      background: transparent;
      border: 0;
      box-shadow: none;
    }
    /* 二级项也要 44px 触控高。原来 0.5rem 上下 padding + 14px 行高 ≈ 36px,
       实测首页 110 个可点元素里 81 个不到 44px,其中 34 个就是这一条。 */
    .sublink { padding: 0.75rem 0 0.75rem 1.125rem; font-size: 0.875rem; min-height: 2.75rem; }

