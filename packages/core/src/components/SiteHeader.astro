---
/**
 * 站点页头 —— 5 站共用一具外壳,风格差异全部由令牌承担。
 * 品牌标识:当前用「字标 + 站内绘制几何符号」占位(零外链、零图片依赖);
 * 创始人提供正式 logo 后,只需替换 <Wordmark> 内的 SVG,不动任何版式。
 * 语言切换:右上角下拉(LocaleSwitch),全站唯一一处实现。
 */
import { t, type Locale } from '../i18n/index.ts';
import LocaleSwitch from './LocaleSwitch.astro';

export interface Props {
  locale: Locale;
  /** 当前路径(含语言前缀),语言切换器据此生成同页他语链接 */
  path: string;
  /** 拉丁品牌名(字标) */
  siteName: string;
  /** 中文定位(字标下的小字) */
  siteNameZh: string;
  /** 语言切换是否可用(风格实验室内嵌预览时关掉,避免跳出画廊) */
  showLocaleSwitch?: boolean;
  /** 惰性模式:风格实验室的预览页用。导航指向 # 而非真实路径,避免点出 404 */
  inert?: boolean;
  /**
   * 导航树(两级)。由数据库驱动 —— 运营在后台加一个页面,导航自动出现,不用改代码。
   * 不传时退回到只有「联系询盘」的最小导航(静态站与实验室预览用)。
   */
  nav?: NavNode[];
}

export interface NavNode {
  slug: string;
  label: string;
  children?: NavNode[];
}

const { locale, path, siteName, siteNameZh, showLocaleSwitch = true, inert = false, nav } = Astro.props;
const tr = t(locale);

const L = (p: string) => (inert ? '#' : `/${locale}${p}`);

/** 数据库没给导航时的兜底:只放确实存在的页面,绝不放死链 */
const items: NavNode[] = nav?.length
  ? nav.filter((n) => n.slug !== '')
  : [{ slug: 'contact', label: tr('nav.contact') }];
---

<header class="hdr">
  {/*
   * 顶部工具条 —— 语言切换单独占一行,而不是挤在主导航那一排。
   *
   * 这不是为了好看,是实测逼出来的:本站一级导航有 8 项(783px),
   * 加字标 170px、语言 89px、询盘按钮 110px,再算两道 39px 的间距,
   * 合计 1247px > 可用的 1199px —— 于是「语言 + 询盘」整块被挤到第二行的**左边**,
   * 正好落在最不该出现的位置。
   *
   * 而且这条只会越来越挤:语种还要加、栏目还要加。
   * 把语言提到独立的一条,主导航就永远不必和它抢宽度 ——
   * 国际站(欧莱雅、资生堂、Intercos)都是这个两层结构,原因是一样的。
   */}
  {showLocaleSwitch && (
    <div class="util">
      <div class="ck-wrap util-in">
        <LocaleSwitch locale={locale} path={path} />
      </div>
    </div>
  )}

  <div class="ck-wrap bar">
    <a class="mark" href={L('/')} aria-label={siteName}>
      {/* 站内绘制的几何标记:同心方 + 斜线,任何流派下都成立;正式 logo 到位后替换 */}
      <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="1.5" y="1.5" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M6 18 L18 6" stroke="currentColor" stroke-width="1.5" />
        <circle cx="12" cy="12" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <span class="words">
        <strong class="name">{siteName}</strong>
        <span class="zh">{siteNameZh}</span>
      </span>
    </a>

    {/* 两级导航:零 JS,靠 :hover / :focus-within 展开 —— 键盘 Tab 同样能打开 */}
    <nav class="nav" aria-label={tr('footer.nav')}>
      {items.map((n) => (
        n.children?.length ? (
          <div class="grp">
            <a class="link" href={L(`/${n.slug}/`)} aria-haspopup="true">{n.label}</a>
            <ul class="sub">
              {n.children.map((c) => (
                <li><a class="sublink" href={L(`/${c.slug}/`)}>{c.label}</a></li>
              ))}
            </ul>
          </div>
        ) : (
          <a class="link" href={L(`/${n.slug}/`)}>{n.label}</a>
        )
      ))}
    </nav>

    <div class="right">
      <a class="cta" href={L('/contact/')}>{tr('cta.inquiry')}</a>
    </div>
  </div>
</header>

<style>
  .hdr {
    background: var(--ck-bg);
    border-bottom: var(--ck-border-w) solid var(--ck-line);
    position: relative;
    z-index: 5;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.5rem;
    flex-wrap: wrap;
  }

  /* ── 字标 ─────────────────────────────── */
  .mark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ck-ink);
    margin-inline-end: auto;
  }
  .glyph {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    color: var(--ck-accent);
  }
  .words {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .name {
    font-family: var(--ck-font-head);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .zh {
    font-size: 0.6875rem;
    color: var(--ck-ink-faint);
    letter-spacing: 0.04em;
    margin-top: 0.125rem;
  }

  /* ── 主导航 ───────────────────────────── */
  .nav {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2rem);
  }
  .link {
    font-size: var(--ck-small);
    text-decoration: none;
    color: var(--ck-ink-soft);
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
    transition: color var(--ck-dur) var(--ck-ease), border-color var(--ck-dur) var(--ck-ease);
  }
  .link:hover {
    color: var(--ck-ink);
    border-bottom-color: var(--ck-accent);
  }

  /* ── 二级下拉(零 JS)────────────────────────── */
  .grp { position: relative; }
  .sub {
    position: absolute;
    top: 100%;
    inset-inline-start: -0.875rem;
    min-width: 13rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--ck-surface);
    border: var(--ck-border-w) solid var(--ck-line);
    border-top: var(--ck-rule-w) solid var(--ck-accent);
    border-radius: var(--ck-radius);
    box-shadow: 0 12px 28px -12px rgb(0 0 0 / 0.25);
    /* 用 visibility 而非 display:none —— 后者会让内部链接对键盘不可达 */
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 20;
  }
  .grp:hover .sub,
  .grp:focus-within .sub {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  .sublink {
    display: block;
    padding: 0.5rem 1.125rem;
    font-size: var(--ck-small);
    color: var(--ck-ink-soft);
    text-decoration: none;
  }
  .sublink:hover { background: var(--ck-surface-alt); color: var(--ck-ink); }

  .right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* ── 顶部工具条 ─────────────────────────────
     贴着页面最上沿,底色比页面深一格、字更小 ——
     让它读起来是「工具」而不是「内容」,眼睛会自动略过,
     需要时才在右上角找到它。 */
  .util {
    background: var(--ck-surface-alt);
    border-bottom: var(--ck-border-w) solid var(--ck-line);
  }
  .util-in {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 2.125rem;
    padding-block: 0.25rem;
  }


  .cta {
    display: inline-block;
    padding: 0.5625rem 1.125rem;
    background: var(--ck-accent);
    color: var(--ck-on-accent);
    border-radius: var(--ck-cta-radius);
    text-decoration: none;
    font-size: var(--ck-small);
    font-weight: var(--ck-cta-weight);
    letter-spacing: var(--ck-cta-tracking);
    text-transform: var(--ck-cta-transform);
    white-space: nowrap;
    transition: background var(--ck-dur) var(--ck-ease);
  }
  .cta:hover { background: var(--ck-accent-deep); }

  /* 窄屏:导航换行到第二排,不做汉堡菜单(零 JS 纪律) */
  @media (max-width: 52rem) {
    .bar { padding-block: 0.875rem; }
    .nav { order: 3; width: 100%; border-top: var(--ck-border-w) solid var(--ck-line); padding-top: 0.5rem; }
    .zh { display: none; }
  }
</style>

