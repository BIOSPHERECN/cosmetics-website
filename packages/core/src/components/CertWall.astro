---
/**
 * 认证墙 —— PDF 钦定本厂信息架构第二件套。
 * 对标 Kolmar Korea(PDF:「认证墙陈列方式」)与 Cosmax 的技术史+认证体系。
 * 徽标一律站内绘制(纯 CSS/文字),不外链任何图床或第三方徽标服务。
 */
import type { Certification } from '../types.ts';

export interface Props {
  title: string;
  note?: string;
  items: Certification[];
}

const { title, note, items } = Astro.props;

/*
 * ★ 数据来自后台,后台的数据来自人手输入 —— 不能假设字段一定在 ★
 *
 * 原来这里直接 c.label.slice(0,2)。一条数据少了 label,整页就是
 * 「HTTP 200 + 0 字节」的空白 —— 没有报错、没有提示,运营只会看到白屏。
 * 一个字段缺失的代价不该是整站那一页打不开。
 *
 * 顺带兼容 name/title 两种写法:同一个概念在别处叫 name,
 * 内容是人填的,不该因为叫法不同就崩。
 */
const rows = (Array.isArray(items) ? items : [])
  .map((c: any) => ({
    label: String(c?.label ?? c?.name ?? c?.title ?? '').trim(),
    note: c?.note ?? c?.code ?? '',
  }))
  .filter((c) => c.label);
---

<section class="certwall ck-section" aria-label={title}>
  <div class="ck-wrap">
    <h2>{title}</h2>
    {note && <p class="note">{note}</p>}
    <ul class="grid">
      {rows.map((c) => (
        <li class="cert">
          <span class="mark" aria-hidden="true">{c.label.slice(0, 2).toUpperCase()}</span>
          <span class="body">
            <strong class="label">{c.label}</strong>
            {c.note && <span class="sub">{c.note}</span>}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .certwall {
    background: var(--ck-bg);
  }
  .note {
    margin-top: 0.875rem;
    max-width: var(--ck-maxw-prose);
    color: var(--ck-ink-soft);
    font-size: var(--ck-small);
  }
  .grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--ck-gap);
  }
  .cert {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.125rem;
    background: var(--ck-surface);
    border: var(--ck-border-w) solid var(--ck-line);
    border-radius: var(--ck-radius);
    box-shadow: var(--ck-shadow);
  }
  /* 站内绘制的徽标占位:取认证名首两字母,方框 + 强调色 —— 零外部请求 */
  .mark {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    background: var(--ck-accent-soft);
    color: var(--ck-accent);
    border-radius: var(--ck-radius);
    font-family: var(--ck-font-head);
    font-weight: 700;
    font-size: max(0.8125rem, 14px);
    letter-spacing: 0.02em;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    min-width: 0;
  }
  .label {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .sub {
    font-size: var(--ck-small);
    color: var(--ck-ink-faint);
  }
  /* 创始人:手机不要一行单图 —— 图网格保持 2 列 */
  @media (max-width: 40rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 0.75rem; } }
  /* 创始人:图下文字手机端太大 —— 降档 */
  @media (max-width: 40rem) { .label { font-size: max(0.8125rem, 14px); } }
</style>
