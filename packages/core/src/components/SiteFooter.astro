---
/**
 * 站点页脚 —— 含「集团品牌生态互链」。
 * 依据创始人品牌视觉图的《品牌生态架构》:以 BIOSPHERE-AI 为科技大脑,
 * 四个平台品牌互为生态。5 站互链既服务真实客户动线,也是矩阵站的自然内链结构。
 * 纪律:互链只指向本集团自有域名,不外链任何第三方。
 */
import { t, type Locale } from '../i18n/index.ts';
import LocaleSwitch from './LocaleSwitch.astro';
import type { SiteDef } from '../registry.ts';
import { waDigits, waOrContact } from '../content/wa-link.mjs';

export interface Props {
  locale: Locale;
  path: string;
  site: SiteDef;
  /** 集团其余站点(互链用);实验室预览时传空数组即可 */
  siblings: SiteDef[];
  email: string;
  /** 互链是否可点(实验室内嵌预览时置 false,避免跳出画廊) */
  linkSiblings?: boolean;
  /** 可选:显式传联络方式;不传则读 Astro.locals.contact(middleware 从 sites 表注入) */
  whatsapp?: string | null;
  wechat?: string | null;
  showLocaleSwitch?: boolean;
  /** 纯中文站(BEAUTY2OEM,09-23 创始人「纯中文,不需要英文」):不出邮箱 / WhatsApp,微信有号才出,联系入口给简报表单 */
  cnOnly?: boolean;
  /** 惰性模式:风格实验室的预览页用。站内导航指向 # 而非真实路径,避免点出 404 */
  inert?: boolean;
  /** 导航树,与页头同源(数据库驱动);不传则退回最小导航 */
  nav?: { slug: string; label: string; children?: { slug: string; label: string }[] }[];
}

const {
  locale, path, site, siblings, email,
  linkSiblings = true, showLocaleSwitch = true, inert = false, nav, cnOnly = false,
} = Astro.props;
const tr = t(locale);
const year = 2026;
const L = (p: string) => (inert ? '#' : `/${locale}${p}`);

/** 页脚列全部顶级页面(含法务页);没拿到导航数据时只放确实存在的两项,不放死链 */
const items = nav?.length
  ? [{ slug: '', label: tr('nav.home') }, ...nav]
  : [{ slug: '', label: tr('nav.home') }, { slug: 'contact', label: tr('nav.contact') }];
/* (行业资讯已作为 pages 行进了导航树,这里不再手动追加 —— 追加过一次,页脚出现双份) */
/* 联络方式:页面可显式传 whatsapp/wechat,否则读 middleware 注入的 locals.contact。
   有号则 wa.me 预填代工话术;无号则链到本语种联系页。纯中文站不出 WhatsApp。 */
const _contact = ((Astro.locals as any)?.contact ?? {}) as { whatsapp?: string | null; wechat?: string | null };
const waRaw = String((Astro.props as any).whatsapp ?? _contact.whatsapp ?? '');
const wa = waDigits(waRaw);
const waHref = waOrContact({ whatsapp: waRaw, lang: locale, siteName: site.name });
const wx = String((Astro.props as any).wechat ?? _contact.wechat ?? '').trim();
---

<footer class="ft">
  <div class="ck-wrap top">
    <div class="col brandcol">
      {/* 09-24 图文版:BEAUTY2OEM 用新字标(样式在 apps/web/src/styles/b2o.css);其它站原样 */}
      {cnOnly ? <strong class="name"><span class="b2o-mark" aria-label={site.name}><b class="m-b">BEAUTY</b><b class="m-2">2</b><b class="m-o">OEM</b></span></strong> : <strong class="name">{site.name}</strong>}
      <p class="zh">{site.nameZh}</p>
      {/* 品牌口径(创始人 2026-08-31 定稿):中文「帛卉化妆品」,英文只用 BIOSPHERE,
          不打集团旗号;法人全称只出现在法务页。 */}
      <p class="group">{cnOnly ? '帛卉化妆品 · 广州工厂' : <>{locale.startsWith('zh') ? '帛卉化妆品 BIOSPHERE' : 'BIOSPHERE'} · {tr('footer.groupLine')}</>}</p>
      {cnOnly && nav?.length && (
        <ul class="b2o-fnav">{nav.filter((n) => n.slug).map((n) => <li><a href={L(`/${n.slug}/`)}>{n.label}</a></li>)}</ul>
      )}
    </div>

    {/* 站内导航列已删(创始人 2026-08-31:「和顶部导航基本重复,这个部分可以不要了」)。
        吸顶导航全程可见,页脚重复一遍只占地方;联系方式与法务链保留。 */}

    <div class="col">
      <h2 class="ch">{tr('footer.contact')}</h2>
      <ul class="list">
        {cnOnly && <li><a href={L('/brief/')}>提交店铺，拿简报 →</a></li>}
        {cnOnly && wx && <li class="plain wx">微信:{wx}</li>}
        {!cnOnly && email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        {/* WhatsApp:海外采购最常用的联络方式。号码来自后台站点设置;没填就回联系页。 */}
        {cnOnly ? null : wa ? (
          <li><a href={waHref} target="_blank" rel="noopener noreferrer" class="wa">
            <span aria-hidden="true">💬</span> WhatsApp +{wa}
          </a></li>
        ) : (
          <li><a href={waHref} class="wa">
            <span aria-hidden="true">💬</span> WhatsApp / WeChat:填询盘表单后我们联系你
          </a></li>
        )}
        {/* WeChat:统一用英文写法「WeChat」,18 个语种都不翻译 ——
            创始人 2026-09-10 04:40:「统一 WeChat,这样翻译也不会乱」。
            微信号本身是标识符,翻译或本地化它只会让客户搜不到人。 */}
        {!cnOnly && <li class="plain wx"><span aria-hidden="true">💬</span> WeChat{wx ? `: ${wx}` : ''}</li>}
        <li class="plain">{site.domain}</li>
      </ul>
    </div>

    {siblings.length > 0 && (
      <div class="col wide">
        <h2 class="ch">集团品牌生态 / Brand Ecosystem</h2>
        <ul class="sibs">
          {siblings.map((s) => (
            <li>
              {linkSiblings ? (
                <a class="sib" href={s.url} rel="noopener">
                  <span class="sn">{s.name}</span>
                  <span class="sd">{s.nameZh}</span>
                </a>
              ) : (
                <span class="sib">
                  <span class="sn">{s.name}</span>
                  <span class="sd">{s.nameZh}</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="ck-wrap bottom">
    <p class="rights">© {year} {site.name}. {tr('footer.rights')}</p>
    {cnOnly && <p class="b2o-aigen">除标注「实拍」的车间照片外，页面中的场景照片为 AI 生成的示意图，不代表具体产品。</p>}
    {/* 隐私与法律声明:页面早就有(/privacy /terms),只是页脚一直没挂链接。
        对 Google 收录不是硬前提,但它是最基础的信任信号,
        AdSense / 购物类审核则是硬要求 —— 挂上有益无害。
        11 门生成语种还没有这两个键,tr 会返回 undefined,所以兜英文默认。 */}
    {/* 法务四件套(创始人对齐国际站惯例:「按 Google 的规定,底部还有几个协议?」)。
        Google 搜索本身不硬性规定数量;四件套是信任惯例 + AdSense/Merchant 的合规预留。 */}
    <nav class="legal" aria-label={tr('footer.privacy') ?? 'Privacy Policy'}>
      <a href={inert ? '#' : `/${locale}/privacy/`}>{tr('footer.privacy') ?? 'Privacy Policy'}</a>
      <span aria-hidden="true">·</span>
      <a href={inert ? '#' : `/${locale}/cookies/`}>{cnOnly ? '浏览数据说明' : (tr('footer.cookies') ?? 'Cookie Policy')}</a>
      <span aria-hidden="true">·</span>
      <a href={inert ? '#' : `/${locale}/terms/`}>{tr('footer.legal') ?? 'Legal Notices'}</a>
      <span aria-hidden="true">·</span>
      <a href={inert ? '#' : `/${locale}/disclaimer/`}>{tr('footer.disclaimer') ?? 'Disclaimer'}</a>
    </nav>
    {showLocaleSwitch && <LocaleSwitch locale={locale} path={path} drop="up" />}
  </div>
</footer>
{/* BEAUTY2OEM 手机吸底条:主按钮 + AI 客服(点它等于点右下角的客服圆钮);拿简报页不出,输入框聚焦时由 CSS 收起 */}
{cnOnly && !/\/brief\/$/.test(path) && (
  <div class="b2o-dock">
    <a class="b2o-btn b2o-btn-pri" href={L('/brief/')}>提交店铺，拿简报<span class="ico" aria-hidden="true">→</span></a>
    <button type="button" class="b2o-ai" data-b2o-ai>AI 客服</button>
  </div>
)}
{cnOnly && (
  <script is:inline>
    document.querySelectorAll('[data-b2o-ai]').forEach(function (b) { b.addEventListener('click', function () { var f = document.getElementById('bh-chat-fab'); if (f) f.click(); }); });
    /* Hide the mobile dock while the hero (which has the same CTA) is on screen; without JS the dock just stays visible. */
    (function () { var h = document.querySelector('.b2o-hero'); if (!h || !('IntersectionObserver' in window)) return;
      new IntersectionObserver(function (e) { document.documentElement.classList.toggle('b2o-hero-in', e[0].isIntersecting); }).observe(h); })();
  </script>
)}

<style>
  .list .wa { display: inline-flex; align-items: center; gap: .375rem; font-weight: 550; }
  .list .wa:hover { color: var(--ck-accent); }
  .ft {
    background: var(--ck-surface-alt);
    border-top: var(--ck-border-w) solid var(--ck-line);
    color: var(--ck-ink-soft);
    font-size: var(--ck-small);
  }
  .top {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1fr;
    gap: 2.5rem var(--ck-gap);
    padding-block: 3.5rem 2.5rem;
  }
  .col.wide { grid-column: 1 / -1; }

  .name {
    font-family: var(--ck-font-head);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ck-ink);
  }
  .zh { margin-top: 0.375rem; }
  .group {
    margin-top: 0.875rem;
    color: var(--ck-ink-faint);
    font-size: max(0.75rem, 14px);
    letter-spacing: 0.02em;
    max-width: 26rem;
  }

  .ch {
    font-size: max(0.6875rem, 14px);
    font-weight: 700;
    letter-spacing: var(--ck-tracking-eyebrow);
    text-transform: var(--ck-eyebrow-transform);
    color: var(--ck-ink-faint);
    margin-bottom: 1rem;
  }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .list a { text-decoration: none; }
  .list a:hover { color: var(--ck-ink); }
  .plain { color: var(--ck-ink-faint); font-family: var(--ck-font-mono); font-size: max(0.75rem, 14px); }

  /* 品牌生态互链:四格并排,悬停时强调色顶条亮起 */
  .sibs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
  }
  .sib {
    display: block;
    padding: 0.875rem 1rem;
    background: var(--ck-surface);
    border: var(--ck-border-w) solid var(--ck-line);
    border-top: var(--ck-rule-w) solid var(--ck-line-strong);
    border-radius: var(--ck-radius);
    text-decoration: none;
    transition: border-top-color var(--ck-dur) var(--ck-ease);
  }
  a.sib:hover { border-top-color: var(--ck-accent); }
  .sn {
    display: block;
    font-family: var(--ck-font-head);
    font-size: max(0.8125rem, 14px);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ck-ink);
  }
  .sd { display: block; margin-top: 0.25rem; font-size: max(0.75rem, 14px); color: var(--ck-ink-faint); }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.125rem;
    border-top: var(--ck-border-w) solid var(--ck-line);
    font-size: max(0.75rem, 14px);
    color: var(--ck-ink-faint);
  }
  .rights { margin: 0; }
  /* flex-wrap + nowrap:窄屏下让整条链接换行,而不是链接内部断字(「隐私政/策」) */
  .legal { display: flex; flex-wrap: wrap; gap: 0.375rem 0.625rem; align-items: baseline; font-size: var(--ck-small); }
  .legal a { white-space: nowrap; }
  .legal a { color: var(--ck-ink-faint); text-decoration: none; }
  .legal a:hover { color: var(--ck-ink); text-decoration: underline; text-underline-offset: 3px; }
  .legal span { color: var(--ck-ink-faint); }

  @media (max-width: 52rem) {
    .top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 34rem) {
    .top { grid-template-columns: 1fr; }
  }
</style>
