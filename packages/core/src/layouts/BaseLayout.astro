---
/**
 * 基座布局 —— 5 站唯一 HTML 外壳。
 * 风格三层叠加全部落在 <html> 的属性上:
 *   data-school  → 八大流派(schools.css)
 *   data-variant → 该域名下的第 N 套风格提案(variants/<siteId>.css)
 *   data-brand   → 品牌色微调(sites/<id>/src/styles/brand.css)
 * 所以「换风格」= 换一个属性值,不动任何页面代码。这是 5 域名 × 4 风格能在一套模板里跑的原因。
 */
import { ldJson } from '../content/ldjson.ts';
import { HREFLANG, OG_LOCALE, LOCALES, DEFAULT_LOCALE, isRtl, switchLocalePath, type Locale } from '../i18n/index.ts';
import ChatWidget from '../components/ChatWidget.astro';
import { env as cfEnv } from 'cloudflare:workers';
import '../styles/tokens.css';
// 字体层放在中性令牌之后、流派之前:它改写字体族与字号阶梯,
// 但仍允许各流派/风格在其上继续覆盖(如奢华系改用衬线)。
import '../styles/fonts.css';
import '../styles/schools.css';
import '../styles/variants.css';
// Summer Fridays 复刻层放最后:它要盖过流派与风格层。
// 由 <html data-summer> 开关控制,现在改成按站可选(见 theme 属性)。
import '../styles/summer.css';
// 深金主题 —— 创始人认可的那一版,现为默认主题(由 theme 属性切换)
import '../styles/noir.css';
// 编辑式版面层放最后:只改版面几何(不对称/出血/超大字/不均留白),不动颜色字体,
// 与主题层互不干扰。这一层是去掉「模板感」的关键 —— 模板感来自"每个版块都长一样"。
import '../styles/editorial.css';
// 节奏层放在几何层之后:它只管「屏与屏之间的空气」——
// 相邻版块背景交替 + 卡片圆角与悬停。不用图片就能造出层次,
// 这是创始人认可的那版深金站真正在做的事(实测,不是感觉)。
import '../styles/rhythm.css';
// 复刻层 —— 照抄创始人认可的那版站(自有账号自有站点),放在最后压过其它层
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource-variable/inter';
import '../styles/marvis.css';
/* DTC 品牌版式 —— 面向消费者的自有品牌站(MEDIERBA)专用。
   与另外四个代工站是两种语言:工厂站讲产能与合规,品牌站讲仪式感与成分故事。 */
import '../styles/dtc.css';
import '../styles/base.css';
import { orgJsonLd } from '../content/org.ts';

export interface Props {
  locale: Locale;
  /** 八大流派之一 */
  school: string;
  /** 该域名下的风格提案编号,如 'v1' */
  variant?: string;
  /** 品牌 id,用于 brand.css 的 [data-brand] 选择器 */
  brand: string;
  title: string;
  description: string;
  /** 站点名,追加到 <title> 后缀 */
  siteName: string;
  /** 生产环境站点根地址,用于 canonical / hreflang 绝对地址 */
  siteUrl: string;
  /** 当前页面路径(含语言前缀),如 /en/products/ */
  path: string;
  /** 是否让搜索引擎收录(风格画廊等内部页设 false) */
  indexable?: boolean;
  /** 品牌主色,用于生成站内绘制的 favicon(不外链、不占用一次网络请求) */
  brandColor?: string;
  /**
   * 社交分享缩略图(绝对地址)。
   * 缺这一张的代价很具体:链接发到 WhatsApp / LinkedIn / 微信,
   * 对方看到的是一条没有图的纯文字 —— 而采购群里刷过去,没图的那条不会有人点。
   */
  ogImage?: string;
  /**
   * 结构化数据(JSON-LD)。给搜索引擎和 AI 答案引擎读的机器可读事实。
   * 传对象或对象数组,这里负责序列化。
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * 视觉主题。此前写死成 summer(白底),5 个站没有一个能切到深金 ——
   * 而创始人认可的正是深金那版。写死主题等于把风格决定权焊在代码里,
   * 那本该是后台一个下拉框的事。
   */
  theme?: 'noir' | 'summer' | 'marvis' | 'dtc';
}

const {
  locale, school, variant, brand, title, description,
  siteName, siteUrl, path, indexable = true, brandColor = '#1f4e79',
  theme = 'marvis',
  ogImage,
  jsonLd,

} = Astro.props;

/**
 * favicon —— 内联 data URI,与页头字标同一个几何符号(同心方 + 斜线 + 圆)。
 * 用 data URI 而非 /favicon.ico 的原因:零额外网络请求、零文件、换品牌色即换图标;
 * 也避免了浏览器默认去请求 /favicon.ico 而产生 404 噪音。
 * 创始人提供正式 logo 后,替换成静态文件即可。
 */
const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="4" fill="${brandColor}"/><path d="M9.5 22.5 L22.5 9.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="16" cy="16" r="4.4" fill="none" stroke="#fff" stroke-width="2.4"/></svg>`;
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

const base = siteUrl.replace(/\/$/, '');
/* 把这一页实际用的站点 ID 写进响应头,供中间件的跨站防回归闸比对。
   只是一个诊断头,不含任何敏感信息。 */
try { Astro.response.headers.set('x-bh-site', String(brand ?? '')); } catch { /* 静态渲染时没有 response */ }
const canonical = `${base}${path}`;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

/**
 * 收录闸门(默认关闭 —— 安全侧默认值)
 * ────────────────────────────────────────────────────────────
 * 只有构建时显式设置 PUBLIC_LIVE=1 才允许被搜索引擎收录。
 * 原因:现阶段站内产能数字、认证清单均为占位样例,尚未经创始人核实;
 * 未核实的功效/产能宣称一旦被收录,撤回成本极高且有合规风险。
 * 正式域名接入、内容核实完毕后,在部署环境加 PUBLIC_LIVE=1 即全线开放收录。
 */
const liveIndexing = import.meta.env.PUBLIC_LIVE === '1';
const allowIndex = indexable && liveIndexing;

/* 社交缩略图:传了就用,没传退回站点厂区图 —— 绝对地址,相对路径在多数平台不解析 */
const ogImg = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${base}${ogImage}`)
  : `${base}/media/57`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
/* 09-24 W1b:Turnstile site key 读运行时 vars(公司 = wrangler.toml,平台 = mkconfig.py 写入自己那把);空 = 不注入组件 */
const tsKey = String((cfEnv as any)?.TURNSTILE_SITE_KEY ?? '').trim();
---

<!doctype html>
<html
  lang={HREFLANG[locale]}
  {/* 阿拉伯语/波斯语/希伯来语整页镜像。少这一个属性,那三门语言的页面
      导航跑左边、正文右起、标点全落错位置 —— 不是"不太好看",是读不了。
      版式用逻辑属性(margin-inline / padding-inline)写,加了 dir 自动翻。 */}
  dir={isRtl(locale) ? 'rtl' : 'ltr'}
  data-school={school}
  data-variant={variant}
  data-brand={brand}
  data-editorial
  data-summer={theme === 'summer' ? '' : undefined}
  data-noir={theme === 'noir' ? '' : undefined}
  data-marvis={theme === 'marvis' ? 'light' : undefined}
  data-dtc={theme === 'dtc' ? '' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    {!allowIndex && <meta name="robots" content="noindex,nofollow" />}

    {/* hreflang:四语互指 + x-default 指向默认语言,与 sitemap 用同一张表 */}
    {LOCALES.map((l) => (
      <link
        rel="alternate"
        hreflang={HREFLANG[l]}
        href={`${base}${switchLocalePath(path, l)}`}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${base}${switchLocalePath(path, DEFAULT_LOCALE)}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {/* og:locale:alternate for hreflang set */}
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:alt" content={title} />

    {/* Twitter/X 用自己一套标签,不读 og:*。少这四行,链接在 X 和部分 IM 里没有大图卡片 */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />

    {/* 结构化数据 —— 搜索引擎靠它出富摘要,AI 答案引擎靠它取事实。
        普通 HTML 里的「20,000 ㎡」机器要靠猜;放进 JSON-LD 就是明确的一条数据。 */}
    {ld.map((obj) => (
      <script type="application/ld+json" set:html={ldJson(obj)} />
    ))}

    {/* 09-24 W1:撤掉 Google Fonts(beauty2oem 铁令:国内可访问,不引 Google 服务)。
        dtc 标题字栈回落到本机阿里普惠体 / 苹方 / 雅黑;要统一字形再自托管(@fontsource)。 */}
    <slot name="head" />
    {/* Organization —— 全站只在这里发一份。2026-09-07 起每一页都带,
        这样单品详情和服务页被 AI 答案引擎落到时也知道是哪家公司。
        页面不要再把 orgJsonLd 塞进自己的 jsonLd:同一个 @id 出现两次就是重复块(SEO-004)。 */}
  <script type="application/ld+json" set:html={ldJson(orgJsonLd(base, siteName, locale, description, (Astro.locals as any)?.contact))} is:inline />
</head>
  <body>
    <slot />

    {/* 回到顶部。右下角从下到上是 AI 客服 → 询盘车(创始人钦定客服住最右下),
        第三个再叠上去就是一根按钮柱 —— 回顶最低频,搬去左下。
        滚过约一屏才出现:页面还在首屏时给"回到顶部"是噪音。 */}
    {/* AI 客服(先机器人后人工)。左下角 —— 右下已有询盘车与回顶两个浮层 */}
    <ChatWidget locale={locale} site={brand ?? 'biosphere-ai'} />

    <button class="ck-top" id="ck-top" aria-label="回到顶部" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
           stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5" /><path d="m5 12 7-7 7 7" />
      </svg>
    </button>
    <style>
      .ck-top {
        position: fixed;
        inset-inline-start: 1.5rem;   /* 左下(右下让给 AI 客服+询盘车);RTL 自动换边 */
        bottom: 1.5rem;
        width: 2.75rem; height: 2.75rem;
        border-radius: 50%;
        border: 1px solid var(--ck-line, rgb(0 0 0 / 0.12));
        background: var(--ck-surface, #fff);
        color: var(--ck-ink, #111);
        display: grid; place-items: center;
        cursor: pointer;
        box-shadow: 0 6px 18px -6px rgb(0 0 0 / 0.28);
        opacity: 0.92;
        z-index: 40;                /* 低于吸顶导航(50),不盖住下拉菜单 */
        transition: opacity 0.2s ease, transform 0.2s ease;
      }
      .ck-top:hover { opacity: 1; transform: translateY(-2px); }
      .ck-top[hidden] { display: none; }
      @media (prefers-reduced-motion: reduce) { .ck-top { transition: none; } }
    </style>
    <script is:inline>
      (() => {
        const btn = document.getElementById('ck-top');
        if (!btn) return;
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        btn.addEventListener('click', () =>
          scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }));

        let tick = false;
        const sync = () => { btn.hidden = scrollY < innerHeight * 0.9; tick = false; };
        addEventListener('scroll', () => {
          if (!tick) { tick = true; requestAnimationFrame(sync); }
        }, { passive: true });
        sync();
      })();
    </script>
    {/* 09-24 W1b 人机验证:凡是提交到询盘 / 简报接口的表单,统一在提交键前注入 Turnstile(服务端配了 secret 就缺令牌拒收,见 lib/human.ts)。
        已自带组件的表单跳过;没有这类表单的页面不加载脚本。组件来自 challenges.cloudflare.com(国内可达,不走 Google)。 */}
    {tsKey && (
      <script is:inline define:vars={{ tsKey }}>
        try {
          const fs = document.querySelectorAll('form[action="/api/inquiry"]:not([data-hc]),form[action="/api/b2o/brief"]:not([data-hc])');   /* data-hc = 已接点选码(C8),不再注入 */
          const mine = [];
          fs.forEach((f) => {
            if (f.querySelector('.cf-turnstile')) return;
            const d = document.createElement('div'); d.className = 'cf-turnstile'; d.dataset.sitekey = tsKey; d.dataset.size = 'flexible'; d.style.margin = '.5rem 0';
            const b = f.querySelector('button[type=submit],input[type=submit],button:not([type])');
            b ? b.parentNode.insertBefore(d, b) : f.appendChild(d); mine.push(d);
          });
          if (fs.length) {
            if (window.turnstile) mine.forEach((d) => window.turnstile.render(d, { sitekey: tsKey, size: 'flexible' }));
            else if (!document.querySelector('script[src*="challenges.cloudflare.com/turnstile"]')) {
              const s = document.createElement('script'); s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js'; s.async = true; document.head.appendChild(s);
            }
          }
        } catch (e) {}
      </script>
    )}
    {/* 真人信标:只有能执行 JS 的浏览器才会打到 /api/pulse,爬虫不会 —— 看真人流量只认这一条(2026-09-15)。
        不带任何个人信息;后台路径不打。 */}
    <script is:inline>
      try { if (!location.pathname.startsWith('/bohui')) { const u = '/api/pulse?p=' + encodeURIComponent(location.pathname.slice(0, 96)); (navigator.sendBeacon && navigator.sendBeacon(u)) || fetch(u, { method: 'POST', keepalive: true }); } } catch (e) {}
    </script>
    {/* WhatsApp 点击埋点(2026-10-28,创始人批准):点任何 wa.me 链接都记一笔 wa:click。
        与 human:js 同一张 AE 表,只换 blob1 —— 查「每天点 WhatsApp 的人数/来源页」就是它。 */}
    <script is:inline>
      try {
        if (!location.pathname.startsWith('/bohui')) {
          document.addEventListener('click', function (e) {
            const a = e.target && e.target.closest ? e.target.closest('a[href*="wa.me"]') : null;
            if (!a) return;
            const u = '/api/pulse?p=' + encodeURIComponent(location.pathname.slice(0, 96)) + '&wa=1';
            (navigator.sendBeacon && navigator.sendBeacon(u)) || fetch(u, { method: 'POST', keepalive: true });
          }, true);
        }
      } catch (e) {}
    </script>
  </body>
</html>
