---
/**
 * 询盘页 —— 全线唯一的转化目标(B 端询盘,不是成交)。
 * 首页每一个「发起询盘」按钮、页头 CTA、页脚都指向这里,所以它必须存在且好用。
 *
 * 零后端设计:静态站没有服务端,接第三方表单服务又会违反零外链纪律,
 * 因此改用「邮件预填模板」——点按钮唤起邮件客户端,主题与正文清单已填好。
 * B 端采购本就习惯邮件往来,且邮件天然留痕、可转发给同事,比表单更贴合真实动线。
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { localePath, t, type Locale } from '../i18n/index.ts';
import { SITES, getVariant, type SiteDef } from '../registry.ts';
import { CONTACT } from '../content/shared.ts';

export interface Props {
  site: SiteDef;
  locale: Locale;
  email: string;
}

const { site, locale, email } = Astro.props;
const tr = t(locale);
const variant = getVariant(site);
const c = CONTACT[locale];
const path = localePath(locale, '/contact/');
const siblings = SITES.filter((s) => s.id !== site.id);

/** 预填邮件:主题带品牌名,正文把清单逐条列成待填项 —— 采购只需在冒号后补内容 */
const mailBody = [
  `${c.checklistTitle}:`,
  '',
  ...c.checklist.map((x) => `- ${x}: `),
  '',
  '—',
  `${site.name} · ${site.domain}`,
].join('\n');
const zhPage = String(locale).startsWith('zh');
const INQUIRY_QS = (zhPage
  ? [
      '① 品牌与销售渠道是什么？', '答:', '',
      '② 目标市场是哪些国家或地区？', '答:', '',
      '③ 想做什么产品？有没有对标产品或链接？', '答:', '',
      '④ 目标人群与主打卖点是什么？', '答:', '',
      '⑤ 包装有什么想法（瓶型、容量、质感等）？', '答:', '',
      '⑥ 有哪些合规需求（FDA/MoCRA、CPNP、HALAL 等）？', '答:', '',
      '⑦ 计划什么时候上市？', '答:', '',
      '⑧ 首单量与后续补货量大概是多少？', '答:', '',
      '⑨ 预算区间是多少（选填）？', '答:',
    ]
  : [
      '① What is your brand and where do you sell?', 'A:', '',
      '② Which markets are you targeting?', 'A:', '',
      '③ What product do you want to make, and do you have benchmark products or links?', 'A:', '',
      '④ Who is the target customer, and what are the key selling points?', 'A:', '',
      '⑤ What packaging do you have in mind (format, size, and finish)?', 'A:', '',
      '⑥ What compliance support do you need (FDA/MoCRA, CPNP, HALAL, etc.)?', 'A:', '',
      '⑦ When do you plan to launch?', 'A:', '',
      '⑧ What are your expected first-order and replenishment volumes?', 'A:', '',
      '⑨ What is your budget range (optional)?', 'A:',
    ]).join('\n');
const mailto = `mailto:${email}?subject=${encodeURIComponent(`[${site.name}] ${c.mailSubject}`)}&body=${encodeURIComponent(mailBody)}`;
---

<BaseLayout
  locale={locale}
  school={variant.school}
  variant={variant.id}
  brand={site.id}
  siteName={site.name}
  siteUrl={site.url}
  path={path}
  title={c.title}
  description={c.intro}
  indexable={site.indexable}
  brandColor={site.brandColor}
>
  <a class="ck-skip-link" href="#main">{tr('a11y.skip')}</a>
  <SiteHeader locale={locale} path={path} siteName={site.name} siteNameZh={site.nameZh} />

  <main id="main">
    <section class="head">
      <div class="ck-wrap">
        <p class="ck-eyebrow">{site.name}</p>
        <h1>{c.title}</h1>
        <p class="intro">{c.intro}</p>
      </div>
    </section>

    <section class="body ck-section">
      <div class="ck-wrap cols">
        <div class="col-main">
          <h2>{c.checklistTitle}</h2>
          <ol class="list">
            {c.checklist.map((item, i) => (
              <li>
                <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{item}</span>
              </li>
            ))}
          </ol>
          {/* 2026-09-04:这一页原来只有一个 mailto 按钮 —— 手机上点了多半什么都不发生,
              而选品链路的「发送这套方案」正是落到这一页。所以这里必须有一张真表单,
              并且把链路带过来的配方号/包材号自动填进去。mailto 降级为备用入口。 */}
          <form class="inq" id="cform" action="/api/inquiry" method="post">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
                   style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
            <input type="hidden" name="source" value="contact" />
            <div class="grid2">
              <label><span>{zhPage ? '称呼' : 'Name'}</span>
                <input type="text" name="name" required autocomplete="name" /></label>
              <label><span>{zhPage ? '邮箱' : 'Email'}</span>
                <input type="email" name="email" autocomplete="email" /></label>
              <label><span>{zhPage ? 'WhatsApp 或电话（邮箱或此项至少填一个）' : 'WhatsApp or phone (email or this field is required)'}</span>
                <input type="tel" name="whatsapp" autocomplete="tel" inputmode="tel" placeholder="+62 812 3456 7890" maxlength="40" /></label>
            </div>
            <label class="full"><span>{zhPage ? '需求' : 'What you need'}</span>
              <textarea name="message" rows="15" required id="cmsg">{INQUIRY_QS}</textarea></label>
            <p class="act">
              <button class="cta" type="submit">{zhPage ? '发送询盘' : 'Send inquiry'}</button>
              <span class="fb" id="cfb" role="status" aria-live="polite"></span>
            </p>
          </form>
          <p class="hint">{c.note} · <a href={mailto}>{c.mailButton}</a></p>
          <script is:inline>
            (function () {
              const f = document.getElementById('cform');
              if (!f) return;
              const fb = document.getElementById('cfb');
              const ta = document.getElementById('cmsg');
              const zh = document.documentElement.lang.indexOf('zh') === 0;
              const email = f.elements.email;
              const whatsapp = f.elements.whatsapp;
              const validateContact = () => {
                const missing = !email.value.trim() && !whatsapp.value.trim();
                const msg = missing ? (zh ? '邮箱和 WhatsApp 或电话至少填写一个。' : 'Enter an email or a WhatsApp/phone number.') : '';
                email.setCustomValidity(msg);
                whatsapp.setCustomValidity(msg);
                return !missing;
              };
              email.addEventListener('input', validateContact);
              whatsapp.addEventListener('input', validateContact);
              try {
                const q = new URLSearchParams(location.search);
                const bits = [];
                if (q.get('formula')) bits.push((zh ? '配方 ' : 'Formula ') + q.get('formula'));
                if (q.get('pack')) bits.push((zh ? '包材 ' : 'Packaging ') + q.get('pack'));
                if (q.get('market')) bits.push((zh ? '目标市场 ' : 'Market ') + q.get('market'));
                if (q.get('claim')) bits.push((zh ? '诉求 ' : 'Claim ') + q.get('claim'));
                if (ta && bits.length) ta.value += String.fromCharCode(10, 10, 10) + bits.join(' · ');
                const h = sessionStorage.getItem('bh-chat-handoff');
                if (ta && h) { ta.value += String.fromCharCode(10, 10, 10) + h; sessionStorage.removeItem('bh-chat-handoff'); }
              } catch {}
              f.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (!validateContact()) { f.reportValidity(); return; }
                const btn = f.querySelector('button');
                btn.disabled = true;
                if (fb) { fb.className = 'fb'; fb.textContent = zh ? '提交中…' : 'Sending…'; }
                try {
                  const r = await fetch('/api/inquiry', { method: 'POST', body: new FormData(f) });
                  if (fb) {
                    fb.className = 'fb ' + (r.ok ? 'ok' : 'err');
                    fb.textContent = r.ok
                      ? (zh ? '已收到,我们会尽快回复。' : 'Received. We will get back to you shortly.')
                      : (zh ? '提交失败,请改用邮件联系我们。' : 'Could not send — please email us instead.');
                  }
                  if (r.ok) f.reset();
                } catch {
                  if (fb) { fb.className = 'fb err'; fb.textContent = zh ? '网络异常,请稍后重试。' : 'Network error, please retry.'; }
                } finally { btn.disabled = false; }
              });
            })();
          </script>
        </div>

        <aside class="col-side">
          <h2 class="sh">{c.directTitle}</h2>
          <dl class="facts">
            <div>
              <dt>{c.emailLabel}</dt>
              <dd><a class="mail" href={`mailto:${email}`}>{email}</a></dd>
            </div>
            {/* 即时联络放在邮箱下面 —— 海外采购普遍先加 WhatsApp / WeChat 再谈,
                邮件是留痕用的。两个号都不翻译:标识符翻译了就搜不到人
                (创始人 2026-09-10:「统一 WeChat,这样翻译也不会乱」)。 */}
            <div>
              <dt>WhatsApp</dt>
              <dd>填表后我们主动联系</dd>
            </div>
            <div>
              <dt>WeChat</dt>
              <dd>填表后我们主动加你</dd>
            </div>
            <div>
              <dt>{c.responseLabel}</dt>
              <dd>{c.responseValue}</dd>
            </div>
            <div>
              <dt>{c.langLabel}</dt>
              <dd>{c.langValue}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} path={path} site={site} siblings={siblings} email={email} />
</BaseLayout>

<style>
  .inq { display: grid; gap: .875rem; margin: 1.25rem 0 .5rem; }
  .inq .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: .875rem; }
  .inq label { display: grid; gap: .3125rem; font-size: var(--ck-small); }
  .inq label > span { color: var(--ck-ink-soft); }
  .inq input, .inq textarea { font: inherit; font-size: .9375rem; padding: .625rem .75rem;
    border: 1px solid var(--ck-line); border-radius: var(--ck-radius, 10px);
    background: var(--ck-surface, #fff); color: var(--ck-ink); width: 100%; }
  .inq input:focus, .inq textarea:focus { outline: none; border-color: var(--ck-accent); }
  .fb { margin-left: .75rem; font-size: var(--ck-small); color: var(--ck-ink-soft); }
  .fb.ok { color: #1D7A46; }
  .fb.err { color: #A02B20; }
  @media (max-width: 40rem) { .inq .grid2 { grid-template-columns: 1fr; } }
  .head {
    background: var(--ck-hero-bg);
    color: var(--ck-hero-ink);
    padding-block: clamp(2rem, 4vw, 4rem)   /* 09-17 「太多空余」 */;
  }
  h1 { margin-top: 0.75rem; }
  .intro {
    margin-top: 1.125rem;
    max-width: var(--ck-maxw-prose);
    color: color-mix(in srgb, currentColor 76%, transparent);
  }

  .body { background: var(--ck-bg); }
  .cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .list {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    border-top: var(--ck-rule-w) solid var(--ck-line-strong);
  }
  .list li {
    display: flex;
    gap: 1rem;
    padding: 0.9375rem 0;
    border-bottom: var(--ck-border-w) solid var(--ck-line);
    color: var(--ck-ink-soft);
  }
  .n {
    flex: none;
    font-family: var(--ck-font-mono);
    font-size: max(0.75rem, 14px);
    color: var(--ck-accent);
    padding-top: 0.25rem;
  }

  .act { margin-top: 2rem; }
  .cta {
    display: inline-block;
    padding: 0.9375rem 2rem;
    background: var(--ck-accent);
    color: var(--ck-on-accent);
    border-radius: var(--ck-cta-radius);
    text-decoration: none;
    font-weight: var(--ck-cta-weight);
    letter-spacing: var(--ck-cta-tracking);
    text-transform: var(--ck-cta-transform);
    transition: background var(--ck-dur) var(--ck-ease);
  }
  .cta:hover { background: var(--ck-accent-deep); }
  .hint {
    margin-top: 1.25rem;
    font-size: var(--ck-small);
    color: var(--ck-ink-faint);
    max-width: var(--ck-maxw-prose);
  }

  .col-side {
    padding: 1.75rem;
    background: var(--ck-surface-alt);
    border: var(--ck-border-w) solid var(--ck-line);
    border-top: var(--ck-rule-w) solid var(--ck-accent);
    border-radius: var(--ck-radius-lg);
  }
  .sh {
    font-size: var(--ck-h3);
  }
  .facts {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 1.125rem;
  }
  .facts dt {
    font-size: max(0.6875rem, 14px);
    letter-spacing: var(--ck-tracking-eyebrow);
    text-transform: var(--ck-eyebrow-transform);
    color: var(--ck-ink-faint);
    font-weight: 700;
  }
  .facts dd {
    margin: 0.375rem 0 0;
    font-size: var(--ck-small);
    color: var(--ck-ink-soft);
  }
  .mail {
    font-family: var(--ck-font-mono);
    color: var(--ck-accent);
    text-decoration: none;
    word-break: break-all;
  }
  .mail:hover { text-decoration: underline; }

  @media (max-width: 52rem) {
    .cols { grid-template-columns: 1fr; }
  }
</style>
