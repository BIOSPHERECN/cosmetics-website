 "risks": {
  "费用": [
   {
    "level": "低",
    "item": "带对 secret 的请求会绕过边缘缓存直接读 D1,值一旦泄露可以被用来放大读量。",
    "mitigation": "盯 Bohui-D1Budget 日读线;怀疑泄露时改 .env 里的值,再过一次 ship_ops prod,smoke.py 会自动跟上。"
   }
  ],
  "安全": [
   {
    "level": "中",
    "item": "set-probe-secret.mjs 可以绕开闸门直接跑:在错误账号下会建出草稿 Worker「bohui-web」,在已 source 公司 .env 的环境下会无单改生产 secret(见综合-1)。",
    "mitigation": "补 --name、cwd、账号守卫,或加进 hook 拦截名单;只通过 ship_ops.sh prod 执行。"
   }
  ],
  "合规": [
   "已查:R1–R11、RK7,未发现"
  ],
  "正确性": [
   {
    "level": "低",
    "item": "secret put 会用当前版本新建一次部署;如果最新上传的版本还没部署,wrangler 会整体报错不改,需要先部署再重跑。回显成功不等于生效。",
    "mitigation": "执行后查最终状态:wrangler secret list 能看到 PROBE_SECRET 这个名字,并且 ops.py 在 ship.jsonl 里记了 version_id;确认线上版本已经带 x-bohui-probe 中间件(本地 dist 已经含有)。"
   }
  ],
  "回归": [
   {
    "level": "低",
    "item": "smoke.py 也会给 beauty2oem.com 的 ?kk= URL 加探针头,但本单只给 bohui-web 设了 secret;如果 beauty2oem 由另一个 Worker 服务,那边 ?kk= 被 301 的误报还会在。",
    "mitigation": "确认 beauty2oem.com 当前由哪个 Worker 服务;如果是 beauty2oem-web,另开 prod 单设同一个值。"
   }
  ]
