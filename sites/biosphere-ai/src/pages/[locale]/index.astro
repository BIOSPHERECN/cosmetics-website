---
/**
 * BIOSPHERE-AI 首页 —— 薄壳,见 beauty2oem 同名文件的说明。
 * 本站 hasStudio=true:二期在此之上加「在线共创工作台」入口与选型器页面。
 */
import HomePage from '@cosmetic/core/layouts/HomePage.astro';
import { LOCALES, type Locale } from '@cosmetic/core/i18n';
import { getSite } from '@cosmetic/core/registry';
import { getHome, EMAIL } from '@cosmetic/core/content';
import '../../styles/brand.css';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const site = getSite('biosphere-ai');
---

<HomePage site={site} locale={locale} content={getHome(site.id, locale)} email={EMAIL[site.id]} />
