---
/**
 * BIOSPHERE-AI 服务总览页 —— 列出所有服务/方案卡片。
 * 数据驱动:从 solutions.ts 读取,加方案就自动出现在这页。
 */
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { LOCALES, type Locale, localePath, t } from '@cosmetic/core/i18n';
import { getSite, getVariant, SITES } from '@cosmetic/core/registry';
import { SOLUTIONS, EMAIL } from '@cosmetic/core/content';
import '../../../styles/brand.css';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const tr = t(locale);
const zhPage = String(locale).startsWith('zh');
const site = getSite('biosphere-ai');
const variant = getVariant(site);
const path = localePath(locale, '/services/');
const siblings = SITES.filter((s) => s.id !== site.id);

const audienceSolutions = SOLUTIONS.filter((s) => s.axis === 'audience');
const categorySolutions = SOLUTIONS.filter((s) => s.axis === 'category');
---

<BaseLayout
  locale={locale}
  school={variant.school}
  variant={variant.id}
  brand={site.id}
  siteName={site.name}
  siteUrl={site.url}
  path={path}
  title={zhPage ? '服务与方案' : 'Services & Solutions'}
  description={zhPage
    ? '护肤品代工、身体护理OEM、口腔护理代工、产品开发与打样、广州工厂质量体系、跨境品牌产品开发'
    : 'Skincare manufacturing, body care OEM, oral care OEM, product development & sampling, factory quality system, cross-border brand development'}
  indexable={true}
  brandColor={site.brandColor}
>
  <SiteHeader locale={locale} path={path} siteName={site.name} siteNameZh={site.nameZh} />

  <main id="main">
    <section class="head">
      <div class="ck-wrap">
        <p class="ck-eyebrow">{zhPage ? '服务与方案' : 'Services & Solutions'}</p>
        <h1>{zhPage ? '我们做什么' : 'What we do'}</h1>
        <p class="lede">{zhPage
          ? '从配方开发到量产交付,每一项服务都有明确的可承接条件、被核实的资质和常见问题解答。'
          : 'From formula development to mass production delivery — each service has clear capability, verified credentials, and FAQ.'}</p>
      </div>
    </section>

    {/* 按客户类型 */}
    <section class="block">
      <div class="ck-wrap">
        <h2>{zhPage ? '按客户类型' : 'By audience'}</h2>
        <div class="card-grid">
          {audienceSolutions.map((s) => {
            const c = s[locale] ?? s.zh;
            return (
              <a class="card" href={localePath(locale, `/services/${s.slug}/`)}>
                <h3>{c.title}</h3>
                <p>{c.tagline}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    {/* 按品类 */}
    <section class="block alt">
      <div class="ck-wrap">
        <h2>{zhPage ? '按品类' : 'By category'}</h2>
        <div class="card-grid">
          {categorySolutions.map((s) => {
            const c = s[locale] ?? s.zh;
            return (
              <a class="card" href={localePath(locale, `/services/${s.slug}/`)}>
                <h3>{c.title}</h3>
                <p>{c.tagline}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} path={path} site={site} siblings={siblings} email={EMAIL[site.id]} />
</BaseLayout>

<style>
  .head {
    background: var(--ck-hero-bg);
    color: var(--ck-hero-ink);
    padding-block: clamp(1.5rem, 3vw, 3rem);
  }
  .head h1 { margin-top: 0.5rem; }
  .lede {
    margin-top: 0.75rem;
    max-width: var(--ck-maxw-prose);
    color: color-mix(in srgb, currentColor 72%, transparent);
    line-height: 1.7;
  }

  .block { padding-block: clamp(1.75rem, 4vw, 3.5rem); background: var(--ck-bg); }
  .block.alt { background: var(--ck-surface-alt); }
  .block h2 { font-size: var(--ck-h2); margin-bottom: 1.5rem; }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }
  .card {
    display: block;
    padding: 1.5rem;
    border: var(--ck-border-w) solid var(--ck-line);
    border-radius: var(--ck-radius, 10px);
    background: var(--ck-surface, #fff);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .card:hover {
    border-color: var(--ck-accent);
    box-shadow: 0 2px 12px color-mix(in srgb, var(--ck-accent) 20%, transparent);
  }
  .card h3 { font-size: 1.125rem; margin-bottom: 0.5rem; }
  .card p { color: var(--ck-ink-soft); font-size: var(--ck-small); line-height: 1.6; }
</style>
