---
/**
 * BEAUTY2OEM 图文版(09-24 19:xx,定稿见 助手交付/beauty2oem-UI重做/定稿方向.md)。
 * 只有 beauty2oem 的 fx_* 版块走这里;工厂站(biosphere-ai)照旧走 FactoryBlock,一行不受影响。
 * 文字仍从后台版块读(标题、导语、步骤、空状态);本组件只管版式、配图与图表。
 * 需要库数据的两处(有机会卡时的卡片、简报表单)直接复用 FactoryBlock,口径与表单字段只有一份。
 * 数字全部读 getCounts(构建时打包的计数快照),访客请求零现场统计;起订 / 价格 / 交期一个字不写。
 * 09-24 v2 零查库:「有没有已发布的机会卡」和公开预判台账也读快照 src/data/b2o-snap.json(tools/counts-refresh.py 导出),本组件不再碰 D1。
 * 样式全在 styles/b2o.css,作用域 html[data-brand="beauty2oem"]。
 */
import FactoryBlock from './FactoryBlock.astro';
import { getCounts } from '../lib/counts';
import { ORG } from '@cosmetic/core/content/org.ts';
import SNAP from '../data/b2o-snap.json';

interface Props {
  type: string; data: any; lang: string; db: D1Database | undefined; siteName: string; email: string;
  whatsapp?: string | null; wechat?: string | null;
  page: string; pageTitle: string; pageDesc?: string | null;
}
const { type, data: d = {}, lang, db, siteName, email, whatsapp, wechat, page, pageTitle, pageDesc } = Astro.props;
const B = `/${lang}`;
const BRIEF = `${B}/brief/`;
const arr = (x: any): any[] => (Array.isArray(x) ? x : []);
const fmt = (n: number) => Number(n || 0).toLocaleString('en-US');
const counts: any = (await getCounts(db)) ?? {};
const N = (k: string) => Number(counts[k] ?? 0);
const lines = Number(ORG.figures.find((f) => f.nameEn === 'Automated production lines')?.value ?? 15);
const foundingYear = new Date(ORG.foundingDate).getUTCFullYear();
const VARS: Record<string, string> = {
  products: fmt(N('products')), summaries: fmt(N('summaries')), formulas: ORG.formulas.value, packaging: fmt(N('pack_shelf')),
  regs: String(N('regs')), inci: fmt(N('inci')), lines: String(lines), site: siteName,
};
/* 后台文案是半角标点、带「——」「1–2」;本站版式统一:数字区间改「至」,破折号改逗号,中文旁的半角标点改全角 */
const tidy = (t: any) => String(t ?? '')
  .replace(/\{(\w+)\}/g, (m, k) => VARS[k] ?? m)
  .replace(`${ORG.formulas.value} 条可直接打样的配方基底`, `${ORG.formulas.value} 个成熟配方,均经稳定性测试`)   // 同 FactoryBlock:后台旧文案兜底
  .replace(/(\d)\s*[–—]\s*(\d)/g, '$1 至 $2')
  .replace(/\s*(——|—|–)\s*/g, ',')
  .replace(/([一-鿿」》）\)])\s*,\s*/g, '$1，')
  .replace(/,\s*([一-鿿「《])/g, '，$1')
  .replace(/([一-鿿」》）\)])\s*:\s*/g, '$1：')
  .replace(/([一-鿿」》）\)])\s*;\s*/g, '$1；');
const href = (h: any, fb: string) => { const v = String(h ?? '').trim(); if (!v) return fb; if (v.startsWith('/') && !/^\/(zh-cn|zh-tw|en|ja)\//.test(v)) return `${B}${v}`; return v; };

/* 配图:全部自托管 webp(apps/web/public/b2o/img/),写死宽高防跳版 */
const IMG: Record<string, [string, number, number, string]> = {
  heroFull: ['vi/hero-lineup', 1672, 941, '深色背景前的一排高端护肤与彩妆产品'],   // 09-25 创始人给参考图,Codex 出图(无文字);旧图 vi/hero-full 保留
  wall01: ['vi/wall-01', 1024, 1024, '海滩与热带水果间陈列多款彩色防晒产品'],
  wall02: ['vi/wall-02', 1024, 1024, '粉色背景前陈列蓝色、白色和橙色软管与喷瓶'],
  wall03: ['vi/wall-03', 1024, 1024, '夜景灯光前陈列星空图案的深蓝色瓶罐'],
  wall04: ['vi/wall-04', 1024, 1024, '柑橘和菠萝旁陈列三款水果插画瓶装产品'],
  wall05: ['vi/wall-05', 1024, 1024, '橙色背景前一支蓝黄粉渐变波浪图案的软管,旁边是切开的橙子'],
  wall06: ['vi/wall-06', 1024, 1024, '热带绿叶前一支满布橙色花朵与民族纹样的方形瓶'],
  wall07: ['vi/wall-07', 1024, 1024, '海浪与贝壳前竖立海洋图案的彩色软管'],
  wall08: ['vi/wall-08', 1024, 1024, '橙子与棕榈叶间陈列橙黄色软管'],
  wall09: ['vi/wall-09', 1024, 1024, '热带水果和泳池背景前陈列多款鲜艳瓶装产品'],
  wall10: ['vi/wall-10', 1024, 1024, '向日葵与橙子旁陈列黄色瓶装和白色软管'],
  wall11: ['vi/wall-11', 1024, 1024, '绿叶与柑橘间陈列热带植物插画包装'],
  wall12: ['vi/wall-12', 1024, 1024, '海滩、菠萝和柑橘间陈列橙绿色防晒产品'],
  m1: ['vi/m1', 1024, 1024, '粉色背景前并排陈列三款渐变色软管'],
  m2: ['vi/m2', 1024, 1024, '棕榈叶影与菠萝旁陈列金白色瓶罐和软管'],
  m3: ['vi/m3', 1024, 1024, '戴草帽和太阳镜的女子在阳光下的花卉市集微笑'],
  m4: ['vi/m4', 1024, 1024, '绿叶间陈列两款热带鸟类插画包装'],
  hero: ['fd/hero-beach-lineup', 1024, 1024, '海边沙滩上摆放着多款色彩明快的防晒产品和热带水果'],
  desk: ['02-seller-desk', 1248, 832, '卖家在打包台前整理样品瓶和纸箱'],
  lab: ['03-lab-bench', 1248, 832, '实验台上,戴手套的手用滴管往烧杯里加精华'],
  methodTrend: ['fd/m1-trend-pastel', 1024, 1024, '粉色背景前摆放着三款淡彩防晒产品'],
  methodJudge: ['fd/m2-judge-gold', 1024, 1024, '棕榈叶影下的金色瓶罐与白色软管防晒组合'],
  methodVerify: ['fd/m3-verify-market', 1024, 1024, '戴遮阳帽和墨镜的女子站在阳光下的户外市集'],
  methodLaunch: ['fd/m4-launch-tropical-box', 1024, 1024, '绿叶间摆放着两款热带植物图案的产品包装'],
  deliveryGold: ['fd/d-gold-set', 1600, 1600, '暖金色桌面上陈列着金色软管、喷瓶和精华瓶'],
  deliveryPapaya: ['fd/d-papaya-set', 1600, 1600, '木瓜和黄瓜旁摆放着淡绿与杏色护肤软管'],
  deliveryCucumber: ['fd/d-cucumber-set', 1600, 1600, '黄瓜与切片旁陈列着浅绿色软管和按压瓶'],
  cardPink: ['fd/c-pink-serum', 1600, 900, '蓝橙粉配色的几何造型陈列,球体、圆环和立柱错落摆放'],   // 09-24 审核员:原图瓶身有近似大牌商标字样,换成无字的几何陈列图
  cardTubes: ['fd/c-color-tubes', 1024, 1024, '粉色背景前的蓝、白、红三款彩色软管'],
  cardStarry: ['fd/c-starry-premium', 1024, 1024, '夜色灯光下摆放着星月图案的深蓝色瓶罐组合'],
  cardFruit: ['fd/c-fruit-cans', 1024, 1024, '鲜橙、柚子和菠萝前摆放着三款色彩鲜艳的防晒瓶'],
  cardBotanical: ['fd/c-botanical-set', 1024, 1024, '向日葵和绿叶间摆放着植物图案的绿色瓶罐'],
  factoryLine01: ['fx/f-line-01', 1600, 1044, '洁净车间里的自动化灌装输送线'],
  factoryLine02: ['fx/f-line-02', 1600, 1067, '洁净车间里的多条不锈钢输送线和包装设备'],
  factoryLine03: ['fx/f-line-03', 1600, 1067, '洁净车间里的灌装设备与环形输送线'],
  factoryLine04: ['fx/f-line-04', 1600, 1067, '洁净车间里的自动化灌装与输送设备'],
  factoryLine05: ['fx/f-line-05', 1600, 1093, '透过玻璃拍摄的洁净车间灌装输送线'],
  factoryLab: ['fx/f-lab', 1600, 899, '研发实验室里的实验台、仪器和工作人员'],
  factoryGate: ['fx/f-gate', 1600, 1067, '广州市帛卉化妆品有限公司厂牌'],
  ware: ['07-warehouse', 1248, 832, '明亮的仓库里整齐码放的纸箱'],
  herb: ['08-botanical', 1024, 1024, '石板上摆着植物油、洋甘菊、茶叶、芦荟和白泥'],
  hand: ['09-market-hand', 1024, 1024, '手握一支浅绿色玻璃精华瓶'],
  dark: ['10-dark-close', 1248, 832, ''],
  vials: ['12-vials-top', 1248, 832, '白色样品架上一排排装着不同颜色原料的小瓶'],
};
const WALL = Array.from({ length: 12 }, (_, i) => `wall${String(i + 1).padStart(2, '0')}`);
const img = (k: string, eager = false) => {
  const [f, w, h, alt] = IMG[k];
  return { src: `/b2o/img/${f}.webp`, width: w, height: h, alt, class: `b2o-img-${k}`, loading: eager ? 'eager' : 'lazy', decoding: 'async', fetchpriority: eager ? 'high' : undefined } as any;
};

/* 机会卡「有没有已发布的」与公开预判台账(is_public=1,≤60 行,只公开字段)都读构建时快照,访客请求零查库。
   有卡时仍交给 FactoryBlock 渲染(会员分级逻辑只有一份)。快照更新:python tools/counts-refresh.py --b2o 后重新构建部署。 */
const hasCards = type === 'fx_cards' && !!(SNAP as any).has_cards;
const ledger: any[] = type === 'fx_ledger' && Array.isArray((SNAP as any).ledger) ? (SNAP as any).ledger : [];
const dotCls = (x: any, r: any) => (!String(r ?? '').trim() ? '' : x.outcome === 'right' ? 'ok' : x.outcome === 'wrong' ? 'x' : 'mid');

/* 09-24 事实口径修正:五项能力性质不同,分别陈述,不再用对数柱长制造可比性。
   配方与产线读 ORG 硬事实;包材、市场情报、法规原料目录只读构建时计数快照。 */
const deliveryTitle = '判断之后，帛卉把它做出来';
const deliveryIntro = '预判落到生产：帛卉自有产线和成熟配方，加上公开市场与法规数据。';
const evidenceCards = [
  { value: ORG.formulas.value, label: '成熟配方', note: '均经稳定性测试，按你的需求匹配现成配方。' },
  { value: fmt(lines), label: '条自动化产线', note: '10 万级 GMP 洁净车间。' },
  { value: fmt(N('pack_shelf')), label: '款包材可选', note: '瓶、罐、软管、泵头等款式库。' },
  { value: fmt(N('products')), label: '款市场爆款情报', note: '从公开渠道收集，用于判断趋势。', href: 'https://biosphere-ai.com/zh-cn/decoder/' },
  { value: fmt(N('inci')), label: '条各国法规原料目录', note: '公开法规数据。', href: 'https://biosphere-ai.com/zh-cn/regulations/' },
];
const exportReasons = [
  { value: String(foundingYear), label: '年成立', note: '帛卉化妆品，专注化妆品研发与生产。' },
  { value: String(lines), label: '条自动化产线', note: '10 万级 GMP 洁净车间。' },
  { value: ORG.formulas.value, label: '成熟配方', note: '均经稳定性测试。' },
  { value: '4 地', label: '注册已开户', note: '美国 FDA（注册≠批准、不发证书）、欧盟 CPNP、英国 SCPN、加拿大 CNF。' },
];

// Certifications and registrations strip under the hero. Images shared with the biosphere-ai certificate wall (/media/152-157);
// SCPN and CNF have no screenshot yet, so they render a text mark. kind=reg items are registrations, never labelled as certificates.
const creds = [
  // /media/155 (a HALAL certificate issued to a different company) is never used; HALAL shows the company's own AHF certificate.
  { name: 'GMPC', note: 'DEKRA 签发', img: '/media/152' },
  { name: 'ISO 22716', note: 'DEKRA 签发', img: '/media/153' },
  { name: 'HALAL', note: 'AHF 清真认证', img: '/media/158' },
  { name: '美国 FDA', note: '注册 · 已开户 · 注册≠批准、不发证书', img: '/media/157', reg: true },
  { name: '欧盟 CPNP', note: '注册 · 已开户', img: '/media/156', reg: true },
  { name: '英国 SCPN', note: '注册 · 已开户', mark: 'SCPN' },
  { name: '加拿大 CNF', note: '注册 · 已开户', mark: 'CNF' },
];

const briefRows = [
  ['产品结构', '你现在卖什么、靠什么赚钱'],
  ['缺口', '同类在涨、你还没有的'],
  ['市场变化', '你在卖和要进的国家、平台'],
  ['三个方向', '最快可测试、最值得做、差异化'],
  ['能做到哪', '帛卉支持到哪一步'],
];
const stepList = arr(d.steps).map((x) => ({ label: tidy(typeof x === 'string' ? x : x?.label), note: tidy(x?.note) }));
const Arrow = '→';
---
{/* ───────────────────────── 首页 ───────────────────────── */}
{type === 'fx_hero' && (
  <>
    <section class="b2o-sec b2o-hero">
      <img {...img('heroFull', true)} />
      <div class="b2o-wrap">
        <div class="b2o-hero-copy">
          <h1 class="b2o-h1 b2o-h1-hero"><span class="ln">{tidy(d.title)}</span>{d.sub && <span class="ln">{tidy(d.sub)}</span>}</h1>
          <p class="b2o-lede">提交店铺，24 小时内拿到一份 1 至 2 页的机会简报。</p>
          <p class="b2o-position">帛卉化妆品 · {foundingYear} 年成立 · 多年海外市场经验 · 主要服务出海化妆品品牌</p>
          <div class="b2o-cta-row">
            <a class="b2o-btn b2o-btn-pri" href={BRIEF}>提交店铺，拿简报<span class="ico" aria-hidden="true">{Arrow}</span></a>
            <a class="b2o-btn b2o-btn-sec" href="#b2o-sample">看简报样张</a>
          </div>
        </div>
      </div>
    </section>

    <section class="b2o-sec alt b2o-creds" id="creds">
      <div class="b2o-wrap">
        <header class="b2o-head"><h2 class="b2o-h2">认证与注册</h2></header>
        <div class="b2o-creds-grid" role="list">
          {creds.map((c) => (
            <article class="b2o-cred" role="listitem">
              {c.img
                ? <a class="pic" href={c.img} target="_blank" rel="noopener"><img src={c.img} alt={c.reg ? `${c.name} 注册记录` : `${c.name} 证书`} width="400" height="400" loading="lazy" decoding="async" /></a>
                : <div class="pic mark" aria-hidden="true">{c.mark}</div>}
              <strong>{c.name}</strong><span>{c.note}</span>
            </article>
          ))}
        </div>
        <div class="b2o-cta-row"><a class="b2o-btn b2o-btn-pri" href={BRIEF}>咨询四地注册<span class="ico" aria-hidden="true">{Arrow}</span></a></div>
      </div>
    </section>

    <section class="b2o-sec b2o-sample" id="b2o-sample">
      <div class="b2o-wrap b2o-sample-row">
        <aside class="b2o-sheet" aria-label="简报样张结构">
          <span class="b2o-mark sm"><b class="m-b">BEAUTY</b><b class="m-2">2</b><b class="m-o">OEM</b></span>
          <h2>客户产品机会简报 · 样张结构</h2>
          <ol>
            <li>产品结构<i style="--w:86%"></i></li>
            <li>缺口：同类在涨、你还没有的<i style="--w:64%"></i></li>
            <li>三个方向，每个写风险<i style="--w:78%"></i></li>
            <li>帛卉能做到哪<i style="--w:52%"></i></li>
          </ol>
          <p class="redact">内容已打码，不公开、不给其他客户</p>
        </aside>
        <div class="b2o-promise">
          <div><b>24<small>小时</small></b><span>内发到你手上</span></div>
          <div><b>1 至 2<small>页</small></b><span>只写要紧的</span></div>
          <div><b>3<small>个方向</small></b><span>每个附风险</span></div>
        </div>
      </div>
    </section>

    <section class="b2o-sec alt b2o-wall">
      <div class="b2o-wrap">
        <header class="b2o-head">
          <h2 class="b2o-h2">包装与视觉方向参考</h2>
          <p class="b2o-lede">这些是效果图,用来和你讨论包装与视觉方向,不是已交付的客户产品。</p>
        </header>
        <div class="b2o-wall-columns">
          {WALL.map((key) => <figure><img {...img(key)} /></figure>)}
        </div>
      </div>
    </section>

    <section class="b2o-sec alt b2o-read">
      <div class="b2o-wrap b2o-grid">
        <figure class="fig b2o-bezel"><div class="core b2o-ph r32"><img {...img('desk')} /></div></figure>
        <div class="txt">
          <h2 class="b2o-h2">先读懂你的生意，<br />再谈下一款产品。</h2>
          {d.lead && <p class="b2o-lede">{tidy(d.lead)}</p>}
          <dl class="b2o-facts">
            <div><dt>主销品类</dt><dd>按你的店铺</dd></div>
            <div><dt>价格带</dt><dd>按你的店铺</dd></div>
            <div><dt>上新节奏</dt><dd>按你的店铺</dd></div>
            <div><dt>流量来源</dt><dd>短视频、达人、直播、广告</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="b2o-sec b2o-export">
      <div class="b2o-wrap">
        <header class="b2o-head">
          <h2 class="b2o-h2">为什么找我们出海</h2>
          <p class="b2o-lede">帛卉化妆品把生产硬实力和出海资料准备放在同一条交付链路里。</p>
        </header>
        <div class="b2o-export-grid" role="list">
          {exportReasons.map((item) => (
            <article class="b2o-export-card" role="listitem">
              <strong>{item.value}</strong><span>{item.label}</span><p>{item.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="b2o-sec alt b2o-factory-real">
      <div class="b2o-wrap">
        <header class="b2o-head">
          <h2 class="b2o-h2">帛卉车间实拍</h2>
          <p class="b2o-lede">广州自有工厂的洁净车间与自动化产线，欢迎来厂验厂</p>
        </header>
        <div class="b2o-factory-grid">
          {['factoryLine01', 'factoryGate', 'factoryLine02', 'factoryLine03', 'factoryLab'].map((key, i) => (
            <figure class:list={['b2o-real-photo', i === 0 && 'is-lead']}><img {...img(key)} /><span>实拍</span></figure>
          ))}
        </div>
      </div>
    </section>

    <section class="b2o-sec b2o-band">
      <div class="b2o-wrap">
        <div class="b2o-ph band-ph"><img {...img('ware')} /></div>
        <div class="panel">
          <h2 class="b2o-h2">提交之后的 24 小时</h2>
          <ol class="b2o-tl">
            <li><span class="when">现在</span><b>留一个联系方式</b><p>只要姓名，加手机或微信。店铺情况想说多少说多少。</p></li>
            <li><span class="when">接下来</span><b>我们读店铺、看信号</b><p>你在卖和准备进的国家、平台，最近在变什么。</p></li>
            <li><span class="when">24 小时内</span><b>简报发到你手上</b><p>发到你留的微信或手机。第一次沟通不介绍工厂。</p></li>
          </ol>
          {d.hint && <p class="note">{tidy(d.hint)}</p>}
        </div>
      </div>
    </section>
  </>
)}

{type === 'fx_steps' && page === '' && (
  <section class="b2o-sec alt b2o-method" id="method">
    <div class="b2o-wrap">
      <header class="b2o-head">
        <h2 class="b2o-h2">{tidy(d.title)}</h2>
