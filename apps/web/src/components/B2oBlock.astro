    </section>
    <script>
      /* 三段进度 + 就地报错(只改视觉,不改字段;后端 api/b2o/brief.ts 照旧兜底校验) */
      const f = document.querySelector<HTMLFormElement>('.b2o-bform form[action="/api/b2o/brief"]');
      const prog = document.getElementById('b2o-prog');
      if (f && prog) {
        f.noValidate = true;   /* 浏览器自带的气泡提示换成字段下方的就地报错;后端校验不变 */
        const q =(n: string) => f.querySelector<HTMLInputElement>(`[name="${n}"]`);
        const notes = f.querySelector<HTMLTextAreaElement>('textarea[name="notes"]');
        const tpl = notes?.value ?? '';
        const msg = (el: Element | null, text: string) => {
          if (!el) return null;
          let m = el.parentElement?.querySelector<HTMLElement>('.b2o-msg');
          if (!m) { m = document.createElement('span'); m.className = 'b2o-msg'; m.id = `b2o-msg-${++seq}`; m.setAttribute('role', 'alert'); el.insertAdjacentElement('afterend', m); }
          m.textContent = text; return m;
        };
        let seq = 0;
        /* 验收 09-24:出错的框读屏要知道「无效 + 为什么」:aria-invalid + aria-describedby 指向就地报错 */
        const flag = (els: (HTMLElement | null)[], m: HTMLElement | null) => els.forEach((x) => {
          if (!x) return;
          x.classList.add('b2o-err'); x.setAttribute('aria-invalid', 'true');
          if (m) x.setAttribute('aria-describedby', [x.getAttribute('aria-describedby'), m.id].filter(Boolean).join(' '));
        });
        const unflag = () => f.querySelectorAll<HTMLElement>('[aria-invalid]').forEach((x) => {
          x.removeAttribute('aria-invalid');
          const d = (x.getAttribute('aria-describedby') ?? '').split(' ').filter((t) => t && !t.startsWith('b2o-msg-')).join(' ');
          d ? x.setAttribute('aria-describedby', d) : x.removeAttribute('aria-describedby');
        });
        const val = (n: string) => (q(n)?.value ?? '').trim();
        const step = () => {
          const s = [!!val('contact') && !!(val('phone') || val('wechat')), !!notes && notes.value.trim() !== tpl.trim(), !!q('agree_policy')?.checked && !!q('agree_xborder')?.checked];
          s.forEach((ok, i) => prog.querySelector(`[data-s="${i + 1}"]`)?.classList.toggle('done', ok));
        };
        const clear = () => { unflag(); f.querySelectorAll('.b2o-msg').forEach((m) => m.remove()); };
        f.addEventListener('input', () => { step(); clear(); f.querySelectorAll('.b2o-err').forEach((e) => e.classList.remove('b2o-err')); });
        f.addEventListener('change', step);
        f.addEventListener('submit', (e) => {
          clear();
          const bad: HTMLElement[] = [];
          if (!val('contact')) { const el = q('contact'); flag([el], msg(el, '请填姓名。')); if (el) bad.push(el); }
          if (!val('phone') && !val('wechat')) { const a = q('phone'), b = q('wechat'); flag([a, b], msg(b, '手机和微信至少留一个。')); if (a) bad.push(a); }
          const ag = f.querySelector('.agree');
          if (!q('agree_policy')?.checked || !q('agree_xborder')?.checked) { msg(ag?.lastElementChild ?? null, '请先勾选两项同意，再提交。'); if (!bad.length && q('agree_policy')) bad.push(q('agree_policy')!); }
          if (bad.length) { e.preventDefault(); e.stopImmediatePropagation(); bad[0].focus(); }
        }, true);
        step();
      }
    </script>
  </>
)}

