---
/**
 * 后台外壳 —— 侧栏 + 内容区,所有后台页共用。
 *
 * 侧栏的意义不只是导航:它让运营一眼看到「这个后台能管哪些东西」,
 * 这是"强大"与"简陋"最直接的区别 —— 功能有没有被看见。
 *
 * ⚠ 共享设计系统在 ../styles/admin.css,不要写回本文件的 <style> 里:
 *   Astro 会把组件样式作用域限定在本组件模板里的元素上,
 *   而各页面写在 <AdminShell>…</AdminShell> 之间的内容属于「页面」组件,
 *   在这里定义的 .btn / .pill / table 对它们一条都不生效 —— 曾经整个后台
 *   都退化成浏览器默认样式就是这么来的。本文件的 <style> 只放侧栏骨架。
 */
import '../styles/admin.css';

export interface Props {
  title: string;
  active: string;
  email: string;
  /** 侧栏计数徽标,如询盘未读数 */
  badges?: Record<string, number>;
  /**
   * 当前管理的站点。一域名一后台 —— 运营必须一眼看到自己在管哪个品牌,
   * 否则改错站是迟早的事(5 个品牌的页面标题都长得差不多)。
   */
  tenant?: { siteId: string; siteName: string; isGroup: boolean; options: { id: string; name: string }[] };
}
const { title, active, email, badges = {}, tenant } = Astro.props;

const NAV = [
  { group: '内容', items: [
    { id: 'sites', label: '站点总览', href: '/bohui/' },
    { id: 'pages', label: '页面与版块', href: '/bohui/pages/' },
    { id: 'media', label: '媒体库', href: '/bohui/media/' },
    { id: 'products', label: '产品与剂型', href: '/bohui/products/' },
  ]},
  { group: '经营', items: [
    { id: 'inquiries', label: '询盘线索', href: '/bohui/inquiries/' },
    { id: 'studio', label: 'AI 共创记录', href: '/bohui/studio/' },
    { id: 'formulas', label: '配方库', href: '/bohui/formulas/' },
  ]},
  { group: '系统', items: [
    { id: 'models', label: '模型舰队', href: '/bohui/models/' },
    { id: 'vision', label: '视觉模型横评', href: '/bohui/vision/' },
    { id: 'users', label: '账号与权限', href: '/bohui/users/' },
    { id: 'log', label: '修订记录', href: '/bohui/log/' },
  ]},
];
---

<html lang="zh-CN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title} · 帛卉后台</title>
  <style>
    /* minmax(0,1fr) 而不是 1fr:栅格轨道最小宽度默认是 auto,
       内容一宽(比如模型页那张表)就会把整列顶出视口、整页横向滚动。 */
    body {
      display: grid;
      grid-template-columns: 15.5rem minmax(0, 1fr);
      min-height: 100vh;
    }

    aside {
      background: var(--ad-side);
      color: var(--ad-side-ink);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
    }
    .brand {
      padding: 1.375rem 1.375rem 1.125rem;
      border-bottom: 1px solid var(--ad-side-line);
    }
    .brand b {
      display: block;
      color: var(--ad-side-on);
      font-size: .9375rem;
      font-weight: 700;
      letter-spacing: .02em;
    }
    .brand span {
      display: block;
      color: var(--ad-side-dim);
      font-family: var(--ad-mono);
      font-size: .625rem;
      letter-spacing: .18em;
      margin-top: .1875rem;
    }

    .site-pick, .site-fixed {
      display: block; width: 100%; margin-top: .75rem;
      font-size: .8125rem; border-radius: var(--ad-r-s);
      padding: .375rem .5rem;
    }
    .site-pick {
      background: var(--ad-side-active); color: var(--ad-side-on);
      border: 1px solid var(--ad-side-line);
    }
    .site-fixed {
      background: var(--ad-side-hover); color: var(--ad-side-ink);
      border: 1px solid var(--ad-side-line);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    nav { flex: 1; overflow-y: auto; padding: .875rem 0; }
    .grp {
      padding: .9375rem 1.375rem .375rem;
      color: var(--ad-side-dim);
      font-family: var(--ad-mono);
      font-size: .5625rem;
      letter-spacing: .2em;
      text-transform: uppercase;
    }
    a.item {
      display: flex;
      align-items: center;
      gap: .5625rem;
      padding: .46875rem 1.375rem;
      color: var(--ad-side-ink);
      text-decoration: none;
      font-size: .875rem;
      border-left: 2px solid transparent;
      transition: background .12s ease, color .12s ease;
    }
    a.item:hover { background: var(--ad-side-hover); color: var(--ad-side-on); }
    a.item.on {
      background: var(--ad-side-active);
      color: var(--ad-side-on);
      border-left-color: var(--ad-accent);
      font-weight: 600;
    }
    /* 小圆点代替图标字符 —— 之前那些 ▤▦▣ 在不同系统里字形宽度不一,
       会让整列文字左边界参差不齐。用几何点反而更整齐,也不抢注意力。 */
    .dot {
      width: .3125rem;
      height: .3125rem;
      border-radius: 50%;
      background: currentColor;
      opacity: .35;
      flex: none;
    }
    a.item.on .dot { opacity: 1; background: var(--ad-accent); }
    .badge {
      margin-left: auto;
      background: var(--ad-accent);
      color: #fff;
      border-radius: 999px;
      padding: 0 .375rem;
      font-size: .6875rem;
      font-weight: 600;
      min-width: 1.125rem;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .who {
      padding: .9375rem 1.375rem;
      border-top: 1px solid var(--ad-side-line);
      font-size: .75rem;
      color: var(--ad-side-dim);
    }
    .who .em {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-family: var(--ad-mono);
      font-size: .6875rem;
    }
    .who button {
      margin-top: .5625rem;
      font: inherit;
      font-size: .75rem;
      background: transparent;
      border: 1px solid var(--ad-side-line);
      color: var(--ad-side-ink);
      padding: .34375rem .625rem;
      border-radius: var(--ad-r-s);
      cursor: pointer;
      width: 100%;
      transition: background .12s ease, color .12s ease;
    }
    .who button:hover { background: var(--ad-side-active); color: #fff; }

    main { padding: 2rem 2.25rem 5rem; max-width: 84rem; min-width: 0; }

    @media (max-width: 56rem) {
      body { grid-template-columns: 1fr; }
      aside { position: static; height: auto; }
      nav { display: flex; overflow-x: auto; padding: .5rem; gap: .125rem; }
      .grp { display: none; }
      a.item {
        white-space: nowrap;
        border-left: 0;
        border-bottom: 2px solid transparent;
        padding: .4375rem .75rem;
      }
      a.item.on { border-left: 0; border-bottom-color: var(--ad-accent); }
      .who { display: flex; align-items: center; gap: .75rem; }
      .who .em { flex: 1; }
      .who button { margin-top: 0; width: auto; }
      main { padding: 1.25rem 1.125rem 3rem; }
    }
  </style>
</head>
<body>
  <aside>
    <div class="brand">
      <b>帛卉后台</b>
      <span>BOHUI CONSOLE</span>
      {tenant && (
        tenant.isGroup && tenant.options.length > 1 ? (
          <select class="site-pick" aria-label="当前管理的站点">
            {tenant.options.map((o) => (
              <option value={o.id} selected={o.id === tenant.siteId}>{o.name}</option>
            ))}
          </select>
        ) : (
          <span class="site-fixed" title="你的账号只能管理这个站点">{tenant.siteName}</span>
        )
      )}
    </div>
    <nav>
      {NAV.map((g) => (
        <>
          <div class="grp">{g.group}</div>
          {g.items.map((it) => (
            <a class:list={['item', active === it.id && 'on']} href={it.href}>
              <span class="dot"></span>
              <span>{it.label}</span>
              {badges[it.id] ? <span class="badge">{badges[it.id]}</span> : null}
            </a>
          ))}
        </>
      ))}
    </nav>
    <div class="who">
      <span class="em">{email}</span>
      <button id="logout">退出登录</button>
    </div>
  </aside>

  <main>
    <slot />
  </main>

  <script is:inline>
    /* 切站:把 ?site= 写进地址再重载。只有集团管理员看得到这个下拉 */
    document.querySelector('.site-pick')?.addEventListener('change', (e) => {
      const u = new URL(location.href);
      u.searchParams.set('site', e.target.value);
      location.href = u.toString();
    });

    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/admin/login', { method: 'DELETE' });
      location.href = '/bohui/login/';
    });

    /* 时间一律按浏览器所在时区显示。
       D1 的 datetime('now') 存的是 UTC,此前直接把字符串截前 16 位显示,
       于是北京时间 20:07 的操作在后台显示成 12:07 —— 差 8 小时,看着像别人干的。
       服务端不做转换是对的:团队要跨时区(海外市场),存 UTC、按看的人所在地渲染,
       才不会出现「谁看谁的时间都不一样但都没标注」的混乱。 */
    (function () {
      var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '本地时区';
      var sameYear = new Date().getFullYear();
      document.querySelectorAll('time[data-utc]').forEach(function (el) {
        var raw = el.getAttribute('data-utc');
        if (!raw) return;
        // SQLite 给的是 "2026-08-15 12:07:33",没有时区标记 —— 补上 Z 才会被当成 UTC
        var d = new Date(raw.replace(' ', 'T') + (/[Zz]|[+-]\d{2}:?\d{2}$/.test(raw) ? '' : 'Z'));
        if (isNaN(d)) return;
        var p = function (n) { return String(n).padStart(2, '0'); };
        var ymd = (d.getFullYear() === sameYear ? '' : d.getFullYear() + '-')
                + p(d.getMonth() + 1) + '-' + p(d.getDate());
        el.textContent = ymd + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
        el.setAttribute('datetime', d.toISOString());
        el.title = d.toLocaleString() + '(' + tz + ')\nUTC ' + raw;
      });
    })();
  </script>
</body>
</html>
