---
/**
 * 后台外壳 —— 侧栏 + 内容区,所有后台页共用。
 *
 * 侧栏的意义不只是导航:它让运营一眼看到「这个后台能管哪些东西」,
 * 这是"强大"与"简陋"最直接的区别 —— 功能有没有被看见。
 *
 * ⚠ 共享设计系统在 ../styles/admin.css,不要写回本文件的 <style> 里:
 *   Astro 会把组件样式作用域限定在本组件模板里的元素上,
 *   而各页面写在 <AdminShell>…</AdminShell> 之间的内容属于「页面」组件,
 *   在这里定义的 .btn / .pill / table 对它们一条都不生效 —— 曾经整个后台
 *   都退化成浏览器默认样式就是这么来的。本文件的 <style> 只放侧栏骨架。
 */
import '../styles/admin.css';
import { env } from 'cloudflare:workers';
import { readSession, readCookie, COOKIE } from '../lib/auth';

export interface Props {
  title: string;
  active: string;
  email: string;
  /** 侧栏计数徽标,如询盘未读数 */
  badges?: Record<string, number>;
  /**
   * 当前管理的站点。一域名一后台 —— 运营必须一眼看到自己在管哪个品牌,
   * 否则改错站是迟早的事(5 个品牌的页面标题都长得差不多)。
   */
  tenant?: { siteId: string; siteName: string; isGroup: boolean; options: { id: string; name: string }[] };
}
const { title, active, email, tenant } = Astro.props;
let badges: Record<string, number> = Astro.props.badges ?? {};

/* 2026-09-17 创始人:「后台登录按部门,展示的内容也相对应,而不是看到全部」。
   v0 里「部门」就是 users.role:admin 管理层 / editor 内容运营 / sales 业务部 / lab 开发部实验室 / viewer 只读。
   侧栏在这里自己读一次 cookie 拿角色,不改 Props —— 35 个页面一个都不用动。
   读不到会话按 admin 处理:宁可多显示,也不能把创始人现有页面弄空。 */
let role = 'admin';
try {
  const sess = await readSession(readCookie(Astro.request.headers.get('cookie'), COOKIE), (env as any).AUTH_SECRET ?? '');
  role = sess?.role ?? 'admin';
} catch { /* 本地预览没有 cloudflare:workers 绑定也不该白屏 */ }

/* 每项的 roles = 哪些部门看得见;不写 = 只 admin / editor / viewer(管理层与内容运营的默认口径)。
   这里只管「看不看得见」,能不能操作仍由 guard.ts 的 roleAllows 在接口层决定 —— 两层各管各的,
   侧栏藏起来不等于接口关上了。 */
/* 邮件未读角标(2026-09-18 邮件中心):35 个页面都不传,壳自己数一次、60 秒缓存在 isolate 里 —— 邮件中心页传的 badges.mail 优先。
   COUNT 走 idx_mails_status,表小;别的页面一个请求最多多一次索引计数,60 秒内不再问库。 */
const MAIL_BADGE: { at: number; n: number } = ((globalThis as any).__mailBadge ??= { at: 0, n: 0 });
if (badges.mail === undefined) {
  try {
    if (Date.now() - MAIL_BADGE.at > 60_000) {
      const db = (env as any).DB as D1Database | undefined;
      const r = db ? await db.prepare(`SELECT COUNT(*) n FROM mails WHERE direction='in' AND status='unread'`).first<{ n: number }>() : null;
      MAIL_BADGE.n = r?.n ?? 0; MAIL_BADGE.at = Date.now();
    }
    if (MAIL_BADGE.n) badges = { ...badges, mail: MAIL_BADGE.n };
  } catch { /* 表还没建 / 本地预览没绑定:没角标而已 */ }
}

const BASE = ['admin', 'editor', 'viewer'];
const SALES = [...BASE, 'sales'];        // 业务部:询盘、外联、CRM、周报、知识库
const SYS = ['admin', 'viewer'];         // 系统组:内容运营不该碰账号、密钥、修订记录
const LAB = ['admin', 'viewer', 'lab'];  // 开发部实验室:只此两项;内容运营(editor)不在其中 —— 进去也只见「没有实验室角色」,别给他们看个空门
type NavItem = { id: string; label: string; href: string; roles?: string[]; sub?: boolean };
const NAV: { group: string; items: NavItem[] }[] = [
  /* 罗盘排最前:它回答的是「现在什么是坏的」。
     2026-09-07 资讯管线停摆三天没人发现,就是因为后台首页只摆内容计数,
     运维状态在后台里根本没有位置。 */
  { group: '总览', items: [
    /* 2026-09-18 创始人发来「业务协同工作台」截图:「我们的工作台也非常的重要」—— 事项五段表单 + 状态机 + 时间线 + 今日待办,总览第一项 */
    { id: 'workbench', label: '业务协同工作台', href: '/bohui/workbench/', roles: SALES },
    { id: 'today', label: '今日待办', href: '/bohui/today/', roles: SALES },
    /* 2026-09-18 创始人「SEO、GEO 要真的给我们带入客户 … 看到进展」:老板看的一页,触达 / 回复 / 报价三个数 + 四行按周 */
    { id: 'growth', label: '获客进展', href: '/bohui/growth/', roles: SALES },
    { id: 'pulse', label: '罗盘', href: '/bohui/pulse/' },
  ]},
  { group: '内容', items: [
    { id: 'sites', label: '站点总览', href: '/bohui/' },
    { id: 'pages', label: '页面与版块', href: '/bohui/pages/' },
    /* 首页五块开关：只对集团管理员或 BIOSPHERE 账号露出，见下方 filter */
    { id: 'home-flags', label: '首页块开关', href: '/bohui/home-flags/' },
    { id: 'media', label: '媒体库', href: '/bohui/media/' },
    { id: 'suppliers', label: '包材供应商', href: '/bohui/suppliers/' },
    /* 2026-09-09:上传要交给其他人做,入库台必须在导航里够得着 */
    { id: 'packimport', label: '包材入库', href: '/bohui/packaging/' },
    { id: 'products', label: '产品与剂型', href: '/bohui/products/' },
    { id: 'i18n', label: '翻译中心', href: '/bohui/i18n/' },
    { id: 'seo', label: 'SEO 与 GEO', href: '/bohui/seo/' },
  ]},
  { group: '经营', items: [
    { id: 'inquiries', label: '询盘线索', href: '/bohui/inquiries/', roles: SALES },
    /* 2026-09-18 创始人「客户邮件统一在后台可以看到,并有提醒」:域名邮箱收进来的信;角标 = 未读数 */
    { id: 'mail', label: '邮件中心', href: '/bohui/mail/', roles: SALES },
    { id: 'prospects', label: '定向外联', href: '/bohui/prospects/', roles: SALES },
    /* 2026-09-18 创始人「海关数据对获客是好事,抓紧进入情报系统」:公开提单 / 海关统计反推进口商(任务 K),与外联同一批人看 */
    { id: 'brand-shopify', label: 'Shopify 品牌', href: '/bohui/brand-shopify/', roles: SALES },
    { id: 'brand-suppliers', label: '代工厂溯源', href: '/bohui/brand-suppliers/', roles: SALES },
    { id: 'customs', label: '海关线索', href: '/bohui/customs/', roles: SALES },
    { id: 'companies', label: 'CRM · 客户', href: '/bohui/companies/', roles: SALES },
    { id: 'deals', label: 'CRM · 机会看板', href: '/bohui/deals/', roles: SALES },
    /* 2026-09-24 W3:BEAUTY2OEM 客户认同七级(SOP 03-v2 §4.1)、Amazon 快照实力 / 速度榜、机会简报草稿助手(只出稿,审批后人工发) */
    { id: 'b2o-trust', label: '客户认同等级', href: '/bohui/b2o-trust/', roles: SALES },
    { id: 'b2o-rank', label: '实力榜与速度榜', href: '/bohui/b2o-rank/', roles: SALES },
    { id: 'b2o-brief', label: '机会简报助手', href: '/bohui/b2o-brief/', roles: SALES },
    /* 2026-09-24 C3:预判引擎机会卡池(SOP 02-v2 §8.3)—— 研发签字、改状态、30/60/90 天复盘;研发(lab)也要进来签字 */
    { id: 'b2o-pool', label: '机会卡池', href: '/bohui/b2o-pool/', roles: [...SALES, 'lab'] },
    { id: 'playbook', label: '销售知识库', href: '/bohui/playbook/', roles: SALES },
    { id: 'market', label: '爆款周报', href: '/bohui/market/', roles: SALES },
    /* 2026-09-18 GPT 设计包 P004 落地:按市场×类目看成分出现频率(频率≠销量),业务部与周报同一批人看 */
    { id: 'market-structure', label: '市场结构', href: '/bohui/market-structure/', roles: SALES },
    /* 2026-09-18 创始人「爆款收集的不要忘记生成了!那是重要的情报分析」:按周固化的市场×品类情报(任务 I),与周报同一批人看 */
    { id: 'market-intel', label: '爆款情报', href: '/bohui/market-intel/', roles: SALES },
    /* 2026-09-18 创始人「把这些机制用于帛卉的规划上」:多 Agent 推演沙盘(任务 S),与周报同一批人看,实验室也要能推配方议题 */
    { id: 'sandbox', label: '推演沙盘', href: '/bohui/sandbox/', roles: [...SALES, 'lab'] },
    { id: 'packsource', label: '包材采集', href: '/bohui/packsource/' },
    { id: 'kb', label: 'AI 客服知识库', href: '/bohui/kb/', roles: SALES },
    { id: 'news', label: '行业资讯', href: '/bohui/news/' },
    { id: 'studio', label: 'AI 共创记录', href: '/bohui/studio/' },
    { id: 'formulas', label: '配方库', href: '/bohui/formulas/' },
    { id: 'formula-lab', label: '配方实验室', href: '/bohui/formula-lab/', roles: LAB },
    { id: 'formula-lab-wiki', label: '配方维基', href: '/bohui/formula-lab/wiki/', roles: LAB, sub: true },
  ]},
  { group: '系统', items: [
    { id: 'models', label: '模型舰队', href: '/bohui/models/', roles: SYS },
    { id: 'design-models', label: '设计模型', href: '/bohui/design-models/', roles: SYS },
    { id: 'gateway', label: 'AI 接入网关', href: '/bohui/gateway/', roles: SYS },
    { id: 'vision', label: '视觉模型横评', href: '/bohui/vision/' },
    /* 2026-09-17 创始人:「后台要有个图片转提示词」「提示词方面一定要优化」—— 开发(lab)/ 设计(editor)/ 老板(admin)都要看得见 */
    { id: 'prompts', label: '效果图提示词', href: '/bohui/prompts/', roles: [...BASE, 'lab'] },
    /* 2026-09-18 创始人「看看他们有没有停止」:任务心跳与 AI 成本进后台;实验室(lab)也要看得见任务有没有停 */
    { id: 'jobs', label: '任务中心', href: '/bohui/jobs/', roles: ['admin', 'editor', 'lab'] },
    { id: 'ai-runs', label: 'AI 调用与成本', href: '/bohui/ai-runs/', roles: ['admin', 'editor'] },
    { id: 'users', label: '账号与权限', href: '/bohui/users/', roles: SYS },
    /* 2026-09-23 网站会员(每天 20 / 100 条查看限额):看注册名单与今日用量,管理员改档位;业务部也要看得见 —— 注册会员就是线索 */
    { id: 'members', label: '网站会员', href: '/bohui/members/', roles: [...SYS, 'sales'] },
    { id: 'log', label: '修订记录', href: '/bohui/log/', roles: SYS },
  ]},
];
/* 按部门过滤;过滤后空了的分组连标题一起不出 —— 实验室账号的侧栏只剩「经营」下两项 */
const nav = NAV
  .map((g) => ({
    group: g.group,
    items: g.items.filter((it) => (it.roles ?? BASE).includes(role))
      .filter((it) => it.id !== 'home-flags' || !tenant || tenant.isGroup || tenant.siteId === 'biosphere-ai'),
  }))
  .filter((g) => g.items.length > 0);
---

<html lang="zh-CN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title} · 帛卉后台</title>
  <style>
    /* 2026-09-16 创始人:「你总是把字体搞那么小」—— 后台全是 rem,根字号一处调大,所有页一起放大。
       18px:正文 .875rem = 15.75px、辅助 .8125rem = 14.6px、最小 .75rem = 13.5px,不再有 12px 的字。 */
    html { font-size: 18px; }
    /* minmax(0,1fr) 而不是 1fr:栅格轨道最小宽度默认是 auto,
       内容一宽(比如模型页那张表)就会把整列顶出视口、整页横向滚动。 */
    body {
      display: grid;
      grid-template-columns: 15.5rem minmax(0, 1fr);
      min-height: 100vh;
    }

    aside {
      background: var(--ad-side);
      color: var(--ad-side-ink);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
    }
    .brand {
      padding: 1.375rem 1.375rem 1.125rem;
      border-bottom: 1px solid var(--ad-side-line);
    }
    .brand b {
      display: block;
      color: var(--ad-side-on);
      font-size: .9375rem;
      font-weight: 700;
      letter-spacing: .02em;
    }
    .brand span {
      display: block;
      color: var(--ad-side-dim);
      font-family: var(--ad-mono);
      font-size: .75rem;
      letter-spacing: .18em;
      margin-top: .1875rem;
    }

    .site-pick, .site-fixed {
      display: block; width: 100%; margin-top: .75rem;
      font-size: .8125rem; border-radius: var(--ad-r-s);
      padding: .375rem .5rem;
    }
    .site-pick {
      background: var(--ad-side-active); color: var(--ad-side-on);
      border: 1px solid var(--ad-side-line);
    }
    .site-fixed {
      background: var(--ad-side-hover); color: var(--ad-side-ink);
      border: 1px solid var(--ad-side-line);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    nav { flex: 1; overflow-y: auto; padding: .875rem 0; }
    .grp {
      padding: 1rem 1.375rem .375rem;
      color: var(--ad-side-dim);
      font-family: var(--ad-mono);
      font-size: .8125rem;      /* 2026-09-16 创始人截图圈出来:分组名 10px 看不清;改 14.6px,字距收窄 */
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    a.item {
      display: flex;
      align-items: center;
      gap: .5625rem;
      padding: .46875rem 1.375rem;
      color: var(--ad-side-ink);
      text-decoration: none;
      font-size: .875rem;
      border-left: 2px solid transparent;
      transition: background .12s ease, color .12s ease;
    }
    a.item:hover { background: var(--ad-side-hover); color: var(--ad-side-on); }
    a.item.on {
      background: var(--ad-side-active);
      color: var(--ad-side-on);
      border-left-color: var(--ad-accent);
      font-weight: 600;
    }
    /* 小圆点代替图标字符 —— 之前那些 ▤▦▣ 在不同系统里字形宽度不一,
       会让整列文字左边界参差不齐。用几何点反而更整齐,也不抢注意力。 */
    .dot {
      width: .3125rem;
      height: .3125rem;
      border-radius: 50%;
      background: currentColor;
      opacity: .35;
      flex: none;
    }
    a.item.on .dot { opacity: 1; background: var(--ad-accent); }
    /* 子项(配方维基挂在配方实验室下)缩进一档,字号不变 —— 缩进就够说明层级,再小字就看不清 */
    a.item.sub { padding-left: 2.5rem; }
    .badge {
      margin-left: auto;
      background: var(--ad-accent);
      color: #fff;
      border-radius: 999px;
      padding: 0 .375rem;
      font-size: .75rem;
      font-weight: 600;
      min-width: 1.125rem;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .who {
      padding: .9375rem 1.375rem;
      border-top: 1px solid var(--ad-side-line);
      font-size: .75rem;
      color: var(--ad-side-dim);
    }
    .who .em {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-family: var(--ad-mono);
      font-size: .75rem;
    }
    .who button {
      margin-top: .5625rem;
      font: inherit;
      font-size: .75rem;
      background: transparent;
      border: 1px solid var(--ad-side-line);
      color: var(--ad-side-ink);
      padding: .34375rem .625rem;
      border-radius: var(--ad-r-s);
      cursor: pointer;
      width: 100%;
      transition: background .12s ease, color .12s ease;
    }
    .who button:hover { background: var(--ad-side-active); color: #fff; }

    main { padding: 2rem 2.25rem 5rem; max-width: 84rem; min-width: 0; }

    @media (max-width: 56rem) {
      body { grid-template-columns: 1fr; }
      aside { position: static; height: auto; }
      nav { display: flex; overflow-x: auto; padding: .5rem; gap: .125rem; }
      .grp { display: none; }
      a.item {
        white-space: nowrap;
        border-left: 0;
        border-bottom: 2px solid transparent;
        padding: .4375rem .75rem;
      }
      a.item.on { border-left: 0; border-bottom-color: var(--ad-accent); }
      a.item.sub { padding-left: .75rem; }   /* 横排时没有层级可缩进 */
      .who { display: flex; align-items: center; gap: .75rem; }
      .who .em { flex: 1; }
      .who button { margin-top: 0; width: auto; }
      main { padding: 1.25rem 1.125rem 3rem; }
    }
  </style>
</head>
<body>
  <aside>
    <div class="brand">
      <b>帛卉后台</b>
      <span>BOHUI CONSOLE</span>
      {tenant && (
        tenant.isGroup && tenant.options.length > 1 ? (
          <select class="site-pick" aria-label="当前管理的站点">
            {tenant.options.map((o) => (
              <option value={o.id} selected={o.id === tenant.siteId}>{o.name}</option>
            ))}
          </select>
        ) : (
          <span class="site-fixed" title="你的账号只能管理这个站点">{tenant.siteName}</span>
        )
      )}
    </div>
    <nav>
      {nav.map((g) => (
        <>
          <div class="grp">{g.group}</div>
          {g.items.map((it) => (
            <a class:list={['item', it.sub && 'sub', active === it.id && 'on']} href={it.href}>
              <span class="dot"></span>
              <span>{it.label}</span>
              {badges[it.id] ? <span class="badge">{badges[it.id]}</span> : null}
            </a>
          ))}
        </>
      ))}
    </nav>
    <div class="who">
      <span class="em">{email}</span>
      <button id="logout">退出登录</button>
    </div>
  </aside>

  <main>
    <slot />
  </main>

  <script is:inline>
    /* 切站:把 ?site= 写进地址再重载。只有集团管理员看得到这个下拉 */
    document.querySelector('.site-pick')?.addEventListener('change', (e) => {
      const u = new URL(location.href);
      u.searchParams.set('site', e.target.value);
      location.href = u.toString();
    });

    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/admin/login', { method: 'DELETE' });
      location.href = '/bohui/login/';
    });

    /* 时间一律按浏览器所在时区显示。
       D1 的 datetime('now') 存的是 UTC,此前直接把字符串截前 16 位显示,
       于是北京时间 20:07 的操作在后台显示成 12:07 —— 差 8 小时,看着像别人干的。
       服务端不做转换是对的:团队要跨时区(海外市场),存 UTC、按看的人所在地渲染,
       才不会出现「谁看谁的时间都不一样但都没标注」的混乱。 */
    (function () {
      var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '本地时区';
      var sameYear = new Date().getFullYear();
      document.querySelectorAll('time[data-utc]').forEach(function (el) {
        var raw = el.getAttribute('data-utc');
        if (!raw) return;
        // SQLite 给的是 "2026-08-15 12:07:33",没有时区标记 —— 补上 Z 才会被当成 UTC
        var d = new Date(raw.replace(' ', 'T') + (/[Zz]|[+-]\d{2}:?\d{2}$/.test(raw) ? '' : 'Z'));
        if (isNaN(d)) return;
        var p = function (n) { return String(n).padStart(2, '0'); };
        var ymd = (d.getFullYear() === sameYear ? '' : d.getFullYear() + '-')
                + p(d.getMonth() + 1) + '-' + p(d.getDate());
        el.textContent = ymd + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
        el.setAttribute('datetime', d.toISOString());
        el.title = d.toLocaleString() + '(' + tz + ')\nUTC ' + raw;
      });
    })();
  </script>
</body>
</html>
