      g: 'Packaging and formulas',
      items: [
        {
          q: 'Can we choose our own packaging?',
          a: `${CHAIN_COUNTS.packaging.toLocaleString('en-US')} items are filterable online. Every one has a code — send the code instead of a description.`,
          d: [
            'Filter by type, material, capacity and compatible format. Every item has a real product shot on white.',
            'PET pump bottles and jars run about $0.20–0.32 per piece FOB Guangzhou at 10,000 — an order of magnitude, not a quotation.',
            'Glass, tubes and cartons are deliberately unpriced: their cost curve is nothing like PET, so a PET-based figure would understate them.',
            'We also fill into packaging you supply — send neck size and capacity and we check compatibility.',
          ],
        },
        {
          q: 'Can one formula go into different packaging?',
          a: 'Yes, after compatibility testing. Bulk reacts with packaging — this is not a theoretical risk.',
          d: [
            'Common failures: high-oil formulas deforming PET, acidic formulas attacking metal pump springs, essential oils swelling gaskets.',
            'Each packaging item lists the formats it fits — filter on that first, then test.',
          ],
        },
        {
          q: 'Where do your botanicals come from?',
          a: 'Over 20 cooperating mountain plots across Bijie (Guizhou), Kashgar (Xinjiang) and Qingyuan (Guangdong), documented batch by batch.',
          d: [
            'Harvest timing is set against the actives peak, and each grade is warehoused separately.',
            'Growing conditions, fertiliser records, harvest batch and test reports are all on file.',
          ],
        },
        {
          q: 'Do you provide test reports per batch?',
          a: 'Yes — actives content, pesticide residue and heavy metals, issued per batch.',
          d: [
            'Tell us the category and destination market and we prepare the set that market asks for.',
          ],
        },
      ],
    },
    {
      g: 'Cross-border and ways of working',
      items: [
        {
          q: 'How should a cross-border brand pick a manufacturer?',
          a: 'In this order: market first, packaging second, formula last. Reverse it and you rework.',
          d: [
            'The market decides ingredient restrictions. Locking the formula first is how projects get scrapped.',
            'Packaging decides restock speed — stock versus tooled differ by an order of magnitude.',
            'Volume decides the price tier: 5,000 versus 50,000 units can differ by 30%+.',
          ],
        },
        {
          q: 'Can you handle only part of the process?',
          a: 'Yes. Full line, formula only, filling only, or packaging supply — we take whichever part you hand over.',
          d: [
            'Each segment is quoted and scheduled separately; nothing is bundled.',
          ],
        },
        {
          q: 'How low can the minimum go?',
          a: 'Stock packaging plus a standard format: first runs from 3,000 units.',
          d: [
            'Below that the unit price stops being meaningful — fixed cost per unit exceeds the bulk itself.',
            'For testing, run several formulas at the minimum and let the market decide which one scales.',
          ],
        },
        {
          q: 'How do we start?',
          a: 'Tell us three things: category, destination market, first-run volume. We will ask the rest.',
          d: [
            'With those three we can tell you OEM or ODM, stock or tooled packaging, and which documents you will need.',
            'Or just send codes — the packaging code you like and the format you are benchmarking beats a paragraph.',
            'WhatsApp / WeChat (we reach out after you submit the form), or use the contact form. Written reply within two business days.',
          ],
        },
      ],
    },
  ],
  ctaTitle: 'Send us the brief',
  ctaBody: 'Category, destination market, first-run volume. Three lines is enough.',
  ctaBtn: 'Send an enquiry',
  wa: 'Rather not wait for email? WhatsApp us',
};

const flat = T.groups.flatMap((g) => g.items);
/* FAQPage 的答案用「直答 + 要点」拼成一段。
   只给 a 的话 AI 摘到的是一句口号;把 d 也拼进去,引用的才是能用的答案。 */
const faqLd = faqJsonLd(flat.map((x) => ({ q: x.q, a: [x.a, ...x.d].join(' ') })));
const crumbs = breadcrumbJsonLd(origin, lang, path, uiT(lang as any)('nav.home'), [
  { label: T.eyebrow, href: path },
]);
const orgLd = orgJsonLd(origin, site?.name ?? 'BIOSPHERE', lang, T.lede);
const jsonLd = [orgLd, faqLd, crumbs].filter(Boolean);

const title = zh
  ? '化妆品代工常见问题 —— 起订量、价格构成、认证、打样周期'
  : 'Cosmetics contract manufacturing FAQ — MOQ, pricing, certification, lead times';
const desc = zh
  ? '采购最常问的 20 个问题:OEM 与 ODM 的区别、起订量、代工价格怎么算、认证、打样周期、包材选择、跨境合规。每条第一句就是答案。'
  : 'The 20 questions buyers ask most: OEM vs ODM, minimum order quantity, how pricing works, certification, lead times, packaging and cross-border compliance.';
---

<BaseLayout
  locale={lang} school={shell.variant?.school ?? 'atelier'} variant={site?.variant ?? 'v1'}
  brand={site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai'}
  title={title} description={desc}
  siteName={site?.name ?? '帛卉'} siteUrl={origin} path={path}
  indexable={site?.is_live === 1} brandColor={site?.brand_color} theme={site?.theme ?? 'noir'}
>
  <a class="ck-skip-link" href="#main">{tSkip}</a>
  <SiteHeader locale={lang} path={path} siteName={site?.name ?? '帛卉'}
              siteNameZh={site?.tagline ?? ''} nav={shell.nav} />

  <main id="main">
    <header class="hd">
      <p class="eyebrow">{T.eyebrow}</p>
      <h1>{T.title}</h1>
      <p class="lede">{T.lede}</p>
      <p class="note">{T.note}</p>
    </header>

    {T.groups.map((g, gi) => (
      <section class="grp">
        <h2><span class="gn">{String(gi + 1).padStart(2, '0')}</span>{g.g}</h2>
        <div class="qs">
          {g.items.map((x) => (
            <article class="q">
              <h3>{x.q}</h3>
              <p class="a">{x.a}</p>
              <ul>{x.d.map((line) => <li>{line}</li>)}</ul>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="cta">
      <h2>{T.ctaTitle}</h2>
      <p>{T.ctaBody}</p>
      <p class="btns">
        <a class="btn" href={`${B}/contact/`}>{T.ctaBtn}</a>
        <a class="wa" href="/zh-cn/contact/">{T.wa}</a>
      </p>
    </section>
  </main>

  <SiteFooter locale={lang} path={path}
              site={{ ...(shell.staticSite ?? {}), name: site?.name ?? '帛卉' } as any}
              siblings={[]} email={shell.email} nav={shell.nav} />
  <script type="application/ld+json" set:html={ldJson(jsonLd)} is:inline />
</BaseLayout>

<style>
  main { max-width: 112.5rem; margin: 0 auto; padding: clamp(2rem, 5vw, 4.5rem) clamp(1rem, 4vw, 3rem) 3rem;  /* 09-17 「太多空余」:页底 5 → 3rem */ }
  .hd { max-width: 46rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .eyebrow { margin: 0 0 0.75rem; font-size: max(0.75rem, 14px); letter-spacing: 0.16em;
             text-transform: uppercase; color: var(--ck-ink-faint); }
  h1 { margin: 0 0 1rem; font-size: clamp(1.9rem, 4.2vw, 3rem); line-height: 1.15;
       letter-spacing: -0.02em; text-wrap: balance; }
  .lede { margin: 0 0 0.75rem; font-size: clamp(1rem, 1.6vw, 1.125rem); line-height: 1.7;
          color: var(--ck-ink-soft); }
  .note { margin: 0; font-size: 0.875rem; line-height: 1.7; color: var(--ck-ink-faint); }

  .grp { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .grp > h2 { display: flex; align-items: baseline; gap: 0.75rem; margin: 0 0 1.5rem;
              font-size: clamp(1.05rem, 2vw, 1.375rem); letter-spacing: -0.01em; }
  .gn { font-family: var(--ck-font-mono); font-size: max(0.75rem, 14px); color: var(--ck-accent);
        letter-spacing: 0.06em; }

  .qs { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr)); }
  .q { padding: clamp(1.125rem, 2vw, 1.5rem); border: var(--ck-border-w) solid var(--ck-line);
       border-radius: var(--ck-radius); background: var(--ck-surface); }
  .q h3 { margin: 0 0 0.625rem; font-size: 1rem; line-height: 1.4; letter-spacing: -0.01em; }
  /* 直答单独一段、加重 —— 这一句就是 AI 会摘走的那一句,排版上也该最先被看到 */
  .a { margin: 0 0 0.75rem; font-size: 0.9375rem; line-height: 1.65; font-weight: 500; color: var(--ck-ink); }
  .q ul { margin: 0; padding-left: 1.05rem; display: grid; gap: 0.375rem; }
  .q li { font-size: max(0.8125rem, 14px); line-height: 1.65; color: var(--ck-ink-soft); }

  .cta { margin-top: clamp(2rem, 4vw, 3.5rem);  /* 09-17 「太多空余」 */ padding: clamp(1.75rem, 4vw, 3rem);
         border-radius: var(--ck-radius); background: var(--ck-surface-alt);
         border: var(--ck-border-w) solid var(--ck-line); }
  .cta h2 { margin: 0 0 0.5rem; font-size: clamp(1.25rem, 2.4vw, 1.75rem); letter-spacing: -0.02em; }
  .cta p { margin: 0; color: var(--ck-ink-soft); line-height: 1.7; }
  .btns { margin-top: 1.25rem !important; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .btn { display: inline-flex; padding: 0.6875rem 1.5rem; border-radius: 999px;
         background: var(--ck-accent); color: #fff; text-decoration: none; font-weight: 600; font-size: 0.9375rem; }
  .wa { font-size: 0.875rem; color: var(--ck-ink-soft); }
</style>
