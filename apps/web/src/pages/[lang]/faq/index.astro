---
import { ldJson } from '@cosmetic/core/content/ldjson.ts';
import { t as uiT, type Locale } from '@cosmetic/core/i18n';
/**
 * 常见问题总表 —— AI 答案引擎的入口页。
 *
 * 外部 GEO 诊断(2026-09-02)给的第一条 P0:
 *   「FAQ 散在 services 各场景下,AI 找不到集中入口 —— 新建 /faq/ 聚合,加 FAQPage schema」
 * 诊断说得对:站上确实已经有 FAQPage 标记(services / capabilities / origin / 包材单品),
 * 但它们分散在各自的场景里。AI 抓一个站的时候,一个集中的问答入口
 * 比六处零散的问答块更容易被整段引用 —— 引用的是「一页」,不是「一句」。
 *
 * 这一页的写法按 AI 引用的偏好来,不是按人读文章的偏好:
 *   · **直接答案写在最前面一句**。AI 摘的是第一句,不是第三段。
 *   · 每条都落到可核对的数字或做法,不写「我们专业可靠」这类无法引用的话。
 *   · 数字全部来自公司资料与本站数据库(包材 4,518 款、配方起订 3,000 起、
 *     打样 3–7 天、认证清单),这里不新造一个数。
 *   · **不写客户品牌名**:合作品牌属于客户的商业信息,不是我们的素材。
 *   · **不写单价**:报价按询盘逐单出具;能公开的只有包材参考价区间,
 *     而那一条已经写在包材库每一款下面。
 *
 * 零 D1 查询:内容是常量,外壳由 pageShell 兜底。
 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
