  /* 左右切换箭头 */
  .nav { position: absolute; top: 50%; transform: translateY(-50%); width: 2.75rem; height: 2.75rem; border: none; border-radius: 50%; background: rgba(0,0,0,.45); color: #fff; font-size: 1.75rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .25s, background .25s; z-index: 5; }
  .stage:hover .nav, .nav:focus-visible { opacity: 1; }
  .nav:hover { background: rgba(0,0,0,.65); }
  .nav-prev { left: .875rem; }
  .nav-next { right: .875rem; }
  @media (hover: none) { .nav { opacity: 1; } }
  .stage-img { width: 100%; border-radius: var(--ck-radius); border: var(--ck-border-w) solid var(--ck-line); display: block; }
  .noimg { aspect-ratio: 4/3; background: var(--ck-surface-alt); border-radius: var(--ck-radius); }
  .stage .count { position: absolute; bottom: .75rem; right: .75rem; background: rgba(0,0,0,.6); color: #fff; padding: .25rem .625rem; border-radius: 6px; font-size: .8125rem; }
