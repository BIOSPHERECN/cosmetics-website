---
/**
 * 产品详情页 —— /{lang}/product/{slug}/(单数)
 *
 * 为什么是单数:根目录的 [...path].astro 会把 /{lang}/products/{任意} 全部吃掉,
 * 返回「no page: products/xxx」的 404 —— 详情页根本轮不到渲染。
 * 站上 /formula/{code}/ 走的就是单数路径且一直是通的,按同一约定改过来。
 *
 * 起因:创始人点着产品列表说「无法点击进入」。他是对的 ——
 * 列表卡此前只有「加入询盘」按钮,没有详情页可进。
 * 访客看到产品卡的第一反应是点它;点不动,10 款产品就只是 10 张图。
 *
 * 数据全部来自 products / product_i18n / product_media,
 * 语种回退与全站一致(目标语 → en → zh-cn)。
 * description 是公开文案;internal_note **不查**(合规提醒只属于后台)。
 */
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import InquiryFormLite from '@cosmetic/core/components/InquiryFormLite.astro';
import { env } from 'cloudflare:workers';
import { pageShell } from '../../../lib/shell';
import { isLang, DEFAULT_LANG, type Lang } from '../../../lib/db';
import { orgJsonLd, breadcrumbJsonLd, faqJsonLd } from '../../../lib/jsonld';
import { siteIdForHost } from '@cosmetic/core/content/tenant-map.ts';
import { readSession, readCookie, COOKIE } from '../../../lib/auth';
import { catalogLabel, softenClaims } from '../../../lib/comply-copy';
import { rfqProductHooks } from '../../../lib/rfq-fields';

export const prerender = false;

const db = (env as any).DB as D1Database | undefined;
const rawLang = Astro.params.lang ?? DEFAULT_LANG;
const lang: Lang = (isLang(rawLang) ? rawLang : DEFAULT_LANG) as Lang;
const pslug = String(Astro.params.pslug ?? '').toLowerCase();

const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const siteId = shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai';
const contactWa: string | null = ((Astro.locals as any)?.contact ?? {}).whatsapp ?? null;

/* 语种回退与全站同一套:目标语 → en → zh-cn */
const PRI = `CASE i.lang WHEN ? THEN 0 WHEN 'en' THEN 1 WHEN 'zh-cn' THEN 2 ELSE 3 END`;

/* 草稿预览(A9 · 09-23):后台「预览」按钮带 ?preview=1,只有已登录后台的人能看到草稿。
   带 preview 参数的地址本来就不进边缘缓存(middleware 里未知参数一律不缓存),草稿不会漏给访客。 */
const preview = Astro.url.searchParams.has('preview')
  && !!(await readSession(readCookie(Astro.request.headers.get('cookie'), COOKIE), (env as any)?.AUTH_SECRET ?? '').catch(() => null));

const product = db ? await db.prepare(
  `SELECT p.id, p.slug, p.category, p.moq, p.cover_media,
          i.name, i.summary, i.description, i.specs_json
     FROM products p
     JOIN product_i18n i ON i.product_id = p.id AND i.lang IN (?, 'en', 'zh-cn')
    WHERE p.site_id = ? AND p.slug = ? AND (p.status = 'published' OR ?)
    ORDER BY ${PRI} LIMIT 1`,
).bind(lang, siteId, pslug, preview ? 1 : 0, lang).first<any>() : null;

if (!product) {
  /* 没这个产品就回列表,别给 404 —— 链接可能来自旧收藏或改过 slug,
     落回列表访客还能自己找;落到 404 这条线索就断了。 */
  return Astro.redirect(`/${lang}/portfolio/`, 302);
}

const { results: gallery } = await db!.prepare(
  `SELECT media_id FROM product_media WHERE product_id = ? ORDER BY sort_order`,
).bind(product.id).all<{ media_id: number }>();
let images = (gallery ?? []).map((g) => `/media/${g.media_id}`);
// 如果 product_media 为空但有 cover_media，回退到 cover_media
if (!images.length && product.cover_media) images.push(`/media/${product.cover_media}`);
// 如果仍然没有图片，设为空数组防止渲染错误
if (!images.length) images = [];

/* 同品类的其他产品 —— 「看更多」要有去处 */
const { results: related } = await db!.prepare(
  `SELECT p.slug, p.cover_media,
          (SELECT x.name FROM product_i18n x WHERE x.product_id = p.id
            ORDER BY CASE x.lang WHEN ? THEN 0 WHEN 'en' THEN 1 ELSE 2 END LIMIT 1) AS name
     FROM products p
    WHERE p.site_id = ? AND p.status = 'published' AND p.category = ? AND p.id <> ?
    ORDER BY p.sort_order LIMIT 4`,
).bind(lang, siteId, product.category, product.id).all<any>();

const CAT_LABEL: Record<string, Record<string, string>> = {
  'zh-cn': { skincare: '护肤', makeup: '彩妆', oral: '口腔护理', kids: '儿童护肤', body: '身体护理', hair: '洗护', haircare: '洗护', cleansing: '洁护', suncare: '防晒', fragrance: '香氛', cleanser: '洁面', toner: '爽肤水', serum: '精华', cream: '面霜乳液', mask: '面膜', 'special-care': '特护', pet: '宠物护理' },
  en: { skincare: 'Skincare', makeup: 'Makeup', oral: 'Oral care', kids: 'Kids', body: 'Body care', hair: 'Hair', haircare: 'Hair care', cleansing: 'Cleansing', suncare: 'Suncare', fragrance: 'Fragrance', cleanser: 'Cleansers', toner: 'Toners', serum: 'Serums', cream: 'Creams & Lotions', mask: 'Masks', 'special-care': 'Special care', pet: 'Pet care' },
};
const catLabel = (CAT_LABEL[lang] ?? CAT_LABEL.en)[product.category] ?? product.category;

/* 产品分节(渝崧现货册那套骨架)—— 由 tools/product-sections.py 写进 specs_json。
   `_pending` 是占位标记:销量与竞品结论必须是运营按实填的,没填就整块不渲染,
   不能拿生成的数字充数(客户一问就穿)。 */
const specs = (() => {
  try { return JSON.parse(product.specs_json || '{}') || {}; } catch { return {}; }
})();
const real = (o: any) => (o && typeof o === 'object' && !o._pending ? o : null);
const techBlocks: { title: string; body: string }[] = Array.isArray(specs.tech) ? specs.tech : [];
/* 历史产品(B2 发布,tools/b2o-products/import.py)的 specs_json 是列表 [{label,value}]:剂型 / 容量 / 主要成分 */
const specList: { label: string; value: string }[] = Array.isArray(specs) ? specs.filter((x: any) => x && x.label && x.value) : [];
const position = (real(specs.position) ?? {}) as { market?: string; audience?: string };
const sales = real(specs.sales) as { text?: string } | null;
const versus = real(specs.versus) as { rows?: { them: string; us: string }[] } | null;

const zh = lang === 'zh-cn';
const shown = catalogLabel(String(product.name ?? ''), zh);
const displayName = shown.name;
const displaySummary = product.summary ? softenClaims(String(product.summary)) : '';
/* W5：详情页三个行动都进 RFQ，product_id 用库内 id，缺则 slug，禁止空串，也不再送到 /contact/。 */
const productRef = String(product.id ?? '').trim() || String(product.slug || pslug).trim();
const productHooks = rfqProductHooks({
  hasContext: true,
  specsJson: typeof product.specs_json === 'string' ? product.specs_json : JSON.stringify(product.specs_json ?? ''),
  hideCjk: lang !== 'zh-cn',
});
const rfqFor = (intent: string) => {
  const qs = new URLSearchParams();
  qs.set('product_id', productRef);
  qs.set('about', displayName);
  qs.set('category', String(product.category ?? ''));
  qs.set('intent', intent);
  if (productHooks.spf_pa) qs.set('spf_pa', productHooks.spf_pa);
  if (productHooks.texture) qs.set('texture', productHooks.texture);
  if (productHooks.skin_type) qs.set('skin_type', productHooks.skin_type);
  return `/${lang}/rfq/?${qs.toString()}`;
};
const T = lang === 'zh-cn'
  ? { back: '返回产品列表', moq: '起订量', inquiry: '就这款发起询盘', more: '同品类还有', desc: '产品说明',
      tech: '产品特点', specs: '产品规格', position: '产品定位', posMarket: '目标市场', posAudience: '目标客户',
      sales: '销售情况', versus: '竞品对照', vsThem: '常见竞品', vsUs: '本品优势',
      chainH: '这支产品背后的链路',
      chainNote: '配方、原料、产区、包材、质检在站内都是可点开的实体 —— 具体到这支产品用哪条配方与哪套包材,按询盘确认,不在页面上假装已经绑定。',
      cFormula: '同品类配方', cIng: '草本原料库', cOrigin: '原料溯源与主产区',
      cPack: '包材库(含彩盒与外封膜)', cQc: '质检体系 36 项', cReg: '各国备案索引',
      note: '以上为公开产品信息。具体规格、包材与交期按询盘沟通；功效宣称以第三方检测报告为准。展示名 ≠ 可宣称功效。' }
  : { back: 'Back to products', moq: 'MOQ', inquiry: 'Inquire about this product', more: 'More in this category', desc: 'About this product',
      tech: 'Product highlights', specs: 'Specifications', position: 'Positioning', posMarket: 'Target markets', posAudience: 'Target buyers',
      sales: 'Sales record', versus: 'Versus common alternatives', vsThem: 'Common alternative', vsUs: 'This product',
      chainH: 'The chain behind this product',
      chainNote: 'Formulation, ingredients, source regions, packaging and quality control are all live entities on this site. Which formula and which packaging set apply to this product is confirmed per inquiry — the page does not pretend they are already bound.',
      cFormula: 'Formulations in this category', cIng: 'Herbal ingredient library', cOrigin: 'Ingredient origins',
      cPack: 'Packaging library (cartons and films included)', cQc: 'Quality control, 36 points', cReg: 'Notification index',
      note: 'Public product information. Specifications, packaging and lead time are confirmed per inquiry. Display name ≠ marketable claim. Efficacy claims follow target-market rules and a third-party report; no report, no label claim.' };

const base = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;
const path = `/${lang}/product/${product.slug}/`;
/* 库里的 description 实测 1164/1164 都是「Product: <name>.」占位 —— 直接渲染等于给访客和 AI 一句空话。
   占位或过短时改用可核实的站内事实(品类/起订量/产线/认证/定制范围)拼采购说明,不编造成分与功效。 */
const descRaw = product.description ? String(product.description).replace(/\s+/g, ' ').trim() : '';
const descStub = !descRaw || descRaw.length < 80 || /^Product:\s*/i.test(descRaw);
const sumTrim = displaySummary ? displaySummary.replace(/\s+/g, ' ').trim() : '';
const aboutText = descStub
  ? (zh
      ? [
          `${displayName} 是帛卉为 OEM/ODM 项目供应的${catLabel}类产品:配方、包材与标签可按品牌需求在自有产线上调整,打样签样后进入量产。`,
          `工厂位于广州,20,000 ㎡ 厂房、15 条自动化产线,在册配方 13,000+,持有 GMPC、ISO 22716:2007 与 HALAL 认证;出口可配合 FDA 注册、CPNP 通报与东南亚市场备案。起订量按品类与包材议定，以书面确认为准。打样通常 5–14 天，这是样品指示，不是大货交期。`,
        ]
      : [
          `${displayName} is a ${catLabel.toLowerCase()} product supplied by BIOSPHERE-AI for OEM/ODM projects: formula, packaging and labels can be adjusted to your brand on our own lines, with sampling and sign-off before mass production.`,
          `The factory is in Guangzhou — over 20,000 m² of manufacturing floor, 15 automated production lines and 13,000+ formulations on file, certified to GMPC, ISO 22716:2007 and HALAL; export support covers FDA registration, CPNP notification and Southeast Asian filings. MOQ is agreed per category and packaging and confirmed in writing. Sampling is typically 5–14 days as a sample indication, not a production lead time.`,
        ])
  : [softenClaims(descRaw)];
const metaDesc = descStub
  ? (sumTrim.length >= 60 ? sumTrim : (zh
      ? `${displayName}——${catLabel}类 OEM/ODM 代工产品,起订量按品类与包材书面确认;支持配方、包材、香型与标签定制,广州自有产线(GMPC/ISO 22716/HALAL),可打样。`
      : `${displayName} — ${catLabel} OEM/ODM manufacturing. MOQ by category and packaging, confirmed in writing. Formula, packaging, fragrance and label customization on our Guangzhou lines (GMPC, ISO 22716, HALAL); sampling available.`))
  : softenClaims(descRaw).slice(0, 158);
/* 产品 FAQ 只定义一次:同时进 FAQPage schema 与可见 HTML。
   2026-10-28 调研结论:AI 只读可见正文,藏在 JSON-LD 里的问答等于没写。 */
const faqs = [
  { q: zh ? `${displayName} 的起订量是多少？` : `What is the MOQ for ${displayName}?`,
    a: zh ? `起订量按品类与包材议定,具体以书面确认为准。请通过询盘告知品类与目标量,我们会在一个工作日内回复。`
         : `MOQ is agreed per category and packaging and confirmed in writing. Send your target quantity via inquiry; we reply within one business day.` },
  { q: zh ? `${displayName} 可以打样吗？多久能拿到样品？` : `Can I get a sample of ${displayName}? How long does sampling take?`,
    a: zh ? `可以打样。打样通常 5–14 天，这是样品指示，须书面确认，不是大货交期。样品是否收费视复杂度而定，询盘时说明。`
         : `Yes. Sampling is typically 5–14 days: a sample indication, confirmed in writing, not a production lead time. Sample fees depend on complexity; mention it in your inquiry.` },
  { q: zh ? `这款产品有哪些认证支持？` : `What certifications are available for this product?`,
    a: zh ? `工厂持有 GMPC、ISO 22716、HALAL 认证;出口支持 FDA 注册、CPNP 通报、东南亚备案。具体到本品的适用认证请询盘确认。`
         : `The factory holds GMPC, ISO 22716, and HALAL certifications. Export compliance includes FDA registration, CPNP notification, and Southeast Asian market filings. Applicable certifications for this product are confirmed per inquiry.` },
  { q: zh ? `${displayName} 的生产周期/交期是多久？` : `What is the production lead time for ${displayName}?`,
    a: zh ? `生产周期按品类、包材与订单量确认,以书面合同为准。打样后可进入量产排程,询盘时说明目标上市时间。`
         : `Lead time is confirmed per category, packaging and order quantity in writing. After sample sign-off the order enters production scheduling; mention your target launch date in the inquiry.` },
  { q: zh ? `${displayName} 可以做 OEM/ODM 定制吗？定制范围是什么？` : `Can ${displayName} be customized under OEM/ODM? What can be changed?`,
    a: zh ? `配方、包材、香型、质地、规格与标签语言可按项目确定。功效宣称受目标市场规则与第三方报告限制：没有对应报告，就不能上标签宣称。`
         : `Formula, packaging, fragrance, texture, volume and label language are scoped per project. Claims are limited by target-market rules and third-party reports: no report, no label claim.` },
];
const jsonLd = [
  orgJsonLd(base, shell.site?.name ?? 'BIOSPHERE', lang, displaySummary || ''),
  breadcrumbJsonLd(base, lang, path, lang === 'zh-cn' ? '首页' : 'Home', [
    { label: lang === 'zh-cn' ? '产品列表' : 'Products', href: `/${lang}/portfolio/` },
    { label: catLabel, href: `/${lang}/collections/${product.category}/` },
    { label: displayName, href: path },
  ]),
  {
    '@context': 'https://schema.org', '@type': 'Product',
    '@id': `${base}${path}`, name: displayName,
    url: `${base}${path}`,
    description: descRaw && !descStub ? softenClaims(descRaw).slice(0, 900) : aboutText.join(' '),
    category: catLabel,
    sku: product.slug,
    ...(images.length ? { image: images.map((img) => `${base}${img}`) } : {}),
    brand: { '@id': `${base}/#organization` },
    manufacturer: { '@id': `${base}/#organization` },
    offers: { '@type': 'Offer',
      businessFunction: 'http://purl.org/goodrelations/v1#ProvideService',
      availability: 'https://schema.org/InStock',
      seller: { '@id': `${base}/#organization` },
      url: `${base}${path}` },
    ...(specList.length ? {
      additionalProperty: specList.map((x) => ({ '@type': 'PropertyValue', name: x.label, value: x.value })),
    } : {}),
  },
  faqJsonLd(faqs),
].filter(Boolean) as Record<string, unknown>[];
---

<BaseLayout
  locale={lang}
  school={shell.variant?.school ?? 'atelier'}
  variant={shell.site?.variant ?? 'v1'}
  brand={shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai'}
  title={specs.seo_title ? softenClaims(String(specs.seo_title)) : `${displayName} | ${catLabel} OEM/ODM`}
  description={metaDesc}
  siteName={shell.site?.name ?? '帛卉'}
  siteUrl={base}
  path={path}
  indexable={shell.site?.is_live === 1}
  brandColor={shell.site?.brand_color}
  theme={(shell.site as any)?.theme ?? 'noir'}
  ogImage={images[0]}
  jsonLd={jsonLd}
>
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'}
              siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />

  <button id="to-top" class="to-top" aria-label={zh ? '返回顶部' : 'Back to top'} title={zh ? '返回顶部' : 'Back to top'}>↑</button>

  <main id="main" class="pd">
    <div class="ck-wrap">
      <p class="crumb"><a href={`/${lang}/portfolio/`}>← {T.back}</a> / <a href={`/${lang}/collections/${product.category}/`}>{catLabel}</a></p>

      <div class="top">
        <div class="gallery" data-gallery>
          <div class="stage">
            {images[0]
              ? <img class="stage-img" data-stage src={images[0]} alt={displayName} decoding="async" />
              : <div class="noimg" aria-hidden="true"></div>}
            {images.length > 1 && <span class="count" data-count>1 / {images.length}</span>}
            {images.length > 1 && (
              <>
                <button type="button" class="nav nav-prev" data-prev
                        aria-label={zh ? '上一张' : 'Previous image'}>‹</button>
                <button type="button" class="nav nav-next" data-next
                        aria-label={zh ? '下一张' : 'Next image'}>›</button>
              </>
            )}
          </div>
          {images.length > 1 && (
            <div class="thumbs" data-thumbs>
              {images.map((img, i) => (
                <button type="button" class:list={['thumb', { on: i === 0 }]} data-thumb data-src={img}
                        aria-label={zh ? `查看第 ${i + 1} 张图` : `View image ${i + 1}`}>
                  <img src={img} alt="" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="info">
          <p class="cat">{catLabel}</p>
          <h1>{displayName}</h1>
          {shown.delist && <p class="sum">{zh ? '下架复核：该展示名不是可宣称功效。' : 'Delist review: this display name is not a marketable claim.'}</p>}
          {displaySummary && <p class="sum">{displaySummary}</p>}
          {(zh || product.moq) && <p class="moq"><b>{T.moq}</b> {zh ? '按品类与包材议定,以书面确认为准' : 'Agreed per category & packaging, confirmed in writing'}</p>}
          <div class="acts">
            {/* 创始人 2026-10-23 最高原则:每个详情页必须有三个明确行动,降低询盘门槛。
                W5：三枚都进 /rfq/?product_id=（非空 id 或 slug），不再去 /contact/。 */}
            <a class="cta primary" href={rfqFor('inquiry')}>{T.inquiry}</a>
            <a class="cta" href={rfqFor('sample')}>{zh ? '拿样品' : 'Request sample'}</a>
            <a class="cta" href={rfqFor('custom')}>{zh ? '发参考开发同款/升级款' : 'Develop similar / upgrade'}</a>
            {contactWa && (
              <a class="wa" href={`https://wa.me/${contactWa.replace(/[^0-9]/g, '')}?text=${encodeURIComponent((zh ? '我对这款产品感兴趣: ' : 'I am interested in this product: ') + displayName + ' | ' + Astro.url.href)}`} target="_blank" rel="noopener">💬 WhatsApp</a>
            )}
          </div>
          <ul class="assure">
            <li>{zh ? 'GMPC · ISO 22716 · HALAL（持证，范围以证书为准）' : 'GMPC · ISO 22716 · HALAL (held; scope as on the certificate)'}</li>
            <li>{zh ? '支持 OEM / ODM 打样' : 'OEM / ODM sampling supported'}</li>
            <li>{zh ? '打样周期按品类与包材备料确认 · 以书面告知为准' : 'Sampling lead time confirmed with category & packaging'}</li>
          </ul>
        </div>
      </div>

      {specList.length > 0 && (
        <section class="desc">
          <h2>{T.specs}</h2>
          <dl class="pos">
            {specList.map((x) => (<><dt>{softenClaims(x.label)}</dt><dd>{softenClaims(x.value)}</dd></>))}
          </dl>
        </section>
      )}

      {techBlocks.length > 0 && (
        <section class="desc">
          <h2>{T.tech}</h2>
          <div class="techs">
            {techBlocks.map((b) => (
              <div class="tech"><h3>{softenClaims(b.title)}</h3><p>{softenClaims(b.body)}</p></div>
            ))}
          </div>
        </section>
      )}

      {(position.market || position.audience) && (
        <section class="desc">
          <h2>{T.position}</h2>
          <dl class="pos">
            {position.market && (<><dt>{T.posMarket}</dt><dd>{position.market}</dd></>)}
            {position.audience && (<><dt>{T.posAudience}</dt><dd>{position.audience}</dd></>)}
          </dl>
        </section>
      )}

      {/* 销售情况与竞品分析:运营按实填了才渲染。
          销量数字和「竞品只控油不修护」这类结论必须是真的 —— 编一个,客户一问就穿。 */}
      {sales && (
        <section class="desc"><h2>{T.sales}</h2><p>{sales.text}</p></section>
      )}

      {versus && Array.isArray(versus.rows) && versus.rows.length > 0 && (
        <section class="desc">
          <h2>{T.versus}</h2>
          <div class="wrap">
            <table>
              <thead><tr><th>{T.vsThem}</th><th>{T.vsUs}</th></tr></thead>
              <tbody>{versus.rows.map((r: any) => (<tr><td>{r.them}</td><td>{r.us}</td></tr>))}</tbody>
            </table>
          </div>
        </section>
      )}

      <section class="desc">
        <h2>{T.desc}</h2>
        {/* 描述按空行分段;写死 white-space 会让长段在窄屏没法读。占位文案已在 aboutText 处换成采购说明 */}
        {aboutText.map((p: string) => <p>{p}</p>)}
      </section>

      {/* 产线链路 —— 创始人 2026-09-10:「每一瓶产品都有草本溯源与 AI 质量记录,
          这个是不是也需要把我们的完整链路打通,而不是孤单单的」。
          产品与配方目前没有外键(配方是可选型的库,不是一支产品绑死一条),
          所以按品类把下一跳给出来,并写明具体配对以询盘确认 —— 不假装有一对一映射。 */}
      <section class="chain">
        <h2>{T.chainH}</h2>
        <p class="chainNote">{T.chainNote}</p>
        <ul class="chainLinks">
          <li><a href={`/${lang}/formulas/?c=${encodeURIComponent(product.category ?? '')}`}>{T.cFormula}</a></li>
          <li><a href={`/${lang}/ingredients/`}>{T.cIng}</a></li>
          <li><a href={`/${lang}/origin/`}>{T.cOrigin}</a></li>
          <li><a href={`/${lang}/packaging/`}>{T.cPack}</a></li>
          <li><a href={`/${lang}/qc/`}>{T.cQc}</a></li>
          <li><a href={`/${lang}/compliance/`}>{T.cReg}</a></li>
        </ul>
      </section>

      {/* 可见 FAQ(2026-10-28 AI-SEO):与 faqJsonLd 同源,渲染成正文 —— AI 摘要读这里,不是读 JSON-LD */}
      <section class="faq">
        <h2>{zh ? '常见问题' : 'Frequently asked questions'}</h2>
        {faqs.map((f) => (
          <div class="qa">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </section>

      <p class="legal">{T.note}</p>

      <section class="rel">
        <h2>{T.more}</h2>
        {(related ?? []).length > 0 && (
          <ul>
            {related.map((r: any) => (
              <li>
                <a href={`/${lang}/product/${r.slug}/`}>
                  {r.cover_media && <img src={`/media/${r.cover_media}`} alt={catalogLabel(String(r.name ?? ''), zh).name} loading="lazy" />}
                  <span>{catalogLabel(String(r.name ?? ''), zh).name}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        <p class="relAll"><a href={`/${lang}/collections/${product.category}/`}>{zh ? `查看「${catLabel}」全部产品 →` : `View all ${catLabel} →`}</a></p>
      </section>
    </div>
  </main>

  <InquiryFormLite lang={lang} email={shell.email} whatsapp={contactWa} source="product" product={displayName} />

  <SiteFooter locale={lang} path={path}
              site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any}
              siblings={[]} email={shell.email} nav={shell.nav} />
</BaseLayout>

