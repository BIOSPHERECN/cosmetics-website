  @media (max-width: 52rem) { .top { grid-template-columns: 1fr; gap: 1.5rem; } }
  /* 返回顶部 */
  .to-top { position: fixed; right: 1.25rem; bottom: 1.25rem; width: 3rem; height: 3rem; border: none; border-radius: 50%; background: var(--ck-accent, #333); color: #fff; font-size: 1.5rem; line-height: 1; cursor: pointer; opacity: 0; transform: translateY(1rem); transition: opacity .25s, transform .25s; pointer-events: none; z-index: 999; box-shadow: 0 4px 12px rgba(0,0,0,.2); }
  .to-top.show { opacity: .85; transform: translateY(0); pointer-events: auto; }
  .to-top:hover { opacity: 1; }
</style>

<script>
  // 画廊交互：缩略图点击 + 左右箭头 + 3秒自动轮播
  document.addEventListener('DOMContentLoaded', () => {
    const stageImg = document.querySelector('.stage-img');
    const thumbs = Array.from(document.querySelectorAll('.thumb'));
    const countSpan = document.querySelector('[data-count]');
    const prevBtn = document.querySelector('[data-prev]');
    const nextBtn = document.querySelector('[data-next]');
    const total = thumbs.length;
    let current = 0;
    let timer = null;

    if (!stageImg || total === 0) return;

    function goTo(idx) {
      current = (idx + total) % total;
      stageImg.src = thumbs[current].getAttribute('data-src');
      thumbs.forEach(t => t.classList.remove('on'));
      thumbs[current].classList.add('on');
      if (countSpan) countSpan.textContent = `${current + 1} / ${total}`;
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    // 缩略图点击
    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => { goTo(i); reset(); }));

    // 左右箭头
    if (prevBtn) prevBtn.addEventListener('click', () => { prev(); reset(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { next(); reset(); });

    // 3秒自动轮播
    function start() { timer = setInterval(next, 3000); }
    function reset() { if (timer) clearInterval(timer); start(); }

    // 鼠标悬停暂停
    const stage = document.querySelector('.stage');
    if (stage) {
      stage.addEventListener('mouseenter', () => { if (timer) clearInterval(timer); });
      stage.addEventListener('mouseleave', () => { start(); });
    }

    // 键盘左右
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { prev(); reset(); }
      else if (e.key === 'ArrowRight') { next(); reset(); }
    });

    start();
  });

  // 返回顶部
  (function() {
    var btn = document.getElementById('to-top');
    if (!btn) return;
    function onScroll() {
      if (window.scrollY > 400) btn.classList.add('show');
      else btn.classList.remove('show');
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    btn.addEventListener('click', function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    onScroll();
  })();
</script>
