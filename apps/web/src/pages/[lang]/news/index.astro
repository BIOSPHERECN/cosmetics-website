---
/**
 * 行业资讯列表 —— /{lang}/news/
 * 全部条目为 AI 改写的原创快讯(转述+点评,注明信息来源),不转载原文。
 * 内容存 zh/en 双语,其余语种回退英文 —— 与法务页同一策略。
 */
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { env } from 'cloudflare:workers';
import { pageShell } from '../../../lib/shell';
import { isLang, DEFAULT_LANG, type Lang } from '../../../lib/db';
import { breadcrumbJsonLd, itemListJsonLd } from '../../../lib/jsonld';

export const prerender = false;

const db = (env as any).DB as D1Database | undefined;
const rawLang = Astro.params.lang ?? DEFAULT_LANG;
const lang: Lang = (isLang(rawLang) ? rawLang : DEFAULT_LANG) as Lang;
const zh = lang === 'zh-cn' || lang === 'zh-tw';

const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const base = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;
const path = `/${lang}/news/`;

const page = Math.max(1, Number(Astro.url.searchParams.get('p')) || 1);
const PER = 24;   // 3列(24=8行)与4列(24=6行)都整除 —— 创始人抓到尾行缺一格

/* 分类 + 排序(创始人:「版块分类别」「排序按照综合、日期、热度」)。
   综合 = 按天倒序、同一天内热度高的在前 —— 新鲜优先但让好内容冒头;
   日期 = 纯时间轴;热度 = 浏览量。全部白名单校验,不信查询串。 */
const TOPICS = ['ingredient', 'tech', 'product', 'brand', 'regulation', 'industry'];
const topicQ = Astro.url.searchParams.get('topic') ?? '';
const topic = TOPICS.includes(topicQ) ? topicQ : '';
const sortQ = Astro.url.searchParams.get('sort') ?? '';
const sort = ['date', 'hot'].includes(sortQ) ? sortQ : 'mix';
const ORDER = {
  mix: `date(COALESCE(orig_date, published_at)) DESC, views DESC, id DESC`,
  date: `COALESCE(orig_date, published_at) DESC, id DESC`,
  hot: `views DESC, COALESCE(orig_date, published_at) DESC`,
}[sort];

const W = `WHERE is_published = 1${topic ? ' AND topic = ?' : ''}`;
const bindW = topic ? [topic] : [];
const total = db ? ((await db.prepare(`SELECT COUNT(*) n FROM news ${W}`).bind(...bindW).first<{ n: number }>())?.n ?? 0) : 0;
const { results: cnts } = db ? await db.prepare(
  `SELECT topic, COUNT(*) n FROM news WHERE is_published = 1 GROUP BY topic`,
).all<{ topic: string; n: number }>() : { results: [] as any[] };
const cnt = Object.fromEntries((cnts ?? []).map((x) => [x.topic, x.n]));
const allCnt = Object.values(cnt).reduce((a: number, b: any) => a + b, 0);

const { results: rows } = db ? await db.prepare(
  `SELECT slug, topic, title_zh, title_en, summary_zh, summary_en, source_name, views, cover_media,
          COALESCE(orig_date, published_at) AS published_at
     FROM news ${W}
    ORDER BY ${ORDER} LIMIT ? OFFSET ?`,
).bind(...bindW, PER, (page - 1) * PER).all<any>() : { results: [] as any[] };

const pages = Math.max(1, Math.ceil(total / PER));
const qs = (over: Record<string, string | number>) => {
  const u = new URLSearchParams();
  const merged = { topic, sort: sort === 'mix' ? '' : sort, p: '', ...over };
  for (const [k, v] of Object.entries(merged)) if (v !== '' && v !== 1 && v !== '1') u.set(k, String(v));
  const s = u.toString();
  return `/${lang}/news/${s ? '?' + s : ''}`;
};
/* 页码窗口:当前页 ±2,首尾恒显 */
const pageNums = [...new Set([1, pages,
  ...[page - 2, page - 1, page, page + 1, page + 2].filter((n) => n >= 1 && n <= pages)])].sort((a, b) => a - b);
const list = (rows ?? []).map((r: any) => ({
  slug: r.slug, topic: r.topic, source: r.source_name, date: String(r.published_at ?? '').slice(0, 10),
  cover: r.cover_media ? '/media/' + r.cover_media : '',
  title: (zh ? r.title_zh : r.title_en) || r.title_en || r.title_zh,
  summary: (zh ? r.summary_zh : r.summary_en) || r.summary_en || r.summary_zh || '',
}));

const TOPIC: Record<string, string> = zh
  ? { ingredient: '新原料', tech: '新技术', product: '爆款观察', brand: '品牌动态', regulation: '法规', industry: '行业' }
  : { ingredient: 'Ingredients', tech: 'Technology', product: 'Products', brand: 'Brands', regulation: 'Regulation', industry: 'Industry' };
const T = zh
  ? { h1: '行业资讯', lead: '化妆品行业的新原料、新技术、爆款与品牌动态 —— AI 编辑每日精选改写,注明信息来源。', empty: '资讯整理中,稍后再来。', src: '信息来源',
      all: '全部', sortLabel: '排序', mix: '综合', byDate: '日期', hot: '热度', prev: '上一页', next: '下一页',
      trendsK: '海外爆款调研',
      trendsV: '12 个市场 × 5 个品类,按国家分开跑 —— 美国、印尼、泰国、越南、菲律宾、马来西亚、新加坡、日本、韩国、中东、巴西、欧洲。每条都带可点开的原始链接,不写没出处的销量。',
      trendsC: '按国家查看 →' }
  : { h1: 'Industry News', lead: 'Ingredients, technology, hero products and brand moves in beauty — daily AI-curated briefs with sources cited.', empty: 'Briefs are being prepared.', src: 'Source',
      all: 'All', sortLabel: 'Sort', mix: 'Featured', byDate: 'Date', hot: 'Popular', prev: 'Prev', next: 'Next',
      trendsK: 'Overseas bestseller research',
      trendsV: '12 markets x 5 categories, run country by country — US, Indonesia, Thailand, Vietnam, Philippines, Malaysia, Singapore, Japan, Korea, Middle East, Brazil, Europe. Every entry carries the original link; no sales figures without a source.',
      trendsC: 'Browse by country →' };

const jsonLd = [
  breadcrumbJsonLd(base, lang, path, zh ? '首页' : 'Home', [{ label: T.h1, href: path }]),
  itemListJsonLd(base, lang, list.map((n) => ({ slug: `news/${n.slug}`, name: n.title }))),
];
---

<BaseLayout
  locale={lang}
  school={shell.variant?.school ?? 'atelier'}
  variant={shell.site?.variant ?? 'v1'}
  brand={shell.site?.id ?? 'biosphere-ai'}
  title={T.h1}
  description={T.lead}
  siteName={shell.site?.name ?? '帛卉'}
  siteUrl={base}
  path={path}
  indexable={shell.site?.is_live === 1}
  brandColor={shell.site?.brand_color}
  theme={(shell.site as any)?.theme ?? 'noir'}
  jsonLd={jsonLd}
>
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'}
              siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />

  <main id="main" class="nw">
    <div class="ck-wrap">
      <header class="hd">
        <h1>{T.h1}</h1>
        <p class="lead">{T.lead}</p>
      </header>

      {/* 创始人 2026-09-10:「新闻版块加 1 个各大海外电商平台爆款调研,分国家分开执行」。
          放在分类项圈**上面**:它不是又一条资讯,是一整套按国家分的调研,
          客户从资讯页进来第一眼就该看见入口。 */}
      <a class="trends" href={`/${lang}/trends/`}>
        <span class="tk">{T.trendsK}</span>
        <span class="tv">{T.trendsV}</span>
        <span class="tc">{T.trendsC}</span>
      </a>

      {/* 分类项圈 + 排序切换 —— 都是链接不是脚本,SEO 每个组合都是可收录 URL */}
      <nav class="bar" aria-label={T.all}>
        <div class="cats">
          <a class:list={['chip', { on: !topic }]} href={qs({ topic: '', p: '' })}>{T.all}（{allCnt}）</a>
          {TOPICS.filter((t) => cnt[t]).map((t) => (
            <a class:list={['chip', { on: topic === t }]} href={qs({ topic: t, p: '' })}>{TOPIC[t]}（{cnt[t]}）</a>
          ))}
        </div>
        <div class="sorts">
          <span class="sl">{T.sortLabel}</span>
          <a class:list={['chip', 'sm', { on: sort === 'mix' }]} href={qs({ sort: '', p: '' })}>{T.mix}</a>
          <a class:list={['chip', 'sm', { on: sort === 'date' }]} href={qs({ sort: 'date', p: '' })}>{T.byDate}</a>
          <a class:list={['chip', 'sm', { on: sort === 'hot' }]} href={qs({ sort: 'hot', p: '' })}>{T.hot}</a>
          {/* 视图与字号:纯本地偏好,localStorage 记住(创始人:「版块和列表的方式,还有字体调整」) */}
          <span class="divider" aria-hidden="true"></span>
          <button type="button" class="chip sm" id="vw-card" title={zh ? '卡片视图' : 'Card view'}>▦</button>
          <button type="button" class="chip sm" id="vw-list" title={zh ? '列表视图' : 'List view'}>☰</button>
          <span class="divider" aria-hidden="true"></span>
          <button type="button" class="chip sm" id="fs-minus" title={zh ? '缩小字号' : 'Smaller text'}>A−</button>
          <button type="button" class="chip sm" id="fs-plus" title={zh ? '放大字号' : 'Larger text'}>A＋</button>
        </div>
      </nav>

      {list.length === 0 ? (
        <p class="empty">{T.empty}</p>
      ) : (
        <div class="grid" id="nw-grid" data-reveal="stagger">
          {list.map((n) => (
            <a class="card" href={`/${lang}/news/${n.slug}/`}>
              <div class="pic">
                {n.cover
                  ? <img src={n.cover} alt="" loading="lazy" decoding="async" />
                  : <div class={`ph ph-${n.topic}`} aria-hidden="true"><span>{TOPIC[n.topic] ?? ''}</span></div>}
              </div>
              <div class="cbody">
                <div class="meta">
                  <span class="topic">{TOPIC[n.topic] ?? n.topic}</span>
                  <time>{n.date}</time>
                </div>
                <h2>{n.title}</h2>
                {n.summary && <p class="sum">{n.summary}</p>}
                <span class="srcline">{T.src}:{n.source}</span>
              </div>
            </a>
          ))}
        </div>
      )}

      {/* 页码分页:上一页 · 1 … n-1 n n+1 … N · 下一页,窗口外用省略号 */}
      {pages > 1 && (
        <nav class="pager" aria-label="pagination">
          {page > 1 && <a class="chip" href={qs({ p: page - 1 })}>{T.prev}</a>}
          {pageNums.map((n, i) => (
            <>
              {i > 0 && pageNums[i - 1] < n - 1 && <span class="gap">…</span>}
              {n === page
                ? <span class="chip on">{n}</span>
                : <a class="chip" href={qs({ p: n })}>{n}</a>}
            </>
          ))}
          {page < pages && <a class="chip" href={qs({ p: page + 1 })}>{T.next}</a>}
        </nav>
      )}
    </div>
  </main>

  <script is:inline>
    /* 视图与字号偏好:localStorage 记忆,纯前端不动 URL(SEO 的分类/排序才走 URL) */
    (() => {
      const grid = document.getElementById('nw-grid');
      const main = document.querySelector('main.nw');
      const K = { view: 'nw-view', fs: 'nw-fs' };
      const applyView = (v) => {
        grid?.classList.toggle('as-list', v === 'list');
        document.getElementById('vw-card')?.classList.toggle('on', v !== 'list');
        document.getElementById('vw-list')?.classList.toggle('on', v === 'list');
      };
      const applyFs = (f) => { if (main) main.dataset.fs = f; };
      let view = 'card', fs = 'm';
      try { view = localStorage.getItem(K.view) || 'card'; fs = localStorage.getItem(K.fs) || 'm'; } catch {}
      applyView(view); applyFs(fs);
      document.getElementById('vw-card')?.addEventListener('click', () => { view = 'card'; applyView(view); try { localStorage.setItem(K.view, view); } catch {} });
      document.getElementById('vw-list')?.addEventListener('click', () => { view = 'list'; applyView(view); try { localStorage.setItem(K.view, view); } catch {} });
      const order = ['s', 'm', 'l'];
      const step = (d) => { fs = order[Math.min(2, Math.max(0, order.indexOf(fs) + d))]; applyFs(fs); try { localStorage.setItem(K.fs, fs); } catch {} };
      document.getElementById('fs-minus')?.addEventListener('click', () => step(-1));
      document.getElementById('fs-plus')?.addEventListener('click', () => step(1));
    })();
  </script>

  <SiteFooter locale={lang} path={path}
              site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any}
              siblings={[]} email={shell.email} nav={shell.nav} />
</BaseLayout>

<style>
  /* 爆款调研入口 —— 一整块可点,手机上整卡都是热区(44px 以上) */
  .trends {
    display: grid; gap: .5rem; margin: 0 0 1.5rem;
    padding: 1.125rem 1.25rem; border: 1px solid var(--ck-line, rgba(0,0,0,.12));
    border-radius: 14px; text-decoration: none; color: inherit;
    background: var(--ck-paper, rgba(0,0,0,.02));
  }
  .trends:hover { border-color: var(--ck-ink, rgba(0,0,0,.4)); }
  .trends .tk { font-size: 1.0625rem; font-weight: 600; letter-spacing: .01em; }
  .trends .tv { font-size: .9375rem; line-height: 1.65; opacity: .78; }
  .trends .tc { font-size: .875rem; font-weight: 600; }
  @media (min-width: 900px) { .trends { padding: 1.25rem 1.5rem; } }

  .nw { background: var(--ck-bg); padding-block: 3rem 4rem; }
  .hd { max-width: var(--ck-maxw-prose); margin-bottom: 2rem; }
  .lead { color: var(--ck-ink-soft); margin-top: 0.75rem; }
  .empty { color: var(--ck-ink-faint); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: var(--ck-gap); }
  .card {
    display: flex; flex-direction: column;
    background: var(--ck-surface); border: var(--ck-border-w) solid var(--ck-line);
    border-radius: var(--ck-radius-lg); overflow: hidden;
    text-decoration: none; color: var(--ck-ink);
    transition: border-color var(--ck-dur) var(--ck-ease), transform var(--ck-dur) var(--ck-ease);
  }
  .card:hover { border-color: var(--ck-line-strong); transform: translateY(-2px); }
  .pic { aspect-ratio: 3 / 2; background: var(--ck-surface-alt); }
  .pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* 无封面占位:配图工到位前不能是一片「空白」(创始人点名)。
     每个主题一个色系 + 同心圆纹理 + 大号主题字浮印 —— 是设计,不是空缺 */
  .pic .ph { width: 100%; height: 100%; display: grid; place-items: center; position: relative; overflow: hidden;
    background:
      radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--ph-c, var(--ck-accent)) 32%, transparent), transparent 55%),
      radial-gradient(circle at 15% 85%, color-mix(in srgb, var(--ph-c, var(--ck-accent)) 20%, transparent), transparent 50%),
      repeating-radial-gradient(circle at 82% 18%, transparent 0 26px, color-mix(in srgb, var(--ph-c, var(--ck-accent)) 9%, transparent) 26px 27px),
      color-mix(in srgb, var(--ph-c, var(--ck-accent)) 7%, var(--ck-surface-alt)); }
  .pic .ph span { font-size: 2rem; font-weight: 700; letter-spacing: 0.35em; padding-inline-start: 0.35em;
    color: color-mix(in srgb, var(--ph-c, var(--ck-accent)) 42%, var(--ck-surface)); user-select: none; }
  .ph-ingredient { --ph-c: #4a6b3a; }
  .ph-tech       { --ph-c: #2b5d8a; }
  .ph-product    { --ph-c: #b0703c; }
  .ph-brand      { --ph-c: #7a4a72; }
  .ph-regulation { --ph-c: #8a5a00; }
  .ph-industry   { --ph-c: #0e6b62; }
  .cbody { display: flex; flex-direction: column; gap: 0.5rem; padding: 1rem 1.25rem 1.125rem; flex: 1; }

  /* 列表视图:图左文右的横排行(创始人:「版块和列表的方式」) */
  .grid.as-list { grid-template-columns: 1fr; gap: 0.75rem; }
  .grid.as-list .card { flex-direction: row; align-items: stretch; }
  .grid.as-list .pic { width: 13rem; min-width: 13rem; aspect-ratio: auto; }
  .grid.as-list .cbody { padding: 0.875rem 1.25rem; }
  @media (max-width: 40rem) { .grid.as-list .pic { width: 7.5rem; min-width: 7.5rem; } }

  /* 字号调节:三档,作用于卡片正文族 */
  .nw[data-fs='s'] .card h2 { font-size: 0.9375rem; }
  .nw[data-fs='s'] .sum { font-size: max(0.75rem, 14px); }
  .nw[data-fs='l'] .card h2 { font-size: 1.25rem; }
  .nw[data-fs='l'] .sum { font-size: 1rem; }
  .divider { width: 1px; height: 1.125rem; background: var(--ck-line); margin-inline: 0.25rem; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; font-size: max(0.75rem, 14px); color: var(--ck-ink-faint); }
  .topic { color: var(--ck-accent); font-weight: 600; letter-spacing: 0.04em; }
  .card h2 { font-size: 1.0625rem; line-height: 1.45; margin: 0; }
  .sum { font-size: var(--ck-small); color: var(--ck-ink-soft); line-height: 1.65; margin: 0; }
  .srcline { margin-top: auto; font-size: max(0.6875rem, 14px); color: var(--ck-ink-faint); }
  .bar { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; align-items: center;
         justify-content: space-between; margin-bottom: 1.5rem; }
  .cats, .sorts { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .sl { font-size: max(0.75rem, 14px); color: var(--ck-ink-faint); }
  .pager { margin-top: 2.25rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .gap { color: var(--ck-ink-faint); }
  .chip { display: inline-block; padding: 0.4375rem 0.9375rem; border: 1px solid var(--ck-line); border-radius: 999px;
          text-decoration: none; color: var(--ck-ink-soft); font-size: var(--ck-small); }
  .chip.sm { padding: 0.3125rem 0.75rem; font-size: max(0.75rem, 14px); }
  .chip.on { background: var(--ck-accent); border-color: var(--ck-accent); color: var(--ck-on-accent); }
  .chip:not(.on):hover { border-color: var(--ck-accent); color: var(--ck-accent); }
</style>
