---
import { siteIdForHost } from '@cosmetic/core/content/tenant-map.ts';
import { t as uiT } from '@cosmetic/core/i18n';
/** 全球化妆品品牌目标清单 —— 创始人 2026-09-11 12:1x:「收集全球 100 家优秀的化妆品品牌的站点、联系方式、联系人、更深入的解读、流量数据、年营业额背调」;「用于下午的展示,后面会隐藏」。
 *  17:0x 追加:「要有官网月访问量等多维数据;是否本土生产或 OEM/ODM 要深入调研;先用第三方角度专业分析,别和帛卉结合,否则会缩小了解面」。
 *  只放公开可查的:官网、母公司、上市与否、公开营收(带年份与来源,不估算)、Similarweb 公开页的月访问量与排名(标来源与月份)、官网公开的企业联系渠道、公开报道的高管、
 *  生产模式(自产/代工,附证据来源)、渠道、价格带、融资、第三方视角分析、合作角度(中性,不提我们)。数据在 D1 brand_leads,`tools/brand-leads-load.py` + `tools/brand-enrich-load.py` 灌。 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../../lib/shell';
export const prerender = false;
const lang = Astro.params.lang ?? 'zh-cn'; const zh = lang.startsWith('zh');
const db = (env as any).DB as D1Database | undefined; const tSkip = uiT(lang as any)('a11y.skip');
const url = new URL(Astro.url); const fC = (url.searchParams.get('c') ?? '').slice(0, 30); const fM = (url.searchParams.get('m') ?? '').slice(0, 10);
/* 分页:600+ 张卡一次全出是 1.3 MB,国内打开要一秒多(创始人:「切换有点慢,优化国内访问速度」);60 张一页 */
const PER = 60; const pg = Math.max(1, parseInt(url.searchParams.get('p') ?? '1') || 1);
let rows: any[] = [];
if (db) { try { rows = ((await db.prepare('SELECT * FROM brand_leads ORDER BY COALESCE(country_zh, country), name').all<any>()).results ?? []) as any[]; } catch { rows = []; } }
const cname = (r: any) => (zh && r.country_zh) ? r.country_zh : String(r.country);
const countries = [...new Set(rows.map(cname))].sort();
const MFG: Record<string, [string, string]> = { 'in-house': ['自有工厂生产', 'In-house'], contract: ['委托代工 OEM/ODM', 'Contract manufacturing'], hybrid: ['自产 + 代工', 'Hybrid'], unknown: ['生产方式未披露', 'Not disclosed'] };
const TIER: Record<string, [string, string]> = { mass: ['大众', 'Mass'], masstige: ['轻奢', 'Masstige'], prestige: ['高端', 'Prestige'], luxury: ['奢侈', 'Luxury'] };
const mfgOf = (r: any) => (r.mfg_model && MFG[r.mfg_model]) ? r.mfg_model : '';
const byC = fC ? rows.filter((r) => cname(r) === fC) : rows;
const all = fM ? byC.filter((r) => mfgOf(r) === fM) : byC;
const pages = Math.max(1, Math.ceil(all.length / PER)); const shown = all.slice((pg - 1) * PER, pg * PER);
const qs = (o: Record<string, string | number>) => { const p = new URLSearchParams(); if (o.c) p.set('c', String(o.c)); if (o.m) p.set('m', String(o.m)); if (o.p && Number(o.p) > 1) p.set('p', String(o.p)); const s = p.toString(); return s ? `?${s}` : ''; };
/* 中文页读 *_zh 列(Agnes 译,tools/brand-leads-zh.py),没有译文时回退英文 */
const Z = (r: any, k: string) => (zh && r[k + '_zh']) ? r[k + '_zh'] : (r[k] ?? '');
const L = (a: [string, string]) => zh ? a[0] : a[1];
const enriched = rows.filter((r) => r.enriched_at).length; const withTraffic = rows.filter((r) => r.visits_month).length;
const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const B = `/${lang}`; const path = `${B}/brands/`; const origin = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;
const T = zh ? { eyebrow: '市场 · 获客', title: `全球化妆品品牌目标清单 · ${rows.length} 家`, lede: '第三方视角逐家看:官网月访问量与排名、母公司与上市情况、公开营收与融资、销售渠道与价格带、自产还是委托代工(附证据)、公开的企业联系渠道与负责人、分析师式解读与合作角度。', note: `只写公开可查的:营收带年份与来源、不估算;流量取 Similarweb 公开页(标月份);生产方式以官网/报道原话为证据。多维补充已完成 ${enriched} 家,其中 ${withTraffic} 家有 Similarweb 月访问量;其余是 Similarweb 公开页不显示的小站,不估算。生产方式只认官网、维基与法定制造商披露,查不到的标「未披露」。`, all: '全部', site: '官网', parent: '母公司', listed: '上市', founded: '成立', cat: '品类', rev: '营收', fund: '融资', chan: '渠道', contact: '联系渠道', exec: '负责人', mfg: '生产方式', made: '产地', ana: '第三方分析', coop: '合作角度', src: '来源', empty: '整理中。', style: '独立站风格', conv: '转化打法', borrow: '可借鉴', fit: '适配度', visits: '月访问量', rank: '全球排名', crank: '本国排名', krank: '类目排名', bounce: '跳出率', ppv: '页/访', dur: '停留', geo: '主要地区', srcT: '主要来源', mfgAll: '全部生产方式', pending: '多维数据补充中' }
             : { eyebrow: 'Market · buyers', title: `Global cosmetic brand target list · ${rows.length}`, lede: 'Third-party view of each brand: monthly site visits and ranks, parent and listing, public revenue and funding, channels and price tier, in-house vs contract manufacturing (with evidence), public corporate contacts and leaders, analyst-style read and partnership angles.', note: `Public facts only: revenue with year and source, never estimated; traffic from Similarweb public pages (month shown); manufacturing model backed by official or press wording. Enrichment done for ${enriched} brands, ${withTraffic} with Similarweb monthly visits; the rest are small sites whose figure Similarweb does not show, never estimated. Manufacturing model only from official sites, Wikipedia or legally required manufacturer disclosures; otherwise marked not disclosed.`, all: 'All', site: 'Site', parent: 'Parent', listed: 'Listed', founded: 'Founded', cat: 'Category', rev: 'Revenue', fund: 'Funding', chan: 'Channels', contact: 'Contact', exec: 'Leaders', mfg: 'Manufacturing', made: 'Made in', ana: 'Analyst view', coop: 'Partnership angles', src: 'Sources', empty: 'Being compiled.', style: 'Site style', conv: 'Conversion play', borrow: 'Worth borrowing', fit: 'Fit', visits: 'Monthly visits', rank: 'Global rank', crank: 'Country rank', krank: 'Category rank', bounce: 'Bounce', ppv: 'Pages/visit', dur: 'Duration', geo: 'Top regions', srcT: 'Top source', mfgAll: 'Any manufacturing', pending: 'Enrichment pending' };
const num = (v: any) => { const s = String(v ?? ''); const m = s.match(/^\d+/); return m ? Number(m[0]).toLocaleString('en-US') + s.slice(m[0].length) : s; };
---
<BaseLayout locale={lang} school={shell.variant?.school ?? 'atelier'} variant={shell.site?.variant ?? 'v1'} brand={shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai'}
  title={T.title} description={T.lede} siteName={shell.site?.name ?? '帛卉'} siteUrl={origin} path={path} indexable={false} brandColor={shell.site?.brand_color} theme={shell.site?.theme ?? 'noir'}>
  <a class="ck-skip-link" href="#main">{tSkip}</a>
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'} siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />
  <main id="main">
    <header class="hd"><p class="eyebrow">{T.eyebrow}</p><h1>{T.title}</h1><p class="lede">{T.lede}</p><p class="note">{T.note}</p></header>
    <nav class="tabs"><a class:list={['chip', { on: !fC }]} href={path + qs({ m: fM })}>{T.all} <i>{rows.length}</i></a>{countries.map((c) => <a class:list={['chip', { on: fC === c }]} href={path + qs({ c, m: fM })}>{c} <i>{rows.filter((r) => cname(r) === c).length}</i></a>)}</nav>
    <nav class="tabs sub"><a class:list={['chip', { on: !fM }]} href={path + qs({ c: fC })}>{T.mfgAll} <i>{byC.length}</i></a>{Object.keys(MFG).map((m) => <a class:list={['chip', { on: fM === m }]} href={path + qs({ c: fC, m })}>{L(MFG[m])} <i>{byC.filter((r) => mfgOf(r) === m).length}</i></a>)}</nav>
    {shown.length === 0 && <p class="lede">{T.empty}</p>}
    {pages > 1 && <nav class="pager">{Array.from({ length: pages }, (_, i) => i + 1).map((n) => <a class:list={['pg', { on: n === pg }]} href={path + qs({ c: fC, m: fM, p: n })}>{n}</a>)}</nav>}
    <ul class="cards">{shown.map((r) => { const srcs: string[] = (() => { try { return [...JSON.parse(r.sources_json || '[]'), ...JSON.parse(r.enrich_sources || '[]')].filter((s: any) => typeof s === 'string' && s.startsWith('http')); } catch { return []; } })(); const m = mfgOf(r); return (
      <li class="card">
        <p class="who">{cname(r)}{Z(r, 'hq_city') ? ` · ${Z(r, 'hq_city')}` : ''} · {Z(r, 'category')}</p>
        <h2>{String(r.name).length > 30 ? String(r.name).slice(0, 30) + '…' : r.name} {r.website && <a class="site" href={r.website} rel="noopener nofollow" target="_blank">{T.site} ↗</a>}</h2>
        <p class="tags">{r.price_tier && TIER[r.price_tier] && <span class="tag">{L(TIER[r.price_tier])}</span>}{m && <span class:list={['tag', m]}>{L(MFG[m])}</span>}{!r.enriched_at && <span class="tag dim">{T.pending}</span>}</p>
        {r.visits_month && <ul class="kpi">
          <li><b>{r.visits_month}</b><span>{T.visits}{r.visits_period ? ` · ${r.visits_period}` : ''}</span></li>
          {r.rank_global && <li><b>#{num(r.rank_global)}</b><span>{T.rank}</span></li>}
          {r.rank_category && <li><b>#{num(r.rank_category)}</b><span>{T.krank}</span></li>}
          {r.bounce && <li><b>{r.bounce}</b><span>{T.bounce}</span></li>}
          {r.pages_visit && <li><b>{r.pages_visit}</b><span>{T.ppv}</span></li>}
          {r.duration && <li><b>{r.duration}</b><span>{T.dur}</span></li>}
        </ul>}
        {r.visits_month && (Z(r, 'top_geo') || Z(r, 'top_source')) && <p class="geo">{Z(r, 'top_geo') && <>{T.geo}:{Z(r, 'top_geo')}</>}{Z(r, 'top_geo') && Z(r, 'top_source') && ' · '}{Z(r, 'top_source') && <>{T.srcT}:{Z(r, 'top_source')}</>}</p>}
        <p class="pos">{Z(r, 'positioning')}</p>
        <dl>
          {Z(r, 'parent') && (<><dt>{T.parent}</dt><dd>{Z(r, 'parent')}{r.listed && !/^private$/i.test(r.listed) ? ` · ${r.listed}` : ''}{r.founded ? ` · ${T.founded} ${r.founded}` : ''}</dd></>)}
          {Z(r, 'revenue') && (<><dt>{T.rev}</dt><dd>{Z(r, 'revenue')}</dd></>)}
          {Z(r, 'funding') && (<><dt>{T.fund}</dt><dd>{Z(r, 'funding')}</dd></>)}
          {Z(r, 'channels') && (<><dt>{T.chan}</dt><dd>{Z(r, 'channels')}</dd></>)}
          {(m || Z(r, 'manufacturing')) && (<><dt>{T.mfg}</dt><dd>{m ? L(MFG[m]) : ''}{Z(r, 'mfg_country') ? ` · ${T.made} ${Z(r, 'mfg_country')}` : ''}{Z(r, 'mfg_evidence') ? ` — ${Z(r, 'mfg_evidence')}` : (!m && Z(r, 'manufacturing') ? Z(r, 'manufacturing') : '')}</dd></>)}
          {Z(r, 'contact') && (<><dt>{T.contact}</dt><dd class="wrap">{Z(r, 'contact')}</dd></>)}
          {Z(r, 'executives') && (<><dt>{T.exec}</dt><dd>{Z(r, 'executives')}</dd></>)}
          {Z(r, 'analysis') && (<><dt>{T.ana}</dt><dd>{Z(r, 'analysis')}</dd></>)}
          {Z(r, 'coop_angles') && (<><dt>{T.coop}</dt><dd><b>{Z(r, 'coop_angles')}</b></dd></>)}
          {r.style_school && (<><dt>{T.style}</dt><dd>{r.style_school}{r.visual ? ` · ${r.visual}` : ''}{r.platform ? ` · ${r.platform}` : ''}</dd></>)}
          {r.conversion && (<><dt>{T.conv}</dt><dd>{r.conversion}{r.social ? ` · ${r.social}` : ''}</dd></>)}
          {r.borrow && (<><dt>{T.borrow}</dt><dd>{r.borrow}{r.fit ? ` · ${T.fit} ${r.fit}` : ''}</dd></>)}
        </dl>
        {srcs.length > 0 && <p class="srcs">{T.src}: {srcs.slice(0, 8).map((s, i) => <a href={s} rel="noopener nofollow" target="_blank">{i + 1}</a>)}</p>}
      </li>); })}</ul>
    {pages > 1 && <nav class="pager">{Array.from({ length: pages }, (_, i) => i + 1).map((n) => <a class:list={['pg', { on: n === pg }]} href={path + qs({ c: fC, m: fM, p: n })}>{n}</a>)}</nav>}
  </main>
  <SiteFooter locale={lang} path={path} site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any} siblings={[]} email={shell.email} nav={shell.nav} />
</BaseLayout>
<style>
  main { max-width: 112.5rem; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
  .hd { display: grid; gap: .75rem; margin-bottom: 1.25rem; max-width: 62rem; } .eyebrow { font-size: .8125rem; letter-spacing: .12em; text-transform: uppercase; opacity: .6; margin: 0; }
  h1 { font-size: clamp(1.625rem, 3vw, 2.25rem); line-height: 1.24; margin: 0; } .lede { font-size: 1rem; line-height: 1.75; opacity: .85; margin: 0; } .note { font-size: .875rem; opacity: .62; margin: 0; border-left: 2px solid currentColor; padding-left: .75rem; }
  .tabs { display: flex; flex-wrap: wrap; gap: .375rem; margin: 0 0 .75rem; } .tabs.sub { margin-bottom: 1.25rem; } .chip { min-height: 40px; display: inline-flex; align-items: center; gap: .375rem; padding: 0 .75rem; font-size: .875rem; border-radius: 999px; text-decoration: none; color: inherit; border: 1px solid var(--ck-line, rgba(0,0,0,.16)); } .chip i { font-style: normal; opacity: .6; } .chip.on { background: var(--ck-ink, #111); color: var(--ck-paper, #fff); }
  .sub .chip { min-height: 34px; font-size: .8125rem; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; } .card { padding: 1rem 1.125rem; border: 1px solid var(--ck-line, rgba(0,0,0,.12)); border-radius: 12px; }
  .who { margin: 0; font-size: .8125rem; opacity: .6; } .card h2 { font-size: 1.125rem; margin: .125rem 0 .375rem; } .site { font-size: .8125rem; font-weight: 400; margin-left: .5rem; } .pos { margin: 0 0 .625rem; font-size: .9375rem; line-height: 1.6; }
  .tags { margin: 0 0 .5rem; display: flex; flex-wrap: wrap; gap: .3rem; } .tag { font-size: .75rem; padding: .15rem .55rem; border-radius: 999px; border: 1px solid var(--ck-line, rgba(0,0,0,.16)); } .tag.contract { background: #ecebfa; border-color: #d9d6f3; } .tag.in-house { background: #e8f3ea; border-color: #cfe4d3; } .tag.hybrid { background: #fbf1df; border-color: #efdcb3; } .tag.dim { opacity: .55; border-style: dashed; }
  .kpi { list-style: none; margin: 0 0 .375rem; padding: .5rem .75rem; display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; background: var(--ck-paper-2, rgba(0,0,0,.035)); border-radius: 8px; } .kpi li { display: grid; line-height: 1.25; } .kpi b { font-size: 1.0625rem; font-variant-numeric: tabular-nums; } .kpi span { font-size: .6875rem; opacity: .6; }
  .geo { margin: 0 0 .625rem; font-size: .8125rem; opacity: .7; }
  .card dl { margin: 0; display: grid; grid-template-columns: 1fr; gap: .2rem; } .card dt { font-size: .8125rem; opacity: .55; } .card dd { margin: 0 0 .4rem; font-size: .9rem; line-height: 1.65; } .wrap { word-break: break-all; }
  .pager { display: flex; flex-wrap: wrap; gap: .375rem; margin: 1rem 0; } .pg { min-width: 2.5rem; min-height: 2.5rem; display: inline-grid; place-items: center; border: 1px solid var(--ck-line, rgba(0,0,0,.16)); border-radius: 8px; text-decoration: none; color: inherit; font-variant-numeric: tabular-nums; } .pg.on { background: var(--ck-ink, #111); color: var(--ck-paper, #fff); }
  .srcs { font-size: .8125rem; opacity: .7; margin: .5rem 0 0; } .srcs a { margin-right: .5rem; }
  @media (min-width: 900px) { main { padding: 2rem 1.5rem 4rem; } .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .card dl { grid-template-columns: 6rem 1fr; gap: .2rem .75rem; align-items: baseline; } }
  @media (min-width: 1400px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
