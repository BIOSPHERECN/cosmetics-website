---
import { siteIdForHost } from '@cosmetic/core/content/tenant-map.ts';
import { t as uiT } from '@cosmetic/core/i18n';
/** 古方单页 —— 创始人 2026-09-11 22:0x「各国的是不是单独链接,是不是更利于 GEO」「你朝着必须引入 GEO 和 SEO 流量奋斗」。
 *  一方一页、一页一问:标题是买手/品牌方真会问的整句,首段 100 字内直答,数字与药味全从 classics 表来。
 *  只给抽检确认与 v2 主候选(ok=1,人工核过的 31 方)建单页 —— 候选表里混着整段抽出来的噪音(勿多饮 / 切豬油),不能一方一页放出去;含铅汞砒等禁用组分的方更不建。红线不变:只列药味不列剂量;每页都标「古籍记载,非功效宣称」。
 *  古籍内容只有中文,只在中文语种下出页;其他语种 404、不进站点地图,免得外国访客看到整页中文。 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../../lib/shell';
export const prerender = false;
const lang = Astro.params.lang ?? 'zh-cn'; const zh = lang.startsWith('zh');
const id = parseInt(String(Astro.params.id ?? ''), 10);
const db = (env as any).DB as D1Database | undefined; const tSkip = uiT(lang as any)('a11y.skip');
if (!zh || !Number.isFinite(id) || id <= 0) return new Response(null, { status: 404 });
let r: any = null; let sibs: any[] = [];
if (db) {
  try {
    r = await db.prepare("SELECT * FROM classics WHERE id = ? AND ok = 1").bind(id).first<any>();
    if (r) sibs = ((await db.prepare("SELECT id, name, book, modern FROM classics WHERE ok = 1 AND id <> ? AND (book = ? OR modern = ?) ORDER BY CASE tier WHEN 'confirmed' THEN 0 WHEN 'primary' THEN 1 ELSE 2 END, id LIMIT 8").bind(id, r.book ?? '', r.modern ?? '').all<any>()).results ?? []) as any[];
  } catch { r = null; }
}
if (!r) return new Response(null, { status: 404 });
const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const B = `/${lang}`; const path = `${B}/classics/${id}/`; const origin = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;
const TIER: Record<string, string> = { confirmed: '抽检确认可用', primary: '主候选', candidate: '外用美容方 · 无禁用组分' };
const herbs = String(r.composition || '').split(/[、,,;;\s]+/).map((s: string) => s.trim()).filter(Boolean);
const first = (t: string, n: number) => { const x = String(t || '').replace(/\s+/g, ' ').trim(); const cut = x.search(/[。;;.!?]/); const y = cut > 0 ? x.slice(0, cut) : x; return y.length > n ? y.slice(0, n - 1) + '…' : y; };
const purp = first(r.purposes, 30); const ind = first(r.indication, 40);
/* 首段直答:一句话把方、书、用途、药味数、现代对应品类说完,100 字内 */
const answer = `《${r.book || '古籍'}》记载的${r.name}${purp ? `用于${purp}` : ''}${herbs.length ? `,共 ${herbs.length} 味药材(${herbs.slice(0, 6).join('、')}${herbs.length > 6 ? '等' : ''})` : ''}${r.modern ? `;放到今天最像${r.modern}` : ''}。古籍记载,非功效宣称。`;
const title = `${r.name}是什么方?《${r.book || '古籍'}》里的组成药味、用途与今天对应的护肤品类`;
const faq: [string, string][] = [
  [`${r.name}出自哪本书、用来做什么?`, `出自《${r.book || '古籍'}》${r.purposes ? `,古籍记载用于${r.purposes}` : ''}${ind ? `;主治条文:${ind}` : ''}。`],
  [`${r.name}由哪些药材组成?`, herbs.length ? `${herbs.join('、')}(只列药味,不列剂量与煎服法;组成以通行本为准)。` : '本方组成暂未收录。'],
  [`${r.name}能做成今天的化妆品吗?`, `${r.modern ? `从剂型与用法看最像${r.modern}。` : ''}任何复刻都要按目标市场的原料目录与安全技术规范重新评估:每味药材先查各国目录能否使用、限量与标注,再由实验室做稳定性与安全评估${r.note ? `。备注:${r.note}` : ''}。`],
].filter((f) => f[1]);
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${origin}/${lang}/` },
    { '@type': 'ListItem', position: 2, name: '古方库', item: `${origin}${B}/classics/` },
    { '@type': 'ListItem', position: 3, name: r.name, item: origin + path } ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
const rows: [string, string][] = [['出处', r.book], ['用途', r.purposes], ['剂型', r.form], ['组成(只列药味)', r.composition], ['主治条文', r.indication], ['最像今天哪类产品', r.modern], ['等级', r.grade], ['备注', r.note]];
---
<BaseLayout locale={lang} school={shell.variant?.school ?? 'atelier'} variant={shell.site?.variant ?? 'v1'} brand={shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai'}
  title={title} description={answer} siteName={shell.site?.name ?? '帛卉'} siteUrl={origin} path={path}
  indexable={shell.site?.is_live === 1} brandColor={shell.site?.brand_color} theme={shell.site?.theme ?? 'noir'}>
  <a class="ck-skip-link" href="#main">{tSkip}</a>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'} siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />
  <main id="main">
    <p class="back"><a href={`${B}/classics/`}>← 古方库</a></p>
    <header class="hd"><p class="eyebrow">源头 · 原料 · 古方 · {TIER[r.tier] ?? r.tier}</p><h1>{r.name}是什么方?</h1>
      <p class="answer">{answer}</p>
      <p class="note">古籍记载,非功效宣称。组成以通行本为准、只列药味不列剂量与煎服法;任何复刻须按目标市场原料目录与安全技术规范重新评估。</p></header>
    <dl class="facts">{rows.filter((x) => x[1]).map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}</dl>
    {herbs.length > 0 && <section class="herbs"><h2>组成药味 · {herbs.length} 味</h2><ul>{herbs.map((h) => <li><a href={`${B}/graph/?t=${encodeURIComponent(h)}`}>{h}</a></li>)}</ul><p class="muted">点药材名进知识图谱,看它在其它古方里怎么用、各国目录能不能用。</p></section>}
    <section class="faq"><h2>常见问题</h2>{faq.map(([q, a]) => (<details open><summary>{q}</summary><p>{a}</p></details>))}</section>
    {sibs.length > 0 && <section class="sibs"><h2>同书或同类的方</h2><ul>{sibs.map((s) => <li><a href={`${B}/classics/${s.id}/`}>{s.name}</a><span class="muted"> · 《{s.book}》{s.modern ? ` · ${s.modern}` : ''}</span></li>)}</ul></section>}
    <p class="ask">想把这一类古方做成今天的产品?把目标市场和品类发给我们,回你可用药味清单与实验室评估路径。 <a href={`${B}/contact/`}>发起询盘</a></p>
  </main>
  <SiteFooter locale={lang} path={path} site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any} siblings={[]} email={shell.email} nav={shell.nav} />
</BaseLayout>
<style>
  main { max-width: 112.5rem; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
  .back { margin: 0 0 .75rem; font-size: .875rem; } .back a { color: inherit; opacity: .7; text-decoration: none; }
  .hd { display: grid; gap: .75rem; margin-bottom: 1.5rem; max-width: 62rem; } .eyebrow { font-size: .8125rem; letter-spacing: .12em; text-transform: uppercase; opacity: .6; margin: 0; }
  h1 { font-size: clamp(1.5rem, 3vw, 2.125rem); line-height: 1.25; margin: 0; text-wrap: balance; }
  .answer { font-size: 1.0625rem; line-height: 1.7; margin: 0; padding: .75rem 1rem; border-left: 3px solid var(--ck-accent, #7C4DA8); background: rgb(0 0 0/.03); border-radius: 0 10px 10px 0; }
  .note { font-size: .875rem; opacity: .62; margin: 0; }
  .facts { display: grid; grid-template-columns: 1fr; gap: .25rem; margin: 0 0 1.5rem; max-width: 62rem; } .facts dt { font-size: .8125rem; opacity: .55; } .facts dd { margin: 0 0 .5rem; line-height: 1.65; }
  .herbs ul, .sibs ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .375rem; }
  .herbs li a { display: inline-block; padding: .25rem .625rem; border: 1px solid var(--ck-line, rgba(0,0,0,.14)); border-radius: 999px; text-decoration: none; color: inherit; font-size: .875rem; }
  .herbs li a:hover { border-color: var(--ck-accent, #7C4DA8); color: var(--ck-accent, #7C4DA8); }
  .sibs ul { display: grid; gap: .375rem; } .sibs a { text-decoration: none; color: inherit; font-weight: 600; } .sibs a:hover { color: var(--ck-accent, #7C4DA8); }
  h2 { font-size: 1.125rem; margin: 1.5rem 0 .625rem; } .muted { opacity: .65; font-size: .875rem; }
  .faq details { border-top: 1px solid var(--ck-line, rgba(0,0,0,.1)); padding: .625rem 0; } .faq summary { cursor: pointer; font-weight: 600; } .faq p { margin: .5rem 0 0; line-height: 1.7; opacity: .85; }
  .ask { margin: 2rem 0 0; font-size: .9375rem; line-height: 1.7; opacity: .85; max-width: 62rem; }
  @media (min-width: 900px) { main { padding: 2rem 1.5rem 4rem; } .facts { grid-template-columns: 10rem 1fr; gap: .25rem 1rem; align-items: baseline; } }
</style>
