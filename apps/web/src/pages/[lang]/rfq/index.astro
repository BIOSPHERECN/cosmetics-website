---
/**
 * 结构化 RFQ / 样品申请（P0）
 * 必填：市场 / 品类 / 预估量 / 联系方式（邮箱或 WhatsApp）
 * POST /api/inquiry → D1 inquiries + 通知；成功页展示 ticket_id
 * 不自动报价。Turnstile 走 humanGate（配了 TURNSTILE_SECRET 即校验）。
 * 小满映射（获客侧回写）：ticket_id→外部单号；name/company/email/whatsapp；
 * market→国家或城市；category→品类；volume→预估量；product_id→产品编码；
 * target_market / halal_ready / halal_scope_note / notification_assist_country / first_order_band；
 * source=rfq。不自动报价。Halal 只问需求。通告国家是协助，不是代办承诺。
 */
import { siteIdForHost } from '@cosmetic/core/content/tenant-map.ts';
import { t as uiT } from '@cosmetic/core/i18n';
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../../lib/shell';
import { CAT_LABEL, PRODUCT_CAT, label } from '../../../lib/catalog';
import { publicMoq } from '../../../lib/comply-copy';
import { rfqCanLookup, rfqHasContext, rfqIdState, type RfqLookup } from '../../../lib/rfq-context';
import {
  NOTIFY_COUNTRIES, ORDER_BANDS, TARGET_MARKETS,
  leadTimeWindowNote, rfqFieldCopy, rfqQueryPrefill, rfqProductHooks,
} from '../../../lib/rfq-fields';
import GhadBoundary from '../../../components/GhadBoundary.astro';

export const prerender = false;
const lang = Astro.params.lang ?? 'en';
const zh = lang.startsWith('zh');
const tSkip = uiT(lang as any)('a11y.skip');
const db = (env as any).DB as D1Database | undefined;
const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const siteId = shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai';
const B = `/${lang}`;
const path = `${B}/rfq/`;
const origin = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;
const q = Astro.url.searchParams;
const productId = (q.get('product_id') ?? '').trim().slice(0, 40);
const about = (q.get('about') ?? '').trim().slice(0, 160);
const formulaQ = (q.get('formula') ?? '').trim().slice(0, 40);
const categoryQ = (q.get('category') ?? '').trim().slice(0, 40);
const marketQ = (q.get('market') ?? '').trim().slice(0, 80);
/* target_market 只预勾区域，不填进下面的国家/城市框。 */
const targetQ = (q.get('target_market') ?? '').trim().slice(0, 40);
/* 有 product_id 才查一行。查不到且不是配方/包材编码 → 错误卡;库故障不误报。边缘缓存按 product_id 分键,同一 id 不会每次都打到 D1。 */
let lookup: RfqLookup = 'skip';
let found: { category: string; name: string; specs: string } | null = null;
if (productId && rfqCanLookup(productId) && db) {
  try {
    const row = await db.prepare(
      `SELECT p.category,
              (SELECT x.name FROM product_i18n x WHERE x.product_id = p.id
                ORDER BY CASE x.lang WHEN ? THEN 0 WHEN 'en' THEN 1 WHEN 'zh-cn' THEN 2 ELSE 3 END
                LIMIT 1) AS name,
              (SELECT x.specs_json FROM product_i18n x WHERE x.product_id = p.id
                ORDER BY CASE x.lang WHEN ? THEN 0 WHEN 'en' THEN 1 WHEN 'zh-cn' THEN 2 ELSE 3 END
                LIMIT 1) AS specs_json
         FROM products p
        WHERE p.site_id = ? AND p.status = 'published' AND (p.id = ? OR p.slug = ?)
        LIMIT 1`,
    ).bind(lang, lang, siteId, productId, productId).first<{ category: string | null; name: string | null; specs_json: string | null }>();
    if (row) {
      lookup = 'found';
      found = { category: String(row.category ?? ''), name: String(row.name ?? ''), specs: String(row.specs_json ?? '') };
    } else lookup = 'miss';
  } catch { lookup = 'error'; }
}
const productName = (about || formulaQ || found?.name || '').trim().slice(0, 160);
const categoryRaw = (categoryQ || found?.category || '').trim().slice(0, 40);
const categoryKnown = !categoryRaw || categoryRaw in PRODUCT_CAT;
const catChip = categoryRaw ? label(CAT_LABEL, categoryRaw, zh) : '';
const showCard = rfqHasContext({ productId, about, formula: formulaQ, category: categoryQ });
const idState = rfqIdState({ productId, about, formula: formulaQ, category: categoryQ, lookup });
let formulaTexture = '';
if (showCard && formulaQ && db) {
  try {
    const fr = await db.prepare(`SELECT texture FROM formulas WHERE code = ? LIMIT 1`).bind(formulaQ).first<{ texture: string | null }>();
    formulaTexture = String(fr?.texture ?? '');
  } catch { formulaTexture = ''; }
}
const F = rfqFieldCopy(zh);
const prefill = rfqQueryPrefill({ market: marketQ, target_market: targetQ });
const leadNote = leadTimeWindowNote(zh);
const hooks = rfqProductHooks({
  hasContext: showCard,
  specsJson: found?.specs ?? '',
  hideCjk: !zh,
  query: {
    spf_pa: (q.get('spf_pa') ?? '').trim(),
    texture: (q.get('texture') ?? '').trim(),
    skin_type: (q.get('skin_type') ?? '').trim(),
  },
});
/* 配方链只在产品规格没写肤感时补一行，避免空卡。 */
if (!hooks.texture && formulaTexture) {
  hooks.texture = rfqProductHooks({
    hasContext: showCard,
    hideCjk: !zh,
    query: { texture: formulaTexture },
  }).texture;
}
const hookCards = [
  hooks.spf_pa ? { k: 'spf_pa', label: F.spf, v: hooks.spf_pa } : null,
  hooks.texture ? { k: 'texture', label: F.texture, v: hooks.texture } : null,
  hooks.skin_type ? { k: 'skin_type', label: F.skin, v: hooks.skin_type } : null,
].filter((x): x is { k: string; label: string; v: string } => !!x);
const siteKey = (import.meta.env.TURNSTILE_SITE_KEY as string | undefined) ?? '0x4AAAAAAEh9PTvpt4eaYV_q';
const waNum = String(((Astro.locals as any)?.contact ?? {}).whatsapp ?? '').replace(/\D/g, '');
const cats = Object.entries(PRODUCT_CAT);

const T = zh
  ? {
      title: '申请样品 / RFQ',
      h1: '申请样品或提交 RFQ',
      lede: '填写目标市场、品类、预估量与联系方式。我们写入工单后通知销售；两个工作日内书面回复。本表不自动报价。',
      note: `${publicMoq(true)}。${leadNote}`,
      category: '品类',
      categoryPh: '选择品类',
      volume: '预估首单量',
      volumePh: '例：5000 件',
      product: '产品 / 编码（可选）',
      productPh: '产品名或内部编码',
      name: '称呼',
      company: '公司（可选）',
      email: '邮箱',
      wa: 'WhatsApp / 电话',
      contactHint: '邮箱或 WhatsApp 至少填一项',
      message: '备注（可选）',
      messagePh: '功效、包材、合规需求等',
      submit: '提交 RFQ',
      sending: '提交中…',
      ok: '已收到。工单号：',
      okHint: '请保存工单号，便于跟进。我们不自动报价，销售会书面回复。',
      fail: '提交失败，请稍后重试或改用邮件。',
      needContact: '请填写邮箱或 WhatsApp。',
      needFields: '请填写市场、品类与预估量。',
      portfolio: '浏览产品',
      oem: 'OEM',
      noQuote: '提交后不会自动报价。',
      forProduct: '正在申请样品',
      change: '更换产品',
      missId: '这条链接没有产品 ID。仍可手动填写并提交。',
      badId: '这个产品 ID 无法识别。仍可手动填写并提交。',
      catUnknown: '不在品类列表中',
      secTarget: '① 目标市场',
      secFiling: '② 备案协助',
      secHalal: '③ 清真需求',
      secOrder: '④ 首单与文件',
      formLabelsEnglish: 'Form labels in English',
    }
  : {
      title: 'Request sample / RFQ',
      h1: 'Request a sample or submit an RFQ',
      lede: 'Required: target market, category, estimated volume, and a contact. We create a ticket, notify sales, and reply in writing within two business days. This form never auto-quotes.',
      note: `${publicMoq(false)}. ${leadNote}`,
      category: 'Category',
      categoryPh: 'Select a category',
      volume: 'Estimated first order',
      volumePh: 'e.g. 5,000 pcs',
      product: 'Product / code (optional)',
      productPh: 'Product name or internal code',
      name: 'Name',
      company: 'Company (optional)',
      email: 'Email',
      wa: 'WhatsApp / phone',
      contactHint: 'Email or WhatsApp required',
      message: 'Notes (optional)',
      messagePh: 'Claims, packaging, compliance needs…',
      submit: 'Submit RFQ',
      sending: 'Sending…',
      ok: 'Received. Ticket ID: ',
      okHint: 'Keep this ticket ID for follow-up. We never auto-quote; sales replies in writing.',
      fail: 'Could not send — please retry or email us.',
      needContact: 'Enter an email or WhatsApp number.',
      needFields: 'Market, category and volume are required.',
      portfolio: 'Browse products',
      oem: 'OEM',
      noQuote: 'Submitting does not generate an automatic quote.',
      forProduct: 'Requesting sample for',
      change: 'Change product',
      missId: 'This link has no product id. You can still fill in the form and submit.',
      badId: 'This product id is not recognized. You can still fill in the form and submit.',
      catUnknown: 'Not a listed category',
      secTarget: '① Target market',
      secFiling: '② Filing assist',
      secHalal: '③ Halal need',
      secOrder: '④ First order + docs',
      formLabelsEnglish: 'Form labels in English',
    };
---
<BaseLayout locale={lang} school={shell.variant?.school ?? 'atelier'} variant={shell.site?.variant ?? 'v1'} brand={siteId}
  title={T.title} description={T.lede} siteName={shell.site?.name ?? '帛卉'} siteUrl={origin} path={path}
  indexable={shell.site?.is_live === 1} brandColor={shell.site?.brand_color} theme={shell.site?.theme ?? 'noir'}>
  <a class="ck-skip-link" href="#main">{tSkip}</a>
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'} siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />
  <main id="main" class="rfq">
    <header class="hd">
      <h1>{T.h1}</h1>
      <p class="lede">{T.lede}</p>
      {lang !== 'en' && !lang.startsWith('zh') && <p class="note en-labels">{T.formLabelsEnglish}</p>}
      <p class="note">{T.note}</p>
      <p class="note strong">{T.noQuote}</p>
    </header>

    {showCard && (
      <section class:list={['sum', idState]} id="rfq-context" data-state={idState || 'ok'} aria-live="polite">
        {idState === 'missing' && <p class="errline" role="alert">{T.missId}</p>}
        {idState === 'bad' && <p class="errline" role="alert">{T.badId}</p>}
        {idState === '' && <p class="kicker">{T.forProduct}</p>}
        {(productName || productId) && (
          <p class="pname">
            {productName && <strong>{productName}</strong>}
            {productId && <code>{productId}</code>}
          </p>
        )}
        {categoryRaw && (
          <p class="chips">
            <span class:list={['chip', !categoryKnown && 'bad']}>{categoryKnown ? catChip : categoryRaw}</span>
            {!categoryKnown && <span class="chip bad">{T.catUnknown}</span>}
          </p>
        )}
        {hookCards.length > 0 && (
          <ul class="hooks">
            {hookCards.map((h) => (
              <li><span>{h.label}</span> {h.v}</li>
            ))}
          </ul>
        )}
        <a class="change" href={`${B}/products/`}>{T.change}</a>
      </section>
    )}

    <div id="rfq-ok" class="ok hidden" role="status" aria-live="polite" hidden></div>

    <form id="rfq-form" class="f" action="/api/inquiry" method="post" novalidate>
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
             style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
      <input type="hidden" name="source" value="rfq" />
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="site" value={siteId} />
      <input type="hidden" name="sourcePath" value={path} />
      <input type="hidden" name="product_id" value={productId} />
      {hookCards.map((h) => <input type="hidden" name={h.k} value={h.v} />)}

      <section class="mkt-block" aria-labelledby="mkt-target">
        <h2 class="mkt-title" id="mkt-target">{T.secTarget}</h2>
        <fieldset class="checks">
          <legend>{F.targetMarket} *</legend>
          <p class="hint">{F.targetMarketHint}</p>
          <div class="opts">
            {TARGET_MARKETS.map((id) => (
              <label class="check">
                <input type="checkbox" name="target_market" value={id} checked={prefill.target_market.includes(id)} />
                <span>{id === 'Other' ? F.other : id}</span>
              </label>
            ))}
          </div>
          <label class="other-in"><span>{F.otherPh}</span>
            <input type="text" name="target_market_other" maxlength="80" placeholder={F.otherPh} aria-describedby="err-market-other" />
            <span id="err-market-other" class="field-err" hidden></span>
          </label>
        </fieldset>
        <label><span>{F.country} *</span>
          <input type="text" name="market" required maxlength="80" placeholder={F.countryPh} value={marketQ} />
        </label>
      </section>

      <section class="mkt-block" aria-labelledby="mkt-filing">
        <h2 class="mkt-title" id="mkt-filing">{T.secFiling}</h2>
        <fieldset class="checks">
          <legend>{F.notify}</legend>
          <p class="hint">{F.notifyHint}</p>
          <div class="opts">
            {NOTIFY_COUNTRIES.map((id) => (
              <label class="check">
                <input type="checkbox" name="notification_assist_country" value={id} checked={prefill.notification_assist_country.includes(id)} />
                <span>{id === 'Other' ? F.other : id}</span>
              </label>
            ))}
          </div>
          <label class="other-in"><span>{F.otherPh}</span>
            <input type="text" name="notification_assist_other" maxlength="80" placeholder={F.otherPh} aria-describedby="err-notify-other" />
            <span id="err-notify-other" class="field-err" hidden></span>
          </label>
        </fieldset>
        <GhadBoundary lang={lang} />
      </section>

      <section class="mkt-block" aria-labelledby="mkt-halal">
        <h2 class="mkt-title" id="mkt-halal">{T.secHalal}</h2>
        <fieldset class="checks">
          <legend>{F.halal}</legend>
          <p class="hint">{F.halalHint}</p>
          <div class="opts">
            <label class="check"><input type="radio" name="halal_ready" value="yes" /><span>{F.halalYes}</span></label>
            <label class="check"><input type="radio" name="halal_ready" value="no" /><span>{F.halalNo}</span></label>
            <label class="check"><input type="radio" name="halal_ready" value="unsure" /><span>{F.halalUnsure}</span></label>
          </div>
        </fieldset>
        <label class="scope"><span>{F.halalScope}</span>
          <input type="text" name="halal_scope_note" maxlength="200" placeholder={F.halalScopePh} />
        </label>
        <p class="hint">{F.held}</p>
      </section>
      <label><span>{T.category} *</span>
        <select name="category" required>
          <option value="">{T.categoryPh}</option>
          {cats.map(([id, lab]) => (
            <option value={id} selected={categoryRaw === id}>{zh ? lab : id}</option>
          ))}
          {categoryRaw && !(categoryRaw in PRODUCT_CAT) && (
            <option value={categoryRaw} selected>{categoryRaw}</option>
          )}
        </select>
        {categoryRaw && !categoryKnown && <span class="chip bad">{T.catUnknown}</span>}
      </label>
      <section class="mkt-block" aria-labelledby="mkt-order">
        <h2 class="mkt-title" id="mkt-order">{T.secOrder}</h2>
        <label><span>{F.band}</span>
          <select name="first_order_band">
            <option value="">{F.bandPh}</option>
            {ORDER_BANDS.map((id) => <option value={id}>{F.bandOpt[id]}</option>)}
          </select>
          <span class="hint">{F.bandHint}</span>
          <span id="err-band" class="field-err" hidden></span>
        </label>
        <fieldset class="checks">
          <legend>{F.msds}</legend>
          <div class="opts">
            <label class="check"><input type="radio" name="need_msds_coa" value="yes" /><span>{F.msdsYes}</span></label>
            <label class="check"><input type="radio" name="need_msds_coa" value="no" /><span>{F.msdsNo}</span></label>
          </div>
        </fieldset>
        <p class="note" id="lead_time_window_note">{leadNote}</p>
        <label class="check solo">
          <input type="checkbox" name="need_written_lead_confirm" value="1" checked />
          <span>{F.leadConfirm}</span>
        </label>
        <p class="hint">{F.leadConfirmHint}</p>
      </section>
      <label><span>{T.volume} *</span>
        <input type="text" name="volume" required maxlength="40" placeholder={T.volumePh} />
      </label>
      <label><span>{T.product}</span>
        <input type="text" name="iq_product" maxlength="160" placeholder={T.productPh} value={productName} />
      </label>

      <div class="g2">
        <label><span>{T.name} *</span><input type="text" name="name" required maxlength="120" autocomplete="name" /></label>
        <label><span>{T.company}</span><input type="text" name="company" maxlength="160" autocomplete="organization" /></label>
      </div>
      <div class="g2">
        <label><span>{T.email}</span><input type="email" name="email" maxlength="200" autocomplete="email" /></label>
        <label><span>{T.wa}</span><input type="tel" name="whatsapp" maxlength="40" autocomplete="tel" inputmode="tel" placeholder="+62 …" /></label>
      </div>
      <p class="hint">{T.contactHint}</p>
      <label><span>{T.message}</span><textarea name="notes" rows="3" maxlength="2000" placeholder={T.messagePh}></textarea></label>

      {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible"></div>}
      <button class="btn" type="submit">{T.submit}</button>
      <p class="fb" id="rfq-fb" role="status" aria-live="polite"></p>
    </form>

    <p class="links">
      <a href={`${B}/products/`}>{T.portfolio}</a>
      · <a href={`${B}/oem/`}>{T.oem}</a>
      {waNum && <> · <a href={`https://wa.me/${waNum}`} target="_blank" rel="noopener">WhatsApp</a></>}
      · <a href={`mailto:${shell.email}`}>{shell.email}</a>
    </p>
  </main>
  <SiteFooter locale={lang} path={path} site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any} siblings={[]} email={shell.email} nav={shell.nav} />
</BaseLayout>

{siteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />}
<script is:inline define:vars={{ zh, tOk: T.ok, tOkHint: T.okHint, tFail: T.fail, tSending: T.sending, tNeedContact: T.needContact, tNeedFields: T.needFields, tNeedMarket: F.needMarket, tPleaseSpecifyMarket: F.pleaseSpecifyMarket, tNeedBand: F.needBand, tNeedNotify: F.needNotify, tSubmit: T.submit }}>
  (function () {
    var form = document.getElementById('rfq-form');
    var fb = document.getElementById('rfq-fb');
    var ok = document.getElementById('rfq-ok');
    if (!form) return;
    function pack(fd, name, allowed, otherName) {
      var selected = fd.getAll(name).map(function (v) { return String(v); });
      var other = String(fd.get(otherName) || '').trim().slice(0, 80).replace(/[,;\n]/g, ' ');
      var out = [];
      allowed.forEach(function (k) {
        if (selected.indexOf(k) < 0) return;
        out.push(k === 'Other' && other ? 'Other:' + other : k);
      });
      return out.join(',');
    }
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      var market = String(fd.get('market') || '').trim();
      var category = String(fd.get('category') || '').trim();
      var volume = String(fd.get('volume') || '').trim();
      var email = String(fd.get('email') || '').trim();
      var whatsapp = String(fd.get('whatsapp') || '').trim();
      var name = String(fd.get('name') || '').trim();
      var targetMarket = pack(fd, 'target_market', ['SEA', 'GCC', 'Other'], 'target_market_other');
      var notify = pack(fd, 'notification_assist_country', ['ID', 'MY', 'TH', 'VN', 'AE', 'SA', 'Other'], 'notification_assist_other');
      var halal = String(fd.get('halal_ready') || '').trim();
      var scope = halal === 'yes' ? String(fd.get('halal_scope_note') || '').trim().slice(0, 200) : '';
      var band = String(fd.get('first_order_band') || '').trim();
      var msds = String(fd.get('need_msds_coa') || '').trim();
      var leadConfirm = fd.get('need_written_lead_confirm') ? '1' : '0';
      function showFieldErr(id, msg) {
        var el = document.getElementById(id);
        if (el) { el.hidden = false; el.textContent = msg; }
      }
      function clearFieldErrs() {
        ['err-market-other','err-notify-other','err-band'].forEach(function (id) {
          var el = document.getElementById(id);
          if (el) { el.hidden = true; el.textContent = ''; }
        });
      }
      clearFieldErrs();
      if (!targetMarket) { fb.className = 'fb err'; fb.textContent = tNeedMarket; return; }
      var otherMarket = String(fd.get('target_market_other') || '').trim();
      if ((',' + targetMarket + ',').indexOf(',Other') >= 0 && !otherMarket) {
        showFieldErr('err-market-other', tPleaseSpecifyMarket);
        var oi = form.querySelector('input[name="target_market_other"]');
        if (oi) oi.focus();
        fb.className = 'fb err'; fb.textContent = tPleaseSpecifyMarket; return;
      }
      var otherNotify = String(fd.get('notification_assist_other') || '').trim();
      if ((',' + notify + ',').indexOf(',Other') >= 0 && !otherNotify) {
        showFieldErr('err-notify-other', tNeedNotify);
        var ni = form.querySelector('input[name="notification_assist_other"]');
        if (ni) ni.focus();
        fb.className = 'fb err'; fb.textContent = tNeedNotify; return;
      }
      if (!band) {
        showFieldErr('err-band', tNeedBand);
        var bs = form.querySelector('select[name="first_order_band"]');
        if (bs) bs.focus();
        fb.className = 'fb err'; fb.textContent = tNeedBand; return;
      }
      if (!market || !category || !volume) { fb.className = 'fb err'; fb.textContent = tNeedFields; return; }
      if (!email && !whatsapp) { fb.className = 'fb err'; fb.textContent = tNeedContact; return; }
      var product = String(fd.get('iq_product') || '').trim();
      var productId = String(fd.get('product_id') || '').trim();
      var notes = String(fd.get('notes') || '').trim();
      var bits = [];
      bits.push((zh ? '【RFQ/样品】' : '[RFQ/Sample]') + ' market=' + market + '; category=' + category + '; volume=' + volume);
      function addLine(k, v) { if (v) bits.push(k + '=' + v); }
      addLine('target_market', targetMarket);
      addLine('halal_ready', halal);
      addLine('halal_scope_note', scope);
      addLine('notification_assist_country', notify);
      addLine('first_order_band', band);
      addLine('need_msds_coa', msds);
      bits.push('need_written_lead_confirm=' + leadConfirm);
      if (productId) bits.push('product_id=' + productId);
      addLine('spf_pa', String(fd.get('spf_pa') || '').trim());
      addLine('texture', String(fd.get('texture') || '').trim());
      addLine('skin_type', String(fd.get('skin_type') || '').trim());
      if (product) bits.push((zh ? '产品: ' : 'Product: ') + product);
      if (notes) bits.push(notes);
      bits.push(zh ? '（不自动报价；待销售书面回复）' : '(No auto-quote; written reply from sales)');
      var body = {
        source: 'rfq',
        lang: String(fd.get('lang') || ''),
        site: String(fd.get('site') || ''),
        sourcePath: String(fd.get('sourcePath') || ''),
        name: name,
        company: String(fd.get('company') || ''),
        email: email,
        whatsapp: whatsapp,
        market: market,
        category: category,
        volume: volume,
        product_id: productId,
        target_market: targetMarket,
        halal_ready: halal,
        halal_scope_note: scope,
        notification_assist_country: notify,
        first_order_band: band,
        need_msds_coa: msds,
        need_written_lead_confirm: leadConfirm,
        spf_pa: String(fd.get('spf_pa') || '').trim(),
        texture: String(fd.get('texture') || '').trim(),
        skin_type: String(fd.get('skin_type') || '').trim(),
        message: bits.join('\n'),
        'cf-turnstile-response': String(fd.get('cf-turnstile-response') || ''),
      };
      var btn = form.querySelector('button[type=submit]');
      if (btn) { btn.disabled = true; btn.textContent = tSending; }
      fb.className = 'fb'; fb.textContent = '';
      try {
        var r = await fetch('/api/inquiry', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
        var j = await r.json().catch(function () { return {}; });
        if (!r.ok || !j.ok) {
          fb.className = 'fb err';
          fb.textContent = (j && j.msg) ? j.msg : tFail;
        } else {
          var tid = j.ticket_id || j.id || '';
          form.classList.add('hidden');
          ok.hidden = false; ok.classList.remove('hidden');
          var echo = (targetMarket || '') + (band ? (' · ' + band) : '');
          ok.innerHTML = '<strong>' + tOk + '<code>' + tid + '</code></strong><br>' + tOkHint
            + (echo ? ('<br/><span class="echo">' + echo + '</span>') : '');
          try { history.replaceState(null, '', '#rfq-ok'); } catch (e2) {}
          fb.className = 'fb ok'; fb.textContent = '';
        }
      } catch (err) {
        fb.className = 'fb err'; fb.textContent = tFail;
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = tSubmit; }
      }
    });
  })();
</script>

