---
import { siteIdForHost } from '@cosmetic/core/content/tenant-map.ts';
import { t as uiT } from '@cosmetic/core/i18n';
/** 爆款监控日报 · 单日页:按节渲染(区域 / 平台),区域标题做目录;表格每张只留前 40 行,全部条目在爆款库里筛。 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../../../lib/shell';
import { mdLite } from '../../../../lib/md-lite';
export const prerender = false;
const lang = Astro.params.lang ?? 'zh-cn'; const zh = lang.startsWith('zh');
const date = String(Astro.params.date ?? '');
if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return new Response(null, { status: 404 });
const db = (env as any).DB as D1Database | undefined;
const tSkip = uiT(lang as any)('a11y.skip');
let rep: any = null; let secs: any[] = []; let dates: string[] = [];
if (db) {
  try {
    rep = await db.prepare('SELECT * FROM trend_reports WHERE date = ?').bind(date).first<any>();
    if (rep) {
      secs = ((await db.prepare('SELECT ord, level, heading, body_md FROM trend_report_sections WHERE date = ? ORDER BY ord').bind(date).all<any>()).results ?? []) as any[];
      dates = (((await db.prepare('SELECT date FROM trend_reports ORDER BY date DESC').all<any>()).results ?? []) as any[]).map((r) => r.date);
    }
  } catch { rep = null; }
}
if (!rep) return new Response(null, { status: 404 });
const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const B = `/${lang}`; const path = `${B}/trends/report/${date}/`;
const origin = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;
const idx = dates.indexOf(date); const newer = idx > 0 ? dates[idx - 1] : null; const older = idx >= 0 && idx < dates.length - 1 ? dates[idx + 1] : null;
const T = zh ? { eyebrow: '爆款监控日报', toc: '本期目录', more: (n: number) => `还有 ${n} 行未展示 —— 全部条目在爆款库里按平台 / 品类 / 品牌筛。`, lib: '打开爆款库', all: '全部日报', newer: '下一期', older: '上一期', note: '数据来自各平台公开榜单与页面,采集当日有效;价格与排名随时变动。' }
             : { eyebrow: 'Bestseller monitor daily', toc: 'In this issue', more: (n: number) => `${n} more rows — filter everything in the bestseller library.`, lib: 'Open the library', all: 'All issues', newer: 'Newer', older: 'Older', note: 'Compiled from public platform charts and pages on the day of collection; prices and ranks change constantly.' };
const html = secs.map((s) => `<section id="s${s.ord}"><h2>${String(s.heading ?? '')}</h2>${mdLite(String(s.body_md ?? ''), { maxRows: 40, rowNote: T.more })}</section>`).join('\n');
---
<BaseLayout locale={lang} school={shell.variant?.school ?? 'atelier'} variant={shell.site?.variant ?? 'v1'} brand={shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai'}
  title={`${rep.title} · ${date}`} description={secs.map((s) => s.heading).join(' · ').slice(0, 200)} siteName={shell.site?.name ?? '帛卉'} siteUrl={origin} path={path}
  indexable={shell.site?.is_live === 1} brandColor={shell.site?.brand_color} theme={shell.site?.theme ?? 'noir'}>
  <a class="ck-skip-link" href="#main">{tSkip}</a>
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'} siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />
  <main id="main">
    <p class="eyebrow">{T.eyebrow} · <a href={`${B}/trends/reports/`}>{T.all}</a></p>
    <h1>{rep.title}</h1>
    <p class="note">{T.note} <a href={`${B}/trends/`}>{T.lib} →</a></p>
    <nav class="toc" aria-label={T.toc}>{secs.map((s) => <a class:list={['c', { sub: s.level === 3 }]} href={`#s${s.ord}`}>{s.heading}</a>)}</nav>
    <article class="rep" set:html={html} />
    <nav class="pn">{older && <a href={`${B}/trends/report/${older}/`}>← {T.older} {older}</a>}{newer && <a class="nx" href={`${B}/trends/report/${newer}/`}>{T.newer} {newer} →</a>}</nav>
  </main>
  <SiteFooter locale={lang} path={path} site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any} siblings={[]} email={shell.email} nav={shell.nav} />
</BaseLayout>
<style is:global>
  main { max-width: 112.5rem; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
  .eyebrow { font-size: .8125rem; letter-spacing: .12em; text-transform: uppercase; opacity: .6; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.5rem, 3vw, 2.125rem); line-height: 1.25; margin: 0 0 .75rem; }
  .note { font-size: .875rem; opacity: .7; margin: 0 0 1rem; }
  .toc { display: flex; flex-wrap: wrap; gap: .375rem; margin: 0 0 1.5rem; } .toc .c { font-size: .875rem; padding: .375rem .75rem; border: 1px solid var(--ck-line, rgba(0,0,0,.16)); border-radius: 999px; text-decoration: none; color: inherit; } .toc .sub { opacity: .75; }
  .rep section { margin: 0 0 2rem; scroll-margin-top: 3.5rem;  /* 09-17 「太多空余」 */ } .rep h2 { font-size: 1.375rem; margin: 1.5rem 0 .5rem; } .rep h3 { font-size: 1.125rem; margin: 1.25rem 0 .5rem; } .rep h4 { font-size: 1rem; margin: 1rem 0 .375rem; }
  .rep p, .rep li { line-height: 1.7; font-size: .9375rem; } .rep .more { font-size: .8125rem; opacity: .65; }
  .rep .tw { overflow-x: auto; margin: .5rem 0 1rem; } .rep table { border-collapse: collapse; font-size: .8125rem; min-width: 40rem; } .rep th, .rep td { border-bottom: 1px solid var(--ck-line, rgba(0,0,0,.12)); padding: .375rem .5rem; text-align: left; vertical-align: top; max-width: 22rem; } .rep th { font-weight: 600; white-space: nowrap; }
  .pn { display: flex; justify-content: space-between; gap: 1rem; margin: 2rem 0 0; } .pn a { text-decoration: none; color: inherit; border: 1px solid var(--ck-line, rgba(0,0,0,.16)); border-radius: 10px; padding: .5rem 1rem; } .pn .nx { margin-left: auto; }
  @media (min-width: 900px) { main { padding: 2rem 1.5rem 4rem; } }
</style>
