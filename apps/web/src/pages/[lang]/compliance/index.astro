/**
 * 东南亚六国化妆品通报账号门槛。
 *
 * 由来(2026-09-10 00:35,创始人转来一篇公众号整理并说「这也是非常重要的信息」)。
 * 他是对的:「印尼 BPOM 备案要什么资质」正是买家会去问 AI 的问题,
 * 而我们站上一个字都没有 —— 客户在这一步卡住,单子就停在那里,和配方好不好无关。
 *
 * 三条纪律:
 *   1. **不转载**。那篇是别人的文章,这里的每一条都按官方源头重新核过,
 *      用我们自己的话写,并逐条挂官方链接。抄一篇公众号发到自己站上,
 *      既侵权,也经不起客户点开来源核对。
 *   2. **划清我们能做什么**。账号是品牌方本地主体的事,我们代办不了,
 *      也不该暗示能代办。工厂能给的是工厂侧资料(CFS、GMP、配方与安全评估、PIF),
 *      把这条写在最显眼处,比含糊地说「协助出海」有用得多。
 *   3. **法规会变**。每条都标注「以最新官方文本为准」并给出原文地址,
 *      不写生效日期以外的时间承诺。越南 2025 年刚出 Circular 34/2025/TT-BYT,
 *      就是活的例子。
 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../../lib/shell';

export const prerender = false;

const lang = Astro.params.lang ?? 'zh-cn';
const zh = lang.startsWith('zh');
const tSkip = uiT(lang as any)('a11y.skip');
const db = (env as any).DB as D1Database | undefined;
const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const path = `/${lang}/compliance/`;
const origin = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;

type Step = { do: string; doEn: string; at: string; atEn: string; url: string };
type Row = {
  cc: string; zhName: string; enName: string; sys: string; reg: string; regEn: string;
  local: string; localEn: string; token: string; tokenTone: 'no' | 'opt' | 'yes';
  docs: string[]; docsEn: string[]; src: string; note: string; noteEn: string;
  steps: Step[];
};

