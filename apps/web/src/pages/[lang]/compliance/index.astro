  theirs: 'Only the local entity can hold these',
  theirsList: [
    'Local company registration and tax number', 'Importer licence',
    'Local technical person in charge or licensed pharmacist',
    'Hardware USB token (issued only to locally registered companies)',
    'Local warehousing and distribution arrangements',
  ],
  tableH: 'The six at a glance',
  cols: ['Market', 'System', 'Local entity', 'Hardware e-signature', 'Core prerequisites'],
  detailH: 'Market by market',
  stepsH: 'Order of steps and official entry points',
  alertH: 'Indonesia: halal certification becomes mandatory for cosmetics on 17 October 2026',
  alertBody: 'BPJPH has announced that from 17 October 2026 cosmetics join medicines and chemical '
           + 'products under mandatory halal certification, imported goods included. On BPJPH figures '
           + 'only 7,558 imported cosmetic products are certified so far. Build the certification lead '
           + 'time into any Indonesian shipping plan — this is a hard date, not background reading.',
  alertSrc: 'BPJPH announcement',
  srcLabel: 'Official source',
  pitH: 'Three things that go wrong most often',
  pits: [
    { t: 'An account is not product compliance',
      d: 'The account is only system access. Every product still needs its own formulation, safety '
       + 'assessment and label submission before a notification number is issued, and the PIF stays '
       + 'subject to inspection afterwards.' },
    { t: 'A narrow authorisation letter has to be reissued',
      d: 'State the full scope: account registration, product notification, dealing with the regulator, '
       + 'handling recalls. Miss one and you re-notarise weeks later.' },
    { t: 'Changing the local entity costs more than expected',
      d: 'Most of these markets require products under the old account to be withdrawn and re-notified '
       + 'under the new one. Choose the local partner before shipping, not after.' },
  ],
  planH: 'Two scheduling notes',
  plans: [
    'Assess the account and the product on separate tracks. Confirm the local entity is viable first; '
    + 'a perfect formula cannot enter a market whose account never opened.',
    'Pre-review authorisation letters, GMP and CFS documents before issuing them formally. '
    + 'Rounds of corrections cost more time than getting it right once — and they land exactly '
    + 'in the weeks when goods are already in transit.',
  ],
  note: 'A compilation of public regulatory information, checked line by line against each authority’s '
      + 'own pages, with sources given. Rules and systems change (Vietnam amended its in 2025); the latest '
      + 'official text prevails, and filing is the responsibility of the brand owner and its local '
      + 'representative. BIOSPHERE does not provide overseas registration agency services.',
  cta: 'Need the factory-side document list for a specific market?',
  ctaBody: 'Tell us the destination and the product category and we will send the factory documents that '
         + 'market’s notification needs, with our lead time for each.',
  ctaBtn: 'Start an enquiry',
  yes: 'Mandatory', opt: 'Depends on route', no: 'Not required',
};

const tokenLabel = (t: Row['tokenTone']) => (t === 'yes' ? T.yes : t === 'opt' ? T.opt : T.no);

const ld = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: zh ? '首页' : 'Home', item: `${origin}/${lang}/` },
      { '@type': 'ListItem', position: 2, name: T.title, item: origin + path },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: ROWS.map((r) => ({
      '@type': 'Question',
      name: zh ? `${r.zhName}化妆品通报账号需要什么资质?` : `What does a cosmetic notification account require in ${r.enName}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: zh
          ? `${r.zhName}的通报系统是 ${r.sys},由${r.reg}主管。${r.local}。硬件电子签:${tokenLabel(r.tokenTone)}。`
            + `核心资质:${r.docs.join('、')}。${r.note}以最新官方文本为准。`
          : `${r.enName} uses ${r.sys}, administered by ${r.regEn}. ${r.localEn}. Hardware e-signature: `
            + `${tokenLabel(r.tokenTone)}. Core prerequisites: ${r.docsEn.join('; ')}. ${r.noteEn} `
            + 'The latest official text prevails.',
      },
    })),
  },
];
const indexable = shell.site?.is_live === 1;
---

<BaseLayout
  locale={lang} school={shell.variant?.school ?? 'atelier'} variant={shell.site?.variant ?? 'v1'}
  brand={shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai'}
  title={T.title} description={T.lede.replace(/\*\*/g, '')}
  siteName={shell.site?.name ?? '帛卉'} siteUrl={origin} path={path}
  indexable={indexable} brandColor={shell.site?.brand_color} theme={shell.site?.theme ?? 'noir'}
>
  <a class="ck-skip-link" href="#main">{tSkip}</a>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'}
              siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />
  <main id="main">
    <header class="hd">
      <p class="eyebrow">{T.eyebrow}</p>
      <h1>{T.title}</h1>
      <p class="lede" set:html={T.lede.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
    </header>

    <aside class="alert">
      <h2>{T.alertH}</h2>
      <p>{T.alertBody}</p>
      <p class="src"><a href="https://bpjph.halal.go.id/detail/bpjph-produk-kosmetik-wajib-bersertifikat-halal-pada-oktober-2026/"
                        rel="nofollow noopener" target="_blank">{T.alertSrc} ↗</a></p>
    </aside>

    <section class="split">
      <div class="box ours">
        <h2>{T.ours}</h2>
        <p>{T.oursBody}</p>
        <ul>{T.oursList.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="box theirs">
        <h2>{T.theirs}</h2>
        <ul>{T.theirsList.map((x) => <li>{x}</li>)}</ul>
      </div>
    </section>

    <section>
      <h2>{T.tableH}</h2>
      <div class="wrap">
        <table>
          <thead><tr>{T.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {ROWS.map((r) => (
              <tr>
                <th scope="row">{zh ? r.zhName : r.enName}</th>
                <td>{r.sys}</td>
                <td>{zh ? r.local : r.localEn}</td>
                <td><span class:list={['tok', r.tokenTone]}>{tokenLabel(r.tokenTone)}</span></td>
                <td class="docs">{(zh ? r.docs : r.docsEn).join(zh ? '、' : '; ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>{T.detailH}</h2>
      <div class="cards">
        {ROWS.map((r) => (
          <article class="card">
            <p class="cc">{r.cc}</p>
            <h3>{zh ? r.zhName : r.enName} · {r.sys}</h3>
            <p class="reg">{zh ? r.reg : r.regEn}</p>
            <ul>{(zh ? r.docs : r.docsEn).map((d) => <li>{d}</li>)}</ul>
            <p class="note">{zh ? r.note : r.noteEn}</p>
            <p class="steps-h">{T.stepsH}</p>
            <ol class="steps">
              {r.steps.map((st) => (
                <li>
                  <span class="what">{zh ? st.do : st.doEn}</span>
                  <a class="at" href={st.url} rel="nofollow noopener" target="_blank">{zh ? st.at : st.atEn} ↗</a>
                </li>
              ))}
            </ol>
            <p class="src"><a href={r.src} rel="nofollow noopener" target="_blank">{T.srcLabel} ↗</a></p>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2>{T.pitH}</h2>
      <div class="pits">
        {T.pits.map((p) => (
          <div class="pit"><h3>{p.t}</h3><p>{p.d}</p></div>
        ))}
      </div>
    </section>

    <section>
      <h2>{T.planH}</h2>
      <ol class="plans">{T.plans.map((x) => <li>{x}</li>)}</ol>
    </section>

    <section class="ask">
      <h2>{T.cta}</h2>
      <p>{T.ctaBody}</p>
      <a class="btn" href={`/${lang}/contact/`}>{T.ctaBtn}</a>
    </section>

    <p class="disclaim">{T.note}</p>
  </main>
  <SiteFooter locale={lang} path={path}
              site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any}
              siblings={[]} email={shell.email} nav={shell.nav} />
  <style>
    main { max-width: min(112.5rem, 100%); margin: 0 auto;
           padding: 2.5rem var(--ck-gutter, 1.25rem) 4rem; }
    .hd { max-width: 56rem; }
    .eyebrow { font-size: max(0.75rem, 14px); letter-spacing: .14em; text-transform: uppercase;
               color: var(--ck-ink-soft); margin: 0 0 .5rem; }
    h1 { font-size: clamp(1.5rem, 3vw, 2.25rem); margin: 0 0 .75rem; text-wrap: balance; }
    .lede { color: var(--ck-ink-soft); line-height: 1.8; margin: 0; }
    section { margin: 3rem 0 0; }
    h2 { font-size: clamp(1.125rem, 2vw, 1.5rem); margin: 0 0 1rem; }
    h3 { font-size: 1rem; margin: 0 0 .5rem; }
    ul, ol { margin: .5rem 0 0; padding-inline-start: 1.125rem; }
    li { line-height: 1.8; margin: 0 0 .25rem; }
    /* 「我们能做/不能做」并排:这一组是全页最该先被看到的,所以放在表格之前 */
    .split { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); }
    .box { border: var(--ck-border-w, 1px) solid var(--ck-line); border-radius: var(--ck-radius, 4px);
           padding: 1.25rem 1.375rem; }
    .box p { color: var(--ck-ink-soft); line-height: 1.8; margin: 0; }
    .ours { background: color-mix(in oklab, var(--ck-accent, #444) 5%, transparent); }
    .wrap { overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; min-width: 52rem; font-size: max(0.8125rem, 14px); }
    th, td { text-align: left; padding: .625rem .75rem; vertical-align: top; line-height: 1.7;
             border-bottom: 1px solid var(--ck-line); }
    thead th { white-space: nowrap; font-weight: 600; }
    tbody th { white-space: nowrap; font-weight: 600; }
    .docs { color: var(--ck-ink-soft); }
    .tok { display: inline-block; padding: .125rem .5rem; border-radius: 999px; white-space: nowrap;
           font-size: max(0.75rem, 14px); border: 1px solid var(--ck-line); }
    .tok.yes { border-color: currentColor; font-weight: 600; }
    .tok.no { color: var(--ck-ink-soft); }
    .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
    .card { border: var(--ck-border-w, 1px) solid var(--ck-line); border-radius: var(--ck-radius, 4px);
            padding: 1.25rem 1.375rem; }
    .cc { font-size: max(0.75rem, 14px); letter-spacing: .14em; color: var(--ck-ink-soft); margin: 0 0 .375rem; }
    .reg, .note, .src { color: var(--ck-ink-soft); line-height: 1.75; margin: .5rem 0 0;
                        font-size: max(0.8125rem, 14px); }
    .alert { border: 2px solid var(--ck-ink, #111); border-radius: var(--ck-radius, 4px);
             padding: 1.25rem 1.375rem; margin: 2rem 0 0; max-width: 56rem; }
    .alert h2 { font-size: 1.0625rem; margin: 0 0 .5rem; }
    .alert p { color: var(--ck-ink-soft); line-height: 1.8; margin: 0; }
    .steps-h { margin: 1rem 0 .25rem; font-size: max(0.75rem, 14px); letter-spacing: .1em;
               text-transform: uppercase; color: var(--ck-ink-soft); }
    /* 办理路径是这一页的主角:序号要明确,入口要能点。
       创始人 2026-09-10:「我们不代办,只是要有怎么样办的索引」。 */
    .steps { margin: 0; padding-inline-start: 1.25rem; }
    .steps li { margin: 0 0 .5rem; line-height: 1.7; }
    .steps .what { display: block; }
    .steps .at { font-size: max(0.8125rem, 14px); color: var(--ck-ink-soft); }
    .pits { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
    .pit { border-inline-start: 3px solid var(--ck-line); padding: 0 0 0 1rem; }
    .pit p { color: var(--ck-ink-soft); line-height: 1.8; margin: 0; }
    .plans { max-width: 56rem; color: var(--ck-ink-soft); }
    .ask { border-top: 1px solid var(--ck-line); padding-top: 2rem; max-width: 56rem; }
    .ask p { color: var(--ck-ink-soft); line-height: 1.8; }
    .btn { display: inline-flex; align-items: center; min-height: 2.75rem; margin-top: 1rem;
           padding: 0 1.5rem; border-radius: 999px; background: var(--ck-ink, #111);
           color: var(--ck-paper, #fff); text-decoration: none; }
    .disclaim { max-width: 56rem; margin: 2.5rem 0 0; font-size: max(0.8125rem, 14px);
                line-height: 1.8; color: var(--ck-ink-soft); }
  </style>
</BaseLayout>
