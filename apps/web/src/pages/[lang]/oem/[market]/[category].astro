---
import { ldJson } from '@cosmetic/core/content/ldjson.ts';
import { siteIdForHost } from '@cosmetic/core/content/tenant-map.ts';
import { t as uiT } from '@cosmetic/core/i18n';
import { OEM_MARKETS, OEM_CATEGORIES, OEM_CERTS } from '@cosmetic/core/content/oem.ts';
import { SAMPLE_DAYS } from '../../../../lib/terms';
import { formulaName, FMT_LABEL } from '../../../../lib/catalog';
/**
 * 意图落地页:「{品类} private label / OEM 代工 · 面向 {市场} 品牌」(2026-09-16)。
 * 买家真会搜的词是 supplier / manufacturer / private label / OEM + 市场 + 品类(头条那篇外贸 SEO 评判标准);站上此前一页都没有。
 * 每页全部由库里的真数拼:法规表(备案路径 / 责任人 / 标签)、配方库计数、包材库计数、买手问答;不写起订量 / 交期 / 价格(lib/terms.ts 铁令)。
 * 多语言:中 / 英模板在这里;其它语种的模板句在 ui_i18n(ns='oem',tools/ui-i18n.py 用免费舰队翻),没有就回落英文;法规原文只有中英。
 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../../../lib/shell';
import InquiryFormLite from '@cosmetic/core/components/InquiryFormLite.astro';

export const prerender = false;
const lang = Astro.params.lang ?? 'zh-cn';
const zh = lang.startsWith('zh');
const isEn = lang === 'en';
const tSkip = uiT(lang as any)('a11y.skip');
const db = (env as any).DB as D1Database | undefined;
const M = OEM_MARKETS.find((m) => m.id === String(Astro.params.market ?? '').toLowerCase());
const C = OEM_CATEGORIES.find((c) => c.id === String(Astro.params.category ?? '').toLowerCase());
if (!M || !C) return new Response(null, { status: 404 });

const reg = db ? await db.prepare('SELECT * FROM regulations WHERE id = ?').bind(M.id).first<any>().catch(() => null) : null;
const nf = db ? Number((await db.prepare(`SELECT COUNT(*) n FROM formulas WHERE status IN ('sample','active') AND category IN (${C.cats.map(() => '?').join(',')})`).bind(...C.cats).first<any>().catch(() => null))?.n ?? 0) : 0;
const formats = db ? (await db.prepare(`SELECT format, COUNT(*) n FROM formulas WHERE status IN ('sample','active') AND category IN (${C.cats.map(() => '?').join(',')}) AND format IS NOT NULL AND format<>'' GROUP BY format ORDER BY n DESC LIMIT 6`).bind(...C.cats).all<any>().catch(() => ({ results: [] as any[] }))).results : [];
/* 09-21 创始人:「开发信要有相对应的产品,要不然就只是空谈」—— 落地页列本品类在库基底(真编号,点进 /formula/<code>/),不只报计数 */
const MK_CODE: Record<string, string> = { id: 'ID', my: 'MY', sa: 'SA', ae: 'MEA', ph: 'SEA', vn: 'SEA', th: 'SEA', us: 'US', br: 'LATAM', mx: 'LATAM', co: 'LATAM', cl: 'LATAM', ar: 'LATAM', pe: 'LATAM' };   // formulas.markets 里的市场码;本市场已核过的基底排前
const bases = db ? (await db.prepare(`SELECT code, format, benefits FROM formulas WHERE status IN ('sample','active') AND category IN (${C.cats.map(() => '?').join(',')}) ORDER BY (',' || COALESCE(markets,'') || ',') LIKE ? DESC, (format = 'tooth-tablet') DESC, updated_at DESC LIMIT 8`).bind(...C.cats, `%,${MK_CODE[M.id] ?? 'XX'},%`).all<any>().catch(() => ({ results: [] as any[] }))).results : [];
const np = db ? Number((await db.prepare(`SELECT COUNT(*) n FROM packaging WHERE status IN ('sample','active') AND type IN (${C.packs.map(() => '?').join(',')})`).bind(...C.packs).first<any>().catch(() => null))?.n ?? 0) : 0;
/* 2026-09-18 扩到 100 题后按 market / category 列挂(迁移 0096):本市场×本品类的题最前,其次本市场、本品类,再补通用;老库没这两列时退回只按 slug。 */
const related = db ? (await db.prepare(`SELECT slug, q_zh, q_en FROM geo_answers WHERE slug IN (?, 'how-to-audit-oem', 'stability-how-long', 'halal-cosmetics', 'multilingual-labels', 'jar-vs-airless') OR market = ? OR category = ? ORDER BY (market = ? AND category = ?) DESC, (slug = ?) DESC, (market = ?) DESC, (category = ?) DESC, updated_at DESC, slug LIMIT 6`)
  .bind(`notify-${M.id}`, M.id, C.id, M.id, C.id, `notify-${M.id}`, M.id, C.id).all<any>().catch(() => db.prepare(`SELECT slug, q_zh, q_en FROM geo_answers WHERE slug IN (?, 'how-to-audit-oem', 'stability-how-long', 'halal-cosmetics', 'multilingual-labels', 'jar-vs-airless') ORDER BY (slug = ?) DESC, slug LIMIT 5`).bind(`notify-${M.id}`, `notify-${M.id}`).all<any>().catch(() => ({ results: [] as any[] })))).results : [];
const relI18n = (related.length && !zh && !isEn && db) ? (await db.prepare(`SELECT slug, q FROM geo_answers_i18n WHERE lang=? AND slug IN (${related.map(() => '?').join(',')})`).bind(lang, ...related.map((r: any) => r.slug)).all<any>().catch(() => ({ results: [] as any[] }))).results : [];
const relQ = (r: any) => zh ? r.q_zh : (relI18n.find((x: any) => x.slug === r.slug)?.q || r.q_en);

const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const B = `/${lang}`; const path = `${B}/oem/${M.id}/${C.id}/`;
const origin = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;
const brand = 'BIOSPHERE';
const pick = (k: string) => (zh ? reg?.[`${k}_zh`] || reg?.[`${k}_en`] : reg?.[`${k}_en`] || reg?.[`${k}_zh`]) || '';
const first = (t: string, n: number) => { const x = String(t || '').replace(/\s+/g, ' ').trim(); const cut = x.search(/[。;;.!?]/); const y = cut > 0 ? x.slice(0, cut) : x; return y.length > n ? y.slice(0, n) + '…' : y; };
const authority = zh ? reg?.authority_zh || reg?.authority_en : reg?.authority_en || reg?.authority_zh;
/* 09-23 GEO:认证只写「工厂口径」页里真有的三项(OEM_CERTS),不再用 ORG.certs(那里混着 FDA / EU CPNP / SGS 注册与检测) */
const certs = OEM_CERTS.map((c) => c.name).join(' / ');
const lines = '15';
const fmtNames = formats.map((f: any) => f.format).join(' · ');

/* 模板句:中 / 英写死;其它语种从 ui_i18n(ns='oem')取译文,占位符 {market} {category} {n} {np} {authority} {certs} {lines} 由这里替换 */
const EN: Record<string, string> = {
  title: `{category} private label & OEM manufacturer for {adj} brands | ${brand}`,
  h1: `{category} OEM / private label manufacturing for {market}`,
  lead: `${brand} runs {lines} automated lines under {certs}, holds {n} proven {category} formulations and {np} stock packaging options for this category. For {market}, products enter the market through {authority}; the filing route, responsible-person rule and label language are summarised below from the official texts. Commercial terms are quoted per project in writing.`,
  s1: `What {market} requires before sale`, s2: `What is on file for {category}`, s3: `How a project runs`, s4: `Related buyer questions`,
  entry: 'Market entry', rp: 'Responsible person', labeling: 'Labeling', official: 'Official source', regpage: 'Full regulation digest for {market} →',
  onfile: `{n} proven {category} formulations on file{formats}, plus {np} stock packaging options in the formats this category uses. Numbers are live counts from the formulation and packaging libraries on this site.`,
  formatsPrefix: ' (formats: {formats})',
  steps: 'Brief → base selection or new formulation → sample (usually {sd} days) → stability (40C accelerated) and preservative challenge (ISO 11930 / USP <51>) → packaging compatibility → dossier for {authority} → production on the certified lines → label review before shipment.',
  halal: `{market} brands usually need halal-ready formulations: every ingredient's origin is checked and documented; the factory holds HALAL certification (scope as stated on the certificate).`,
  faq1q: `Can ${brand} manufacture {category} products for a {adj} brand?`, faq1a: `Yes. {n} {category} formulations are on file, produced on {lines} automated lines under {certs}; the dossier is prepared for {authority}.`,
  faq2q: `Who files the product in {market}?`, faq2a: `{rp}`,
  faq3q: `What must the label carry in {market}?`, faq3a: `{labeling}`,
  faq5q: `How do I verify ${brand} before placing a {category} order?`, faq5a: `Ask for the certificate copies ({certs}), a live video walk-through of the {category} line, and a reference from a brand already selling in {market}; a factory audit visit in Guangzhou is welcome. Samples are tested against your spec before any tooling or bulk order.`,
  faq6q: `What does the first {category} project look like, step by step?`, faq6a: `Brief → formulation match from the {n} on-file bases → sample dispatch (usually {sd} days) → your evaluation and revisions → {market} dossier by the responsible party → packaging artwork check → pilot batch → bulk production and QC release. One project manager stays with you through every step.`,
  faq4q: 'What are the MOQ, sampling time and price?', faq4a: 'Sampling usually takes {sd} days from brief confirmation to dispatch (existing bases at the short end, new formulations at the long end). MOQ and price depend on the format, whether the packaging is a stock shape or a new mould, and whether the formula changes; they are stated per project in a written quotation.',
  ask: `Planning a {category} line for {market}? Send the product type and target launch; we reply with the filing checklist and a written quotation.`, inquiry: 'Send an inquiry',
  /* 09-23 GEO 答案胶囊:问题型 H2 + 40–60 词自足答案(AI 摘答案只取这一段);商务数字只有工厂口径页里的出样 {sd} 天 */
  capQ: `Which factory can make private-label {category} for {adj} brands?`,
  capA: `${brand} (Guangzhou Bohui Cosmetics Co., Ltd.) makes private-label {category} for {adj} brands on {lines} automated lines in Guangzhou, China, certified {certs}. {n} proven {category} formulations and {np} stock packaging options are on file. Samples usually ship in {sd} days; MOQ and price are quoted per project in writing.`,
  certH: 'Certifications',
  eyebrow: 'OEM / private label', back: '← All markets and categories', note: 'Factory-side digest of the official texts; the official text prevails; not legal advice.',
};
const ZH: Record<string, string> = {
  title: `{category}代工 / 贴牌(private label)· 面向{market}品牌 | ${brand}`,
  h1: `{category} OEM / 贴牌代工 · {market}市场`,
  lead: `${brand} 在 {certs} 体系下运行 {lines} 条自动化产线,库内 {n} 条成熟{category}配方、{np} 款该品类常用包材。进入{market}要经 {authority} 的上市路径;备案路径、责任人与标签语言要求按官方原文整理如下。商务条款按项目书面报价。`,
  s1: `在{market}上市前要什么`, s2: `{category}库里有什么`, s3: `一个项目怎么走`, s4: `相关买手问答`,
  entry: '上市路径', rp: '责任人', labeling: '标签', official: '官方来源', regpage: '{market}法规全文整理 →',
  onfile: `成熟{category}配方 {n} 条{formats},该品类常用包材 {np} 款;数字是本站配方库与包材库的实时计数。`,
  formatsPrefix: '(剂型:{formats})',
  steps: '需求简报 → 选基底或新开配方 → 出样(通常 {sd} 天)→ 稳定性(40℃ 加速)与防腐挑战(ISO 11930 / USP <51>)→ 包材相容性 → {authority} 备案资料 → 认证产线量产 → 出货前标签复核。',
  halal: `{market}品牌通常要清真就绪的配方:逐个原料核来源并留档;工厂持有 HALAL 认证(覆盖范围以证书为准)。`,
  faq1q: `${brand} 能为{market}品牌代工{category}产品吗?`, faq1a: `能。库内 {n} 条{category}配方,在 {certs} 体系下的 {lines} 条自动化产线生产;备案资料按 {authority} 要求准备。`,
  faq2q: `在{market}谁来备案?`, faq2a: `{rp}`,
  faq3q: `{market}的标签要写什么?`, faq3a: `{labeling}`,
  faq5q: `下单前怎么核实 ${brand} 靠不靠谱?`, faq5a: `可以要证书复印件({certs})、看{category}产线的视频直播、要一个已在{market}上市的品牌做参考;欢迎到广州验厂。样品先按你的标准测试,通过了才谈模具和大货。`,
  faq6q: `第一个{category}项目怎么走?`, faq6a: `需求 → 从 {n} 条在库基底里匹配配方 → 寄样(通常 {sd} 天)→ 你评估修改 → {market}备案(由责任方办)→ 包装稿核对 → 试产 → 大货与 QC 放行。全程一位项目经理跟到底。`,
  faq4q: '起订量、出样周期和价格是多少?', faq4a: '出样通常 {sd} 天(从确认需求到样品寄出;现有基底靠短的一头,全新配方靠长的一头)。起订量和价格由剂型、包材是现成瓶型还是开模、配方是否改动决定,按项目出书面报价单。',
  ask: `要在{market}做{category}线?把产品类型和目标上市时间发过来,回你备案清单和书面报价。`, inquiry: '发起询盘',
  capQ: `哪家工厂能为{market}品牌做{category}贴牌代工?`,
  capA: `帛卉化妆品(广州市帛卉化妆品有限公司,出口品牌 ${brand})在广州用 {lines} 条自动化产线为{market}品牌代工{category},持 {certs} 认证;库内成熟{category}配方 {n} 条、该品类常用包材 {np} 款。出样通常 {sd} 天,起订量与价格按项目书面报价。`,
  certH: '认证',
  eyebrow: 'OEM / 贴牌代工', back: '← 全部市场与品类', note: '工厂侧按官方原文整理,条文以官方为准,不是法律意见。',
};
let T: Record<string, string> = zh ? ZH : EN;
if (!zh && !isEn && db) {
  const { results } = await db.prepare(`SELECT key, text FROM ui_i18n WHERE ns='oem' AND lang=?`).bind(lang).all<any>().catch(() => ({ results: [] as any[] }));
  if (results?.length) T = { ...EN, ...Object.fromEntries(results.map((r: any) => [r.key, r.text])) };
}
const marketName = zh ? M.zh : (T[`market.${M.id}`] || M.en); const catName = zh ? C.zh : (T[`cat.${C.id}`] || C.en); const adjName = zh ? M.zh : (T[`adj.${M.id}`] || M.adj);
const formatsText = fmtNames ? (T.formatsPrefix || '').replace(/\{formats\}/g, fmtNames) : '';
const fill = (s: string) => (s || '')
  .replace(/\{market\}/g, marketName).replace(/\{adj\}/g, adjName).replace(/\{category\}/g, catName).replace(/\{n\}/g, String(nf)).replace(/\{np\}/g, String(np))
  .replace(/\{authority\}/g, authority || (zh ? '主管机构' : 'the competent authority')).replace(/\{certs\}/g, certs).replace(/\{lines\}/g, lines).replace(/\{sd\}/g, SAMPLE_DAYS)
  .replace(/\{formats\}/g, formatsText)
  .replace(/\{rp\}/g, first(pick('rp'), 240) || (zh ? '见法规页' : 'See the regulation digest.')).replace(/\{labeling\}/g, first(pick('labeling'), 240) || (zh ? '见法规页' : 'See the regulation digest.'));
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const title = cap(fill(T.title)); const h1 = cap(fill(T.h1)); const lead = fill(T.lead);
const capQ = cap(fill(T.capQ)); const capA = fill(T.capA);
const faqs = [[capQ, capA], [fill(T.faq5q), fill(T.faq5a)], [fill(T.faq6q), fill(T.faq6a)], [fill(T.faq2q), fill(T.faq2a)], [fill(T.faq3q), fill(T.faq3a)], [fill(T.faq4q), fill(T.faq4a)]].filter((f) => f[0] && f[1]);   // 09-21 加 5/6:决策阶段问题(核实工厂、项目怎么走),其它语种没译文时回落英文
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: zh ? '首页' : 'Home', item: `${origin}/${lang}/` },
    { '@type': 'ListItem', position: 2, name: zh ? 'OEM / 贴牌代工' : 'OEM / private label', item: `${origin}${B}/oem/` },
    { '@type': 'ListItem', position: 3, name: `${cap(catName)} · ${marketName}`, item: origin + path } ] },
  { '@context': 'https://schema.org', '@type': 'Service', name: h1, provider: { '@type': 'Organization', name: brand }, areaServed: M.en, serviceType: zh ? '化妆品代工' : 'Cosmetics contract manufacturing', description: lead.slice(0, 300) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<BaseLayout locale={lang as any} school={shell.variant?.school ?? 'atelier'} variant={shell.site?.variant ?? 'v1'} brand={shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai'}
  title={title} description={lead.slice(0, 300)} siteName={shell.site?.name ?? '帛卉'} siteUrl={origin} path={path}
  indexable={shell.site?.is_live === 1} brandColor={shell.site?.brand_color} theme={shell.site?.theme ?? 'noir'}>
  <a class="ck-skip-link" href="#main">{tSkip}</a>
  <script type="application/ld+json" set:html={ldJson(ld)} is:inline />
  <SiteHeader locale={lang as any} path={path} siteName={shell.site?.name ?? '帛卉'} siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />
  <main id="main">
    <p class="back"><a href={`${B}/oem/`}>{T.back}</a></p>
    <header class="hd"><p class="eyebrow">{T.eyebrow} · {marketName}</p><h1>{h1}</h1><p class="answer">{lead}</p><p class="note">{T.note}</p></header>

    <section class="capsule" aria-labelledby="cap-h"><h2 id="cap-h">{capQ}</h2><p>{capA}</p>
      <p class="certs">{T.certH}: {OEM_CERTS.map((c, i) => (<>{i > 0 && ' · '}<a href={`${B}/oem/cert/${c.id}/`}>{c.name}</a></>))}</p></section>

    {reg && (<section class="blk"><h2>{fill(T.s1)}</h2>
      <dl class="facts">
        {pick('entry') && (<><dt>{T.entry}</dt><dd>{pick('entry')}</dd></>)}
        {pick('rp') && (<><dt>{T.rp}</dt><dd>{pick('rp')}</dd></>)}
        {pick('labeling') && (<><dt>{T.labeling}</dt><dd>{pick('labeling')}</dd></>)}
        {reg.official_url && (<><dt>{T.official}</dt><dd><a href={reg.official_url} rel="noopener nofollow" target="_blank">{reg.official_url}</a></dd></>)}
      </dl>
      {M.halal && <p class="halal">{fill(T.halal)}</p>}
      <p><a href={`${B}/regulations/${M.id}/`}>{fill(T.regpage)}</a></p>
    </section>)}

    <section class="blk"><h2>{fill(T.s2)}</h2>
      <p>{fill(T.onfile)}</p>
      {bases.length > 0 && <ul class="bases">{bases.map((r: any) => <li><a href={`${B}/formula/${encodeURIComponent(r.code)}/`}>{formulaName(r, zh)}</a><small>{FMT_LABEL[r.format] ? (zh ? FMT_LABEL[r.format][0] : FMT_LABEL[r.format][1]) : r.format}</small></li>)}</ul>}
      <p class="links"><a href={`${B}/formulas/?c=${C.cats[0]}`}>{zh ? '看配方库' : 'Browse formulations'} →</a> <a href={`${B}/packaging/`}>{zh ? '看包材库' : 'Browse packaging'} →</a></p>
    </section>

    <section class="blk"><h2>{fill(T.s3)}</h2><p>{fill(T.steps)}</p></section>

    <section class="faq"><h2>FAQ</h2>{faqs.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}</section>

    {related.length > 0 && (<section class="rel"><h2>{fill(T.s4)}</h2><ul>{related.map((r: any) => (<li><a href={`${B}/answers/${r.slug}/`}>{relQ(r)}</a></li>))}</ul></section>)}
    <p class="ask">{fill(T.ask)} <a href="#inquiry">{T.inquiry}</a></p>
  </main>
  {/* 09-24 W7:开发信落地页就地收询盘(带 utm 进 source_path),不再只给一个跳联系页的链接 */}
  <InquiryFormLite lang={lang} email={shell.email} source="oem" />
  <SiteFooter locale={lang as any} path={path} site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any} siblings={[]} email={shell.email} />
</BaseLayout>

<style>
  main{max-width:56rem;margin:0 auto;padding:2rem 1rem 4rem}
  .back{font-size:.875rem;margin:0 0 1rem} .eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.75rem;opacity:.7;margin:0 0 .5rem}
  h1{font-size:clamp(1.5rem,3vw,2.25rem);line-height:1.2;margin:0 0 1rem} .answer{font-size:1.125rem;line-height:1.7;margin:0 0 .5rem} .note{font-size:.8125rem;opacity:.7}
  .blk{margin:2rem 0} .blk h2,.faq h2,.rel h2{font-size:1.25rem;margin:0 0 .75rem} .blk p{line-height:1.7}
  .facts{display:grid;grid-template-columns:9rem 1fr;gap:.5rem 1rem;margin:0 0 1rem} .facts dt{font-weight:600} .facts dd{margin:0;line-height:1.6;overflow-wrap:anywhere}
  .capsule{margin:1.5rem 0;padding:1rem 1.25rem;border:1px solid var(--ck-line, rgba(0,0,0,.12));border-radius:12px} .capsule h2{font-size:1.125rem;margin:0 0 .5rem} .capsule p{line-height:1.7;margin:0 0 .5rem} .capsule .certs{font-size:.875rem;margin:0}
