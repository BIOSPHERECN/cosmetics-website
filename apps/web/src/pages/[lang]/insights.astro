---
/**
 * BEAUTY2OEM「洞察」页(09-24 W6):市场调研对外版 v1(红线审后)原文上站,纯中文。
 * 正文在同目录 _insights-v1.md(源:助手交付/BEAUTY2OEM/市场调研-v1/跨境美妆卖家选品与供应链洞察-对外版-v1.md,
 * 只改两处:品牌行「帛卉(BIOSPHERE)」→「帛卉化妆品」、询盘入口 → /zh-cn/brief/)。表格与脚注靠 Astro 自带 GFM,零新依赖。
 * 只在 beauty2oem 出;别的站 404(工厂站不挂这份,middleware 也只把 insights/ 列进 B2O 白名单)。
 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../lib/shell';
import { Content } from './_insights-v1.md';

export const prerender = false;

const lang = Astro.params.lang ?? 'zh-cn';
const db = (env as any).DB as D1Database | undefined;
const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
if (shell.site?.id !== 'beauty2oem' || lang !== 'zh-cn') return new Response('Not found', { status: 404 });

const path = `/${lang}/insights/`;
const title = '跨境美妆卖家选品与供应链洞察(2026 秋)';
const desc = '写给国内跨境美妆卖家:出口与平台数据、选品与选厂逻辑、17 个市场的准入要点,以及帛卉基于美国亚马逊榜单快照和各国法规原文的六条独家洞察。每个数字都有出处脚注。';
---

<BaseLayout
  locale={lang as any} school={shell.variant?.school ?? 'atelier'} variant={shell.site?.variant ?? 'v1'}
  brand={shell.site!.id} title={title} description={desc} siteName={shell.site!.name}
  siteUrl={`https://${shell.site!.domain}`} path={path}
  indexable={shell.site!.is_live === 1} brandColor={shell.site!.brand_color} theme={shell.site!.theme ?? 'dtc'}
>
  <a class="ck-skip-link" href="#main">跳到正文</a>
  <SiteHeader locale={lang as any} path={path} siteName={shell.site!.name} siteNameZh={shell.site!.tagline ?? ''}
              nav={shell.nav} showLocaleSwitch={false} />
  <main id="main" class="ins">
    <p class="eyebrow">洞察 · 帛卉化妆品公开研究 v1 · 数据截至 2026-09-23</p>
    <h1>{title}</h1>
    <article class="doc"><Content /></article>
    <p class="cta"><a class="btn" href="/zh-cn/brief/">提交店铺,拿机会简报 →</a></p>
  </main>
  <SiteFooter locale={lang as any} path={path} site={{ ...(shell.staticSite ?? {}), name: shell.site!.name } as any}
              siblings={[]} email={shell.email} nav={shell.nav} showLocaleSwitch={false} cnOnly={true} />

  <style>
    .ins { max-width: 56rem; margin: 0 auto; padding: 3rem var(--ck-gutter, 1rem) 4rem; }
    .eyebrow { font-size: .875rem; color: var(--ck-ink-soft); margin: 0 0 .5rem; }
    h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 650; letter-spacing: -.02em; line-height: 1.25; margin: 0 0 2rem; }
    .doc :global(h2) { font-size: 1.5rem; margin: 3rem 0 1rem; }
    .doc :global(h3) { font-size: 1.1875rem; margin: 2rem 0 .75rem; }
    .doc :global(p), .doc :global(li) { font-size: 1rem; line-height: 1.8; color: var(--ck-ink-soft); }
    .doc :global(p) { margin: 0 0 1rem; }
    .doc :global(ul), .doc :global(ol) { padding-inline-start: 1.25rem; margin: 0 0 1rem; }
    .doc :global(strong) { color: var(--ck-ink, inherit); }
    .doc :global(blockquote) { margin: 1rem 0; padding: .75rem 1rem; border-inline-start: 3px solid var(--ck-accent); background: rgb(0 0 0 / .03); border-radius: 8px; }
    .doc :global(blockquote p) { margin: 0; font-size: .9375rem; }
    .doc :global(hr) { border: 0; border-top: 1px solid rgb(0 0 0 / .1); margin: 2.5rem 0; }
    /* 宽表在手机上横向滚动,不撑破页面 */
    .doc :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 0 0 1.25rem; font-size: .875rem; line-height: 1.6; }
    .doc :global(th), .doc :global(td) { border: 1px solid rgb(0 0 0 / .12); padding: .5rem .625rem; vertical-align: top; min-width: 5rem; }
    .doc :global(th) { background: rgb(0 0 0 / .04); text-align: start; white-space: nowrap; }
    .doc :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
    .doc :global(sup a) { text-decoration: none; color: var(--ck-accent); padding: 0 .1em; }
    .doc :global(.footnotes) { margin-top: 3rem; font-size: .8125rem; }
    .doc :global(.footnotes li) { font-size: .8125rem; line-height: 1.65; overflow-wrap: anywhere; }
    .cta { margin: 2.5rem 0 0; }
    .btn { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.375rem; border-radius: 980px; text-decoration: none;
           font-size: .9375rem; font-weight: 600; background: var(--ck-accent); color: var(--ck-on-accent); }
  </style>
</BaseLayout>
