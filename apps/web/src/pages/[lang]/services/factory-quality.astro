---
/**
 * W5: services 子页可见证据补丁。
 * 线上 CMS 空壳页缺三证与 RFQ；本 Astro 页覆盖同路径，复述 hub 已有 held-only 三证 + 打样逻辑 + RFQ，并明确指回 /services/。
 * 红线：不编造证书 / 不写未核准低 MOQ。
 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../../lib/shell';

export const prerender = false;

const lang = Astro.params.lang ?? 'zh-cn';
const zh = String(lang).startsWith('zh');
const db = (env as any).DB as D1Database | undefined;
const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const path = `/${lang}/services/factory-quality/`;
const origin = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;
const B = `/${lang}`;

const T = zh ? {
  title: '工厂与质量',
  lede: '工厂持证、产线与质检口径的摘要页。完整七步与认证说明见服务枢纽；本页只复述站上已有、已持有的认证，不新增证书口号。',
  focus: '质量与放行：按 QC 项目检验；放行报告随货。FDA / CPNP 等为注册或通报路径，不作工厂「认证」口号。',
  certsH: '工厂已有认证（仅列真有）',
  certs: '按工厂口径仅列出：GMPC、ISO 22716:2007、HALAL。FDA / CPNP 等为注册或通报路径，不作「认证」口号。',
  sampleH: '打样逻辑',
  sample: '确认品类与目标市场后打样；寄样通常 5–14 天（按品类与包材备料，书面告知）。样品签样后进入量产排程。起订量按品类与包材议定，不以未核准低 MOQ 口号对外承诺。',
  hub: '查看完整服务枢纽（七步 · 三证 · RFQ）',
  rfq: '提交 RFQ / 申请样品',
  oem: '按市场与品类看 OEM',
} : {
  title: 'Factory & quality',
  lede: 'Summary of plant certifications, lines and QC terms. Full seven-step process and certification notes live on the services hub. This page only restates held certifications already published on the site — no new certificate claims.',
  focus: 'Quality & release: QC checklist; release report ships with the goods. FDA / CPNP are registration or notification routes — never marketed as plant certifications.',
  certsH: 'Plant certifications on file (held only)',
  certs: 'Per factory terms we list only: GMPC, ISO 22716:2007, and HALAL. FDA / CPNP are registration or notification routes — never marketed as plant certifications.',
  sampleH: 'Sampling logic',
  sample: 'Sampling starts after category and target market are clear. Samples typically ship in 5–14 days (by category and packaging stock; confirmed in writing). Mass production is scheduled after sample sign-off. MOQ is agreed per category and packaging — we do not promise unapproved low-MOQ slogans.',
  hub: 'Open the full services hub (7 steps · certifications · RFQ)',
  rfq: 'Submit RFQ / request sample',
  oem: 'OEM by market & category',
};
---
<BaseLayout
  locale={lang}
  school={shell.variant?.school ?? 'atelier'}
  variant={shell.site?.variant ?? 'v1'}
  brand={shell.site?.id ?? 'biosphere-ai'}
  title={`${T.title} | BIOSPHERE`}
  description={T.lede}
  siteName={shell.site?.name ?? '帛卉'}
  siteUrl={origin}
  path={path}
  indexable={shell.site?.is_live === 1}
  brandColor={shell.site?.brand_color}
  theme={shell.site?.theme ?? 'noir'}
>
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'}
              siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />
  <main id="main" class="sv-sub">
    <header class="hd">
      <p class="crumb"><a href={`${B}/services/`}>{zh ? '← 服务枢纽' : '← Services hub'}</a></p>
      <h1>{T.title}</h1>
      <p class="lede">{T.lede}</p>
      <p class="focus">{T.focus}</p>
    </header>

    <section id="sv-certs" aria-labelledby="certs-h">
      <h2 id="certs-h">{T.certsH}</h2>
      <p>{T.certs}</p>
      <ul>
        <li>GMPC</li>
        <li>ISO 22716:2007</li>
        <li>HALAL</li>
      </ul>
    </section>

    <section id="sv-sample" aria-labelledby="sample-h">
      <h2 id="sample-h">{T.sampleH}</h2>
      <p>{T.sample}</p>
    </section>

    <p class="cta">
      <a class="btn" href={`${B}/services/#services-evidence`}>{T.hub}</a>
      <a class="btn primary" href={`${B}/rfq/`}>{T.rfq}</a>
      <a class="btn ghost" href={`${B}/oem/`}>{T.oem}</a>
    </p>
  </main>
  <SiteFooter locale={lang} path={path}
              site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any}
              siblings={[]} email={shell.email} nav={shell.nav} />
</BaseLayout>

<style>
  .sv-sub { max-width: 44rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  .crumb { margin: 0 0 .75rem; font-size: .875rem; }
  .crumb a { color: inherit; opacity: .7; text-decoration: none; }
  .crumb a:hover { opacity: 1; text-decoration: underline; }
  .hd h1 { margin: 0 0 .75rem; font-size: clamp(1.5rem, 3vw, 2rem); }
  .lede, .focus, section p { line-height: 1.65; opacity: .9; }
  section { margin: 2rem 0; }
  section h2 { font-size: 1.125rem; margin: 0 0 .5rem; }
  ul { margin: .5rem 0 0; padding-left: 1.25rem; }
  .cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .btn { display: inline-flex; align-items: center; padding: .55rem 1rem; border: 1px solid currentColor; border-radius: 999px; text-decoration: none; color: inherit; font-weight: 600; font-size: .875rem; }
  .btn.primary { background: var(--ck-accent, #222); color: #fff; border-color: transparent; }
  .btn.ghost { opacity: .8; }
</style>
