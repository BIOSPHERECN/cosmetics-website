---
import { siteIdForHost } from '@cosmetic/core/content/tenant-map.ts';
import { t as uiT } from '@cosmetic/core/i18n';
/**
 * 买手问答 —— 答案型内容的入口页。按「使用场景 / 功能对比 / 购买决策」三维列出问句。
 *
 * 由来(创始人 2026-09-10 12:3x 发来一套 GEO 打法:「都去用这个 SEO 方法去做独立站」,
 * 并说「抓紧变现,才是我们急需要做的」)。
 *
 * 这一页只做一件事:让 AI 答案引擎与搜索引擎一眼看到**整句的、带购买意图的问题**,
 * 每个问题指向一页结论前置的答案。问句是买手会敲进对话框的原话,不是关键词堆。
 *
 * 内容规则见 tools/geo-answers.py:每个数字从库里取,取不到就不生成;不用第一人称品牌口吻。
 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../../lib/shell';

export const prerender = false;

const lang = Astro.params.lang ?? 'zh-cn';
const zh = lang.startsWith('zh');
const tSkip = uiT(lang as any)('a11y.skip');
const db = (env as any).DB as D1Database | undefined;

let rows: any[] = [];
if (db) {
  try {
    rows = ((await db.prepare(
      'SELECT slug, dim, q_zh, q_en, lead_zh, lead_en, updated_at FROM geo_answers ORDER BY dim, slug')
      .all<any>()).results ?? []) as any[];
  } catch { rows = []; }
}
/* 多语言(2026-09-16):非中英语种的问句与结论取 geo_answers_i18n,没有的回落英文 */
if (db && !zh && lang !== 'en') {
  try {
    const { results } = await db.prepare('SELECT slug, q, lead FROM geo_answers_i18n WHERE lang=?').bind(lang).all<any>();
    const m = new Map((results ?? []).map((r: any) => [r.slug, r]));
    for (const r of rows) { const t = m.get(r.slug); if (t) { r.q_en = t.q; r.lead_en = t.lead; } }
  } catch { /* 回落英文 */ }
}
const DIMS = ['scene', 'compare', 'decide'];
const byDim = new Map<string, any[]>();
for (const r of rows) {
  if (!byDim.has(r.dim)) byDim.set(r.dim, []);
  byDim.get(r.dim)!.push(r);
}

const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const path = `/${lang}/answers/`;
const origin = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;

const T = zh ? {
  eyebrow: '买手问答',
  title: '代工下单前,买手最常问的问题',
  lede: `${rows.length} 个问题,每个都是整句、带购买意图的原话;答案结论前置、按场景分点、每点带具体数字,`
      + '数字全部来自站内配方库、包材库、质检体系与备案索引的真实记录。',
  dims: { scene: '使用场景', compare: '功能对比', decide: '购买决策' },
  open: '看答案',
  ask: '问题里没有你要的?把品类与目标市场发过来,按实际情况答。', inquiry: '发起询盘',
} : {
  eyebrow: 'Buyer questions',
  title: 'What buyers ask before placing an OEM order',
  lede: `${rows.length} questions, each a full sentence with purchase intent. Every answer leads with the conclusion, breaks down by scenario `
      + 'with concrete figures, and every figure comes from live records on this site — formulations, packaging, quality control, notification index.',
  dims: { scene: 'Use scenarios', compare: 'Comparisons', decide: 'Purchase decisions' },
  open: 'Read the answer',
  ask: 'Question not covered? Send the category and target market.', inquiry: 'Send an inquiry',
};

const ld = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: zh ? '首页' : 'Home', item: `${origin}/${lang}/` },
      { '@type': 'ListItem', position: 2, name: T.title, item: origin + path },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: rows.map((r) => ({
      '@type': 'Question', name: zh ? r.q_zh : r.q_en,
      acceptedAnswer: { '@type': 'Answer', text: zh ? r.lead_zh : r.lead_en,
                        url: `${origin}/${lang}/answers/${r.slug}/` },
    })),
  },
];
---

<BaseLayout
  locale={lang} school={shell.variant?.school ?? 'atelier'} variant={shell.site?.variant ?? 'v1'}
  brand={shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai'}
  title={T.title} description={T.lede}
  siteName={shell.site?.name ?? '帛卉'} siteUrl={origin} path={path}
  indexable={shell.site?.is_live === 1} brandColor={shell.site?.brand_color}
  theme={shell.site?.theme ?? 'noir'}
>
  <a class="ck-skip-link" href="#main">{tSkip}</a>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'}
              siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />
  <main id="main">
    <header class="hd">
      <p class="eyebrow">{T.eyebrow}</p>
      <h1>{T.title}</h1>
      <p class="lede">{T.lede}</p>
    </header>

    {DIMS.filter((d) => (byDim.get(d) ?? []).length).map((d) => (
      <section class="dim">
        <h2>{(T.dims as any)[d]}</h2>
        <ul class="qs">
          {(byDim.get(d) ?? []).map((r) => (
            <li class="q">
              <a href={`/${lang}/answers/${r.slug}/`}>
                <h3>{zh ? r.q_zh : r.q_en}</h3>
                <p>{zh ? r.lead_zh : r.lead_en}</p>
                <span class="go">{T.open} →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="ask"><a href={`/${lang}/oem/`}>{zh ? '按市场与品类找代工 →' : 'Find a manufacturer by market and category →'}</a></p>
    <p class="ask">{T.ask} <a href={`/${lang}/contact/`}>{T.inquiry}</a></p>
  </main>
  <SiteFooter locale={lang} path={path}
              site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any}
              siblings={[]} email={shell.email} nav={shell.nav} />
</BaseLayout>

<style>
  main { max-width: 112.5rem; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
  .hd { display: grid; gap: .75rem; margin-bottom: 1.5rem; max-width: 62rem; }
  .eyebrow { font-size: .8125rem; letter-spacing: .12em; text-transform: uppercase; opacity: .6; margin: 0; }
  h1 { font-size: clamp(1.625rem, 3vw, 2.25rem); line-height: 1.24; margin: 0; text-wrap: balance; }
  .lede { font-size: 1rem; line-height: 1.75; opacity: .85; margin: 0; }
  .dim { margin: 0 0 2rem; }
  .dim h2 { font-size: 1.25rem; margin: 0 0 .75rem; }
  .qs { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
  .q a { display: grid; gap: .375rem; padding: 1rem 1.125rem; border-radius: 12px; text-decoration: none; color: inherit;
         border: 1px solid var(--ck-line, rgba(0,0,0,.12)); }
  .q a:hover { border-color: var(--ck-ink, rgba(0,0,0,.4)); }
  .q h3 { font-size: 1.0625rem; line-height: 1.45; margin: 0; }
  .q p { margin: 0; font-size: .9375rem; line-height: 1.7; opacity: .78; }
  .go { font-size: .9375rem; font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  .ask { margin: 1.75rem 0 0; font-size: .9375rem; line-height: 1.75; opacity: .85; }
  @media (min-width: 900px) {
    main { padding: 2rem 1.5rem 4rem; }
    .qs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
