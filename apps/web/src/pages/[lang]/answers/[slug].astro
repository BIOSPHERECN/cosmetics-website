---
import { ldJson } from '@cosmetic/core/content/ldjson.ts';
import { siteIdForHost } from '@cosmetic/core/content/tenant-map.ts';
import { t as uiT } from '@cosmetic/core/i18n';
/**
 * 单个买手问题的答案页 —— 结论前置、按场景分点、每点带数字、结尾 FAQ。
 *
 * 结构是给 AI 答案引擎看的:第一段就是可以被整段引用的结论;
 * 中间每一点都能单独摘出来当一条事实;FAQ 用 Question/Answer 结构化数据标出来。
 * 不用「我们」「本公司」—— 客观陈述才会被引用,广告口吻不会。
 *
 * 数字来源:tools/geo-answers.py 生成时从配方库、包材库、质检体系、备案索引取的真实记录。
 * 页面底部把来源链接列出来,读者能自己点回去核。
 */
import { env } from 'cloudflare:workers';
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import { pageShell } from '../../../lib/shell';

export const prerender = false;

const lang = Astro.params.lang ?? 'zh-cn';
const zh = lang.startsWith('zh');
const tSkip = uiT(lang as any)('a11y.skip');
const db = (env as any).DB as D1Database | undefined;
const slug = String(Astro.params.slug ?? '').toLowerCase().slice(0, 80);

const row = db ? await db.prepare(
  'SELECT slug, dim, q_zh, q_en, lead_zh, lead_en, sections_json, faqs_json, sources_json, updated_at'
  + ' FROM geo_answers WHERE slug = ?').bind(slug).first<any>().catch(() => null) : null;
if (!row) return Astro.redirect(`/${lang}/answers/`, 302);

const parse = (s: string) => { try { return JSON.parse(s || '[]') || []; } catch { return []; } };
const sections: any[] = parse(row.sections_json);
const faqs: any[] = parse(row.faqs_json);
const sources: any[] = parse(row.sources_json);
/* 多语言(2026-09-16):中 / 英在主表;其它 15 语在 geo_answers_i18n(tools/geo-answers-i18n.py 用免费舰队翻),没有就回落英文 */
const isEn = lang === 'en';
const tr = (!zh && !isEn && db) ? await db.prepare('SELECT q, lead, sections_json, faqs_json FROM geo_answers_i18n WHERE slug=? AND lang=?').bind(slug, lang).first<any>().catch(() => null) : null;
const q = zh ? row.q_zh : (tr?.q || row.q_en);
const lead = zh ? row.lead_zh : (tr?.lead || row.lead_en);
const secsL: { h: string; b: string }[] = tr ? parse(tr.sections_json) : sections.map((x: any) => ({ h: zh ? x.h_zh : x.h_en, b: zh ? x.b_zh : x.b_en }));
const faqsL: { q: string; a: string }[] = tr ? parse(tr.faqs_json) : faqs.map((x: any) => ({ q: zh ? x.q_zh : x.q_en, a: zh ? x.a_zh : x.a_en }));

const shell = await pageShell(db, Astro.url, lang, Astro.cookies);
const path = `/${lang}/answers/${row.slug}/`;
const origin = `https://${shell.site?.domain ?? 'biosphere-ai.com'}`;

const T = zh ? {
  eyebrow: '买手问答', back: '全部问题', faq: '常见追问', src: '数字来源(站内可核)',
  updated: '更新于', ask: '按你的品类与目标市场重新算一遍?', inquiry: '发起询盘',
  dims: { scene: '使用场景', compare: '功能对比', decide: '购买决策' } as Record<string, string>,
} : {
  eyebrow: 'Buyer questions', back: 'All questions', faq: 'Follow-up questions', src: 'Figures sourced from',
  updated: 'Updated', ask: 'Want this worked out for your category and target market?', inquiry: 'Send an inquiry',
  dims: { scene: 'Use scenarios', compare: 'Comparisons', decide: 'Purchase decisions' } as Record<string, string>,
};

const ld = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: zh ? '首页' : 'Home', item: `${origin}/${lang}/` },
      { '@type': 'ListItem', position: 2, name: T.eyebrow, item: `${origin}/${lang}/answers/` },
      { '@type': 'ListItem', position: 3, name: q, item: origin + path },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: lead } },
      ...faqsL.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: q, description: lead, dateModified: String(row.updated_at || ''),
    author: { '@type': 'Organization', name: shell.site?.name ?? 'BIOSPHERE' },
    mainEntityOfPage: origin + path,
  },
];
---

<BaseLayout
  locale={lang} school={shell.variant?.school ?? 'atelier'} variant={shell.site?.variant ?? 'v1'}
  brand={shell.site?.id ?? siteIdForHost(Astro.url.hostname) ?? 'biosphere-ai'}
  title={q} description={lead}
  siteName={shell.site?.name ?? '帛卉'} siteUrl={origin} path={path}
  indexable={shell.site?.is_live === 1} brandColor={shell.site?.brand_color}
  theme={shell.site?.theme ?? 'noir'}
>
  <a class="ck-skip-link" href="#main">{tSkip}</a>
  <script type="application/ld+json" set:html={ldJson(ld)} is:inline />
  <SiteHeader locale={lang} path={path} siteName={shell.site?.name ?? '帛卉'}
              siteNameZh={shell.site?.tagline ?? ''} nav={shell.nav} />
  <main id="main">
    <article>
      <header class="hd">
        <p class="eyebrow"><a href={`/${lang}/answers/`}>{T.eyebrow}</a> · {T.dims[row.dim] ?? row.dim}</p>
        <h1>{q}</h1>
        <p class="lead">{lead}</p>
      </header>

      {secsL.map((s, i) => (
        <section class="sec">
          <h2><span class="n">{i + 1}</span>{s.h}</h2>
          <p>{s.b}</p>
        </section>
      ))}

      {faqsL.length > 0 && (
        <section class="faq">
          <h2>{T.faq}</h2>
          <dl>
            {faqsL.map((f) => (<>
              <dt>Q:{f.q}</dt>
              <dd>A:{f.a}</dd>
            </>))}
          </dl>
        </section>
      )}

      {sources.length > 0 && (
        <p class="src">{T.src}:
          {sources.map((s) => <a href={s.u.replace('/zh-cn/', `/${lang}/`)}>{s.t}</a>)}
        </p>
      )}
      <p class="upd">{T.updated} {String(row.updated_at || '').slice(0, 10)}</p>
      <p class="ask">{T.ask} <a href={`/${lang}/contact/`}>{T.inquiry}</a></p>
      <p class="back"><a href={`/${lang}/answers/`}>← {T.back}</a></p>
    </article>
  </main>
  <SiteFooter locale={lang} path={path}
              site={{ ...(shell.staticSite ?? {}), name: shell.site?.name ?? '帛卉' } as any}
              siblings={[]} email={shell.email} nav={shell.nav} />
</BaseLayout>

<style>
  main { max-width: 112.5rem; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
  article { max-width: 62rem; }
  .hd { display: grid; gap: .75rem; margin-bottom: 1.75rem; }
  .eyebrow { font-size: .8125rem; letter-spacing: .12em; text-transform: uppercase; opacity: .6; margin: 0; }
  .eyebrow a { color: inherit; }
  h1 { font-size: clamp(1.5rem, 3vw, 2.125rem); line-height: 1.3; margin: 0; text-wrap: balance; }
  /* 结论段是这一页最重要的一段 —— 字号比正文大一档,AI 与人都先看到它 */
  .lead { font-size: 1.125rem; line-height: 1.75; margin: 0; padding: 1rem 1.125rem; border-radius: 12px;
          border: 1px solid var(--ck-line, rgba(0,0,0,.14)); background: var(--ck-paper, rgba(0,0,0,.02)); }
  .sec { margin: 0 0 1.5rem; }
  .sec h2 { font-size: 1.125rem; margin: 0 0 .375rem; display: flex; gap: .625rem; align-items: baseline; }
  .n { font-size: .8125rem; opacity: .55; font-variant-numeric: tabular-nums; }
  .sec p { margin: 0; font-size: 1rem; line-height: 1.8; }
  .faq { margin: 2rem 0 0; padding: 1.125rem 1.25rem; border-radius: 12px; border: 1px solid var(--ck-line, rgba(0,0,0,.12)); }
  .faq h2 { font-size: 1.0625rem; margin: 0 0 .75rem; }
  .faq dl { margin: 0; display: grid; gap: .5rem; }
  .faq dt { font-weight: 600; font-size: 1rem; line-height: 1.6; }
  .faq dd { margin: 0 0 .5rem; font-size: .9375rem; line-height: 1.75; opacity: .85; }
  .src { margin: 1.5rem 0 0; font-size: .9375rem; line-height: 1.9; opacity: .8; }
  .src a { margin-right: .875rem; color: inherit; min-height: 44px; display: inline-flex; align-items: center; }
  .upd { margin: .25rem 0 0; font-size: .8125rem; opacity: .55; }
  .ask { margin: 1.5rem 0 0; font-size: .9375rem; line-height: 1.75; opacity: .85; }
  .back { margin: 1rem 0 0; font-size: .9375rem; }
  .back a { color: inherit; min-height: 44px; display: inline-flex; align-items: center; }
  @media (min-width: 900px) { main { padding: 2rem 1.5rem 4rem; } }
</style>
