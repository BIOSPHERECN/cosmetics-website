---
/**
 * 销售知识库 —— 创始人 2026-09-16:「Google 就能搜到很多,作为 CRM 的知识库,让业务员快速提升」;
 * 05:22 看了 jxxy.net:「他们做得专业,我们太乱」→ 改成专业知识库的组织法:
 *   搜索框 + 类型 × 阶段两组切面 + 内容分型(规则 / 策略 / 工作流 / 提示词 / 模板 / 案例 / 路径 / 资料)+ 学习路径置顶 + 「问知识库」。
 * `rules-for-ai` 会进 AI 提示词,改它等于改 AI 的写法,页面上标黄。
 */
import AdminShell from '../../layouts/AdminShell.astro';
import { pageGuard } from '../../lib/guard';
import { mdLite } from '../../lib/md-lite';

export const prerender = false;
const c = await pageGuard(Astro.request);
if (!c) return Astro.redirect('/bohui/login/');
const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') ?? '').trim();
const kind = url.searchParams.get('kind') ?? '';
const stage = url.searchParams.get('stage') ?? '';
const KINDS = ['路径', '工作流', '规则', '策略', '提示词', '模板', '案例', '资料', '知识卡片', '方法卡'];   // 后两类 09-24 C4:走人审上下线,在 /bohui/kb 操作
const STAGES = ['找客户', '背调', '开发信', '跟进', '询盘', '谈判', '合规', '市场', '通用'];

const where: string[] = [], bind: unknown[] = [];
if (q) { where.push('(title LIKE ? OR tags LIKE ? OR body LIKE ?)'); bind.push(`%${q}%`, `%${q}%`, `%${q}%`); }
if (kind) { where.push('kind=?'); bind.push(kind); }
if (stage) { where.push('stage=?'); bind.push(stage); }
const W = where.length ? `WHERE ${where.join(' AND ')}` : '';
const { results: all } = await c.db.prepare(`SELECT slug, kind, stage, title, tags, updated_at, length(body) n FROM playbooks ${W} ORDER BY sort, title`).bind(...bind).all<any>();
const { results: counts } = await c.db.prepare(`SELECT kind, stage, COUNT(*) n FROM playbooks GROUP BY kind, stage`).all<any>();
const kc: Record<string, number> = {}, sc: Record<string, number> = {};
for (const r of counts) { kc[r.kind] = (kc[r.kind] || 0) + r.n; sc[r.stage] = (sc[r.stage] || 0) + r.n; }
const total = counts.reduce((s: number, r: any) => s + r.n, 0);
/* 外部参考库:有搜索词才查(几千篇的库不列全表);展示标题 + 来源 + 前 200 字 */
const refs = q ? (await c.db.prepare(`SELECT slug, title, category, source_url, source_site, substr(body, 1, 200) snip FROM kb_docs WHERE title LIKE ? OR tags LIKE ? OR body LIKE ? ORDER BY imported_at DESC LIMIT 20`).bind(`%${q}%`, `%${q}%`, `%${q}%`).all<any>().catch(() => ({ results: [] as any[] }))).results : [];
const refTotal = (await c.db.prepare(`SELECT COUNT(*) n FROM kb_docs`).first<{ n: number }>().catch(() => null))?.n ?? 0;
const ref = url.searchParams.get('ref') ? await c.db.prepare(`SELECT * FROM kb_docs WHERE slug=?`).bind(url.searchParams.get('ref')).first<any>().catch(() => null) : null;
const want = url.searchParams.get('s') ?? '';
const slug = want && (await c.db.prepare(`SELECT slug FROM playbooks WHERE slug=?`).bind(want).first()) ? want : (all[0]?.slug ?? '');
const cur = slug ? await c.db.prepare(`SELECT * FROM playbooks WHERE slug=?`).bind(slug).first<any>() : null;
const edit = url.searchParams.get('edit') === '1';
const link = (p: Record<string, string>) => { const u = new URLSearchParams(); if (q) u.set('q', q); if (kind) u.set('kind', kind); if (stage) u.set('stage', stage); for (const [k, v] of Object.entries(p)) v ? u.set(k, v) : u.delete(k); return `?${u}`; };
const KC: Record<string, string> = { 路径: '#0b6e64', 工作流: '#1d4ed8', 规则: '#7c3aed', 策略: '#b45309', 提示词: '#0f766e', 模板: '#be185d', 案例: '#a16207', 资料: '#475569', 知识卡片: '#15803d', 方法卡: '#4338ca' };
---

<AdminShell title="销售知识库" active="playbook" email={c.sess.email} tenant={c.tenant}>
  <div class="hd">
    <div><h1>销售知识库</h1><p class="lead">{total} 篇 · 规则 / 工作流 / 提示词 / 模板 / 案例,按阶段找;先「问知识库」,没有再翻。AI 写信的规则也在这里改。</p></div>
    <a class="btn" href={link({ s: '', edit: '1' })}>+ 新建一篇</a>
  </div>

  <form class="search" method="get">
    <input name="q" value={q} placeholder="搜:MOQ 太高怎么回 / 第二封怎么写 / 印尼 / GDPR / 提示词…" />
    {kind && <input type="hidden" name="kind" value={kind} />}{stage && <input type="hidden" name="stage" value={stage} />}
    <button class="btn" type="submit">搜索</button>
    <button class="btn pri" type="button" id="askbtn" title="把整个知识库喂给模型来答">问知识库</button>
  </form>
  <div id="answer" class="answer" hidden></div>

  <div class="facets">
    <div class="fr"><span class="fl">类型</span><a class:list={['chip', !kind && 'on']} href={link({ kind: '' })}>全部</a>{KINDS.map((k) => <a class:list={['chip', kind === k && 'on']} href={link({ kind: k })} style={`--c:${KC[k]}`}><i></i>{k}<small>{kc[k] || 0}</small></a>)}</div>
    <div class="fr"><span class="fl">阶段</span><a class:list={['chip', !stage && 'on']} href={link({ stage: '' })}>全部</a>{STAGES.map((s) => <a class:list={['chip', stage === s && 'on']} href={link({ stage: s })}>{s}<small>{sc[s] || 0}</small></a>)}</div>
  </div>

  {q && (
    <section class="refs">
      <b>外部参考库{refTotal ? `(共 ${refTotal} 篇)` : ''} · 命中 {refs.length}</b>
      {refs.length === 0 ? <p class="dim">参考库里没有「{q}」。{refTotal === 0 ? 'WorkBuddy 抓的资料放 data/kb/inbox/ 后跑 tools/crm/kb_import.py 就有了。' : ''}</p> : (
        <div class="rl">{refs.map((r: any) => <a class="r" href={link({ ref: r.slug })}><b>{r.title}</b><span>{r.category} · {r.source_site}</span><p>{r.snip}…</p></a>)}</div>
      )}
    </section>
  )}

  <div class="layout">
    <nav class="toc">
      {all.length === 0 && <p class="dim">没有匹配的内容。</p>}
      {all.map((p: any) => <a class:list={['t', p.slug === slug && 'on', p.slug === 'rules-for-ai' && 'ai']} href={link({ s: p.slug })}><span class="k" style={`--c:${KC[p.kind] || '#475569'}`}>{p.kind}</span><b>{p.title}</b><span class="m">{p.stage}{p.tags ? ` · ${p.tags}` : ''}</span></a>)}
    </nav>
    <article class="doc">
      {ref ? (
        <>
          <div class="dh"><span class="k big" style="--c:#475569">参考</span><span class="meta">{ref.category} · 来源 <a href={ref.source_url} target="_blank" rel="noreferrer">{ref.source_site}</a> · 只作内部参考</span><a class="btn" href={link({ ref: '' })}>返回</a></div>
          <h2 style="font-size:1.25rem;margin:.25rem 0 .75rem">{ref.title}</h2>
          <div class="md" set:html={mdLite(ref.body, { maxRows: 200 })} />
        </>
      ) : edit || !cur ? (
        <form id="ed" class="ed">
          <div class="row">
            <input name="slug" value={cur?.slug ?? ''} placeholder="slug(英文小写,如 market-indonesia)" required pattern="[a-z0-9-]+" readonly={!!cur} />
            <input name="title" value={cur?.title ?? ''} placeholder="标题" required />
          </div>
          <div class="row">
            <select name="kind">{KINDS.map((k) => <option value={k} selected={(cur?.kind ?? '规则') === k}>{k}</option>)}</select>
            <select name="stage">{STAGES.map((s) => <option value={s} selected={(cur?.stage ?? '通用') === s}>{s}</option>)}</select>
            <input name="tags" value={cur?.tags ?? ''} placeholder="标签,逗号分隔" />
          </div>
          {cur?.status && <p class="warn">这是一张卡。改了标题或正文,保存后回到「待审」,要管理员在知识库页重新人审才能对外用。</p>}
          {cur?.slug === 'rules-for-ai' &&<p class="warn">这一篇会原样进入开发信 / 询盘首回的模型提示词。改完看下一封信有没有按新规则写。</p>}
          <textarea name="body" rows="28" required>{cur?.body ?? ''}</textarea>
          <div class="row end"><a class="btn" href={cur ? link({ s: cur.slug }) : link({})}>取消</a><button class="btn pri" type="submit">保存</button></div>
        </form>
      ) : (
        <>
          <div class="dh">
            <span class="k big" style={`--c:${KC[cur.kind] || '#475569'}`}>{cur.kind}</span>
            <span class="meta">{cur.stage} · {cur.tags} · 更新 {String(cur.updated_at).slice(0, 16)}{cur.slug === 'rules-for-ai' ? ' · 进 AI 提示词' : ''}{cur.status ? ` · ${cur.status === '在用' ? `已人审(${cur.reviewed_by ?? ''})可对外` : `${cur.status} · 不可对外`}` : ''}{cur.source && !/^(manual|edited|seed)/.test(cur.source) ? ` · 出处 ${cur.source}` : ''}</span>
            {cur.status && <a class="btn" href="/bohui/kb/">去人审 / 上下线</a>}
            <button class="btn" type="button" data-copy title="复制正文(提示词 / 模板直接贴去用)">复制正文</button>
            <a class="btn" href={link({ s: cur.slug, edit: '1' })}>编辑</a>
          </div>
          <div class="md" set:html={mdLite(cur.body, { maxRows: 200 })} />
          <pre id="raw" hidden>{cur.body}</pre>
        </>
      )}
    </article>
  </div>

  <style>
    .hd{display:flex;align-items:flex-start;gap:1rem} .hd div{flex:1} .hd .btn{margin-top:.5rem}
    .search{display:flex;gap:.5rem;margin:.75rem 0 .5rem} .search input{flex:1;font-size:1rem;padding:.625rem .875rem}
    .answer{background:var(--ad-panel);border:1px solid var(--ad-line);border-left:3px solid #0b6e64;border-radius:8px;padding:.875rem 1rem;margin-bottom:.75rem;white-space:pre-wrap;line-height:1.7;font-size:.9375rem}
    .facets{display:grid;gap:.375rem;margin-bottom:1rem} .fr{display:flex;gap:.375rem;align-items:center;flex-wrap:wrap} .fl{font-size:.75rem;color:var(--ad-faint);width:2.5rem}
    .chip{display:inline-flex;gap:.25rem;align-items:center;font-size:.8125rem;padding:.2rem .625rem;border:1px solid var(--ad-line);border-radius:999px;text-decoration:none;color:inherit;background:var(--ad-panel)}
    .chip i{width:.5rem;height:.5rem;border-radius:50%;background:var(--c,#94a3b8)} .chip small{color:var(--ad-faint);font-size:.6875rem} .chip.on{background:#10131a;color:#fff;border-color:#10131a} .chip.on small{color:#cbd5e1}
    .layout{display:grid;grid-template-columns:18rem minmax(0,1fr);gap:1rem} @media (max-width:60rem){.layout{grid-template-columns:1fr}}
    .toc{display:grid;gap:.375rem;align-content:start;max-height:70vh;overflow:auto;padding-right:.25rem}
    .t{display:grid;grid-template-columns:auto 1fr;gap:.125rem .5rem;align-items:center;padding:.5rem .625rem;border:1px solid var(--ad-line);border-radius:8px;text-decoration:none;color:inherit;background:var(--ad-panel)}
    .t b{font-size:.875rem} .t .m{grid-column:2;font-size:.75rem;color:var(--ad-faint)} .t.on{border-color:#10131a;background:#10131a;color:#fff} .t.on .m{color:#cbd5e1} .t.ai{border-left:3px solid #eab308}
    .k{font-size:.6875rem;padding:.0625rem .4375rem;border-radius:4px;background:var(--c,#475569);color:#fff;white-space:nowrap} .k.big{font-size:.75rem}
    .doc{background:var(--ad-panel);border:1px solid var(--ad-line);border-radius:9px;padding:1.25rem 1.5rem;min-height:30rem}
    .dh{display:flex;align-items:center;gap:.625rem;margin-bottom:.75rem;flex-wrap:wrap} .meta{color:var(--ad-faint);font-size:.8125rem;margin-right:auto}
    .md{font-size:.9375rem;line-height:1.75;max-width:56rem} .md :global(h2){font-size:1.25rem;margin:.25rem 0 .75rem} .md :global(h3){font-size:1rem;margin:1.25rem 0 .375rem} .md :global(h4){font-size:.9375rem;margin:1rem 0 .25rem}
    .md :global(ul),.md :global(ol){padding-left:1.375rem} .md :global(li){margin-bottom:.25rem} .md :global(table){border-collapse:collapse;font-size:.875rem;margin:.5rem 0} .md :global(th),.md :global(td){border:1px solid var(--ad-line);padding:.375rem .625rem;vertical-align:top;text-align:left}
    .md :global(code){background:#f1f5f9;padding:.0625rem .375rem;border-radius:4px;font-size:.8125rem} .md :global(pre){background:#0f172a;color:#e2e8f0;padding:.875rem 1rem;border-radius:8px;overflow:auto;font-size:.8125rem;line-height:1.6} .md :global(pre code){background:transparent;color:inherit;padding:0} .md :global(.tw){overflow-x:auto}
    .ed{display:grid;gap:.625rem} .row{display:flex;gap:.5rem;flex-wrap:wrap} .row input,.row select{flex:1;min-width:10rem} .row.end{justify-content:flex-end}
    .ed textarea{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.875rem;line-height:1.6;padding:.75rem;border:1px solid var(--ad-line);border-radius:8px;resize:vertical}
    .warn{background:#fef9c3;color:#854d0e;padding:.5rem .75rem;border-radius:6px;font-size:.875rem;margin:0} .dim{color:var(--ad-faint);font-size:.875rem}
    .refs{background:var(--ad-panel);border:1px dashed var(--ad-line);border-radius:9px;padding:.75rem 1rem;margin-bottom:1rem} .refs>b{font-size:.8125rem;color:var(--ad-soft)}
    .rl{display:grid;grid-template-columns:repeat(auto-fill,minmax(16rem,1fr));gap:.5rem;margin-top:.5rem}
    .r{display:grid;gap:.125rem;padding:.625rem .75rem;border:1px solid var(--ad-line);border-radius:8px;text-decoration:none;color:inherit} .r b{font-size:.875rem} .r span{font-size:.75rem;color:var(--ad-faint)} .r p{margin:.25rem 0 0;font-size:.8125rem;color:var(--ad-soft);line-height:1.5}
  </style>
  <script is:inline>
    const call = async (body) => (await fetch('/api/admin/playbook', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })).json().catch(() => ({}));
    const ans = document.getElementById('answer'), q = document.querySelector('.search input[name=q]'), btn = document.getElementById('askbtn');
    btn.addEventListener('click', async () => { const v = q.value.trim(); if (v.length < 2) { q.focus(); return; } btn.disabled = true; btn.textContent = '在想…'; ans.hidden = false; ans.textContent = '…';
      const d = await call({ op: 'ask', q: v }); ans.textContent = d.ok ? d.answer : (d.msg || '失败'); btn.disabled = false; btn.textContent = '问知识库'; });
    document.querySelector('[data-copy]')?.addEventListener('click', async (e) => { try { await navigator.clipboard.writeText(document.getElementById('raw').textContent); e.target.textContent = '已复制'; setTimeout(() => (e.target.textContent = '复制正文'), 1500); } catch { alert('复制失败'); } });
    document.getElementById('ed')?.addEventListener('submit', async (e) => { e.preventDefault(); const d = await call({ op: 'save', ...Object.fromEntries(new FormData(e.target)) }); if (d.ok) location.assign('?s=' + d.slug); else alert(d.msg || '保存失败'); });
  </script>
</AdminShell>
