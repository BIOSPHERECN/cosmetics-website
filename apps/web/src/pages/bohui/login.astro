---
/**
 * 后台登录页 —— 独立成页。
 * 之前登录表单塞在仪表盘里,导致未登录时也会执行仪表盘的全部数据库查询,
 * 既浪费也让代码分支变复杂。登录就该是一个干净的、只做一件事的页面。
 */
import { env } from 'cloudflare:workers';
import { readSession, readCookie, COOKIE } from '../../lib/auth';

export const prerender = false;

const secret = (env as any).AUTH_SECRET as string | undefined;
const sess = await readSession(readCookie(Astro.request.headers.get('cookie'), COOKIE), secret ?? '');
if (sess) return Astro.redirect('/bohui/');

const db = (env as any).DB as D1Database | undefined;
const n = db ? await db.prepare(`SELECT COUNT(*) AS c FROM users`).first<{ c: number }>().catch(() => null) : null;
const noUser = (n?.c ?? 0) === 0;
---
<html lang="zh-CN">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex,nofollow" /><title>登录 · 帛卉后台</title>
<style>
:root{--panel:#fff;--ink:#10131a;--soft:#5b6472;--line:#e4e7ec;--accent:#1f4e79;--bad:#b3261e;
      font-family:system-ui,'PingFang SC','Microsoft YaHei',sans-serif}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:grid;place-items:center;padding:1.5rem;
     background:linear-gradient(160deg,#12161d 0%,#1c2431 100%)}
.card{width:min(23rem,100%);background:var(--ad-panel);border-radius:14px;padding:2.25rem 2rem;
      box-shadow:0 24px 60px -24px rgb(0 0 0/.5)}
.b{font-size:1.0625rem;font-weight:700;letter-spacing:.06em}
.s{color:var(--ad-soft);font-size:.75rem;letter-spacing:.1em;margin-bottom:1.75rem}
.fld{display:grid;gap:.375rem;margin-bottom:1rem}
.fld span{font-size:.8125rem;color:var(--ad-soft)}
.fld input{font:inherit;padding:.6875rem .75rem;border:1px solid var(--ad-line);border-radius:7px}
.fld input:focus{outline:2px solid var(--ad-accent);outline-offset:1px}
button{font:inherit;width:100%;padding:.75rem;border:0;border-radius:7px;background:var(--ad-accent);
       color:#fff;cursor:pointer;font-weight:600;margin-top:.5rem}
button:disabled{opacity:.5;cursor:default}
.msg{margin-top:.875rem;font-size:.8125rem;color:var(--ad-bad);min-height:1.3em}
a{color:var(--ad-accent);font-size:.8125rem}
</style>
</head>
<body>
<div class="card">
  <div class="b">帛卉后台</div>
  <div class="s">BOHUI CONSOLE</div>
  {noUser ? (
    <p style="color:var(--ad-soft);font-size:.875rem;line-height:1.7">
      还没有任何账号。<a href="/bohui/setup/">先创建第一个管理员 →</a>
    </p>
  ) : (
    <form id="f">
      <label class="fld"><span>邮箱</span><input name="email" type="email" required autocomplete="username" /></label>
      <label class="fld"><span>口令</span><input name="password" type="password" required autocomplete="current-password" /></label>
      <button type="submit">登录</button>
      <p class="msg" id="m"></p>
    </form>
  )}
</div>
<script is:inline>
const f=document.getElementById('f');
if(f)f.addEventListener('submit',async(e)=>{
  e.preventDefault();
  const m=document.getElementById('m'),b=f.querySelector('button'),fd=new FormData(f);
  b.disabled=true;m.textContent='';
  try{
    const r=await fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({email:fd.get('email'),password:fd.get('password')})});
    const raw=await r.text();let d;
    try{d=JSON.parse(raw)}catch{throw new Error('服务端返回异常:'+raw.slice(0,100))}
    if(d.ok)location.href='/bohui/';else{m.textContent=d.msg||'登录失败';b.disabled=false}
  }catch(err){m.textContent=err.message||'请求失败';b.disabled=false}
});
</script>
</body>
</html>
