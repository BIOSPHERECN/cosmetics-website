---
/**
 * 爆款情报 —— tools/market/intel-build.py 每周生成的「市场 × 品类」情报(统计层纯 SQL 可复核 + 模型按数字写结论),这里只展示。
 * 创始人 2026-09-18:「爆款收集的不要忘记生成了!那是重要的情报分析」;铁令「频率不是销量,不得声称销量增长」→ 顶部固定口径。
 * 与 /bohui/market/(Amazon 榜单周报)和 /bohui/market-structure/(即时频率快照)的分工:这页是按周固化的结论,给老板 / 研发 / 业务读与打印。
 * 数据:market_intel(0093);没跑过脚本时显示空态,不 500。
 */
import AdminShell from '../../layouts/AdminShell.astro';
import { pageGuard } from '../../lib/guard';
import { MARKET } from '../../lib/decoder';

export const prerender = false;
const c = await pageGuard(Astro.request);
if (!c) return Astro.redirect('/bohui/login/');

const url = new URL(Astro.request.url);
const qp = url.searchParams.get('p') ?? '';
const qm = url.searchParams.get('m') ?? '';
const qc = url.searchParams.get('cat') ?? '';

type Row = { id: number; period: string; market: string; category: string; n_products: number; model: string | null; created_at: string };
type Full = Row & { stats_json: string; report_json: string | null; report_md: string };
let periods: string[] = [], rows: Row[] = [], cur: Full | null = null;
try {
  periods = ((await c.db.prepare(`SELECT DISTINCT period FROM market_intel ORDER BY period DESC LIMIT 26`).all<{ period: string }>()).results).map((r) => r.period);
  const period = periods.includes(qp) ? qp : periods[0];
  if (period) {
    rows = (await c.db.prepare(`SELECT id, period, market, category, n_products, model, created_at FROM market_intel WHERE period=? ORDER BY market, n_products DESC`).bind(period).all<Row>()).results;
    /* 列表按筛选缩;右侧报告 = 筛选后的第一行(或 URL 精确指定的 m+cat) */
    const list = rows.filter((r) => (!qm || r.market === qm) && (!qc || r.category === qc));
    const pick = list.find((r) => r.market === (qm || 'all') && r.category === (qc || 'all')) ?? list[0];
    if (pick) cur = await c.db.prepare(`SELECT * FROM market_intel WHERE id=?`).bind(pick.id).first<Full>();
    rows = list;
  }
} catch { /* 表还没建(0093 未跑)→ 空态 */ }

const markets = [...new Set(rows.map((r) => r.market))];
const cats = [...new Set(rows.map((r) => r.category))].filter((x) => x !== 'all');
const mk = (m: string) => m === 'all' ? '全部市场' : (MARKET[m]?.[0] ?? m.toUpperCase());
const ck = (x: string) => x === 'all' ? '全部品类' : x;
const S = cur ? JSON.parse(cur.stats_json) : null;
const R = cur?.report_json ? JSON.parse(cur.report_json) : null;
const RATING: Record<string, string> = { green: '安全', yellow: '注意', red: '风险' };
const pct = (v: number | undefined) => v == null ? '—' : `${v}%`;
---

<AdminShell title="爆款情报" active="market-intel" email={c.sess.email} tenant={c.tenant}>
  <h1>爆款情报</h1>
  <p class="lead notice">出现频率 ≠ 销量。以下全部是公开全成分的出现款数与占比,不代表销量或市场份额;成分顺序只代表标签标示顺序。每周一 07:00 自动生成(计划任务 Bohui-MarketIntel)。</p>

  {periods.length === 0 ? (
    <div class="empty">还没有情报。跑 <code>python tools/market/intel-build.py</code>(约 30–40 个组合,每个一次模型调用)。</div>
  ) : (
    <>
      <form class="bar" method="get">
        <select name="p">{periods.map((p) => <option value={p} selected={p === (cur?.period ?? periods[0])}>{p}</option>)}</select>
        <select name="m"><option value="">全部市场</option>{markets.map((m) => <option value={m} selected={m === qm}>{mk(m)}</option>)}</select>
        <select name="cat"><option value="">全部品类</option>{cats.map((x) => <option value={x} selected={x === qc}>{x}</option>)}</select>
        <button class="btn pri" type="submit">查看</button>
        {(qm || qc) && <a class="btn" href={`/bohui/market-intel/?p=${cur?.period ?? ''}`}>清空</a>}
        <button class="btn" type="button" id="print">打印</button>
      </form>

      <div class="grid2">
        <aside class="list">
          {rows.map((r) => (
            <a class:list={['row', cur?.id === r.id && 'on']} href={`/bohui/market-intel/?p=${r.period}&m=${r.market}&cat=${encodeURIComponent(r.category)}`}>
              <b>{mk(r.market)} × {ck(r.category)}</b>
              <span class="dim">{r.n_products.toLocaleString('en-US')} 款{r.model ? '' : ' · 模型未返回'}</span>
            </a>
          ))}
        </aside>

        {cur && S && (
          <article class="report" id="report">
            <header>
              <div class="dim">{cur.period} · {mk(cur.market)} × {ck(cur.category)} · {S.n.toLocaleString('en-US')} 款 · {S.n_brands} 个品牌 · 入库 {S.first_seen_min} ~ {S.last_seen_max} · 模型 {cur.model ?? '—'} · 生成 {cur.created_at}</div>
              <h2>{R?.headline ?? '(模型未返回结论,只有统计表)'}</h2>
            </header>
            {R && (
              <>
                <section><h3>配方结构画像</h3><p>{R.structure}</p></section>
                <section><h3>值得关注的成分</h3>
                  <p class="dim">时间序列从 2026-09-18 起积累,「vs 上周期」满两周才有;首周只有高频出现,不是升降。</p>
                  <ul>{(R.rising ?? []).map((x: any) => <li><b>{x.inci_key}</b> — {x.why}</li>)}</ul></section>
                <section><h3>标配成分</h3><p>{(R.standard_kit ?? []).map((k: string) => <span class="pill p-wait">{k}</span>)}</p></section>
                <section><h3>宣称趋势</h3><p>{R.claims_trend}</p></section>
                <section><h3>机会</h3><ul>{(R.whitespace ?? []).map((x: any) => <li>{x.point} <span class="dim">依据:{x.basis}</span></li>)}</ul></section>
                <section><h3>风险</h3><ul>{(R.risks ?? []).map((x: any) => <li>{x.point} <span class="dim">依据:{x.basis}</span></li>)}</ul></section>
                <div class="two">
                  <section class="box"><h3>给研发</h3><p>{R.for_rd}</p></section>
                  <section class="box"><h3>给业务</h3><p>{R.for_sales}</p></section>
                </div>
              </>
            )}
            <details class="stats" open={!R}>
              <summary>统计表(可复核;纯 SQL,不经模型)</summary>
              <div class="two">
                <section><h3>高频成分 Top 20(已排除水 / 甘油等 10 个基础成分)</h3>
                  <table><thead><tr><th>#</th><th>INCI</th><th class="r">款数</th><th class="r">占比</th><th class="r">vs 上周期</th></tr></thead>
                    <tbody>{S.top.map((t: any, i: number) => (
                      <tr><td class="dim">{i + 1}</td><td><i class:list={['dot', t.rating]} title={RATING[t.rating ?? ''] ?? '未评'} /> <b>{t.inci_key}</b>{t.name_zh && <span class="dim"> · {t.name_zh}</span>}</td>
                        <td class="r num">{t.n}</td><td class="r num">{pct(t.pct)}</td><td class="r num">{t.delta_pct == null ? '—' : `${t.delta_pct > 0 ? '+' : ''}${t.delta_pct}pp`}</td></tr>
                    ))}</tbody></table>
                </section>
                <div>
                  <section><h3>品牌 Top 10(款数,不是销量)</h3>
                    <table><thead><tr><th>品牌</th><th class="r">款数</th><th class="r">占比</th></tr></thead>
                      <tbody>{S.brands.map((b: any) => <tr><td>{b.brand}</td><td class="r num">{b.n}</td><td class="r num">{pct(b.pct)}</td></tr>)}</tbody></table>
                  </section>
                  <section><h3>安全评级与标签</h3>
                    <table><tbody>
                      <tr><td>含红色成分</td><td class="r num">{S.flags.red.n}</td><td class="r num">{pct(S.flags.red.pct)}</td></tr>
                      <tr><td>含黄色成分</td><td class="r num">{S.flags.yellow.n}</td><td class="r num">{pct(S.flags.yellow.pct)}</td></tr>
                      {Object.entries(S.free_of).map(([k, v]: [string, any]) => <tr><td>{k}</td><td class="r num">{v.n}</td><td class="r num">{pct(v.pct)}</td></tr>)}
                    </tbody></table>
                  </section>
                </div>
              </div>
              <div class="two">
                <section><h3>功能标签(含该功能成分的款数)</h3>
                  <table><tbody>{S.functions.map((f: any) => <tr><td>{f.label}</td><td class="r num">{f.n}</td><td class="r num">{pct(f.pct)}</td></tr>)}</tbody></table></section>
                <section><h3>基础成分出现占比</h3>
                  <table><tbody>{S.basics.map((b: any) => <tr><td>{b.inci_key}</td><td class="r num">{b.n}</td><td class="r num">{pct(b.pct)}</td></tr>)}</tbody></table></section>
              </div>
              <div class="two">
                <section><h3>规格分布</h3>
                  <table><tbody>{S.sizes.map((s: any) => <tr><td>{s.bin}</td><td class="r num">{s.n}</td><td class="r num">{pct(s.pct)}</td></tr>)}</tbody></table></section>
                <section><h3>宣称关键词 Top 15(内部统计,不对外)</h3>
                  <p>{S.claim_words.map((w: any) => <span class="pill p-wait">{w.kw} {w.n}</span>)}</p>
                  <h3>新入库品牌(近 7 天)</h3>
                  {S.new_brands?.length ? <table><tbody>{S.new_brands.map((b: any) => <tr><td>{b.brand}</td><td class="dim">{b.first_seen}</td><td class="r num">{b.n}</td></tr>)}</tbody></table>
                    : <p class="dim">{S.new_brands_window_ok ? '(无)' : '数据窗口不足 7 天,暂不统计。'}</p>}
                </section>
              </div>
            </details>
          </article>
        )}
      </div>
    </>
  )}

  <style>
    .notice{border-left:3px solid var(--ad-warn);padding-left:.75rem}
    .grid2{display:grid;grid-template-columns:16rem 1fr;gap:.75rem;align-items:start}
    .list{display:grid;gap:.25rem;position:sticky;top:1rem}
    .row{display:grid;gap:.125rem;padding:.5rem .75rem;border:1px solid var(--ad-line);border-radius:8px;background:var(--ad-panel);color:inherit;text-decoration:none;font-size:.8125rem}
    .row.on{border-color:#10131a;background:#10131a;color:#fff} .row.on .dim{color:#cbd0da}
    .report{background:var(--ad-panel);border:1px solid var(--ad-line);border-radius:9px;padding:1.25rem 1.5rem;font-size:.875rem;line-height:1.7}
    .report h2{font-size:1.25rem;margin:.25rem 0 1rem} .report h3{font-size:.875rem;margin:1rem 0 .25rem;color:var(--ad-soft)} .report p{margin:0} .report ul{margin:0;padding-left:1.25rem}
    .two{display:grid;grid-template-columns:1fr 1fr;gap:1rem} .box{background:var(--ad-sunk);border-radius:8px;padding:.25rem 1rem .75rem}
    .stats{margin-top:1.25rem;border-top:1px solid var(--ad-line);padding-top:.75rem} .stats>summary{cursor:pointer;font-weight:600;font-size:.875rem}
    th.r,td.r{text-align:right} .dim{color:var(--ad-faint);font-size:.75rem} .pill{margin:0 .25rem .25rem 0}
    .dot{display:inline-block;width:.5rem;height:.5rem;border-radius:50%;background:var(--ad-line);vertical-align:middle}
    .dot.green{background:var(--ad-ok)} .dot.yellow{background:var(--ad-warn)} .dot.red{background:var(--ad-bad)}
    @media (max-width:60rem){.grid2,.two{grid-template-columns:1fr} .list{position:static}}
    /* 打印:只留报告,统计表展开 */
    @media print{:global(aside),.bar,.list,h1,.notice{display:none!important} :global(main){padding:0} .grid2{display:block} .report{border:0;padding:0} .stats{display:block}}
  </style>
  <script is:inline>
    document.getElementById('print')?.addEventListener('click', () => { document.querySelector('.stats')?.setAttribute('open', ''); window.print(); });
  </script>
</AdminShell>
