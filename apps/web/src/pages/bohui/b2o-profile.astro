    .three .k{color:var(--ad-faint);font-size:.75rem} .three b{font-size:1.0625rem} .three .s{color:var(--ad-faint);font-size:.75rem}
    .steps{display:flex;flex-wrap:wrap;gap:.25rem;list-style:none;padding:0;margin:0 0 .5rem}
    .steps li{padding:.25rem .625rem;border:1px solid var(--ad-line);border-radius:999px;font-size:.8125rem;color:var(--ad-faint)}
    .steps li.done{color:inherit} .steps li.on{background:var(--ad-accent);border-color:var(--ad-accent);color:#fff;font-weight:600}
    fieldset{border:0;padding:0;margin:0;display:grid;gap:.75rem;min-width:0}
    fieldset.grp{border:1px solid var(--ad-line);border-radius:9px;padding:.75rem;grid-template-columns:repeat(auto-fill,minmax(16rem,1fr))}
    legend{font-weight:600;font-size:.875rem;padding:0 .25rem} label.wide{grid-column:1/-1}
    .in{display:flex;gap:.375rem} .in select.src{flex:0 0 6.5rem;font-size:.75rem}
    .checks{display:flex;flex-wrap:wrap;gap:.5rem 1rem;font-size:.875rem;align-items:center} label.ck{display:flex;gap:.375rem;align-items:center}
    label.ck input{width:auto} table.sku input,table.sku select{min-width:5rem}
    tr.back td{color:var(--ad-faint)} td{font-size:.875rem;vertical-align:top}
    .tl{list-style:none;padding:0;margin:0;display:grid;gap:.5rem} .tl li{border-left:2px solid var(--ad-line);padding-left:.75rem;font-size:.875rem}
    .tl .body{white-space:pre-wrap}
    @media (max-width:640px){.in{flex-direction:column}.in select.src{flex:auto}}
  </style>
