---
/**
 * 配方实验室 · 对话工作台(2026-09-17 创始人:「填表单那 AI 有啥价值」「人只说话,系统干活」)。
 *
 * 入口只有一个输入框:实验室一句话说需求 → op:brief 让模型抽需求单 → 缺品类 / 剂型才追问一句(系统气泡),
 * 下一句把两句拼起来再发;齐了接口直接建项目,页面跳到 /bohui/formula-lab/{id}/。
 * 左栏是项目列表(经 redact 投影,业务 / 无角色看不到客户名);打版员只见待打版的版本列表。
 * 独立界面:走 LabShell,不带后台侧栏(创始人 11:2x:「跳出一个单独的界面,别和原有系统混在一起」)。
 */
import LabShell from '../../../layouts/LabShell.astro';
import { pageGuard } from '../../../lib/guard';
import { catZh, fmtZh, PROJECT_STATUS_ZH, VERSION_STATUS_ZH, canWrite, redact, type ProjectRow } from '../../../lib/formula-lab';

export const prerender = false;
const c = await pageGuard(Astro.request);
if (!c) return Astro.redirect('/bohui/login/');

const labRole = c.sess.lab_role ?? null;
const sampler = labRole === 'sampler';
const writable = canWrite(labRole);

/* 表还没灌时页面不该 500,每句都兜 [] */
const none = () => ({ results: [] as any[] });
const { results: rawProjects } = sampler ? none() : await c.db.prepare(
  `SELECT p.*, COUNT(v.id) AS nv FROM formula_projects p LEFT JOIN formula_versions v ON v.project_id = p.id
    GROUP BY p.id ORDER BY p.updated_at DESC LIMIT 200`).all<ProjectRow & { nv: number }>().catch(none);
const projects = rawProjects.map((r) => ({ ...redact(labRole, 'project', r), nv: r.nv }));
const { results: versions } = sampler ? await c.db.prepare(
  `SELECT v.id, v.project_id, v.version_no, v.status, v.created_at, p.code, p.category, p.format
     FROM formula_versions v JOIN formula_projects p ON p.id = v.project_id ORDER BY v.created_at DESC LIMIT 200`).all<any>().catch(none) : none();

const P_PILL: Record<string, string> = { open: 'p-wait', sampling: 'p-warn', final: 'p-ok' };
const V_PILL: Record<string, string> = { draft: 'p-wait', sampled: 'p-warn', final: 'p-ok' };
---

<LabShell title="配方实验室" email={c.sess.email} tenant={c.tenant}>
  <div class="lab">
    <aside class="lab-side">
      <a class="btn pri new" href="/bohui/formula-lab/">+ 新建对话</a>
      <div class="plist">
        {!sampler && projects.length === 0 && <div class="pempty">还没有项目</div>}
        {!sampler && projects.map((r) => (
          <a class="pitem" href={`/bohui/formula-lab/${r.id}/`}>
            <b><code>{r.code}</code> <span class:list={['pill', P_PILL[r.status ?? ''] ?? 'p-wait']}>{PROJECT_STATUS_ZH[r.status ?? ''] ?? r.status}</span></b>
            <span>{catZh(r.category ?? '')} · {fmtZh(r.format ?? '')}{r.nv ? ` · v${r.nv}` : ''}</span>
          </a>
        ))}
        {sampler && versions.map((v: any) => (
          <a class="pitem" href={`/bohui/formula-lab/${v.project_id}/#feedback`}>
            <b><code>{v.code}</code> v{v.version_no} <span class:list={['pill', V_PILL[v.status] ?? 'p-wait']}>{VERSION_STATUS_ZH[v.status] ?? v.status}</span></b>
            <span>{catZh(v.category)} · {fmtZh(v.format)}</span>
          </a>
        ))}
      </div>
      {writable && <a class="wiki" href="/bohui/formula-lab/import/">导入老配方(拍照识别)</a>}
      <a class="wiki" href="/bohui/formulas/">配方库(公司 · 海外爆款 · 老配方)</a>
      {/* 09-18 创始人:「还有要可以改配方的原料,多选原料和价格」→ 原料库入口 */}
      <a class="wiki" href="/bohui/formula-lab/materials/">原料库(名称 · INCI · 供应商 · 单价)</a>
      <a class="wiki" href="/bohui/formula-lab/wiki/">配方维基</a>
      <a class="wiki" href="/bohui/formula-lab/esg/">ESG 规则(四支柱 · 带法规依据)</a>
    </aside>

    <main class="lab-main">
      {sampler ? (
        <div class="chat">
          <div class="bub sys">待打版的版本在左栏,点进项目页「填打版结果」记录 pH / 黏度 / 离心等结果;称量单由总工另给。</div>
        </div>
      ) : (
        <>
          <div class="chat" id="chat">
            {labRole === null && <div class="note info">你还没有实验室角色,只能查看;请管理员在「账号与权限」页设置。</div>}
            {labRole !== null && !writable && <div class="note info">当前实验室角色只能查看,开新项目请找总工或配方师。</div>}
            <div class="bub sys">说说要做什么 —— 一句话就行;下面的选项可勾可不勾,勾了会一起发给刘总工、黄总工。</div>
          </div>
          {writable && (
            <div class="opts" id="opts">
              <div class="orow"><span>品类</span>{['护肤','清洁','身体','洗护发','防晒','口腔','彩妆','儿童','香氛'].map((v) => <button type="button" class="chip" data-g="cat" data-v={v}>{v}</button>)}</div>
              <div class="orow"><span>剂型</span>{['精华液','面霜','乳液','凝胶','洁面','面膜','喷雾','防晒乳','洗发水','护发素','身体乳','沐浴露','牙膏','唇膏','其他'].map((v) => <button type="button" class="chip" data-g="fmt" data-v={v}>{v}</button>)}</div>
              <div class="orow"><span>市场</span>{['中国','欧盟','美国','日本','韩国','东南亚'].map((v) => <button type="button" class="chip multi" data-g="mkt" data-v={v}>{v}</button>)}</div>
              <div class="orow"><span>要求</span>{['清真','纯素','无香','无 MIT/CMIT','无防腐','敏感肌可用','全绿标','ESG 全绿'].map((v) => <button type="button" class="chip multi" data-g="req" data-v={v}>{v}</button>)}</div>
              <div class="orow"><span>成本</span>{['经济','中档','高端'].map((v) => <button type="button" class="chip" data-g="cost" data-v={v}>{v}</button>)}</div>
            </div>
          )}
          {writable && (
            <form class="ask" id="ask">
              <textarea name="text" rows="3" placeholder="例:给一个韩国客户做一支保湿修护精华,水剂,无香,卖到中国和欧盟,中档" required></textarea>
              <button class="btn" type="button" id="mic" title="按一下开始说话,再按一下停止;识别的文字会追加进输入框">🎤 语音</button>
              <button class="btn" type="button" id="cam" title="拍一张需求单 / 手写纸,识别成文字填进输入框">📷 拍照 / 传图</button>
              <input type="file" id="camf" accept="image/*" capture="environment" hidden />
              <button class="btn pri" type="submit" id="send">发送</button>
              <small class="tag" id="ocr-tag" hidden>识别自图片 · 发送前请核对</small>
            </form>
          )}
        </>
      )}
    </main>
  </div>
  <div id="toast" class="toast" hidden></div>
  <script is:inline>
    document.querySelectorAll('#opts .chip').forEach((b) => b.addEventListener('click', () => {
      if (!b.classList.contains('multi')) b.parentElement.querySelectorAll('.chip.on').forEach((o) => { if (o !== b) o.classList.remove('on'); });
      b.classList.toggle('on'); document.querySelector('#ask textarea')?.focus();
    }));
  </script>

  <style>
    :global(html){font-size:18px} :global(body){font-size:1rem}
    .lab{display:grid;grid-template-columns:15rem minmax(0,1fr);gap:1rem;max-width:1800px;margin:0 auto;padding:1rem}
    .lab-side{display:flex;flex-direction:column;gap:.625rem;min-width:0}
    .new{text-align:center}
    .plist{display:grid;gap:.25rem;overflow:auto;max-height:calc(100vh - 9rem)}
    .pitem{display:grid;gap:.125rem;padding:.5rem .625rem;border-radius:var(--ad-r-s);text-decoration:none;color:var(--ad-ink);font-size:.8125rem;border:1px solid transparent}
    .pitem:hover{background:var(--ad-panel);border-color:var(--ad-line-soft)}
    .pitem b{display:flex;gap:.375rem;align-items:center;font-weight:600} .pitem>span{color:var(--ad-soft);font-size:.75rem}
    .pempty{font-size:.8125rem;color:var(--ad-faint);padding:.5rem .625rem}
    .wiki{font-size:.75rem;color:var(--ad-faint);text-decoration:none;padding:.25rem .625rem} .wiki:hover{color:var(--ad-accent)}
    .lab-main{display:flex;flex-direction:column;gap:1rem;min-width:0}
    .chat{display:flex;flex-direction:column;gap:.75rem}
    .bub{max-width:none;align-self:stretch;padding:.75rem 1rem;border-radius:var(--ad-r);font-size:.9375rem;line-height:1.6;white-space:pre-wrap}
    .bub.sys{background:var(--ad-panel);border:1px solid var(--ad-line);align-self:flex-start}
    .bub.me{background:var(--ad-accent-soft);color:var(--ad-accent-deep);align-self:flex-end}
    .bub.wait{color:var(--ad-soft)}
    .ask{display:grid;grid-template-columns:minmax(0,1fr) auto auto auto;gap:.5rem;align-items:end;position:sticky;bottom:1rem;background:var(--ad-ground);padding-top:.5rem}
    .ask{max-width:none} .ask .tag{grid-column:1/-1;font-size:.75rem;color:var(--ad-faint)}
    #mic.on{background:var(--ad-bad-soft);border-color:#EFC6C0;color:var(--ad-bad)}
    .ask textarea{width:100%;resize:vertical;font-size:.9375rem}
    @media (max-width:60rem){.lab{grid-template-columns:1fr}.plist{max-height:12rem}}
  
    .guide { background: var(--ad-panel); border: 1px solid var(--ad-side-line); border-radius: 14px; padding: 1.125rem 1.375rem; margin-bottom: 1rem; }
    .gtitle { font-weight: 700; margin-bottom: .5rem; }
    .gsteps { margin: 0 0 .875rem; padding-left: 1.25rem; line-height: 1.7; font-size: .9375rem; }
    .gsteps b { margin-right: .5rem; color: var(--ad-ink); }
    .gex { font-size: .8125rem; color: var(--ad-side-dim); margin-bottom: .375rem; }
    .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
    .chip { border: 1px solid var(--ad-side-line); background: var(--ad-sunk); border-radius: 999px; padding: .375rem .875rem; font-size: .875rem; cursor: pointer; color: var(--ad-ink); }
    .chip:hover { background: var(--ad-side-active); }

    .opts { background: var(--ad-panel); border: 1px solid var(--ad-side-line); border-radius: 14px; padding: .75rem 1rem .5rem; margin-bottom: .625rem; }
    .orow { display: flex; flex-wrap: wrap; align-items: center; gap: .375rem; margin-bottom: .375rem; }
    .orow > span { width: 2.5rem; font-size: .8125rem; color: var(--ad-side-dim); }
    .chip.on { background: var(--ad-ink); color: #fff; border-color: var(--ad-ink); }
</style>

  <script is:inline>
    const f = document.getElementById('ask'), chat = document.getElementById('chat'), toast = document.getElementById('toast');
    const show = (msg, bad) => { toast.textContent = msg; toast.classList.toggle('bad', !!bad); toast.hidden = false; setTimeout(() => { toast.hidden = true; }, 3500); };
    const bub = (cls, text) => { const d = document.createElement('div'); d.className = 'bub ' + cls; d.textContent = text; chat.appendChild(d); d.scrollIntoView({ block: 'end' }); return d; };
    if (f) {
      const ta = f.elements.text, send = document.getElementById('send');
      let pending = '';   // 追问过一次:下一句和上一句拼起来再发,模型看到完整需求
      ta.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); f.requestSubmit(); } });
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const t = ta.value.trim();
        if (!t) return;
        bub('me', t);
        ta.value = ''; send.disabled = true; ta.disabled = true;
        const sel = [...document.querySelectorAll('#opts .chip.on')].map((b) => b.dataset.v);
        const pre = sel.length ? '选项:' + sel.join('、') + '。' : '';
        const text = (pending ? pending + '\n' : '') + pre + t;
        const wait = bub('sys wait', '正在整理需求单…');
        const d = await fetch('/api/admin/formula-lab', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: 'brief', text }) })
          .then((r) => r.json()).catch(() => ({ ok: false, msg: '网络错误,请重试' }));
        wait.remove(); send.disabled = false; ta.disabled = false;
        if (d.ok && d.id) { bub('sys', '已建项目 ' + (d.code || '') + ',正在打开…'); location.href = '/bohui/formula-lab/' + d.id + '/'; return; }
        if (d.ok && d.ask) { pending = text; bub('sys', d.ask + '(也可以直接点上面的选项再发)'); ta.focus(); return; }
        bub('sys', '没建成:' + (d.msg || '未知错误') + ',请换个说法再发。'); show(d.msg || '失败', true);
      });

      // 🎤 语音(Web Speech API,zh-CN 连续识别)与 📷 拍照(本地压到 ≤1600px 再发 op:ocr mode=text),识别文字都追加进输入框
      const append = (t) => { ta.value = (ta.value.trim() ? ta.value.replace(/\s+$/, '') + '\n' : '') + t; ta.focus(); };
      const mic = document.getElementById('mic'), cam = document.getElementById('cam'), camf = document.getElementById('camf'), tag = document.getElementById('ocr-tag');
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      let rec = null;
      mic.addEventListener('click', () => {
        if (!SR) return show('这个浏览器不支持语音输入,请用 Chrome / Edge', true);
        if (rec) { rec.stop(); return; }
        rec = new SR(); rec.lang = 'zh-CN'; rec.continuous = true; rec.interimResults = false;
        rec.onresult = (e) => { for (let i = e.resultIndex; i < e.results.length; i++) if (e.results[i].isFinal) append(e.results[i][0].transcript.trim()); };
        rec.onerror = (e) => show(e.error === 'not-allowed' ? '没拿到麦克风权限,请在地址栏允许' : '语音识别出错:' + e.error, true);
        rec.onend = () => { rec = null; mic.classList.remove('on'); mic.textContent = '🎤 语音'; };
        rec.start(); mic.classList.add('on'); mic.textContent = '⏹ 停止'; show('在听,说完再按一下停止');
      });
      const shrink = (f) => new Promise((ok, no) => {
        const img = new Image(), url = URL.createObjectURL(f);
        img.onload = () => { URL.revokeObjectURL(url); const k = Math.min(1, 1600 / Math.max(img.width, img.height)); const cv = document.createElement('canvas'); cv.width = Math.round(img.width * k); cv.height = Math.round(img.height * k); cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height); ok(cv.toDataURL('image/jpeg', .85)); };
        img.onerror = () => { URL.revokeObjectURL(url); no(new Error('图片打不开,请换一张 jpg / png')); };
        img.src = url;
      });
      cam.addEventListener('click', () => camf.click());
      camf.addEventListener('change', async () => {
        const file = camf.files[0]; camf.value = '';
        if (!file) return;
        cam.disabled = true; cam.textContent = '识别中…';
        try {
          const image = await shrink(file);
          if (image.length > 4 * 1024 * 1024) throw new Error('图片压缩后仍超 4MB,请拍近一点');
          const d = await fetch('/api/admin/formula-lab', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: 'ocr', image, mode: 'text' }) })
            .then((r) => r.json()).catch(() => ({ ok: false, msg: '网络错误,请重试' }));
          if (!d.ok) throw new Error(d.msg || '识别失败');
          if (!String(d.text || '').trim()) throw new Error('图里没识别出文字,请拍清楚一点');
          append(String(d.text).trim()); tag.hidden = false; show('已识别,请核对后发送');
        } catch (err) { show(err.message || '识别失败', true); }
        cam.disabled = false; cam.textContent = '📷 拍照 / 传图';
      });
    }
  </script>
</LabShell>
