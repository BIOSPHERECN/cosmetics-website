---
/**
 * 配方实验室 · 项目页 = 对话流(2026-09-17 创始人:「人只说话,系统干活」「跳出一个单独的界面」)。
 *
 * 流里按轮次:需求摘要气泡 → 用户气泡(需求原话)→ 三张卡并排:刘总工(L)/ 黄总工(R)各出基底或配方,李总工(J)逐项点评;
 * 推荐轮勾基底 → 「让两位总工出配方」→ 生成轮三张卡 → 采纳成版本卡(相表 / 改比例 / 打版结果);底部输入框追加需求 → 「再出一版」。
 * 页面只显示人名,不显示模型名(留档里有);免费兜底只在卡角小字「测试通道」。
 *
 * 三条硬规矩(规范 3.4 / 6.2)不变:
 *   1. 所有行先经 redact(labRole, kind, row) 再进模板;李总工行不走 redact(它会把 review 输出按草案形状改写),
 *      在本页按角色投影:业务 / 无角色只留 summary + recommendation,打版员 null。
 *   2. define:vars 只传 { id, labRole, canRecipe } 三个标量;run_id / version_id / round 走按钮 data-*。
 *   3. 能看比例的人打开这页,往 formula_access_log 记一行(渲染出相表的版本 + 解析出相表的生成 run + 会诊网关)。
 *
 * 模型调用前端串行:网关 → 专家逐位(免费模型串行、付费 3 路)→ 汇总 L → R → 李总工 review → reload。
 */
import LabShell from '../../../layouts/LabShell.astro';
import { pageGuard } from '../../../lib/guard';
import { ingredientPath } from '../../../lib/decoder';
import {
  LAB_SIDES, MARKET_ZH, COST_BAND_ZH, PROJECT_STATUS_ZH, VERSION_STATUS_ZH,
  catZh, fmtZh, benefitZh, sourceZh, splitList, parseConstraints, safeJson, redact, marketRef, rateMaterials,
  canRecipe as canRecipeOf, canWrite as canWriteOf, canFeedback as canFeedbackOf,
  type ProjectRow, type RunRow, type VersionRow, type RecipeRow, type GateJson, type Side, type Tier, type Step,
} from '../../../lib/formula-lab';

type RunRowG = RunRow & { gateway_run_id?: number | null };

export const prerender = false;
const c = await pageGuard(Astro.request);
if (!c) return Astro.redirect('/bohui/login/');

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return new Response('项目号不对', { status: 404 });
const raw = await c.db.prepare(`SELECT * FROM formula_projects WHERE id=?`).bind(id).first<ProjectRow>();
if (!raw) return new Response('没有这个项目', { status: 404 });

const labRole = c.sess.lab_role ?? null;
const canRecipe = canRecipeOf(labRole);
const canWrite = canWriteOf(labRole);
const canFeedback = canFeedbackOf(labRole);
const sampler = labRole === 'sampler';

/* 人名:LAB_SIDES.persona(接口同时在加);SSR 拿不到就按侧映射 */
const PERSONA: Record<string, string> = { L: '刘总工', R: '黄总工', J: '李总工' };
const personaOf = (s: string) => ((LAB_SIDES as any)[s]?.persona as string | undefined) ?? PERSONA[s] ?? s;

/* ── 读库 ─────────────────────────────────────────────────────────────────── */
const project = redact(labRole, 'project', raw);
const constraints = raw.constraints_json && 'constraints_json' in project ? parseConstraints(raw.constraints_json) : null;

/* 左栏项目列表(与工作台同款投影) */
const none = () => ({ results: [] as any[] });
const { results: plistRaw } = sampler ? none() : await c.db.prepare(`SELECT * FROM formula_projects ORDER BY updated_at DESC LIMIT 60`).all<ProjectRow>().catch(none);
const plist = plistRaw.map((r) => redact(labRole, 'project', r));

/* runs:按 step 取最新一轮,每侧取最新 attempt;review 行按 gateway_run_id 各取最新 attempt(李总工点评归属哪一轮由网关号定) */
const { results: runRows } = await c.db.prepare(
  `SELECT * FROM formula_runs WHERE project_id=? AND step IN ('recommend','generate','review') ORDER BY step, round DESC, side, attempt DESC`,
).bind(id).all<RunRowG>();
const latest: Record<string, Partial<Record<Side, RunRowG | null>>> = { recommend: {}, generate: {} };
const topRound: Record<string, number> = { recommend: 0, generate: 0 };
const reviewRaw = new Map<number, RunRowG>();
for (const r of runRows) {
  if (r.step === 'review') { if (r.gateway_run_id != null && !reviewRaw.has(r.gateway_run_id)) reviewRaw.set(r.gateway_run_id, r); continue; }
  const step = r.step as 'recommend' | 'generate';
  if (!latest[step]) continue;
  if (!topRound[step]) topRound[step] = r.round;
  if (r.round !== topRound[step]) continue;
  const side = r.side as Side;
  if (latest[step][side] === undefined) latest[step][side] = redact(labRole, 'run', r) as RunRowG | null;
}
const SIDES: Side[] = ['L', 'R'];

/* 会诊记录:只 canRecipe 读(同 v0.1;折叠进刘总工卡内) */
type Tiered = { text: string; tier?: Tier };
type ConsultExpert = { slug: string; question: string; must: boolean; row: RunRowG | null; out: any; secs: [string, Tiered[]][]; numbers: any[]; sugg: any[] };
type Consult = { gw: RunRowG; out: any; experts: ConsultExpert[]; okN: number; synced: boolean };
const tiered = (a: unknown): Tiered[] => (Array.isArray(a) ? a.map((x) => (typeof x === 'string' ? { text: x } : { text: String(x?.text ?? ''), tier: x?.tier })).filter((x) => x.text) : []);
const arr = (a: unknown): any[] => (Array.isArray(a) ? a : []);
const consults: Partial<Record<Step, Consult>> = {};
const boundGw = (stage: Step): number | null => SIDES.map((s) => latest[stage][s]?.gateway_run_id).find((x) => x != null) ?? null;
if (canRecipe) {
  const RUN_COLS = 'id,project_id,step,round,side,attempt,provider_id,model,is_free,experts,output_json,ok,err,ms,gateway_run_id,created_at';
  const bound = [boundGw('recommend'), boundGw('generate')].filter((x): x is number => x != null);
  const { results: gwRows } = await c.db.prepare(
    `SELECT ${RUN_COLS}, json_extract(input_json,'$.meta.stage') AS stage FROM formula_runs WHERE project_id=? AND step='gateway'
      ORDER BY (id IN (${bound.length ? bound.map(() => '?').join(',') : 'NULL'})) DESC, id DESC LIMIT 10`,
  ).bind(id, ...bound).all<RunRowG & { stage: string | null }>().catch(() => ({ results: [] as (RunRowG & { stage: string | null })[] }));
  const gwLatest: Partial<Record<Step, RunRowG>> = {};
  for (const stage of ['recommend', 'generate'] as Step[]) {
    const gid = boundGw(stage);
    const g = gwRows.find((r) => r.id === gid) ?? gwRows.find((r) => r.stage === stage);
    const r = g ? (redact(labRole, 'run', g) as RunRowG | null) : null;
    if (r) gwLatest[stage] = r;
  }
  const gws = Object.values(gwLatest);
  const { results: exRows } = gws.length
    ? await c.db.prepare(`SELECT ${RUN_COLS} FROM formula_runs WHERE step='expert' AND gateway_run_id IN (${gws.map(() => '?').join(',')}) ORDER BY id DESC`)
        .bind(...gws.map((g) => g.id)).all<RunRowG>().catch(() => ({ results: [] as RunRowG[] }))
    : { results: [] as RunRowG[] };
  for (const [stage, gw] of Object.entries(gwLatest) as [Step, RunRowG][]) {
    const out = safeJson<any>(gw.output_json, null);
    const seats = [...arr(out?.must).map((m) => ({ ...m, must: true })), ...arr(out?.optional).map((m) => ({ ...m, must: false }))] as { slug: string; question?: string; must: boolean }[];
    if (!seats.length) seats.push(...splitList(gw.experts).map((slug) => ({ slug, must: true })));
    const experts: ConsultExpert[] = seats.map((s) => {
      const row = (exRows.find((x) => x.gateway_run_id === gw.id && x.experts === s.slug) ?? null) as RunRowG | null;
      const eo = row?.ok === 1 ? safeJson<any>(row.output_json, null) : null;
      return {
        slug: s.slug, question: String(s.question ?? ''), must: s.must, row, out: eo,
        secs: eo ? [['要点', tiered(eo.points)], ['风险', tiered(eo.risks)], ['红线', tiered(eo.red_lines)], ['必须核实', tiered(eo.must_verify)]] : [],
        numbers: arr(eo?.numbers), sugg: arr(eo?.suggestions_for_recipe),
      };
    });
    consults[stage] = { gw, out, experts, okN: experts.filter((e) => e.out).length, synced: gw.id === boundGw(stage) };
  }
}
const consultN = (stage: Step) => { const r = SIDES.map((s) => latest[stage][s]).find((x) => x?.gateway_run_id != null); return r ? splitList(r.experts).length : 0; };

/* versions */
const { results: verRows } = await c.db.prepare(
  `SELECT v.*, r.side AS src_side FROM formula_versions v LEFT JOIN formula_runs r ON r.id=v.source_run_id WHERE v.project_id=? ORDER BY v.version_no DESC`,
).bind(id).all<VersionRow & { src_side: string | null }>();
const versions = verRows.map((v) => redact(labRole, 'version', v) as VersionRow & { src_side: string | null });
const verNo = new Map(verRows.map((v) => [v.id, v.version_no]));
const { results: fbRows } = versions.length && (canRecipe || sampler)
  ? await c.db.prepare(`SELECT * FROM formula_feedback WHERE version_id IN (${versions.map(() => '?').join(',')}) ORDER BY version_id, round`).bind(...versions.map((v) => v.id)).all<any>()
  : { results: [] as any[] };
const fbByVer = new Map<number, any[]>();
for (const f of fbRows) fbByVer.set(f.version_id, [...(fbByVer.get(f.version_id) ?? []), f]);

/* 专家中文标题 */
const shown = SIDES.flatMap((s) => [latest.recommend[s], latest.generate[s]]).filter((r): r is RunRow => !!r);
const slugs = [...new Set([...shown.flatMap((r) => splitList(r.experts)), ...Object.values(consults).flatMap((k) => k.experts.map((e) => e.slug))])];
const expertTitle = new Map<string, string>();
const expertDomain = new Map<string, string>();
if (slugs.length) {
  const { results } = await c.db.prepare(`SELECT slug, title, domain FROM expert_skills WHERE slug IN (${slugs.map(() => '?').join(',')})`)
    .bind(...slugs).all<{ slug: string; title: string; domain: string }>().catch(() => ({ results: [] as any[] }));
  for (const e of results ?? []) { expertTitle.set(e.slug, e.title); expertDomain.set(e.slug, e.domain ?? ''); }
}
const titleOf = (slug: string) => expertTitle.get(slug) ?? slug;

/* ── 显示小工具 ───────────────────────────────────────────────────────────── */
const TIER_CLS: Record<string, string> = { '①': 'p-ok', '②': 'p-warn', '③': 'p-wait' };
const tierCls = (t: Tier | string | undefined) => TIER_CLS[t ?? ''] ?? 'p-wait';
/* 创始人 12:4x:「为什么、卖点、风险文字少一点,他们工作量大没时间看」—— 页面只显示前 N 字,全文在 title 与留档里(以后录知识库用全文) */
const cut = (s: unknown, n = 36): string => { const x = String(s ?? '').trim(); return x.length > n ? x.slice(0, n) + '…' : x; };
const roleZh = (r: string) => (r === 'system' ? '系统提示' : r === 'user' ? '需求与资料' : r);
const marketsZh = (m: string | undefined) => splitList(m).map((x) => MARKET_ZH[x] ?? x).join('、') || '—';
const claimsZh = (s: string | undefined) => splitList(s).map(benefitZh).join('、') || '—';
const range = (lo: number | null | undefined, hi: number | null | undefined) => (lo == null && hi == null ? '—' : `${lo ?? '?'}–${hi ?? '?'}%`);
const fmtN = (n: number | null | undefined) => (n == null ? '—' : String(n));
/* 全绿标(总工 09-17「按照美丽修行那种标准确认」):每行 INCI 前色点;无 facts 行灰点 */
const DOT: Record<string, string> = { green: '🟢', yellow: '🟡', red: '🔴' };
const dotOf = (m: { green?: string | null; irr?: number | null; com?: number | null }) => ({ dot: DOT[m.green ?? ''] ?? '⚪', title: m.green ? `${m.green === 'green' ? '绿标' : m.green === 'yellow' ? '黄标' : '红标'} · 刺激 ${fmtN(m.irr)} · 致痘 ${fmtN(m.com)}` : '无评级数据' });
const greenBadge = (rows: { green?: string | null }[]) => { const n = rows.filter((m) => m.green === 'yellow' || m.green === 'red').length; const u = rows.filter((m) => !m.green).length; return n ? { cls: 'p-warn', text: `有 ${n} 项黄/红` } : u ? { cls: 'p-wait', text: `绿 ${rows.length - u} · 无评级 ${u}` } : { cls: 'p-ok', text: '全绿 ✓' }; };   // 09-18:全无评级不许冒充「全绿」
/* 老版本 / 老运行的 materials 没存等级(09-18 之前生成):渲染时补一次评级,不改库;一版一次 IN 查 */
const fillGreen = async (mats: any[]) => { if (!mats.length || !mats.some((m) => m && m.green === undefined)) return; const rated = await rateMaterials(c.db, mats); rated.forEach((r, i) => { if (mats[i]) Object.assign(mats[i], { green: r.green ?? null, irr: r.irr ?? null, com: r.com ?? null }); }); };
/* 市场验证参考(GPT 设计包原则:频率 ≠ 销量):同品类公开全成分 Top 15,表空则不显示 */
const mref = await marketRef(c.db, raw);
/* ESG 四支柱(创始人 09-18:「开发部需要符合 ESG 规范全绿的配方」):esg_json 由 op=esg 写(G 任务),形状按契约;本页只渲染 + 按钮 */
type EsgHit = { seq: number | string; inci: string; pct: number | null; pillar: string; severity: 'red' | 'yellow'; rule_id: number; title_zh: string; reason_zh: string; basis: string; basis_url?: string | null; limit?: { max: number | null; note: string; exceeds: boolean | null } | null };
type Esg = { standard: string; checked_at: string; form: string; markets: string[]; pass: boolean; pillars: Record<string, { status: string; n: number }>; hits: EsgHit[]; alternatives?: Record<string, { inci_key: string; name_zh: string; functions_zh?: string }[]> };
const PILLARS: [string, string][] = [['regulatory', '法规'], ['environment', '环境'], ['social', '社会'], ['safety', '安全']];
const PILLAR_ZH = Object.fromEntries(PILLARS);
const ESG_CLS: Record<string, string> = { green: 'p-ok', yellow: 'p-warn', red: 'p-bad' };
const esgOk = (e: any): Esg | null => (e && Array.isArray(e.hits) ? (e as Esg) : null);
const esgN = (e: Esg | null) => ({ red: e ? e.hits.filter((h) => h.severity === 'red').length : 0, yellow: e ? e.hits.filter((h) => h.severity === 'yellow').length : 0 });
const esgSummary = (e: Esg) => { const n = esgN(e); return n.red || n.yellow ? `${n.red} 项红 · ${n.yellow} 项黄` : 'ESG 全绿 ✓'; };
/* 行级小标:同一 seq 命中多条取最重;与美丽修行安全档色点并列,不混 */
const esgSev = (e: Esg | null, seq: unknown): 'red' | 'yellow' | null => { if (!e) return null; const hs = e.hits.filter((h) => String(h.seq) === String(seq)); return hs.some((h) => h.severity === 'red') ? 'red' : hs.length ? 'yellow' : null; };
const constraintTags = (k: NonNullable<typeof constraints>) => [
  k.halal && '清真', k.vegan && '纯素', k.fragrance_free && '无香', k.no_mit_cmit && '无 MIT/CMIT', k.preservative_free && '无防腐', k.all_green && '全绿标', (k as any).esg && 'ESG',   // esg 键由 G 任务加进 Constraints
  (k.ph_low != null || k.ph_high != null) && `pH ${k.ph_low ?? '?'}–${k.ph_high ?? '?'}`, k.other,
].filter(Boolean) as string[];
const errHint = (err: string | null) => {
  const e = err ?? '';
  const out: string[] = [];
  if (/401|404|model/i.test(e)) out.push('多半是密钥或模型配置不对:后台 → 模型舰队 → 体检。');
  if (e.includes('已判死')) out.push('5 分钟后再试。');
  return out.join('');
};
const gateOf = (r: RunRow) => {
  const g = safeJson<any>(r.gate_json, null);
  if (!g) return { red: 0, yellow: 0, dropped: 0, list: null as GateJson | null };
  const n = (x: unknown) => (Array.isArray(x) ? x.length : Number(x) || 0);
  return { red: n(g.red), yellow: n(g.yellow), dropped: n(g.dropped), list: Array.isArray(g.red) ? (g as GateJson) : null, esg: esgOk(g.esg) };   // gate_json.esg:草稿闸门顺带的 ESG 结果(非 canRecipe 被 redact 压成计数,自然为 null)
};
const promptOf = (r: RunRow) => (safeJson<any>(r.input_json, null)?.messages ?? []) as { role: string; content: string }[];
const notesOf = (r: RunRow) => (safeJson<any>(r.input_json, null)?.meta?.notes ?? []) as string[];
const missingOf = (r: RunRow) => (safeJson<any>(r.input_json, null)?.meta?.missing ?? []) as string[];
const STANCE_CLS: Record<string, string> = { '支持': 'p-ok', '有条件支持': 'p-warn', '反对': 'p-bad', '不适用': 'p-wait' };
const stanceCls = (s: unknown) => STANCE_CLS[String(s ?? '')] ?? 'p-wait';
const consultSummary = (k: Consult) => `会诊记录 · ${k.experts.length} 位专家${k.okN < k.experts.length ? ` · 缺席 ${k.experts.length - k.okN}` : ''} · 第 ${k.gw.round} 轮${k.synced ? '' : ' · 本轮尚未汇总'}`;
const latestVer = versions[0] ?? null;
const nextRound = (v: VersionRow | null) => (v ? (fbByVer.get(v.id)?.length ?? 0) + 1 : 1);
const FB_COLS: [string, string][] = [['ph', 'pH'], ['viscosity', '黏度'], ['centrifuge', '离心'], ['freeze_thaw', '冻融'], ['accel_40c', '40℃ 加速'], ['appearance', '外观'], ['odor', '气味'], ['skin_feel', '肤感'], ['customer_text', '客户意见']];
const DECISION_ZH: Record<string, string> = { adjust: '继续调整', accept: '接受' };
const REC_ZH: Record<string, string> = { liu: `采纳${personaOf('L')}版`, huang: `采纳${personaOf('R')}版`, merge: '合并两版' };
const FROM_ZH: Record<string, string> = { liu: personaOf('L'), huang: personaOf('R') };
const STAGE_ZH: Record<Step, string> = { recommend: '推荐基底', generate: '配方草案' };

/* 李总工行按角色投影(不走 redact):业务 / 无角色只留结论一句 + 建议;打版员 null;input_json 只 canRecipe */
const reviewOf = (stage: Step) => {
  const gid = boundGw(stage);
  const r = gid != null ? reviewRaw.get(gid) ?? null : null;
  if (!r || sampler) return null;
  const full = r.ok ? safeJson<any>(r.output_json, null) : null;
  const out = full && !canRecipe ? { summary: full.summary, recommendation: full.recommendation } : full;
  return {
    id: r.id, ok: r.ok, err: r.err, round: r.round, is_free: r.is_free, prompt: canRecipe && r.input_json ? promptOf(r) : [],
    out, cmp: arr(out?.comparison), plan: arr(out?.merge_plan), notes: arr(out?.red_yellow_notes), next: arr(out?.next_steps),
  };
};

/* 模板里不写块体箭头函数,每轮 / 每栏 / 每版本的派生量在这里先算好 */
const stageBlocks = (['recommend', 'generate'] as Step[]).map((stage) => {
  const cols = SIDES.map((side) => {
    const r = latest[stage][side] ?? null;
    const out = r?.ok ? safeJson<any>(r.output_json, null) : null;
    return { side, r, out, g: r ? gateOf(r) : null, full: !!out && Array.isArray(out.phases), picks: arr(out?.picks), persona: personaOf(side) };
  });
  return { stage, cols, has: cols.some((x) => !!x.r), round: topRound[stage], j: reviewOf(stage), consult: consults[stage] ?? null, n: consultN(stage) };
});
/* 价格快照四字段(契约:RecipeRow 可选 material_id/price/price_at/price_status;老版本没有就是 null)。创始人 09-18 12:5x「多选原料和价格」 */
type Priced = { material_id?: number | null; price?: number | null; price_at?: string | null; price_status?: string | null };
const priceOf = (m: RecipeRow) => { const p = (m as Priced).price; return p == null || p === ('' as any) || Number.isNaN(Number(p)) ? null : Number(p); };
const priceAtOf = (m: RecipeRow) => (m as Priced).price_at ?? null;
const midOf = (m: RecipeRow) => (m as Priced).material_id ?? null;
/* 只有财务已确认的价当准数(创始人 09-18 12:5x「价格由财务和采购确认,我们不可以瞎编」);有价但未到 finance_confirmed 一律「待确认」 */
const confirmedOf = (m: RecipeRow) => (m as Priced).price_status === 'finance_confirmed';
/* 版本成本口径:cost 只按财务确认行累加(准数),pending 是待确认行部分,missing 无价行;priced=0 表示整版没价格字段(未估价) */
const costOf = (rows: RecipeRow[]) => rows.reduce((a, m) => { const p = priceOf(m); if (p == null) a.missing++; else { a.priced++; const c = ((Number(m.pct) || 0) / 100) * p; if (confirmedOf(m)) a.cost += c; else { a.unconfirmed++; a.pending += c; } } return a; }, { cost: 0, pending: 0, missing: 0, priced: 0, unconfirmed: 0 });
/* Σ 行文案:准数 / 含待确认 / 无价 三句可叠加 */
const costText = (rows: RecipeRow[]) => {
  const c = costOf(rows);
  if (c.priced === 0) return '未估价 · 编辑并保存新版本即可带价';
  const parts: string[] = [];
  if (c.unconfirmed === 0 && c.missing === 0) parts.push(`成本 ≈ ${c.cost.toFixed(2)} 元/kg(财务确认价)`);
  else if (c.priced > c.unconfirmed) parts.push(`财务确认价部分 ≈ ${c.cost.toFixed(2)} 元/kg`);
  if (c.unconfirmed > 0) parts.push(`含 ${c.unconfirmed} 项待确认价,非准数:≈ ${(c.cost + c.pending).toFixed(2)} 元/kg`);
  if (c.missing > 0) parts.push(`${c.missing} 项无价,成本不完整`);
  return parts.join(';');
};
const verCards = versions.map((v) => {
  const vg = safeJson<any>(v.gate_json, null);
  return { v, rows: safeJson(v.recipe_json, [] as RecipeRow[]), dropN: Array.isArray(vg?.dropped) ? vg.dropped.length : 0, esg: esgOk(safeJson<any>((v as any).esg_json, null)),   // esg_json 列由迁移加(G 任务)
    proc: (safeJson<any>(v.rationale_json, null)?.process ?? []) as { text: string }[], fbs: fbByVer.get(v.id) ?? [] };
});
for (const b of stageBlocks) for (const x of b.cols) if (x.full) await fillGreen(x.out.phases.flatMap((p: any) => (Array.isArray(p?.materials) ? p.materials : [])));
for (const vc of verCards) await fillGreen(vc.rows as any[]);
const genBlock = stageBlocks[1];
const latestBases = canRecipe && latestVer?.base_codes ? splitList(latestVer.base_codes).join(',') : '';

/* 留痕(3.5) */
if (canRecipe) {
  const refs = [
    ...verCards.filter((x) => x.rows.length > 0).map((x) => `version:${x.v.id}`),
    ...genBlock.cols.filter((x) => x.r?.ok === 1 && x.full).map((x) => `run:${x.r!.id}`),
    ...Object.values(consults).filter((k) => k.gw.ok === 1).map((k) => `gateway:${k.gw.id}`),
  ];
  if (refs.length) await c.db.batch(refs.map((ref) => c.db.prepare(`INSERT INTO formula_access_log (uid, kind, ref) VALUES (?, 'recipe', ?)`).bind(c.sess.uid, ref))).catch(() => {});
}
const P_PILL: Record<string, string> = { open: 'p-wait', sampling: 'p-warn', final: 'p-ok' };
const statusZh = PROJECT_STATUS_ZH[project.status ?? ''] ?? project.status ?? '';
const userLine = 'brief' in project && project.brief ? project.brief : `${catZh(project.category ?? '')} · ${fmtZh(project.format ?? '')}${'claims' in project ? ` · ${claimsZh(project.claims)}` : ''}`;
---

<LabShell title={`配方实验室 · ${project.code}`} email={c.sess.email} tenant={c.tenant} code={project.code} status={statusZh}>
  <div class="lab" id="lab">
    <!-- 左栏:项目列表 -->
    <aside class="lab-side">
      <a class="btn pri new" href="/bohui/formula-lab/">+ 新建对话</a>
      <div class="plist">
        {plist.map((r) => (
          <a class:list={['pitem', r.id === id && 'on']} href={`/bohui/formula-lab/${r.id}/`}>
            <b><code>{r.code}</code> <span class:list={['pill', P_PILL[r.status ?? ''] ?? 'p-wait']}>{PROJECT_STATUS_ZH[r.status ?? ''] ?? r.status}</span></b>
            <span>{catZh(r.category ?? '')} · {fmtZh(r.format ?? '')}</span>
          </a>
        ))}
        {sampler && <a class="pitem on" href="#"><b><code>{project.code}</code></b><span>{catZh(project.category ?? '')} · {fmtZh(project.format ?? '')}</span></a>}
      </div>
    </aside>

    <!-- 中间:对话流 -->
    <main class="lab-main">
      <div class="chat" id="chat">
        {!labRole && <div class="note info">你还没有实验室角色,看不到配方比例;请管理员在「账号与权限」页设置。</div>}

        {canWrite && (
        <form class="ask" id="ask">
          <textarea name="text" rows="2" placeholder="追加需求,例:客户要求改成无防腐、pH 5.5 以下" required></textarea>
          <button class="btn" type="button" id="mic" title="按一下开始说话,再按一下停止;识别的文字会追加进输入框">🎤 语音</button>
          <button class="btn" type="button" id="cam" title="拍一张需求单 / 手写纸,识别成文字填进输入框">📷 拍照 / 传图</button>
          <input type="file" id="camf" accept="image/*" capture="environment" hidden />
          <button class="btn pri" type="submit" id="send">发送</button>
          <button class="btn" type="button" id="btn-again" data-round={genBlock.round + 1} data-bases={latestBases} hidden>再出一版</button>
          <small class="tag" id="ocr-tag" hidden>识别自图片 · 发送前请核对</small>
        </form>
        )}
        <!-- 需求摘要(系统维护,可折叠) -->
        <details class="bub sys brief" open>
          <summary>需求摘要 · <code>{project.code}</code> · {catZh(project.category ?? '')} / {fmtZh(project.format ?? '')} <span class:list={['pill', P_PILL[project.status ?? ''] ?? 'p-wait']}>{statusZh}</span></summary>
          <dl>
            {'customer' in project && <><dt>客户</dt><dd>{project.customer || '—'}</dd></>}
            {'claims' in project && <><dt>目标功效</dt><dd>{claimsZh(project.claims)}</dd></>}
            {'markets' in project && <><dt>目标市场</dt><dd>{marketsZh(project.markets)}</dd></>}
            {constraints && <><dt>硬约束</dt><dd>{constraintTags(constraints).join(' · ') || '—'}</dd></>}
            {'cost_band' in project && <><dt>成本档</dt><dd>{COST_BAND_ZH[project.cost_band ?? ''] ?? project.cost_band ?? '—'}</dd></>}
            <dt>创建</dt><dd><time data-utc={project.created_at}>{(project.created_at ?? '').slice(0, 16)}</time></dd>
            {mref.rows.length > 0 && <><dt>市场参考</dt><dd class="mref"><span class="soft">{mref.cats.join('/')} · {mref.total} 款公开全成分的出现频率(不是销量):</span>{mref.rows.map((r) => <a class="pill p-wait" href={ingredientPath('zh-cn', r.k)} target="_blank" title={`${r.n} 款 · ${r.pct}%`}>{r.k} {r.pct}%</a>)}</dd></>}
          </dl>
        </details>

        <!-- 用户气泡:需求原话 -->
        <div class="bub me">{userLine}</div>

        {!sampler && stageBlocks.map(({ stage, cols, has, round, j, consult, n }) => (
          <>
            {stage === 'recommend' && !has && (
              <div class="bub sys">
                {canWrite ? <>两位总工还没出基底推荐。<button class="btn pri" id="btn-rec" data-round={round + 1}>开始会诊 · 推荐基底</button><span class="soft">网关拆题 → 专家逐位审核 → {personaOf('L')} / {personaOf('R')}各出一版 → {personaOf('J')}点评,约 5–10 分钟。</span></> : '两位总工还没出基底推荐。'}
              </div>
            )}
            {has && (
              <div class="turn">
                <div class="turnhead"><b>第 {round} 轮 · {STAGE_ZH[stage]}</b>{!canRecipe && n > 0 && <span class="soft">本轮会诊 {n} 位专家参与</span>}{stage === 'recommend' && canWrite && <button class="btn sm" id="btn-rec" data-round={round + 1}>再会诊一轮</button>}</div>
                <div class="cards">
                  {cols.map(({ side, r, out, g, full, picks, persona }) => (
                    <section class="pcard" data-col={`${stage}-${side}`}>
                      <header class="phead">
                        <span class:list={['ava', side === 'L' ? 'a-l' : 'a-r']}>{persona.slice(0, 1)}</span>
                        <b>{persona}</b>
                        {r?.is_free === 1 && <small class="test">测试通道</small>}
                        <span class="st" data-st={`${stage}-${side}`}></span>
                      </header>
                      {g?.esg && <div class="esg-line soft">ESG:{esgN(g.esg).red} 红 {esgN(g.esg).yellow} 黄</div>}
                      {!r && <div class="empty">还没有结果。</div>}
                      {r && !r.ok && (
                        <div class="note bad">
                          没出来:{r.err || '未知错误'}{errHint(r.err) && <><br />{errHint(r.err)}</>}
                          {canWrite && <><br /><button class="btn sm retry" data-run={r.id} style="margin-top:.375rem">重试</button></>}
                        </div>
                      )}

                      {/* 推荐:基底卡片 */}
                      {stage === 'recommend' && r?.ok === 1 && picks.map((p: any, i: number) => (
                        <div class="pick">
                          <div class="pickhead">
                            {canWrite && 'code' in p && <input type="checkbox" class="pick-ck" value={p.code} title="选为基底" />}
                            {'code' in p ? <a href={`/bohui/formulas/?q=${encodeURIComponent(p.code)}`} target="_blank"><code>{p.code}</code></a> : <code>候选 {i + 1}</code>}
                            {p.expected && <span class="exp">{p.expected}</span>}
                          </div>
                          <details>
                            <summary>为什么 · 卖点 · 风险</summary>
                            {p.why && <p title={p.why}><b>为什么推荐</b>{cut(p.why)} <span class:list={['pill', tierCls(p.why_tier)]}>{p.why_tier ?? '③'}</span></p>}
                            {p.combo && <p title={p.combo}><b>组合逻辑</b>{cut(p.combo)}</p>}
                            {Array.isArray(p.selling) && p.selling.length > 0 && <p title={p.selling.join(';')}><b>功效卖点</b>{p.selling.slice(0, 3).map((x: string) => cut(x, 14)).join(' · ')}</p>}
                            {Array.isArray(p.risks) && p.risks.length > 0 && <p><b>风险</b>{p.risks.slice(0, 2).map((k: any) => <span class="li" title={k.text}>{cut(k.text, 22)} <span class:list={['pill', tierCls(k.tier)]}>{k.tier ?? '③'}</span></span>)}</p>}
                            {Array.isArray(p.verify) && p.verify.length > 0 && <p title={p.verify.join(';')}><b>需验证</b>{p.verify.slice(0, 2).map((x: string) => cut(x, 16)).join(' · ')}</p>}
                          </details>
                        </div>
                      ))}
                      {stage === 'recommend' && r?.ok === 1 && out?.notes && <details class="notes"><summary>整体说明 · {cut(out.notes, 30)}</summary><p>{out.notes}</p></details>}

                      {/* 生成:配方相表 */}
                      {stage === 'generate' && r?.ok === 1 && out && (
                        <div class="draft">
                          <h3>{out.name || '(未命名)'} <span class="soft">{out.system_type}</span></h3>
                          {full && (
                            <table class="recipe">
                              <thead><tr><th>序号</th><th>相</th><th>原料</th><th>INCI</th><th>比例</th><th>区间</th><th>用途</th><th class="gb">核对 <span class:list={['pill', greenBadge(out.phases.flatMap((ph: any) => ph.materials ?? [])).cls]}>{greenBadge(out.phases.flatMap((ph: any) => ph.materials ?? [])).text}</span></th></tr></thead>
                              <tbody>
                                {out.phases.map((ph: any) => (ph.materials ?? []).map((m: any) => (
                                  <tr class:list={[m.flag === 'red' && 'red', m.flag === 'yellow' && 'yellow']}>
                                    <td><code>{m.seq}</code></td><td>{ph.phase}</td><td>{m.name}</td><td class="mono"><span class="dot" title={dotOf(m).title}>{dotOf(m).dot}</span>{m.inci}{esgSev(g?.esg ?? null, m.seq) && <span class:list={['esg-tag', esgSev(g?.esg ?? null, m.seq)]}>ESG {esgSev(g?.esg ?? null, m.seq) === 'red' ? '红' : '黄'}</span>}</td>
                                    <td class="num"><b>{m.pct == null ? '—' : `${m.pct}%`}</b></td><td class="num soft">{range(m.pct_low, m.pct_high)}</td><td>{m.purpose}</td>
                                    <td>
                                      {m.flag === 'red' && <span class="pill p-bad" title={m.flag_note}>红</span>}
                                      {m.flag === 'yellow' && <span class="pill p-warn" title={m.flag_note}>黄 · {sourceZh(m.source)}</span>}
                                      {!m.flag && <span class:list={['pill', tierCls(m.tier)]}>{m.tier ?? '③'}</span>}
                                    </td>
                                  </tr>
                                )))}
                              </tbody>
                              <tfoot><tr><td colspan="4" class="soft">Σ 比例</td><td class="num"><b>{(out.phases ?? []).flatMap((ph: any) => ph.materials ?? []).reduce((a: number, m: any) => a + (Number(m.pct) || 0), 0).toFixed(2)}%</b></td><td colspan="3"></td></tr></tfoot>
                            </table>
                          )}
                          {Array.isArray(out.selling_points) && out.selling_points.length > 0 && (
                            <div class="blk"><b>功效卖点</b><ul>{out.selling_points.slice(0, 3).map((s: any) => <li title={s.text}>{cut(s.text, 16)}</li>)}</ul></div>
                          )}
                          <details>
                            <summary>为什么 · 工艺 · 风险 · 需验证</summary>
                            {Array.isArray(out.efficacy_logic) && out.efficacy_logic.length > 0 && (
                              <div class="blk"><b>功效逻辑</b><ul>{out.efficacy_logic.map((e: any) => <li><i>{e.claim}</i>:{e.because} <span class:list={['pill', tierCls(e.tier)]}>{e.tier ?? '③'}</span></li>)}</ul></div>
                            )}
                            {full && Array.isArray(out.process) && out.process.length > 0 && (
                              <div class="blk"><b>工艺步骤</b><ol>{out.process.map((s: any) => <li>{s.text} <span class:list={['pill', tierCls(s.tier)]}>{s.tier ?? '③'}</span></li>)}</ol></div>
                            )}
                            {full && out.ph_window && <div class="blk"><b>pH 窗口</b>{fmtN(out.ph_window.low)}–{fmtN(out.ph_window.high)}</div>}
                            {full && Array.isArray(out.risks) && out.risks.length > 0 && (
                              <div class="blk"><b>风险</b><ul>{out.risks.slice(0, 3).map((s: any) => <li title={s.text}>{cut(s.text, 22)} <span class:list={['pill', tierCls(s.tier)]}>{s.tier ?? '③'}</span></li>)}</ul></div>
                            )}
                            {full && Array.isArray(out.verify) && out.verify.length > 0 && (
                              <div class="blk"><b>需验证</b><ul>{out.verify.slice(0, 3).map((s: any) => <li title={`${s.text}${s.how ? ' —— ' + s.how : ''}`}>{cut(s.text, 16)}</li>)}</ul></div>
                            )}
                            {full && Array.isArray(out.unlisted) && out.unlisted.length > 0 && (
                              <div class="blk unlisted"><b>另提但不在库内(采纳时自动剔除)</b><ul>{out.unlisted.map((u: any) => <li>{u.name}{u.why ? `:${u.why}` : ''}</li>)}</ul></div>
                            )}
                            {full && Array.isArray(out.decisions_for_customer) && out.decisions_for_customer.length > 0 && (
                              <div class="blk"><b>需客户拍板</b><ul>{out.decisions_for_customer.map((s: string) => <li>{s}</li>)}</ul></div>
                            )}
                            {g && <div class="blk"><b>闸门</b><span class="pill p-bad">红 {g.red}</span> <span class="pill p-warn">黄 {g.yellow}</span>{g.dropped > 0 && <span class="soft"> · 候选外 {g.dropped} 条已剔</span>}</div>}
                          </details>
                          {canWrite && full && (
                            <div class="row"><button class="btn pri adopt" data-run={r.id}>采纳{persona}版</button><span class="soft">红项自动剔除,黄项保留标记;采纳后在版本卡改比例。</span></div>
                          )}
                        </div>
                      )}

                      {/* 卡脚:会诊记录(刘总工卡内)、召集、提示词 */}
                      {r && canRecipe && (
                        <footer class="pfoot">
                          {side === 'L' && consult && (
                            <details class="crec">
                              <summary>{consultSummary(consult)}</summary>
                              {!consult.gw.ok && <div class="note bad">网关拆解失败:{consult.gw.err || '未知错误'}</div>}
                              {consult.out && (
                                <div class="gw">
                                  <b>网关拆解</b>
                                  {consult.out.analysis?.system_type_hint && <p>体系提示:{consult.out.analysis.system_type_hint}</p>}
                                  {arr(consult.out.analysis?.sub_questions).length > 0 && <ol>{arr(consult.out.analysis?.sub_questions).map((q: any) => <li>{q.topic ? <i>{q.topic}:</i> : null}{q.question ?? q}</li>)}</ol>}
                                  {consult.out.notes && <p class="soft">{consult.out.notes}</p>}
                                </div>
                              )}
                              <b class="gwb">专家意见</b>
                              {consult.experts.map((e) => (
                                <div class="xcard">
                                  <div class="xhead">
                                    <b>{titleOf(e.slug)}</b><span class="soft">{expertDomain.get(e.slug) ?? ''}</span>
                                    <span class:list={['pill', e.must ? 'p-ok' : 'p-wait']}>{e.must ? '必审' : '旁听'}</span>
                                    {e.out ? <span class:list={['pill', stanceCls(e.out.stance)]}>{e.out.stance ?? '—'}</span> : <span class="pill p-bad">缺席 · {e.row ? e.row.err || '失败' : '未调用'}</span>}
                                  </div>
                                  {e.question && <p class="q">问:{e.question}</p>}
                                  {e.secs.map(([label, items]) => items.length > 0 && <div class="blk"><b>{label}</b><ul>{items.map((it) => <li>{it.text} {it.tier && <span class:list={['pill', tierCls(it.tier)]}>{it.tier}</span>}</li>)}</ul></div>)}
                                  {e.numbers.length > 0 && (
                                    <table class="recipe"><thead><tr><th>数字</th><th>值</th><th>来源</th><th>档</th></tr></thead>
                                      <tbody>{e.numbers.map((x: any) => <tr><td>{x.what}</td><td class="num">{x.value}</td><td class="soft">{x.source ?? '—'}</td><td><span class:list={['pill', tierCls(x.tier)]}>{x.tier ?? '③'}</span></td></tr>)}</tbody></table>
                                  )}
                                  {e.sugg.length > 0 && (
                                    <table class="recipe"><thead><tr><th>建议原料</th><th>INCI</th><th>用量</th><th>用途</th><th>来源</th><th>档</th></tr></thead>
                                      <tbody>{e.sugg.map((m: any) => <tr><td>{m.name}</td><td class="mono">{m.inci}</td><td class="num">{range(m.pct_low, m.pct_high)}</td><td>{m.purpose}</td><td class="soft">{sourceZh(m.source)}</td><td><span class:list={['pill', tierCls(m.tier)]}>{m.tier ?? '③'}</span></td></tr>)}</tbody></table>
                                  )}
                                </div>
                              ))}
                            </details>
                          )}
                          <details>
                            <summary>本栏召集 · 提示词</summary>
                            <div class="soft">召集:{splitList(r.experts).map(titleOf).join('、') || '—'}</div>
                            {missingOf(r).length > 0 && <div class="soft">缺席:{missingOf(r).map(titleOf).join('、')}</div>}
                            {notesOf(r).map((x) => <div class="soft">{x}</div>)}
                            {canWrite && r.ok === 1 && <button class="btn sm retry" data-run={r.id}>重跑本栏</button>}
                            {r.input_json && promptOf(r).map((m) => <div class="prompt"><b>[{roleZh(m.role)}]</b><pre>{m.content}</pre></div>)}
                          </details>
                        </footer>
                      )}
                    </section>
                  ))}
                </div>

                {/* 李总工点评 */}
                <section class="pcard jcard" data-col={`${stage}-J`}>
                  <header class="phead">
                    <span class="ava a-j">{personaOf('J').slice(0, 1)}</span>
                    <b>{personaOf('J')}点评</b>
                    {j?.is_free === 1 && <small class="test">测试通道</small>}
                    {j?.out?.recommendation && <span class="pill p-ok">{REC_ZH[j.out.recommendation] ?? j.out.recommendation}</span>}
                    {j?.out?.tier && <span class:list={['pill', tierCls(j.out.tier)]}>{j.out.tier}</span>}
                    <span class="st" data-st={`${stage}-J`}></span>
                  </header>
                  {!j && <div class="empty">还没有点评。{canWrite ? '两版都出来后自动点评;若中断可点「再会诊一轮」。' : ''}</div>}
                  {j && !j.ok && <div class="note bad">点评没出来:{j.err || '未知错误'}{errHint(j.err) && <><br />{errHint(j.err)}</>}{canWrite && <><br /><button class="btn sm retry" data-run={j.id} style="margin-top:.375rem">重试</button></>}</div>}
                  {j?.out && (
                    <>
                      <p class="jsum">{j.out.summary}</p>
                      {canRecipe && (j.cmp.length > 0 || j.plan.length > 0 || j.notes.length > 0 || j.next.length > 0) && (
                        <details>
                          <summary>逐项对比 · 合并方案 · 红黄项 · 下一步</summary>
                          {j.cmp.length > 0 && (
                            <table class="cmp">
                              <thead><tr><th>项</th><th>{personaOf('L')}</th><th>{personaOf('R')}</th><th>判定</th><th>档</th></tr></thead>
                              <tbody>{j.cmp.map((x: any) => <tr><td><b>{x.aspect}</b></td><td>{x.liu}</td><td>{x.huang}</td><td>{x.verdict}</td><td><span class:list={['pill', tierCls(x.tier)]}>{x.tier ?? '③'}</span></td></tr>)}</tbody>
                            </table>
                          )}
                          {j.plan.length > 0 && (
                            <div class="blk"><b>合并方案</b><ul>{j.plan.map((m: any) => <li>取{FROM_ZH[m.take_from] ?? m.take_from}的 {arr(m.rows).join('、') || '—'}:{m.why}</li>)}</ul></div>
                          )}
                          {j.notes.length > 0 && <div class="blk"><b>红黄项</b><ul>{j.notes.map((x: any) => <li>{typeof x === 'string' ? x : x.text}</li>)}</ul></div>}
                          {j.next.length > 0 && <div class="blk"><b>下一步</b><ul>{j.next.map((x: any) => <li>{typeof x === 'string' ? x : x.text}</li>)}</ul></div>}
                          {j.prompt.length > 0 && <details><summary>提示词</summary>{j.prompt.map((m) => <div class="prompt"><b>[{roleZh(m.role)}]</b><pre>{m.content}</pre></div>)}</details>}
                        </details>
                      )}
                    </>
                  )}
                </section>

                {stage === 'recommend' && canWrite && (
                  <div class="row after">
                    <button class="btn pri" id="btn-gen" data-round={genBlock.round + 1} disabled>让两位总工出配方</button>
                    <span class="soft">在上面勾 1–3 个基底;约 5–10 分钟。</span>
                  </div>
                )}
              </div>
            )}
            <div class="bub sys prog" id={`prog-${stage}`} hidden></div>
          </>
        ))}

        <!-- 版本卡 -->
        {verCards.map(({ v, rows, dropN, proc, fbs, esg }) => (
          <section class="pcard ver" id={`v${v.id}`}>
            <header class="phead">
              <span class="ava a-v">v</span>
              <b>版本 v{v.version_no}</b>
              <span class:list={['pill', v.status === 'final' ? 'p-ok' : v.status === 'sampled' ? 'p-warn' : 'p-wait']}>{VERSION_STATUS_ZH[v.status] ?? v.status}</span>
              {(canRecipe || sampler) && (v.parent_version_id ? <span class="soft">由 v{verNo.get(v.parent_version_id) ?? '?'} 改比例</span> : v.src_side ? <span class="soft">采纳{personaOf(v.src_side)}版</span> : null)}
              {canRecipe && v.base_codes && <span class="soft">基底 {splitList(v.base_codes).map((b) => <a href={`/bohui/formulas/?q=${encodeURIComponent(b)}`} target="_blank"><code>{b}</code></a>)}</span>}
              {canRecipe && dropN > 0 && <span class="soft">剔除 {dropN} 项</span>}
              <time class="soft" data-utc={v.created_at}>{(v.created_at ?? '').slice(0, 16)}</time>
              <span class="grow"></span>
              {canWrite && rows.length > 0 && <button class="btn sm edit-open" data-vid={v.id}>改比例</button>}
              {canFeedback && <a class="btn sm" href="#feedback">填打版结果</a>}
              <button class="btn sm" disabled title="第二期开放(定稿入库 + 三份文件)">定稿</button>
            </header>
            {canRecipe && rows.length > 0 && (
              <table class="recipe">
                <thead><tr><th>序号</th><th>相</th><th>原料</th><th>INCI</th><th>区间</th><th>完整比例</th><th title="元/kg,来自保存版本时的原料库快照">单价</th><th>用途</th><th class="gb">标记 <span class:list={['pill', greenBadge(rows).cls]}>{greenBadge(rows).text}</span></th></tr></thead>
                <tbody>
                  {rows.map((m) => (
                    <tr class:list={[m.flag === 'yellow' && 'yellow']} data-seq={m.seq} data-name={m.name} data-inci={m.inci} data-purpose={m.purpose ?? ''} data-lo={m.pct_low ?? ''} data-hi={m.pct_high ?? ''} data-pct={m.pct ?? ''} data-price={priceOf(m) ?? ''} data-price-at={priceAtOf(m) ?? ''} data-mid={midOf(m) ?? ''} data-ps={(m as Priced).price_status ?? ''}>
                      <td><code>{m.seq}</code></td><td>{m.phase}</td><td>{m.name}</td><td class="mono"><span class="dot" title={dotOf(m).title}>{dotOf(m).dot}</span>{m.inci}{esgSev(esg, m.seq) && <span class:list={['esg-tag', esgSev(esg, m.seq)]}>ESG {esgSev(esg, m.seq) === 'red' ? '红' : '黄'}</span>}</td>
                      <td class="num">{range(m.pct_low, m.pct_high)}</td><td class="num"><b>{m.pct == null ? '—' : `${m.pct}%`}</b></td>
                      {/* 单价:版本行快照 price(创始人 09-18 12:5x「多选原料和价格」);无价「—」,不编数;未财务确认的标黄(「价格由财务和采购确认,我们不可以瞎编」) */}
                      <td class:list={['num', { unc: priceOf(m) != null && !confirmedOf(m) }]} title={priceOf(m) != null && !confirmedOf(m) ? `待采购/财务确认${priceAtOf(m) ? ` · 报价日期 ${priceAtOf(m)}` : ''}` : priceAtOf(m) ? `财务确认价 · 报价日期 ${priceAtOf(m)}` : undefined}>{priceOf(m) == null ? '—' : Number(priceOf(m)).toFixed(2)}</td><td>{m.purpose}</td>
                      <td>{m.flag === 'yellow' ? <span class="pill p-warn">黄 · {m.source ? sourceZh(m.source) : '待核'}</span> : m.catalog_no ? <span class="pill p-ok">目录 {m.catalog_no}</span> : <span class:list={['pill', tierCls(m.tier)]}>{m.tier}</span>}</td>
                    </tr>
                  ))}
                </tbody>
                <tfoot><tr><td colspan="5" class="soft">Σ 完整比例</td><td class="num"><b class:list={[Math.abs(rows.reduce((a, m) => a + (Number(m.pct) || 0), 0) - 100) > 0.01 ? 'bad' : 'ok']}>{rows.reduce((a, m) => a + (Number(m.pct) || 0), 0).toFixed(2)}%</b>{Math.abs(rows.reduce((a, m) => a + (Number(m.pct) || 0), 0) - 100) > 0.01 && <span class="soft"> ≠ 100,请「修改成分与比例」补齐</span>}</td>
                  {/* 版本成本 = Σ pct/100×price,只按财务确认价当准数;待确认价另报「非准数」;无价行「不完整」;老版本无价格字段 → 未估价(编辑保存新版本即带价) */}
                  <td colspan="3" class="soft">{costText(rows)}</td></tr></tfoot>
              </table>
            )}
            {/* ESG 合规面板(Σ 合计下方):四支柱胶囊 + 总判 + 命中表;没算过只给「算 ESG」按钮 */}
            {canRecipe && rows.length > 0 && (
              <div class="esg" data-vid={v.id}>
                <div class="esg-head">
                  <b>ESG 合规</b>
                  {esg ? (
                    <>
                      {PILLARS.map(([k, zh]) => <span class:list={['pill', ESG_CLS[esg.pillars?.[k]?.status ?? ''] ?? 'p-wait']}>{zh} {esg.pillars?.[k]?.n ?? 0}</span>)}
                      <b class:list={['esg-sum', esg.pass ? 'ok' : 'bad']}>{esgSummary(esg)}</b>
                      <span class="soft">{esg.form === 'rinse-off' ? '淋洗' : '驻留'} · {(esg.markets ?? []).map((k) => MARKET_ZH[k] ?? k).join('、') || '—'} · <time data-utc={esg.checked_at}>{String(esg.checked_at ?? '').slice(0, 16)}</time></span>
                      <span class="grow"></span>
                      {canWrite && <button class="btn sm esg-run" data-vid={v.id}>重算</button>}
                    </>
                  ) : (
                    <>
                      <span class="soft">还没算过(四支柱:法规 / 环境 / 社会 / 安全,每条命中都带法规依据)</span>
                      <span class="grow"></span>
                      {canWrite && <button class="btn sm pri esg-run" data-vid={v.id}>算 ESG</button>}
                    </>
                  )}
                </div>
                {esg && esg.hits.length > 0 && (
                  <table class="esg-t">
                    <thead><tr><th>序号</th><th>成分</th><th>用量</th><th>支柱</th><th>等级</th><th>问题</th><th>原因</th><th>依据</th><th>限量</th><th>替代</th></tr></thead>
                    <tbody>
                      {esg.hits.map((h) => (
                        <tr class:list={[h.severity]}>
                          <td><code>{h.seq}</code></td><td class="mono">{h.inci}</td><td class="num">{h.pct == null ? '—' : `${h.pct}%`}</td>
                          <td>{PILLAR_ZH[h.pillar] ?? h.pillar}</td>
                          <td><span class:list={['pill', h.severity === 'red' ? 'p-bad' : 'p-warn']}>{h.severity === 'red' ? '红' : '黄'}</span></td>
                          <td>{h.title_zh}</td><td class="soft">{h.reason_zh}</td>
                          <td>{h.basis_url ? <a href={h.basis_url} target="_blank" rel="noopener">{h.basis}</a> : h.basis}</td>
                          <td class="num">{h.limit ? (h.limit.max == null ? <span class="soft" title={h.limit.note}>需人工核</span> : <>{h.limit.max}% {h.limit.exceeds === true ? <b class="bad">超</b> : h.limit.exceeds === false ? <span class="ok">内</span> : ''}</>) : '—'}</td>
                          <td>{(esg.alternatives?.[String(h.seq)] ?? []).map((a) => <span class="pill p-wait" title={a.functions_zh ?? ''}>{a.name_zh || a.inci_key}</span>)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </div>
            )}
            {canRecipe && rows.length > 0 && rows.every((m) => m.pct == null) && <p class="soft">完整比例还没填;点「改比例」逐行填再打版,反馈才有对照基线。</p>}
            {sampler && <p class="soft">称量单由总工另给;按序号称量。</p>}
            {(canRecipe || sampler) && proc.length > 0 && (
              <details open={sampler}><summary>工艺步骤({proc.length} 步)</summary><ol>{proc.map((s) => <li>{s.text}</li>)}</ol></details>
            )}
            {(canRecipe || sampler) && fbs.length > 0 && (
              <table class="fb">
                <thead><tr><th>次</th>{FB_COLS.map(([, zh]) => <th>{zh}</th>)}<th>结论</th><th>时间</th></tr></thead>
                <tbody>{fbs.map((f) => (
                  <tr><td>第 {f.round} 次</td>{FB_COLS.map(([k]) => <td>{f[k] ?? '—'}</td>)}<td><span class:list={['pill', f.decision === 'accept' ? 'p-ok' : 'p-warn']}>{DECISION_ZH[f.decision] ?? f.decision ?? '—'}</span></td><td><time data-utc={f.created_at}>{(f.created_at ?? '').slice(0, 16)}</time></td></tr>
                ))}</tbody>
              </table>
            )}
          </section>
        ))}
        {sampler && versions.length === 0 && <div class="bub sys">还没有版本可打版。</div>}

        {canFeedback && latestVer && (
          <details class="pcard fbform" id="feedback">
            <summary>填打版结果(第 <span id="fb-n">{nextRound(latestVer)}</span> 次)</summary>
            <form id="fbf">
              <div class="g3">
                <label>打版版本<select name="version_id">{versions.map((v) => <option value={v.id} data-n={nextRound(v)}>v{v.version_no} · {VERSION_STATUS_ZH[v.status] ?? v.status}</option>)}</select></label>
                <label>pH<input type="number" step="0.1" name="ph" placeholder="一位小数" /></label>
                <label>黏度(mPa·s 或描述)<input name="viscosity" placeholder="数值,或「中等,可泵」" /></label>
                <label>离心(3000 rpm × 30 min)<input name="centrifuge" placeholder="通过 / 分层 / 析水 / 析油" /></label>
                <label>冻融<input name="freeze_thaw" placeholder="第几轮 · 现象" /></label>
                <label>40℃ 加速<input name="accel_40c" placeholder="天数 · 现象" /></label>
                <label>外观<input name="appearance" placeholder="颜色 / 透明度 / 均一性" /></label>
                <label>气味<input name="odor" placeholder="正常 / 异味描述" /></label>
                <label>肤感<input name="skin_feel" placeholder="前段 / 中段 / 后段各一句" /></label>
              </div>
              <label>客户意见<textarea name="customer_text" rows="2" placeholder="原话"></textarea></label>
              <div class="row">
                <label class="inl">结论<select name="decision"><option value="adjust">继续调整</option><option value="accept">接受</option></select></label>
                <button class="btn pri" type="submit">保存打版结果</button>
              </div>
            </form>
          </details>
        )}
      </div>

    </main>

    <!-- 右栏:需求摘要 / 版本(可折叠) -->
    <aside class="lab-aside" id="aside">
      <button class="btn sm fold" id="fold" type="button" title="折叠">›</button>
      <details open>
        <summary>需求摘要</summary>
        <dl>
          <dt>项目号</dt><dd><code>{project.code}</code></dd>
          <dt>品类</dt><dd>{catZh(project.category ?? '')}</dd>
          <dt>剂型</dt><dd>{fmtZh(project.format ?? '')}</dd>
          {'claims' in project && <><dt>功效</dt><dd>{claimsZh(project.claims)}</dd></>}
          {'markets' in project && <><dt>市场</dt><dd>{marketsZh(project.markets)}</dd></>}
          {constraints && <><dt>约束</dt><dd>{constraintTags(constraints).join(' · ') || '—'}</dd></>}
          {'cost_band' in project && <><dt>成本档</dt><dd>{COST_BAND_ZH[project.cost_band ?? ''] ?? project.cost_band ?? '—'}</dd></>}
        </dl>
      </details>
      <details open>
        <summary>版本({versions.length})</summary>
        {versions.length === 0 && <div class="soft">还没有版本</div>}
        <ul class="vlist">{versions.map((v) => <li><a href={`#v${v.id}`}>v{v.version_no}</a> <span class:list={['pill', v.status === 'final' ? 'p-ok' : v.status === 'sampled' ? 'p-warn' : 'p-wait']}>{VERSION_STATUS_ZH[v.status] ?? v.status}</span></li>)}</ul>
      </details>
    </aside>
    <button class="btn sm unfold" id="unfold" type="button" hidden title="展开">‹</button>
  </div>

  {canWrite && (
    <dialog id="dlg">
      <form id="ef">
        <h3>修改成分与比例 → 保存为新版本 <span class="soft" id="ef-title"></span></h3>
        <p class="soft">可改原料名 / INCI / 用途、填完整比例、删行、加行(手填或从原料库多选);合计必须 100%。新加或改名的原料会自动对药监局目录核一遍。单价只认原料库导入或人工维护,不编数。</p>
        {/* 手机端表格横向滚动(④);单价 / 行成本两列只读,由脚本按 pct/100×price 实时算(创始人 09-18 12:5x「多选原料和价格」) */}
        <div class="tscroll"><table class="recipe">
          <thead><tr><th>序号</th><th>原料</th><th>INCI</th><th>用途</th><th>下限 %</th><th>上限 %</th><th>完整比例 %</th><th>单价 元/kg</th><th>行成本</th><th>删除</th></tr></thead>
          <tbody id="ef-rows"></tbody>
          {/* 成本两行:准数(财务确认价)/ 待确认(非准数)分开合计(创始人 09-18 12:5x「价格由财务和采购确认,我们不可以瞎编」) */}
          <tfoot><tr><td colspan="6">Σ 完整比例</td><td class="num"><b id="ef-sum">0</b>%</td><td colspan="2" class="soft" id="ef-cost">未估价</td><td class="nowrap"><button type="button" class="btn sm" id="ef-add" title="加一行原料(手填)">+ 加行</button> <button type="button" class="btn sm" id="ef-pick" title="搜原料库,勾选多条一次加入">从原料库选</button></td></tr>
          <tr id="ef-cost2-row" hidden><td colspan="7" class="soft">待确认价(非准数)</td><td colspan="2" class="soft" id="ef-cost2"></td><td></td></tr></tfoot>
        </table></div>
        {/* 内嵌原料库面板:≥1 字 300ms 防抖 GET op=materials;勾选 → 加入已选(N);同 INCI 已在表里标「已在配方」不重复加 */}
        <div id="mp" class="mp" hidden>
          <div class="mp-head"><input type="search" id="mp-q" placeholder="搜原料:中文名 / 牌号 / INCI / 供应商 / 编码" autocomplete="off" /><button type="button" class="btn sm" id="mp-close">收起</button></div>
          <div id="mp-list" class="mp-list"><p class="soft">输入关键字开始搜</p></div>
          <div class="ops"><span class="soft grow" id="mp-hint"></span><button type="button" class="btn pri sm" id="mp-addsel" disabled>加入已选(0)</button></div>
        </div>
        <div class="ops"><button type="button" class="btn" id="ef-cancel">取消</button><button type="submit" class="btn pri" id="ef-save">保存为新版本</button></div>
      </form>
    </dialog>
  )}
  <div id="toast" class="toast" hidden></div>

  <style>
    :global(html){font-size:18px} :global(body){font-size:1rem}
    .lab{display:grid;grid-template-columns:12rem minmax(0,1fr) 14rem;gap:1rem;max-width:1800px;margin:0 auto;padding:1rem;position:relative}
    .lab.folded{grid-template-columns:14rem minmax(0,1fr)} .lab.folded .lab-aside{display:none}
    .unfold{position:fixed;right:.5rem;top:4rem} .fold{position:absolute;right:.5rem;top:.5rem}
    .lab-side{display:flex;flex-direction:column;gap:.625rem;min-width:0} .new{text-align:center}
    .plist{display:grid;gap:.25rem;overflow:auto;max-height:calc(100vh - 8rem)}
    .pitem{display:grid;gap:.125rem;padding:.5rem .625rem;border-radius:var(--ad-r-s);text-decoration:none;color:var(--ad-ink);font-size:.8125rem;border:1px solid transparent}
    .pitem:hover{background:var(--ad-panel);border-color:var(--ad-line-soft)} .pitem.on{background:var(--ad-accent-soft);border-color:transparent}
    .pitem b{display:flex;gap:.375rem;align-items:center;font-weight:600} .pitem>span{color:var(--ad-soft);font-size:.75rem}
    .lab-main{display:flex;flex-direction:column;gap:1rem;min-width:0}
    .chat{display:flex;flex-direction:column;gap:.875rem}
    .bub{max-width:none;align-self:stretch;padding:.75rem 1rem;border-radius:var(--ad-r);font-size:.9375rem;line-height:1.6;white-space:pre-wrap}
    .bub.sys{background:var(--ad-panel);border:1px solid var(--ad-line);align-self:flex-start;white-space:normal}
    .bub.sys .btn{margin:0 .5rem} .bub.me{background:var(--ad-accent-soft);color:var(--ad-accent-deep);align-self:flex-end}
    .bub.brief{max-width:none;align-self:stretch} .bub.brief summary{cursor:pointer;font-weight:600;font-size:.9375rem}
    .bub.brief dl{display:grid;grid-template-columns:6rem 1fr;gap:.25rem .75rem;margin:.5rem 0 0;font-size:.875rem} .bub.brief dt{color:var(--ad-faint)} .bub.brief dd{margin:0}
    .bub.prog{display:grid;gap:.25rem;font-size:.875rem;max-width:none;align-self:stretch} .prog .bad{color:var(--ad-bad)} .prog .ok{color:var(--ad-ok)}
    .prog .xrow{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;padding-left:1rem;font-size:.8125rem} .prog .xrow .btn{padding:.125rem .5rem;font-size:.75rem}
    .turn{display:grid;gap:.75rem} .turnhead{display:flex;gap:.75rem;align-items:center;font-size:.875rem}
    .cards{display:grid;grid-template-columns:1fr 1fr;gap:.875rem} @media (max-width:70rem){.cards{grid-template-columns:1fr}}
    .pcard{background:var(--ad-panel);border:1px solid var(--ad-line);border-radius:var(--ad-r);padding:.875rem 1rem;min-width:0;box-shadow:var(--ad-shadow)}
    .phead{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-bottom:.625rem;font-size:.9375rem}
    .ava{width:1.75rem;height:1.75rem;border-radius:50%;display:inline-grid;place-items:center;color:#fff;font-weight:600;font-size:.875rem}
    .a-l{background:#7C4DA8} .a-r{background:#1B6E45} .a-j{background:#8A5A00} .a-v{background:#5A5470}
    .test{font-size:.75rem;color:var(--ad-faint);border:1px solid var(--ad-line);border-radius:999px;padding:0 .5rem}
    .st{font-size:.8125rem;color:var(--ad-accent-deep);margin-left:auto}
    .btn.sm{padding:.25rem .625rem;font-size:.75rem}
    .soft{font-size:.8125rem;color:var(--ad-soft)} .grow{flex:1} .row{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;margin-top:.625rem} .row.after{margin-top:0}
    .pick{border:1px solid var(--ad-line-soft);border-radius:var(--ad-r-s);padding:.5rem .75rem;margin-bottom:.5rem;font-size:.875rem}
    .pickhead{display:flex;gap:.625rem;align-items:center;flex-wrap:wrap} .pickhead .exp{color:var(--ad-soft)}
    .pick details{margin-top:.25rem} .pick summary,.draft summary,.jcard summary,.pfoot summary{cursor:pointer;font-size:.75rem;color:var(--ad-faint)}
    .pick p{margin:.25rem 0;line-height:1.55} .pick p b{display:inline-block;min-width:5rem;color:var(--ad-faint);font-weight:500;font-size:.75rem}
    .li{display:block;padding-left:5rem} .notes{font-size:.8125rem;color:var(--ad-soft);white-space:pre-wrap}
    .draft h3{font-size:1rem;margin:0 0 .5rem}
    .blk{margin:.5rem 0;font-size:.875rem} .blk>b{display:block;font-size:.75rem;color:var(--ad-faint);margin-bottom:.25rem}
    .blk ul,.blk ol{margin:0;padding-left:1.25rem} .blk li{margin:.125rem 0;line-height:1.55}
    .blk.unlisted{background:var(--ad-bad-soft);border:1px solid #EFC6C0;border-radius:var(--ad-r-s);padding:.5rem .75rem} .blk.unlisted>b{color:var(--ad-bad)}
    table.recipe,table.cmp,table.fb{font-size:.8125rem;margin:.5rem 0;box-shadow:none} table.recipe th,table.recipe td,table.cmp th,table.cmp td,table.fb th,table.fb td{padding:.375rem .5rem;vertical-align:top}
    table.recipe tr.red td{background:var(--ad-bad-soft)} table.recipe tr.yellow td{background:var(--ad-warn-soft)}
    table.recipe td.unc{background:var(--ad-warn-soft);cursor:help} small.ps{font-size:.6875rem;white-space:nowrap} small.ps.ok{color:var(--ad-ok)}   /* 未财务确认的单价黄底(创始人 09-18「价格由财务和采购确认」) */
    .jcard{border-color:#EFDCB6} .jsum{margin:0 0 .5rem;font-size:.9375rem;line-height:1.6}
    .pfoot{margin-top:.75rem;padding-top:.625rem;border-top:1px solid var(--ad-line-soft);font-size:.8125rem;display:grid;gap:.375rem}
    .crec .gw{margin:.5rem 0;font-size:.875rem} .crec .gw>b,.crec .gwb{display:block;font-size:.75rem;color:var(--ad-faint);margin:.5rem 0 .25rem}
    .crec .gw ol{margin:.25rem 0;padding-left:1.25rem} .crec .gw p{margin:.25rem 0}
    .xcard{border:1px solid var(--ad-line-soft);border-radius:var(--ad-r-s);padding:.5rem .75rem;margin:.375rem 0;font-size:.875rem}
    .xhead{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-bottom:.25rem} .xcard .q{margin:.25rem 0;font-size:.8125rem;color:var(--ad-soft)}
    .prompt{font-size:.75rem;white-space:pre-wrap;background:var(--ad-sunk);border:1px solid var(--ad-line-soft);border-radius:var(--ad-r-s);padding:.5rem .625rem;max-height:24rem;overflow:auto;margin-top:.375rem}
    .ver details{margin:.5rem 0;font-size:.875rem} .ver details ol{margin:.25rem 0;padding-left:1.25rem}
    .fbform summary{font-size:.9375rem;font-weight:600;cursor:pointer} .fbform form{margin-top:.75rem}
    .fbform label{display:grid;gap:.25rem;font-size:.75rem;color:var(--ad-soft);margin-bottom:.625rem} .fbform label.inl{display:flex;gap:.5rem;align-items:center;margin:0}
    .g3{display:grid;grid-template-columns:repeat(3,1fr);gap:0 .875rem} @media (max-width:60rem){.g3{grid-template-columns:1fr}}
    .ask{display:grid;grid-template-columns:minmax(0,1fr) auto auto auto auto;gap:.5rem;align-items:end;margin-bottom:.75rem}
    .ask textarea{width:100%;resize:vertical;font-size:.9375rem}
    .ask .tag{grid-column:1/-1;font-size:.75rem;color:var(--ad-faint)} #mic.on{background:var(--ad-bad-soft);border-color:#EFC6C0;color:var(--ad-bad)}
    .lab-aside{position:relative;display:grid;gap:.625rem;align-content:start;font-size:.8125rem}
    .lab-aside details{background:var(--ad-panel);border:1px solid var(--ad-line);border-radius:var(--ad-r);padding:.625rem .75rem} .lab-aside summary{cursor:pointer;font-weight:600}
    .lab-aside dl{display:grid;grid-template-columns:4rem 1fr;gap:.25rem .5rem;margin:.5rem 0 0} .lab-aside dt{color:var(--ad-faint)} .lab-aside dd{margin:0}
    .vlist{margin:.5rem 0 0;padding-left:1rem} .vlist li{margin:.125rem 0} .vlist a{color:var(--ad-accent)}
    dialog{border:0;border-radius:12px;padding:1.5rem;width:min(56rem,94vw);box-shadow:0 24px 64px -20px rgb(0 0 0/.4)}
    dialog::backdrop{background:rgb(0 0 0/.4)} dialog h3{margin:0 0 .25rem;font-size:1rem}
    dialog input[type=number]{width:6rem} .ops{display:flex;gap:.5rem;justify-content:flex-end;margin-top:.75rem;align-items:center}
    /* 编辑弹窗:表可横滚(手机端 ④)+ 原料库面板 */
    .tscroll{overflow-x:auto;-webkit-overflow-scrolling:touch} .tscroll table{min-width:52rem} .nowrap{white-space:nowrap}
    .mp{margin-top:.75rem;border:1px solid var(--ad-line);border-radius:10px;padding:.75rem} .mp-head{display:flex;gap:.5rem} .mp-head input{flex:1;min-width:0}
    .mp-list{max-height:16rem;overflow:auto;margin-top:.5rem} .mp-row{display:grid;grid-template-columns:auto 1fr auto;gap:.25rem .625rem;align-items:center;padding:.375rem 0;border-bottom:1px solid var(--ad-line-soft);font-size:.8125rem;cursor:pointer}
    .mp-row .mono{font-size:.75rem} .mp-row.in{opacity:.55;cursor:default} .mp-row .num{text-align:right;white-space:nowrap}
    .dot{font-size:.75rem;margin-right:.25rem;cursor:help} th.gb{white-space:nowrap} th.gb .pill{font-weight:500;margin-left:.25rem}
    .mref{display:flex;flex-wrap:wrap;gap:.25rem;align-items:center} .mref .soft{width:100%;font-size:.75rem} .mref a.pill{text-decoration:none;font-size:.75rem}
    .toast{position:fixed;right:1.25rem;bottom:1.25rem;background:#10131a;color:#fff;padding:.625rem 1rem;border-radius:7px;font-size:.8125rem;z-index:9}
    @media (max-width:70rem){.lab{grid-template-columns:1fr}.lab-aside{display:none}.plist{max-height:10rem}}
    [hidden]{display:none !important}
  
    /* 创始人 12:0x:「卖点、风险文字太多,没时间看」—— 卡内段落默认最多 2 行,点一下展开 */
    .pcard details p, .pcard .blk li { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; cursor: pointer; }
    .pcard details p.open, .pcard .blk li.open { -webkit-line-clamp: unset; display: block; }
    tfoot b.bad{color:var(--ad-bad)} tfoot b.ok{color:var(--ad-ok)}

    /* ESG 面板(09-18):四支柱胶囊 + 命中表;行级 ESG 小标与色点并列 */
    .esg{margin:.625rem 0;padding:.625rem .75rem;border:1px solid var(--ad-line-soft);border-radius:var(--ad-r-s);background:var(--ad-sunk)}
    .esg-head{display:flex;flex-wrap:wrap;gap:.375rem;align-items:center;font-size:.8125rem} .esg-head>b:first-child{font-size:.875rem;margin-right:.25rem}
    .esg-sum.ok{color:var(--ad-ok)} .esg-sum.bad{color:var(--ad-bad)}
    table.esg-t{font-size:.75rem;margin:.5rem 0 0;box-shadow:none;width:100%} table.esg-t th,table.esg-t td{padding:.25rem .375rem;vertical-align:top}
    table.esg-t tr.red td{background:var(--ad-bad-soft)} table.esg-t tr.yellow td{background:var(--ad-warn-soft)}
    table.esg-t td.num{white-space:nowrap} table.esg-t .bad{color:var(--ad-bad)} table.esg-t .ok{color:var(--ad-ok)}
    .esg-tag{display:inline-block;margin-left:.375rem;padding:0 .375rem;border-radius:999px;font-size:.6875rem;font-family:inherit;vertical-align:middle}
    .esg-tag.red{background:var(--ad-bad-soft);color:var(--ad-bad)} .esg-tag.yellow{background:var(--ad-warn-soft);color:#8a5a00}
    .esg-line{font-size:.75rem;margin:-.25rem 0 .375rem}
    /* 打印:ESG 面板完整展开、按钮隐藏(交给客户看的合规页) */
    @media print{.esg{break-inside:avoid;background:#fff;border-color:#999} .esg-run,.btn,.ask,.lab-aside,.toast{display:none !important} table.esg-t{font-size:.6875rem}}
</style>

  <script is:inline define:vars={{ id, labRole, canRecipe }}>
    // 页面脚本只拿三个标量;run_id / version_id / round 从按钮 data-* 读,行数据从已渲染的 DOM 读。
    const PERSONA = { L: '刘总工', R: '黄总工', J: '李总工' };
    const toast = document.getElementById('toast');
    const say = (m, bad) => { toast.textContent = m; toast.className = 'toast' + (bad ? ' bad' : ''); toast.hidden = false; };
    const post = (b) => fetch('/api/admin/formula-lab', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b) })
      .then((r) => r.json()).catch((e) => ({ ok: false, msg: '网络错误:' + e }));
    const st = (key, text) => document.querySelectorAll('[data-st="' + key + '"]').forEach((el) => { el.textContent = text; });
    const el = (tag, cls, text) => { const d = document.createElement(tag); if (cls) d.className = cls; if (text != null) d.textContent = text; return d; };

    // 右栏折叠
    const lab = document.getElementById('lab'), unfold = document.getElementById('unfold');
    document.getElementById('fold')?.addEventListener('click', () => { lab.classList.add('folded'); unfold.hidden = false; });
    unfold?.addEventListener('click', () => { lab.classList.remove('folded'); unfold.hidden = true; });

    // 会诊:网关拆题 → 逐位专家(免费模型串行:同网关同 key;付费 3 路)→ 两位总工串行 L → R → 李总工点评 → 刷新。
    // 进度写在气泡里;失败的专家可单个重试或跳过(缺席),至少 1 位成功才汇总。
    const LOCKED = '.retry,.adopt,#btn-rec,#btn-gen,#btn-again,#send';
    async function consult(stage, btn, extra) {
      btn.disabled = true;
      document.querySelectorAll(LOCKED).forEach((b) => { b.disabled = true; });
      const unlock = () => { document.querySelectorAll(LOCKED).forEach((b) => { b.disabled = false; }); syncPicks(); };
      const round = +btn.dataset.round;
      const card = document.getElementById('prog-' + stage);
      card.innerHTML = ''; card.hidden = false; card.scrollIntoView({ block: 'nearest' });
      const line = (text, cls) => card.appendChild(el('div', cls || null, text));

      const gwLine = line('网关拆题中,最长 2 分钟…');
      const gw = await post({ op: 'gateway', project_id: id, stage, round, ...extra });
      if (!gw.ok) { gwLine.textContent = '网关拆题失败:' + (gw.msg || '未知错误') + '(已留档,可再点按钮重来)'; gwLine.className = 'bad'; say('网关拆题失败', true); unlock(); return; }
      const seats = [...(gw.must || []).map((m) => ({ ...m, must: true })), ...(gw.optional || []).map((m) => ({ ...m, must: false }))];
      const titleOf = (slug) => (seats.find((s) => s.slug === slug) || {}).title || slug;
      gwLine.textContent = '已召集 ' + seats.length + ' 位专家:' + seats.map((s) => s.title || s.slug).join('、');
      if (!seats.length) { line('网关没给出任何专家,无法会诊;可再点按钮重来。', 'bad'); unlock(); return; }

      const conc = gw.is_free ? 1 : 3;
      const xLine = line('专家审核 0/' + seats.length);
      let done = 0, pooling = true, retryChain = Promise.resolve();
      const rows = seats.map((s) => {
        const row = card.appendChild(el('div', 'xrow')); row.hidden = true;   // 只有失败的专家才露出行(重试 / 缺席)
        row.appendChild(el('b', null, (s.must ? '必审 · ' : '旁听 · ') + (s.title || s.slug)));
        const x = { s, ok: false, busy: false, dead: false, row, stEl: row.appendChild(el('span', 'xst', '')), retry: row.appendChild(el('button', 'btn', '重试')) };
        x.retry.type = 'button'; x.retry.hidden = true;
        x.retry.addEventListener('click', () => { retryChain = retryChain.then(async () => { if (x.busy || x.ok) return; await ask(x); settle(); }); });
        return x;
      });
      const setSt = (x, text, cls) => { x.stEl.textContent = text; x.stEl.className = 'xst' + (cls ? ' ' + cls : ''); x.row.hidden = cls !== 'bad'; x.retry.hidden = pooling || cls !== 'bad'; };
      const ask = async (x) => {
        x.busy = true; xLine.textContent = '专家审核 ' + done + '/' + seats.length + ' · ' + (x.s.title || x.s.slug) + ' 审核中…';
        const d = await post({ op: 'expert', gateway_run_id: gw.run_id, slug: x.s.slug });
        x.busy = false; x.ok = !!d.ok; x.dead = !d.ok && /已判死/.test(d.msg || '');
        done++;
        setSt(x, d.ok ? '' : x.dead ? '✗ 模型 5 分钟内被判死,稍后再点重试' : '✗ 失败 · ' + (d.msg || '未知错误'), d.ok ? 'ok' : 'bad');
        xLine.textContent = '专家审核 ' + done + '/' + seats.length;
      };
      let synthStarted = false, bar = null;
      const settle = () => {
        if (synthStarted) return;
        const okN = rows.filter((x) => x.ok).length, badN = rows.filter((x) => !x.ok && !x.busy).length, busyN = rows.filter((x) => x.busy).length;
        if (busyN) return;
        if (!badN) { synth(); return; }
        if (!bar) {
          bar = card.appendChild(el('div', 'row'));
          const go = bar.appendChild(el('button', 'btn pri sm', '')); go.type = 'button';
          bar.appendChild(el('span', 'soft', ''));
          go.addEventListener('click', () => synth());
        }
        const go = bar.querySelector('button'), hint = bar.querySelector('.soft');
        go.textContent = '跳过缺席,让两位总工出结果(' + okN + ' 位成功 · ' + badN + ' 位缺席)';
        go.disabled = okN < 1;
        hint.textContent = rows.some((x) => x.dead) ? '模型被判死 5 分钟(限流 / 超时),建议 5 分钟后逐位点「重试」再继续。' : (okN < 1 ? '至少 1 位专家成功才能继续,请重试失败的专家。' : '也可先点失败行的「重试」再继续。');
      };
      // 两位总工串行 L → R(兜底行同网关同 key,并发必撞 rpm)→ 李总工点评;一栏失败不拖死另一栏
      const synth = async () => {
        if (synthStarted) return;
        synthStarted = true;
        if (bar) bar.querySelector('button').disabled = true;
        rows.forEach((x) => { x.retry.hidden = true; });
        const sLine = line('');
        for (const side of ['L', 'R']) {
          sLine.textContent = PERSONA[side] + '思考中,最长 3 分钟…';
          st(stage + '-' + side, '思考中…');
          const d = await post({ op: 'synthesize', gateway_run_id: gw.run_id, side });
          st(stage + '-' + side, d.ok ? '完成' : '失败:' + (d.msg || '未知错误'));
          if (!d.ok) say(PERSONA[side] + '没出来:' + (d.msg || ''), true);
          if (Array.isArray(d.missing) && d.missing.length) line('缺席 ' + d.missing.length + ' 位:' + d.missing.map(titleOf).join('、'), 'soft');
        }
        sLine.textContent = PERSONA.J + '点评中,最长 3 分钟…';
        st(stage + '-J', '点评中…');
        const j = await post({ op: 'review', gateway_run_id: gw.run_id });
        sLine.textContent = j.ok ? '三张卡都已返回,刷新中…' : PERSONA.J + '点评失败:' + (j.msg || '未知错误') + ',刷新中…';
        location.reload();
      };
      let next = 0, halted = false;
      await Promise.all(Array.from({ length: Math.min(conc, rows.length) }, async () => {
        while (next < rows.length && !halted) { const x = rows[next++]; await ask(x); if (x.dead) halted = true; }
      }));
      pooling = false;
      rows.forEach((x) => {
        if (x.ok || x.busy) return;
        if (!x.stEl.className.includes('bad')) setSt(x, '未调用 · 模型被判死,5 分钟后再点重试', 'bad');
        x.retry.hidden = false;
      });
      settle();
    }
    const btnRec = document.getElementById('btn-rec');
    btnRec?.addEventListener('click', () => consult('recommend', btnRec, {}));

    // 勾选基底:最多 3 个;勾 1–3 个才能出配方
    const btnGen = document.getElementById('btn-gen'), btnAgain = document.getElementById('btn-again');
    const picks = () => [...document.querySelectorAll('.pick-ck')];
    const checked = () => picks().filter((k) => k.checked).map((k) => k.value);
    const syncPicks = () => {
      const on = checked();
      picks().forEach((k) => { k.disabled = !k.checked && on.length >= 3; });
      if (btnGen) btnGen.disabled = on.length < 1 || on.length > 3;
    };
    picks().forEach((k) => k.addEventListener('change', syncPicks));
    syncPicks();
    btnGen?.addEventListener('click', () => consult('generate', btnGen, { base_codes: checked() }));
    // 再出一版:勾了基底用勾的,没勾用最新版本的基底
    btnAgain?.addEventListener('click', () => {
      const bases = checked().length ? checked() : (btnAgain.dataset.bases || '').split(',').filter(Boolean);
      if (!bases.length) return say('先在推荐卡上勾 1–3 个基底', true);
      consult('generate', btnAgain, { base_codes: bases });
    });

    // 追加需求:op brief + project_id;成功后露出「再出一版」
    const ask = document.getElementById('ask'), chat = document.getElementById('chat');
    if (ask) {
      const ta = ask.elements.text, send = document.getElementById('send');
      const bub = (cls, text) => { const d = el('div', 'bub ' + cls, text); chat.appendChild(d); d.scrollIntoView({ block: 'end' }); return d; };
      ta.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); ask.requestSubmit(); } });
      ask.addEventListener('submit', async (e) => {
        e.preventDefault();
        const t = ta.value.trim();
        if (!t) return;
        bub('me', t); ta.value = ''; send.disabled = true;
        const d = await post({ op: 'brief', text: t, project_id: id });
        send.disabled = false;
        if (!d.ok) { bub('sys', '没记上:' + (d.msg || '未知错误')); return; }
        bub('sys', '已追加到需求单。点「再出一版」让两位总工按新需求出配方。');
        btnAgain.hidden = false;
      });

      // 🎤 语音(Web Speech API,zh-CN 连续识别)与 📷 拍照(本地压到 ≤1600px 再发 op:ocr mode=text),识别文字都追加进输入框
      const append = (t) => { ta.value = (ta.value.trim() ? ta.value.replace(/\s+$/, '') + '\n' : '') + t; ta.focus(); };
      const mic = document.getElementById('mic'), cam = document.getElementById('cam'), camf = document.getElementById('camf'), tag = document.getElementById('ocr-tag');
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      let rec = null;
      mic.addEventListener('click', () => {
        if (!SR) return say('这个浏览器不支持语音输入,请用 Chrome / Edge', true);
        if (rec) { rec.stop(); return; }
        rec = new SR(); rec.lang = 'zh-CN'; rec.continuous = true; rec.interimResults = false;
        rec.onresult = (e) => { for (let i = e.resultIndex; i < e.results.length; i++) if (e.results[i].isFinal) append(e.results[i][0].transcript.trim()); };
        rec.onerror = (e) => say(e.error === 'not-allowed' ? '没拿到麦克风权限,请在地址栏允许' : '语音识别出错:' + e.error, true);
        rec.onend = () => { rec = null; mic.classList.remove('on'); mic.textContent = '🎤 语音'; };
        rec.start(); mic.classList.add('on'); mic.textContent = '⏹ 停止'; say('在听,说完再按一下停止');
      });
      const shrink = (f) => new Promise((ok, no) => {
        const img = new Image(), url = URL.createObjectURL(f);
        img.onload = () => { URL.revokeObjectURL(url); const k = Math.min(1, 1600 / Math.max(img.width, img.height)); const cv = document.createElement('canvas'); cv.width = Math.round(img.width * k); cv.height = Math.round(img.height * k); cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height); ok(cv.toDataURL('image/jpeg', .85)); };
        img.onerror = () => { URL.revokeObjectURL(url); no(new Error('图片打不开,请换一张 jpg / png')); };
        img.src = url;
      });
      cam.addEventListener('click', () => camf.click());
      camf.addEventListener('change', async () => {
        const file = camf.files[0]; camf.value = '';
        if (!file) return;
        cam.disabled = true; cam.textContent = '识别中…';
        try {
          const image = await shrink(file);
          if (image.length > 4 * 1024 * 1024) throw new Error('图片压缩后仍超 4MB,请拍近一点');
          const d = await post({ op: 'ocr', image, mode: 'text' });
          if (!d.ok) throw new Error(d.msg || '识别失败');
          if (!String(d.text || '').trim()) throw new Error('图里没识别出文字,请拍清楚一点');
          append(String(d.text).trim()); tag.hidden = false; say('已识别,请核对后发送');
        } catch (err) { say(err.message || '识别失败', true); }
        cam.disabled = false; cam.textContent = '📷 拍照 / 传图';
      });
    }

    // 重试 / 重跑本栏(李总工卡也走 retry:复用原提示词)
    document.querySelectorAll('.retry').forEach((b) => b.addEventListener('click', async () => {
      b.disabled = true; b.textContent = '重试中…';
      const d = await post({ op: 'retry', run_id: +b.dataset.run });
      if (!d.ok) { say(d.msg || '重试失败', true); b.disabled = false; b.textContent = '重试'; return; }
      say('已重跑,刷新中…'); location.reload();
    }));

    // 采纳:红项剔除、黄项保留,服务端写版本
    document.querySelectorAll('.adopt').forEach((b) => b.addEventListener('click', async () => {
      b.disabled = true;
      const d = await post({ op: 'adopt', run_id: +b.dataset.run });
      if (!d.ok) { say(d.msg || '采纳失败', true); b.disabled = false; return; }
      say('已采纳为新版本,刷新中…'); location.reload();
    }));
    // ESG:op=esg 按版本算四支柱(G 任务实现),写 esg_json 后刷新
    document.querySelectorAll('.esg-run').forEach((b) => b.addEventListener('click', async () => {
      b.disabled = true; say('正在核 ESG 规则…');
      const d = await post({ op: 'esg', version_id: +b.dataset.vid });
      if (!d.ok) { say(d.msg || 'ESG 没算出来', true); b.disabled = false; return; }
      say('ESG 已算好,刷新中…'); location.reload();
    }));

    // 改比例:从版本卡已渲染的表格行读数据进弹窗
    const dlg = document.getElementById('dlg'), ef = document.getElementById('ef'), efRows = document.getElementById('ef-rows'), efSum = document.getElementById('ef-sum');
    const NUMS = ['lo', 'hi', 'pct'];
    let curVid = null;
    const efCost = document.getElementById('ef-cost'), efCost2 = document.getElementById('ef-cost2'), efCost2Row = document.getElementById('ef-cost2-row');
    const num = (v) => (v === '' || v == null || Number.isNaN(Number(v)) ? null : Number(v));
    const PS_ZH = { draft: '待确认', purchasing_confirmed: '采购已确认', finance_confirmed: '财务已确认' };
    const psZh = (ps) => PS_ZH[ps] || '待确认';
    /* Σ 比例 + 成本:行成本 = pct/100 × 单价;只有 finance_confirmed 行进准数,其余有价行另计「待确认」;无价 → 「N 项无价」(创始人 09-18「价格由财务和采购确认,我们不可以瞎编」) */
    const sum = () => {
      let s = 0, cost = 0, pending = 0, missing = 0, confirmed = 0, unconfirmed = 0;
      efRows?.querySelectorAll('tr').forEach((tr) => {
        const cc = tr.querySelector('.cost'); if (tr.querySelector('.drop').checked) { if (cc) cc.textContent = ''; return; }
        const pct = Number(tr.querySelector('.pct').value) || 0, p = num(tr.dataset.price); s += pct;
        if (p == null) { missing++; if (cc) cc.textContent = '—'; return; }
        const c = (pct / 100) * p; if (cc) cc.textContent = c.toFixed(2);
        if (tr.dataset.ps === 'finance_confirmed') { confirmed++; cost += c; } else { unconfirmed++; pending += c; }
      });
      if (efSum) { efSum.textContent = s.toFixed(2); efSum.style.color = Math.abs(s - 100) < 0.005 ? 'var(--ad-ok)' : s > 100 ? 'var(--ad-bad)' : ''; }
      if (efCost) efCost.textContent = confirmed + unconfirmed === 0 ? `未估价(${missing} 项无价)` : confirmed === 0 ? '财务确认价:无' : `财务确认价 ≈ ${cost.toFixed(2)} 元/kg(${confirmed} 项)` + (missing ? `;${missing} 项无价,不完整` : '');
      if (efCost2Row) { efCost2Row.hidden = unconfirmed === 0; if (efCost2) efCost2.textContent = `${unconfirmed} 项待确认价 ≈ ${pending.toFixed(2)} 元/kg;合计(非准数)≈ ${(cost + pending).toFixed(2)} 元/kg`; }
    };
    /* 统一造行:d.seq 有值 = 版本已有行(序号只读);无值 = 新行(相可填)。price/price_at/mid 挂 dataset,提交原样带回(创始人 09-18 12:5x「多选原料和价格」) */
    const mkRow = (d) => {
      const tr = document.createElement('tr'); tr.dataset.seq = d.seq || ''; if (!d.seq) tr.className = 'newrow';
      const td = (x) => { const c = document.createElement('td'); if (typeof x === 'string') c.textContent = x; else if (x) c.appendChild(x); tr.appendChild(c); return c; };
      const inp = (type, k, w) => { const i = document.createElement('input'); i.type = type; i.className = k; i.style.width = w; if (type === 'number') { i.step = '0.01'; i.min = '0'; i.max = '100'; } i.value = d[k] ?? ''; return i; };
      if (d.seq) td(d.seq); else { const ph = inp('text', 'phase', '3.5rem'); ph.placeholder = '相,如 A'; td(ph); }
      for (const k of ['name', 'inci', 'purpose']) {   // 原料 / INCI / 用途可改(创始人 12:5x:「需要修改的是成分和比例」)
        const i = inp('text', k, k === 'inci' ? '11rem' : '7rem'); i.placeholder = { name: '原料名', inci: 'INCI 名', purpose: '用途' }[k]; td(i); tr.dataset['orig_' + k] = d[k] ?? '';
      }
      for (const k of NUMS) { td(inp('number', k, '')); tr.dataset['orig_' + k] = d[k] ?? ''; }
      tr.dataset.price = d.price ?? ''; tr.dataset.priceAt = d.priceAt ?? ''; tr.dataset.mid = d.mid ?? ''; tr.dataset.ps = d.ps ?? '';
      const pc = td(num(d.price) == null ? '—' : Number(d.price).toFixed(2)); pc.className = 'num price'; if (d.priceAt) pc.title = '报价日期 ' + d.priceAt;
      if (num(d.price) != null) { const unc = d.ps !== 'finance_confirmed'; if (unc) { pc.classList.add('unc'); pc.title = '待采购/财务确认' + (d.priceAt ? ' · 报价日期 ' + d.priceAt : ''); } pc.appendChild(el('small', 'soft ps', ' ' + psZh(d.ps))); }   // 状态小字(创始人 09-18「价格由财务和采购确认」)
      td('').className = 'num cost';
      const ck = document.createElement('input'); ck.type = 'checkbox'; ck.className = 'drop'; ck.title = '删除此行'; td(ck);
      efRows.appendChild(tr); return tr;
    };
    document.querySelectorAll('.edit-open').forEach((b) => b.addEventListener('click', () => {
      curVid = +b.dataset.vid;
      document.getElementById('ef-title').textContent = b.closest('.ver').querySelector('.phead b').textContent;
      efRows.innerHTML = '';
      b.closest('.ver').querySelectorAll('tr[data-seq]').forEach((src) => mkRow(src.dataset));
      mp.hidden = true; sum(); dlg.showModal();
    }));
    efRows?.addEventListener('input', sum); efRows?.addEventListener('change', sum);
    document.getElementById('ef-add')?.addEventListener('click', () => { mkRow({}).querySelector('.name').focus(); });
    document.getElementById('ef-cancel')?.addEventListener('click', () => dlg.close());

    /* 从原料库选:≥1 字 300ms 防抖 GET op=materials(M 任务接口);多选 → 加入已选(N);同 INCI 已在表里标「已在配方」不重复加 */
    const mp = document.getElementById('mp'), mpQ = document.getElementById('mp-q'), mpList = document.getElementById('mp-list'), mpAdd = document.getElementById('mp-addsel'), mpHint = document.getElementById('mp-hint');
    const picked = new Map();   // id → 原料行
    let mpTimer = null, mpLast = [];
    const inciKey = (s) => String(s || '').split(/[,，;/]/)[0].trim().toLowerCase();   // ponytail: 前台只按 INCI 首成分粗去重,服务端 factKey 才是准口径
    const inTable = () => { const set = new Set(); efRows.querySelectorAll('tr').forEach((tr) => { if (!tr.querySelector('.drop').checked) set.add(inciKey(tr.querySelector('.inci').value)); }); return set; };
    const mpCount = () => { mpAdd.textContent = `加入已选(${picked.size})`; mpAdd.disabled = picked.size === 0; };
    const renderMp = () => {
      mpList.innerHTML = ''; const have = inTable();
      if (!mpLast.length) { mpList.appendChild(el('p', 'soft', mpQ.value.trim() ? '没搜到,换个词试试(或用「+ 加行」手填)' : '输入关键字开始搜')); return; }
      for (const m of mpLast) {
        const dup = have.has(inciKey(m.inci));
        const row = el('label', 'mp-row' + (dup ? ' in' : ''));
        const ck = document.createElement('input'); ck.type = 'checkbox'; ck.disabled = dup; ck.checked = picked.has(m.id);
        ck.addEventListener('change', () => { if (ck.checked) picked.set(m.id, m); else picked.delete(m.id); mpCount(); });
        row.appendChild(ck);
        const main = el('div'); main.appendChild(el('b', '', m.name_zh + (m.trade_name ? `(${m.trade_name})` : ''))); main.appendChild(el('div', 'mono soft', m.inci || ''));
        main.appendChild(el('div', 'soft', [m.supplier, m.use_min != null || m.use_max != null ? `用量 ${m.use_min ?? '?'}–${m.use_max ?? '?'}%` : '', dup ? '已在配方' : ''].filter(Boolean).join(' · ')));
        row.appendChild(main);
        const pr = el('div', 'num', num(m.price) == null ? '无价' : `${Number(m.price).toFixed(2)} ${m.price_unit || '元/kg'}`);   // 无价就写无价,不编数
        if (num(m.price) != null) { pr.appendChild(el('br')); pr.appendChild(el('small', 'soft ps' + (m.price_status === 'finance_confirmed' ? ' ok' : ''), psZh(m.price_status))); }   // 状态小字:只有财务已确认进准数
        row.appendChild(pr);
        mpList.appendChild(row);
      }
    };
    document.getElementById('ef-pick')?.addEventListener('click', () => { mp.hidden = !mp.hidden; if (!mp.hidden) mpQ.focus(); });
    document.getElementById('mp-close')?.addEventListener('click', () => { mp.hidden = true; });
    mpQ?.addEventListener('input', () => {
      clearTimeout(mpTimer); const q = mpQ.value.trim();
      if (!q) { mpLast = []; renderMp(); return; }
      mpTimer = setTimeout(async () => {
        mpHint.textContent = '搜索中…';
        const d = await fetch('/api/admin/formula-lab?op=materials&q=' + encodeURIComponent(q) + '&limit=50').then((r) => r.json()).catch(() => ({}));
        const list = Array.isArray(d) ? d : (d.items ?? d.rows ?? d.list ?? d.materials ?? []);   // 契约只定字段没定外层键,几种都认
        mpLast = list.filter((m) => m.status !== 'off'); mpHint.textContent = d.ok === false ? (d.msg || '搜索失败') : `${mpLast.length} 条`; renderMp();
      }, 300);
    });
    mpAdd?.addEventListener('click', () => {
      const have = inTable(); let n = 0;
      for (const m of picked.values()) {
        if (have.has(inciKey(m.inci))) continue;   // 同 INCI 已在配方,不重复加
        mkRow({ phase: 'A', name: m.name_zh + (m.trade_name ? `(${m.trade_name})` : ''), inci: m.inci, purpose: m.function_zh || '', lo: m.use_min ?? '', hi: m.use_max ?? '', pct: m.use_min ?? '', price: num(m.price) ?? '', priceAt: m.price_at ?? '', mid: m.id, ps: m.price_status || '' });
        have.add(inciKey(m.inci)); n++;
      }
      picked.clear(); mpCount(); renderMp(); sum(); say(`已加入 ${n} 行,可继续搜再加`);
    });
    ef?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const KEY = { lo: 'pct_low', hi: 'pct_high', pct: 'pct' };
      const rows = [];
      efRows.querySelectorAll('tr').forEach((tr) => {
        if (tr.querySelector('.drop').checked) { if (tr.dataset.seq) rows.push({ seq: tr.dataset.seq, drop: true }); return; }
        if (!tr.dataset.seq) {   // 新加的行
          const g = (k) => tr.querySelector('.' + k).value.trim();
          if (!g('name') && !g('inci')) return;
          // 新行带 material_id/price/price_at 快照(从原料库选来的才有;手填行三者为 null,服务端 priceMaterials 可按 INCI 补)
          rows.push({ add: true, phase: g('phase') || 'A', name: g('name'), inci: g('inci'), purpose: g('purpose'), pct: g('pct') === '' ? null : Number(g('pct')), pct_low: g('lo') === '' ? null : Number(g('lo')), pct_high: g('hi') === '' ? null : Number(g('hi')),
            material_id: num(tr.dataset.mid), price: num(tr.dataset.price), price_at: tr.dataset.priceAt || null });
          return;
        }
        const row = { seq: tr.dataset.seq };
        let changed = false;
        for (const k of ['name', 'inci', 'purpose']) {
          const v = tr.querySelector('.' + k).value.trim();
          if (v !== tr.dataset['orig_' + k]) { row[k] = v; changed = true; }
        }
        for (const k of NUMS) {
          const v = tr.querySelector('.' + k).value.trim();
          if (v === tr.dataset['orig_' + k]) continue;
          row[KEY[k]] = v === '' ? null : Number(v);
          changed = true;
        }
        if (changed) rows.push(row);
      });
      if (!rows.length) { say('没有改动', true); return; }
      /* 创始人 12:1x:「完整比例必须总和是 100%」—— 只要有行填了定值,就要求所有未删行都填且合计 = 100(允许 ±0.01) */
      let total = 0, filled = 0, kept = 0;
      efRows.querySelectorAll('tr').forEach((tr) => { if (tr.querySelector('.drop').checked) return; kept++; const v = tr.querySelector('.pct').value.trim(); if (v !== '') { filled++; total += Number(v) || 0; } });
      if (filled > 0 && filled < kept) { say(`还有 ${kept - filled} 行没填完整比例,填齐后合计要等于 100%`, true); return; }
      if (filled > 0 && Math.abs(total - 100) > 0.01) { say(`完整比例合计 ${total.toFixed(2)}%,必须等于 100%(水相用「加至 100」补足)`, true); return; }
      const save = document.getElementById('ef-save'); save.disabled = true;
      const d = await post({ op: 'edit', version_id: curVid, rows });
      if (!d.ok) { say(d.msg || '保存失败', true); save.disabled = false; return; }
      say('已保存为新版本,刷新中…'); dlg.close(); location.reload();
    });

    // 打版结果
    const fbf = document.getElementById('fbf');
    fbf?.elements.version_id?.addEventListener('change', (e) => { const n = e.target.selectedOptions[0]?.dataset.n; if (n) document.getElementById('fb-n').textContent = n; });
    fbf?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = { op: 'feedback' };
      new FormData(fbf).forEach((v, k) => { body[k] = k === 'version_id' ? +v : k === 'ph' ? (v === '' ? null : Number(v)) : v; });
      const b = fbf.querySelector('button[type=submit]'); b.disabled = true;
      const d = await post(body);
      if (!d.ok) { say(d.msg || '保存失败', true); b.disabled = false; return; }
      say('已保存打版结果,刷新中…'); location.reload();
    });
  
    document.addEventListener('click', (e) => { const el = e.target.closest('.pcard details p, .pcard .blk li'); if (el && !e.target.closest('a,button,input')) el.classList.toggle('open'); });
  </script>
