---
/**
 * 配方实验室 · 导入老配方(2026-09-17 创始人:「把原有的一些资料拍照导入我们的系统」)。
 *
 * 三步:① 拍照 / 传图(可多张,逐张 op:ocr mode=recipe)→ ② 表格逐格确认(相 / 原料 / INCI / 比例 / 用途,加行删行,Σ 必须 100)
 *      + 品类 / 剂型 / 原编号 / 标题 → ③ op:import_formula 存进配方库(formulas + formula_recipes),显示编号,可继续下一张。
 * 识不清的行(比例为 null 或接口 unsure 点名)黄底提示。只有总工 / 配方师能导;不传 define:vars,选项在服务端渲染。
 */
import LabShell from '../../../layouts/LabShell.astro';
import { pageGuard } from '../../../lib/guard';
import { canWrite } from '../../../lib/formula-lab';
import zh from '../../../lib/formula-lab-zh.json';

export const prerender = false;
const c = await pageGuard(Astro.request);
if (!c) return Astro.redirect('/bohui/login/');
const labRole = c.sess.lab_role ?? null;
const writable = canWrite(labRole);
const CATS = Object.entries(zh.CAT_ZH as Record<string, string>);
const FMTS = Object.entries(zh.FORMAT_ZH as Record<string, string>).sort((a, b) => a[1].localeCompare(b[1], 'zh'));
---

<LabShell title="导入老配方" email={c.sess.email} tenant={c.tenant}>
  <div class="lab">
    <aside class="lab-side">
      <a class="btn pri new" href="/bohui/formula-lab/">+ 新建对话</a>
      <a class="pitem on" href="/bohui/formula-lab/import/"><b>导入老配方</b><span>拍照 → 识别 → 确认 → 入库</span></a>
      <a class="wiki" href="/bohui/formula-lab/wiki/">配方维基</a>
    </aside>

    <main class="lab-main">
      {!writable ? (
        <div class="note info">只有总工 / 配方师能导入配方;请管理员在「账号与权限」页设置实验室角色。</div>
      ) : (
        <>
          <section class="pcard">
            <h2>① 拍照 / 传图</h2>
            <p class="soft">纸质配方表、手写单、旧 Excel 截图都行;一张表拍不全可以分几张传,识别结果会接在一起。拍的时候尽量正对、光线均匀。</p>
            <div class="row">
              <button class="btn pri" type="button" id="pick">📷 拍照 / 传图(可多张)</button>
              <input type="file" id="files" accept="image/*" multiple hidden />
              <span class="soft" id="prog"></span>
            </div>
            <div class="note info" id="done" hidden></div>
            <div class="thumbs" id="thumbs"></div>
          </section>

          <section class="pcard" id="s2" hidden>
            <h2>② 核对表格</h2>
            <p class="soft">每格都能改;<mark>黄底</mark>是识不清的行,请对照图片补齐。比例合计必须 100%(差 ±0.5 以内接受)。</p>
            <div class="meta">
              <label>标题<input id="m-title" placeholder="例:保湿修护精华 老配方 2019" /></label>
              <label>品类<select id="m-cat"><option value="">请选</option>{CATS.map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
              <label>剂型<select id="m-fmt"><option value="">请选</option>{FMTS.map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
              <label>原编号<input id="m-code" placeholder="纸上原来的编号,没有可空" /></label>
            </div>
            <table class="recipe">
              <thead><tr><th>相</th><th>原料</th><th>INCI</th><th>比例 %</th><th>用途</th><th></th></tr></thead>
              <tbody id="rows"></tbody>
              <tfoot><tr><td colspan="3" class="soft">Σ 比例</td><td class="num"><b id="sum">0.00</b>% <span class="soft" id="sumhint"></span></td><td colspan="2"><button type="button" class="btn sm" id="add">+ 加行</button></td></tr></tfoot>
            </table>
            <label class="notes">备注<textarea id="m-notes" rows="2" placeholder="识别备注会自动填在这里,可改"></textarea></label>
          </section>

          <section class="pcard" id="s3" hidden>
            <h2>③ 存入配方库</h2>
            <div class="row">
              <button class="btn pri" type="button" id="save">存入配方库</button>
              <span class="soft">存进去的配方状态是「已导入」,不会出现在公开站;以后可在配方库里查到。</span>
            </div>
          </section>
        </>
      )}
    </main>
  </div>
  <div id="toast" class="toast" hidden></div>

  <style>
    :global(html){font-size:18px} :global(body){font-size:1rem}
    .lab{display:grid;grid-template-columns:15rem minmax(0,1fr);gap:1rem;max-width:1800px;margin:0 auto;padding:1rem}
    .lab-side{display:flex;flex-direction:column;gap:.625rem;min-width:0} .new{text-align:center}
    .pitem{display:grid;gap:.125rem;padding:.5rem .625rem;border-radius:var(--ad-r-s);text-decoration:none;color:var(--ad-ink);font-size:.8125rem;border:1px solid transparent}
    .pitem.on{background:var(--ad-accent-soft)} .pitem b{font-weight:600} .pitem>span{color:var(--ad-soft);font-size:.75rem}
    .wiki{font-size:.75rem;color:var(--ad-faint);text-decoration:none;padding:.25rem .625rem} .wiki:hover{color:var(--ad-accent)}
    .lab-main{display:flex;flex-direction:column;gap:1rem;min-width:0}
    .pcard{background:var(--ad-panel);border:1px solid var(--ad-line);border-radius:var(--ad-r);padding:.875rem 1rem;min-width:0;box-shadow:var(--ad-shadow)}
    .pcard h2{font-size:1rem;margin:0 0 .375rem} .pcard>p{margin:0 0 .625rem}
    .soft{font-size:.8125rem;color:var(--ad-soft)} .row{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap}
    .btn.sm{padding:.25rem .625rem;font-size:.75rem}
    .thumbs{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.625rem} .thumbs img{max-height:9rem;border-radius:var(--ad-r-s);border:1px solid var(--ad-line);cursor:zoom-in}
    .thumbs img.big{max-height:none;max-width:100%;cursor:zoom-out}
    .meta{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:.75rem;margin-bottom:.625rem} @media (max-width:60rem){.meta{grid-template-columns:1fr 1fr}}
    .meta label,.notes{display:grid;gap:.25rem;font-size:.75rem;color:var(--ad-soft)} .notes{margin-top:.5rem}
    table.recipe{font-size:.8125rem;margin:.5rem 0;box-shadow:none;width:100%} table.recipe th,table.recipe td{padding:.25rem .375rem;vertical-align:middle}
    table.recipe input{width:100%;box-sizing:border-box} table.recipe td.ph input{width:3.5rem} table.recipe td.pct input{width:5.5rem}
    table.recipe tr.unsure td{background:var(--ad-warn-soft)}
    .num{text-align:right} #sum.ok{color:var(--ad-ok)} #sum.bad{color:var(--ad-bad)}
    mark{background:var(--ad-warn-soft);padding:0 .25rem}
    .toast{position:fixed;right:1.25rem;bottom:1.25rem;background:#10131a;color:#fff;padding:.625rem 1rem;border-radius:7px;font-size:.8125rem;z-index:9}
    @media (max-width:60rem){.lab{grid-template-columns:1fr}}
    [hidden]{display:none !important}
  </style>

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const toast = $('toast');
    const say = (m, bad) => { toast.textContent = m; toast.className = 'toast' + (bad ? ' bad' : ''); toast.hidden = false; setTimeout(() => { toast.hidden = true; }, 4000); };
    const post = (b) => fetch('/api/admin/formula-lab', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b) })
      .then((r) => r.json()).catch(() => ({ ok: false, msg: '网络错误,请重试' }));
    const shrink = (f) => new Promise((ok, no) => {
      const img = new Image(), url = URL.createObjectURL(f);
      img.onload = () => { URL.revokeObjectURL(url); const k = Math.min(1, 1600 / Math.max(img.width, img.height)); const cv = document.createElement('canvas'); cv.width = Math.round(img.width * k); cv.height = Math.round(img.height * k); cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height); ok(cv.toDataURL('image/jpeg', .85)); };
      img.onerror = () => { URL.revokeObjectURL(url); no(new Error('图片打不开,请换一张 jpg / png')); };
      img.src = url;
    });

    const rows = $('rows'), sumEl = $('sum'), hint = $('sumhint');
    if (rows) {
      const COLS = ['phase', 'name', 'inci', 'pct', 'purpose'];
      const addRow = (r, unsure) => {
        const tr = document.createElement('tr');
        if (unsure) { tr.className = 'unsure'; tr.title = '识不清,请对照图片补齐'; }
        for (const k of COLS) {
          const td = document.createElement('td'); td.className = k === 'phase' ? 'ph' : k === 'pct' ? 'pct' : '';
          const inp = document.createElement('input'); inp.className = k;
          if (k === 'pct') { inp.type = 'number'; inp.step = '0.001'; inp.min = '0'; inp.max = '100'; inp.value = r.pct == null ? '' : String(r.pct); }
          else { inp.type = 'text'; inp.value = String(r[k] ?? ''); inp.placeholder = { phase: '相', name: '原料名', inci: 'INCI', purpose: '用途' }[k]; }
          inp.addEventListener('input', () => { tr.classList.remove('unsure'); sum(); });
          td.appendChild(inp); tr.appendChild(td);
        }
        const td = document.createElement('td'); const del = document.createElement('button'); del.type = 'button'; del.className = 'btn sm'; del.textContent = '删';
        del.addEventListener('click', () => { tr.remove(); sum(); }); td.appendChild(del); tr.appendChild(td);
        rows.appendChild(tr);
        return tr;
      };
      const sum = () => {
        let s = 0; rows.querySelectorAll('.pct').forEach((i) => { s += Number(i.value) || 0; });
        const d = s - 100;
        sumEl.textContent = s.toFixed(2); sumEl.className = Math.abs(d) <= 0.5 ? 'ok' : 'bad';
        hint.textContent = Math.abs(d) <= 0.5 ? '' : d > 0 ? `多 ${d.toFixed(2)},请核对比例` : `差 ${(-d).toFixed(2)},常见是水相「加至 100」没写数`;
        return s;
      };
      $('add').addEventListener('click', () => { addRow({}, false).querySelector('.name').focus(); });

      // ① 逐张识别
      const pick = $('pick'), files = $('files'), prog = $('prog'), thumbs = $('thumbs'), done = $('done');
      pick.addEventListener('click', () => files.click());
      thumbs.addEventListener('click', (e) => { if (e.target.tagName === 'IMG') e.target.classList.toggle('big'); });
      files.addEventListener('change', async () => {
        const list = [...files.files]; files.value = '';
        if (!list.length) return;
        pick.disabled = true; done.hidden = true;
        let n = 0, gotAny = false;
        for (const f of list) {
          n++; prog.textContent = `第 ${n}/${list.length} 张识别中,约 30 秒…`;
          try {
            const image = await shrink(f);
            if (image.length > 4 * 1024 * 1024) throw new Error('压缩后仍超 4MB,请拍近一点');
            const im = document.createElement('img'); im.src = image; thumbs.appendChild(im);
            const d = await post({ op: 'ocr', image, mode: 'recipe' });
            if (!d.ok) throw new Error(d.msg || '识别失败');
            const rs = Array.isArray(d.rows) ? d.rows : [];
            if (!rs.length) throw new Error('这张图没识别出配方行,请拍清楚一点或换一张');
            const unsure = new Set(Array.isArray(d.unsure) ? d.unsure : []);
            rs.forEach((r, i) => addRow(r, r.pct == null || unsure.has(i + 1)));
            if (d.title && !$('m-title').value) $('m-title').value = d.title;
            if (d.notes) $('m-notes').value = ($('m-notes').value ? $('m-notes').value + '\n' : '') + d.notes;
            gotAny = true;
          } catch (err) { say(`第 ${n} 张:${err.message || '识别失败'}`, true); }
        }
        pick.disabled = false; prog.textContent = gotAny ? `已识别 ${rows.children.length} 行,请到 ② 核对` : '';
        if (gotAny) { $('s2').hidden = false; $('s3').hidden = false; sum(); $('s2').scrollIntoView({ block: 'start' }); }
      });

      // ③ 入库
      const save = $('save');
      save.addEventListener('click', async () => {
        const title = $('m-title').value.trim(), category = $('m-cat').value, format = $('m-fmt').value;
        if (!title) return say('请填标题', true);
        if (!category || !format) return say('请选品类和剂型', true);
        const out = [];
        rows.querySelectorAll('tr').forEach((tr) => {
          const g = (k) => tr.querySelector('.' + k).value.trim();
          if (!g('name') && !g('inci')) return;
          out.push({ phase: g('phase') || 'A', name: g('name'), inci: g('inci'), pct: g('pct') === '' ? null : Number(g('pct')), purpose: g('purpose') });
        });
        if (!out.length) return say('表里没有原料行', true);
        if (out.some((r) => r.pct == null)) return say('还有行没填比例(黄底行),请对照图片补齐', true);
        const s = sum();
        if (Math.abs(s - 100) > 0.5) return say(`比例合计 ${s.toFixed(2)}%,请先在表里改齐到 100%`, true);
        save.disabled = true; save.textContent = '存入中…';
        const d = await post({ op: 'import_formula', title, category, format, rows: out, orig_code: $('m-code').value.trim() || undefined, notes: $('m-notes').value.trim() || undefined });
        save.disabled = false; save.textContent = '存入配方库';
        if (!d.ok) return say(d.msg || '没存成,请重试', true);
        done.hidden = false; done.textContent = `已存入配方库,编号 ${d.code || d.formula_id}。要导下一张:直接再点「拍照 / 传图」,表会清空。`;
        say('已存入 ' + (d.code || ''));
        // 下一张:清表、清图、保留品类 / 剂型(同一批老配方多半同类)
        rows.innerHTML = ''; thumbs.innerHTML = ''; $('m-title').value = ''; $('m-code').value = ''; $('m-notes').value = ''; sum();
        $('s2').hidden = true; $('s3').hidden = true; prog.textContent = '';
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</LabShell>
