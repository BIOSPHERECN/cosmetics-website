---
/**
 * 后台:上传一个国家 / 地区的原料目录(CSV 粘贴)—— 创始人 2026-09-11「要预留很多端口,他们可以在后台上传」。
 * 表头 no,name,inci,cas,note(逗号或 Tab 分隔);同一目录 id 重复上传即覆盖。上完前台 /inci/{id}/ 立即可查。
 */
import AdminShell from '../../layouts/AdminShell.astro';
import { pageGuard } from '../../lib/guard';
export const prerender = false;
const c = await pageGuard(Astro.request);
if (!c) return Astro.redirect('/bohui/login/');
const { results: regs } = await c.db.prepare('SELECT r.id, r.region, r.name_zh, r.status, (SELECT COUNT(*) FROM inci_catalog k WHERE k.registry = r.id) n FROM inci_registry r ORDER BY r.sort_order, r.id').all<any>();
---
<AdminShell title="各国原料目录 · 上传" active="registries" email={c.sess.email} tenant={c.tenant}>
  <h1>各国原料目录 · 上传</h1>
  <p class="lead">把一个国家的禁限用 / 准用清单整理成 CSV(Excel 另存为 CSV 即可),表头固定:<code>no,name,inci,cas,note</code>;贴进下面,填目录 id 与名称,提交。前台 <code>/zh-cn/inci/目录id/</code> 立即可查,原料页与配方页的「各市场目录状态」自动对账。</p>
  <table class="tbl"><thead><tr><th>目录 id</th><th>地区</th><th>名称</th><th>条数</th><th>状态</th></tr></thead>
    <tbody>{(regs ?? []).map((r: any) => (<tr><td><code>{r.id}</code></td><td>{r.region}</td><td>{r.name_zh}</td><td>{Number(r.n).toLocaleString()}</td><td>{r.status}</td></tr>))}</tbody></table>
  <form id="f" class="form">
    <label>目录 id <input name="id" placeholder="vn-moh(国家码-机构,小写)" required pattern="[a-z]{2,3}-[a-z0-9-]{2,20}" /></label>
    <label>地区 <input name="region" placeholder="越南" required /></label>
    <label>中文名 <input name="name_zh" placeholder="越南卫生部化妆品禁限用清单" required /></label>
    <label>英文名 <input name="name_en" placeholder="Vietnam MoH restricted list" /></label>
    <label>发布机构 <input name="issuer" placeholder="越南卫生部药品管理局" /></label>
    <label>官方链接 <input name="url" placeholder="https://" /></label>
    <label>来源说明 <input name="source" placeholder="Circular 06/2011/TT-BYT Annex II · 2026-09" /></label>
    <label>CSV <textarea name="csv" rows="12" placeholder="no,name,inci,cas,note&#10;1,Hydroquinone,HYDROQUINONE,123-31-9,禁用" required></textarea></label>
    <button type="submit">上传 / 覆盖</button> <span id="msg"></span>
  </form>
  <script is:inline>
    const f = document.getElementById('f'), msg = document.getElementById('msg');
    f.addEventListener('submit', async (e) => {
      e.preventDefault(); msg.textContent = '上传中…';
      const b = Object.fromEntries(new FormData(f).entries());
      const r = await fetch('/api/admin/registry', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b) }).then((x) => x.json()).catch(() => ({ ok: false, msg: '网络错误' }));
      msg.textContent = r.ok ? `已写入 ${r.rows} 条 → /zh-cn/inci/${r.id}/(刷新本页看条数)` : ('失败:' + r.msg);
    });
  </script>
</AdminShell>
<style>
  .lead { max-width: 60rem; line-height: 1.7; } .tbl { border-collapse: collapse; margin: 1rem 0; font-size: .9rem; } .tbl th, .tbl td { border-bottom: 1px solid #ddd; padding: .375rem .75rem; text-align: left; }
  .form { display: grid; gap: .625rem; max-width: 48rem; } .form label { display: grid; gap: .25rem; font-size: .9rem; } .form input, .form textarea { padding: .5rem; border: 1px solid #ccc; border-radius: 6px; font: inherit; }
  .form button { justify-self: start; padding: .5rem 1rem; border-radius: 8px; border: 0; background: #111; color: #fff; cursor: pointer; }
</style>
