---
/**
 * 版块编辑器 —— 后台的核心。
 *
 * 上一版把表单交给前端 JS 现造,结果 Astro 的作用域样式全部落空、页面糊成一团。
 * 这一版全部服务端渲染(见 FieldTree.astro),JS 只做三件事:增行、删行、保存时回读。
 *
 * 回读不再靠预先埋好的下标路径,而是**按 DOM 结构走一遍** ——
 * 这样新增/删除行之后下标自然连续,不会留洞,也不需要在增删时重排任何东西。
 */
import AdminShell from '../../../layouts/AdminShell.astro';
import FieldTree from '../../../components/admin/FieldTree.astro';
import { pageGuard } from '../../../lib/guard';
import { LANG_GROUPS } from '../../../lib/db';
import { SITES } from '@cosmetic/core/registry';

export const prerender = false;
const c = await pageGuard(Astro.request);
if (!c) return Astro.redirect('/bohui/login/');

const id = Number(Astro.params.id);
const pg = await c.db.prepare(
  `SELECT id, site_id, slug, template, status, in_nav FROM pages WHERE id=?`
).bind(id).first<any>();
if (!pg) return new Response('页面不存在', { status: 404 });

const { results: meta } = await c.db.prepare(
  `SELECT lang, nav_label, title, seo_desc FROM page_i18n WHERE page_id=? ORDER BY lang`
).bind(id).all<any>();

const { results: blocks } = await c.db.prepare(
  `SELECT id, type, sort_order, is_visible FROM blocks WHERE page_id=? ORDER BY sort_order, id`
).bind(id).all<any>();

const ids = blocks.map((b: any) => b.id);
let i18n: any[] = [];
if (ids.length) {
  const { results } = await c.db.prepare(
    `SELECT block_id, lang, data_json FROM block_i18n WHERE block_id IN (${ids.map(() => '?').join(',')})`
  ).bind(...ids).all<any>();
  i18n = results ?? [];
}
const dataBy = new Map<string, string>(i18n.map((r) => [`${r.block_id}:${r.lang}`, r.data_json]));

const url = new URL(Astro.request.url);
// 默认中英双栏:一屏对照着改,比来回切语种快得多
const editLangs = (url.searchParams.get('langs') ?? 'zh-cn,en').split(',').filter(Boolean);

const LNAME = new Map(LANG_GROUPS.flatMap((g) => g.langs));
const siteName = new Map(SITES.map((s) => [s.id, s.name])).get(pg.site_id) ?? pg.site_id;
const BTYPE: Record<string, string> = {
  hero: '首屏', workshop: '车间实拍', certs: '资质证书', matrix: '品类矩阵',
  process: '服务流程', evidence: '能力佐证', proof: '数字实证', form: '询盘表单',
  inquiry: '询盘引导', prose: '正文段落', statwall: '数字墙', bases: '生产基地', stages: '叙事流程',
};
const PICK = ['zh-cn', 'en', 'zh-tw', 'ja', 'ko', 'es', 'fr', 'de', 'ru', 'ar', 'pt', 'id'];

/** 某语种没有译文时,拿已有语种的结构做骨架 —— 让运营直接在上面译,而不是面对一片空白 */
const parse = (s?: string) => { try { return s ? JSON.parse(s) : null; } catch { return null; } };
const skeleton = (o: unknown): unknown =>
  Array.isArray(o) ? o.map(skeleton)
  : o !== null && typeof o === 'object'
    ? Object.fromEntries(Object.entries(o as object).map(([k, v]) => [k, skeleton(v)]))
    : '';

const view = blocks.map((b: any) => {
  const have = i18n.filter((r) => r.block_id === b.id).map((r) => r.lang);
  const seed = parse(dataBy.get(`${b.id}:zh-cn`)) ?? parse(dataBy.get(`${b.id}:en`))
    ?? parse(dataBy.get(`${b.id}:${have[0]}`)) ?? {};
  return {
    ...b,
    have,
    missing: editLangs.filter((l) => !have.includes(l)),
    cols: editLangs.map((l) => ({
      lang: l,
      exists: have.includes(l),
      data: parse(dataBy.get(`${b.id}:${l}`)) ?? skeleton(seed),
    })),
  };
});
const zhTitle = meta.find((m: any) => m.lang === 'zh-cn')?.title;
---

<AdminShell title="编辑页面" active="pages" email={c.sess.email}>
  <nav class="crumb">
    <a href="/bohui/">仪表盘</a><span>›</span><a href="/bohui/pages/">页面与版块</a><span>›</span>
    <b>{zhTitle ?? `/${pg.slug}`}</b>
  </nav>

  <div class="hd">
    <div class="hd-t">
      <h1>{zhTitle ?? pg.slug ?? '首页'}</h1>
      <p class="sub">
        <span>{siteName}</span><span class="dot"></span>
        <code>/{pg.slug}</code><span class="dot"></span>
        <span>模板 {pg.template}</span><span class="dot"></span>
        <span>{blocks.length} 个版块</span><span class="dot"></span>
        <span>已有 {meta.length} 个语种</span>
      </p>
    </div>
    <div class="hd-a">
      <a class="btn" href={`/zh-cn/${pg.slug}${pg.slug ? '/' : ''}?site=${pg.site_id}`} target="_blank">预览前台</a>
      <button class="btn pri" id="saveall">保存全部</button>
    </div>
  </div>

  <section class="card">
    <div class="card-h"><h2>对照编辑的语种</h2></div>
    <div class="card-b langbar">
      {PICK.map((l) => (
        <label class:list={['lg', editLangs.includes(l) && 'on']}>
          <input type="checkbox" value={l} checked={editLangs.includes(l)} />
          <span>{LNAME.get(l) ?? l}</span>
        </label>
      ))}
    </div>
  </section>

  <section class="card">
    <div class="card-h"><h2>页面信息</h2><span class="hint">导航标签是菜单里显示的短名,页面标题用于 &lt;title&gt; 与搜索结果</span></div>
    <div class="card-b">
      <div class="cols" style={`--n:${editLangs.length}`}>
        {editLangs.map((l) => {
          const m = meta.find((x: any) => x.lang === l);
          return (
            <div class="col" data-meta-lang={l}>
              <div class="col-h">
                <b>{LNAME.get(l) ?? l}</b>
                {!m && <span class="pill p-warn">尚无译文</span>}
              </div>
              <div class="ft-f"><label>导航标签</label><input class="m-nav" value={m?.nav_label ?? ''} /></div>
              <div class="ft-f"><label>页面标题</label><input class="m-title" value={m?.title ?? ''} /></div>
              <div class="ft-f"><label>SEO 描述</label><textarea class="m-seo" rows="2">{m?.seo_desc ?? ''}</textarea></div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {view.length === 0 ? (
    <div class="empty">这个页面还没有版块。</div>
  ) : view.map((b: any, i: number) => (
    <details class="card blk" data-id={b.id} open={i < 2}>
      <summary class="card-h">
        <span class="chev"></span>
        <b>{BTYPE[b.type] ?? b.type}</b>
        <code class="ty">{b.type}</code>
        {b.missing.length > 0 && (
          <span class="pill p-warn">缺 {b.missing.map((l: string) => LNAME.get(l) ?? l).join(' / ')}</span>
        )}
        <label class="vis">
          <input type="checkbox" checked={!!b.is_visible} />
          <span>在前台显示</span>
        </label>
      </summary>
      <div class="card-b">
        <div class="cols" style={`--n:${editLangs.length}`}>
          {b.cols.map((col: any) => (
            <div class="col" data-lang={col.lang}>
              <div class="col-h">
                <b>{LNAME.get(col.lang) ?? col.lang}</b>
                {!col.exists && <span class="pill p-warn">按已有语种生成的空壳,填完保存即建立译文</span>}
              </div>
              <div class="col-b">
                {Object.keys(col.data ?? {}).length === 0
                  ? <p class="none">(无内容)</p>
                  : Object.entries(col.data).map(([k, v]) => <FieldTree data={v} name={k} />)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </details>
  ))}

  <div id="toast" class="toast" hidden></div>

  <style>
    .crumb { display: flex; align-items: center; gap: .4375rem; font-size: .8125rem; color: var(--ad-faint); margin-bottom: .875rem; }
    .crumb a { color: var(--ad-accent); text-decoration: none; }
    .crumb a:hover { text-decoration: underline; }
    .crumb b { color: var(--ad-ink); font-weight: 600; }

    .hd { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.25rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .hd h1 { font-size: 1.375rem; margin: 0 0 .375rem; }
    .sub { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin: 0; font-size: .8125rem; color: var(--ad-soft); }
    .sub code { background: #eef0f3; padding: .0625rem .375rem; border-radius: 4px; font-size: .75rem; }
    .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ad-line); }
    .hd-a { display: flex; gap: .5rem; flex-shrink: 0; }

    .card { background: var(--ad-panel); border: 1px solid var(--ad-line); border-radius: 10px; margin-bottom: 1rem; overflow: hidden; }
    .card-h { display: flex; align-items: center; gap: .625rem; padding: .8125rem 1.125rem; background: #fafbfc; border-bottom: 1px solid var(--ad-line); }
    .card-h h2 { font-size: .875rem; margin: 0; }
    .card-h .hint { font-size: .75rem; color: var(--ad-faint); margin-left: auto; }
    .card-b { padding: 1.125rem; }

    /* 版块折叠卡 */
    .blk > summary { cursor: pointer; list-style: none; }
    .blk > summary::-webkit-details-marker { display: none; }
    .blk:not([open]) > summary { border-bottom: 0; }
    .blk .chev { width: .5rem; height: .5rem; border-right: 1.5px solid var(--ad-faint); border-bottom: 1.5px solid var(--ad-faint);
                 transform: rotate(-45deg); transition: transform .15s; flex-shrink: 0; margin-left: .125rem; }
    .blk[open] .chev { transform: rotate(45deg); }
    .blk .ty { font-size: .6875rem; color: var(--ad-faint); font-family: ui-monospace, monospace; }
    .vis { margin-left: auto; display: flex; align-items: center; gap: .375rem; font-size: .75rem; color: var(--ad-soft); white-space: nowrap; }
    .vis input { width: auto; margin: 0; }

    /* 多语并排:超过两栏时自动换行,不硬挤 */
    .cols { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr)); }
    .col-h { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; padding-bottom: .5rem; margin-bottom: .875rem; border-bottom: 1px solid var(--ad-line); }
    .col-h b { font-size: .8125rem; color: var(--ad-accent); }
    .none { color: var(--ad-faint); font-size: .8125rem; margin: 0; }

    .langbar { display: flex; gap: .375rem; flex-wrap: wrap; }
    .lg { display: inline-flex; align-items: center; gap: .3125rem; border: 1px solid var(--ad-line); border-radius: 999px;
          padding: .25rem .6875rem; font-size: .8125rem; color: var(--ad-soft); background: #fff; cursor: pointer; }
    .lg:hover { border-color: var(--ad-accent); }
    .lg.on { border-color: var(--ad-accent); color: var(--ad-accent); background: #eef4fa; font-weight: 600; }
    .lg input { width: auto; margin: 0; }

    .toast { position: fixed; right: 1.25rem; bottom: 1.25rem; background: #10131a; color: #fff;
             padding: .6875rem 1.0625rem; border-radius: 8px; font-size: .8125rem; z-index: 9;
             box-shadow: 0 10px 30px -8px rgb(0 0 0 / .35); }
    .toast.bad { background: var(--ad-bad); }
    [hidden] { display: none !important; }
  </style>

  <script is:inline>
  (() => {
    const toast = document.getElementById('toast');
    const say = (m, bad) => {
      toast.textContent = m; toast.classList.toggle('bad', !!bad); toast.hidden = false;
      clearTimeout(say.t); say.t = setTimeout(() => { toast.hidden = true; }, 3000);
    };

    /* 增行:克隆模板里的空白行。模板是服务端渲染的,带着作用域类,所以新行有样式 */
    document.addEventListener('click', (e) => {
      const add = e.target.closest('.ft-grp.ft-arr > .ft-h > .ft-add');
      if (add) {
        e.preventDefault();
        const grp = add.closest('.ft-grp.ft-arr');
        const node = grp.querySelector(':scope > .ft-tpl').content.firstElementChild.cloneNode(true);
        grp.querySelector(':scope > .ft-items').appendChild(node);
        renumber(grp);
        return;
      }
      const rm = e.target.closest('.ft-item > .ft-item-h > .ft-rm');
      if (rm) {
        e.preventDefault();
        const grp = rm.closest('.ft-grp.ft-arr');
        rm.closest('.ft-item').remove();
        renumber(grp);
      }
    });
    function renumber(grp) {
      const items = grp.querySelectorAll(':scope > .ft-items > .ft-item');
      items.forEach((it, i) => { it.querySelector(':scope > .ft-item-h > .ft-ix').textContent = i + 1; });
      grp.querySelector(':scope > .ft-h > .ft-cnt').textContent = items.length + ' 条';
    }

    /* 回读:按 DOM 结构走一遍。不依赖预埋下标,增删行之后下标天然连续 */
    function readBody(body) {
      const out = {};
      body.querySelectorAll(':scope > [data-key]').forEach((el) => { out[el.dataset.key] = readEl(el); });
      return out;
    }
    function readEl(el) {
      if (el.dataset.kind === 'arr') {
        return [...el.querySelectorAll(':scope > .ft-items > .ft-item')].map((it) => {
          const ob = it.querySelector(':scope > .ft-body');
          if (ob) return readBody(ob);
          const f = it.querySelector(':scope > .ft-f');
          return f ? f.querySelector('input,textarea').value : '';
        });
      }
      if (el.dataset.kind === 'obj') return readBody(el.querySelector(':scope > .ft-body'));
      return el.querySelector('input,textarea').value;
    }

    document.getElementById('saveall').addEventListener('click', async (ev) => {
      const btn = ev.currentTarget;
      btn.disabled = true; btn.textContent = '保存中…';
      const meta = [...document.querySelectorAll('[data-meta-lang]')].map((col) => ({
        lang: col.dataset.metaLang,
        nav_label: col.querySelector('.m-nav').value,
        title: col.querySelector('.m-title').value,
        seo_desc: col.querySelector('.m-seo').value,
      }));
      const blocks = [...document.querySelectorAll('.blk')].map((d) => ({
        id: +d.dataset.id,
        is_visible: d.querySelector('.vis input').checked ? 1 : 0,
        data: Object.fromEntries([...d.querySelectorAll('.col')].map((col) => [
          col.dataset.lang, readBody(col.querySelector(':scope > .col-b')),
        ])),
      }));
      try {
        const r = await fetch('/api/admin/page', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ page_id: +location.pathname.split('/').filter(Boolean).pop(), meta, blocks }),
        });
        const d = await r.json();
        if (!d.ok) throw new Error(d.msg);
        say(d.meta + d.blocks === 0 ? '内容没有变化,未写入' : `已保存 · 页面信息 ${d.meta} 条,版块译文 ${d.blocks} 条`);
      } catch (e) { say(e.message || '保存失败', true); }
      btn.disabled = false; btn.textContent = '保存全部';
    });

    document.querySelectorAll('.langbar input').forEach((cb) => cb.addEventListener('change', () => {
      const on = [...document.querySelectorAll('.langbar input')].filter((x) => x.checked).map((x) => x.value);
      location.search = '?langs=' + (on.length ? on.join(',') : 'zh-cn');
    }));
  })();
  </script>
</AdminShell>
