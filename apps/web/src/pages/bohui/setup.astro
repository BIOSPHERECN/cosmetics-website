---
/**
 * 首次安装页 —— 在浏览器里创建第一个管理员。
 *
 * 为什么要有这一页:此前只提供了 curl 命令,结果在 PowerShell 上反复失败
 * (curl 被别名成 Invoke-WebRequest、参数不兼容、POST 被降级成 GET…)。
 * 让人跟终端较劲是我的失误 —— 一个表单两个输入框,零门槛。
 *
 * 口令由创始人自己在浏览器里输入,服务端只存 PBKDF2 派生值。
 * 已有管理员时本页自动失效,不留后门。
 */
import { env } from 'cloudflare:workers';

export const prerender = false;

const db = (env as any).DB as D1Database | undefined;
let already = false;
if (db) {
  const n = await db.prepare(`SELECT COUNT(*) AS c FROM users`).first<{ c: number }>().catch(() => null);
  already = (n?.c ?? 0) > 0;
}
---

<html lang="zh-CN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" /><title>首次安装 · 帛卉后台</title>
  <style>
    :root{--panel:#fff;--ink:#10131a;--soft:#5b6472;--faint:#858d99;--line:#e3e7ec;
          --accent:#1f4e79;--ok:#197a4b;--bad:#b3261e;
          font-family:system-ui,'PingFang SC','Microsoft YaHei',sans-serif}
    *{box-sizing:border-box}
    body{margin:0;background:#f6f7f9;color:var(--ink);display:grid;place-items:center;min-height:100vh;padding:1.5rem}
    .card{width:min(26rem,100%);background:var(--panel);border:1px solid var(--line);
          border-radius:12px;padding:2rem}
    h1{font-size:1.25rem;margin:0 0 .375rem}
    p.sub{color:var(--soft);font-size:.875rem;margin:0 0 1.5rem;line-height:1.6}
    .fld{display:grid;gap:.375rem;margin-bottom:1rem}
    .fld span{font-size:.8125rem;color:var(--soft)}
    .fld input{font:inherit;padding:.6875rem .75rem;border:1px solid var(--line);border-radius:6px}
    .fld input:focus{outline:2px solid var(--accent);outline-offset:1px}
    button{font:inherit;width:100%;padding:.75rem;border:0;border-radius:6px;
           background:var(--accent);color:#fff;cursor:pointer;font-weight:600}
    button:disabled{opacity:.5;cursor:default}
    .msg{margin-top:1rem;font-size:.875rem;min-height:1.4em}
    .msg.ok{color:var(--ok)} .msg.bad{color:var(--bad)}
    .done{padding:1rem;background:#f1f2f4;border-radius:8px;color:var(--soft);font-size:.875rem;line-height:1.7}
    a{color:var(--accent)}
  </style>
</head>
<body>
  <div class="card">
    <h1>帛卉后台 · 首次安装</h1>

    {already ? (
      <div class="done">
        管理员已经创建过了,本页已失效。<br />
        直接去 <a href="/bohui/">/admin/</a> 登录即可。<br /><br />
        忘记口令的话告诉我,我加一个「重置口令」的入口 —— 不会绕过登录,只是走邮箱验证。
      </div>
    ) : (
      <>
        <p class="sub">
          创建第一个管理员。口令由你自己设定,服务端只保存不可逆的派生值。
          <strong>创建成功后本页自动失效</strong>,不会留后门。
        </p>
        <form id="f">
          <label class="fld">
            <span>邮箱</span>
            {/* 不用 admin@ —— 那是撞库时第一个被试的用户名 */}
            <input name="email" type="email" required value="bohui@biosphere-ai.com" autocomplete="username" />
          </label>
          <label class="fld">
            <span>口令(至少 6 位)</span>
            <input name="password" type="password" required minlength="6" autocomplete="new-password" />
          </label>
          <button type="submit">创建管理员</button>
        </form>
        <p class="msg" id="m"></p>
      </>
    )}
  </div>

  <script is:inline>
    const f = document.getElementById('f');
    if (f) f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const m = document.getElementById('m');
      const btn = f.querySelector('button');
      const fd = new FormData(f);
      btn.disabled = true; m.className = 'msg'; m.textContent = '创建中…';
      // 失败时把真实原因显示出来。之前只报"请求失败"导致排查困难 ——
      // 分不清是网络挡了、服务端 500、还是返回的不是 JSON。
      let stage = '发起请求';
      try {
        const r = await fetch('/api/admin/setup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: fd.get('email'), password: fd.get('password') }),
        });
        stage = `读取响应(HTTP ${r.status})`;
        const raw = await r.text();
        let d;
        try { d = JSON.parse(raw); }
        catch { throw new Error(`服务端返回的不是 JSON:${raw.slice(0, 120) || '(空响应)'}`); }

        if (d.ok) {
          m.className = 'msg ok';
          m.textContent = '创建成功,正在跳转登录…';
          setTimeout(() => (location.href = '/bohui/'), 900);
        } else {
          m.className = 'msg bad'; m.textContent = d.msg || `创建失败(HTTP ${r.status})`; btn.disabled = false;
        }
      } catch (err) {
        m.className = 'msg bad';
        m.textContent = `${stage}失败:${err && err.message ? err.message : err}`;
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
