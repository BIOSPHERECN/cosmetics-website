---
/**
 * 任务中心 —— 后台脚本注册 + 心跳,一眼看到谁停了。
 * 依据:创始人 2026-09-18「看看他们有没有停止」;GPT 设计包 jobs / job_events 落到 D1 jobs 表(0087,G 任务同建)。
 * 表还没建好时显示「数据准备中」,不 500;页面每 60 秒自动刷新(Worker 看不到 Windows 计划任务,只能看心跳)。
 */
import AdminShell from '../../layouts/AdminShell.astro';
import { pageGuard } from '../../lib/guard';

export const prerender = false;
const c = await pageGuard(Astro.request);
if (!c) return Astro.redirect('/bohui/login/');

type Job = { id: number; name: string; job_type: string | null; host: string | null; status: string; progress: number | null; total: number | null;
  note: string | null; started_at: string | null; heartbeat_at: string | null; finished_at: string | null; error: string | null };
let rows: Job[] | null = null;   // null = 表不存在 / 查询失败 → 「数据准备中」
try { rows = (await c.db.prepare(`SELECT * FROM jobs ORDER BY id DESC LIMIT 200`).all<Job>()).results; } catch { rows = null; }

const now = Date.now();
/** D1 CURRENT_TIMESTAMP 是 UTC 'YYYY-MM-DD HH:MM:SS',没有时区标记,补 Z 再解析 */
const ts = (s: string | null | undefined) => s ? Date.parse(s.includes('T') ? s : s.replace(' ', 'T') + 'Z') : NaN;
const mins = (s: string | null | undefined) => Math.round((now - ts(s)) / 60000);
const STALL_MIN = 15;   // 心跳超 15 分钟 = 疑似停了(任务口径)
const state = (j: Job) => j.status === 'running' ? (mins(j.heartbeat_at ?? j.started_at) > STALL_MIN ? 'stalled' : 'running') : j.status;
const STATE: Record<string, [string, string]> = { running: ['运行中', 'p-ok'], stalled: ['疑似停了', 'p-bad'], done: ['完成', 'p-ok'], failed: ['失败', 'p-bad'] };
const RANK: Record<string, number> = { stalled: 0, failed: 1, running: 2, done: 3 };
const ago = (s: string | null | undefined) => { const m = mins(s); return isNaN(m) ? '—' : m < 1 ? '刚刚' : m < 60 ? `${m} 分钟前` : m < 1440 ? `${Math.floor(m / 60)} 小时前` : `${Math.floor(m / 1440)} 天前`; };
/* 注意:Astro 编译器把「) / 60000」当正则起点,整段 frontmatter 就找不到结尾了(09-18 实测),所以除号前放变量不放括号 */
const dur = (j: Job) => {
  const a = ts(j.started_at), b = j.finished_at ? ts(j.finished_at) : now;
  if (isNaN(a)) return '—';
  const secs = (b - a) * 0.001, m = Math.max(0, Math.round(secs / 60)), h = Math.floor(m / 60);
  return m < 60 ? `${m} 分` : `${h} 时 ${m - h * 60} 分`;
};
const pct = (j: Job) => j.total ? Math.min(100, Math.round(((j.progress ?? 0) / j.total) * 100)) : null;
const dayOf = (s: string | null | undefined) => isNaN(ts(s)) ? '' : new Date(ts(s)).toLocaleDateString('sv-SE', { timeZone: 'Asia/Shanghai' });
const today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Asia/Shanghai' });

/* 按 name 分组:只显示每个 name 最新一条 + 历史条数;疑似停了排最上面 */
const groups = new Map<string, { latest: Job; n: number }>();
for (const j of rows ?? []) { const g = groups.get(j.name); if (g) g.n++; else groups.set(j.name, { latest: j, n: 1 }); }
const list = [...groups.values()].sort((a, b) => (RANK[state(a.latest)] ?? 9) - (RANK[state(b.latest)] ?? 9));
const all = rows ?? [];
const stats = {
  running: list.filter((g) => state(g.latest) === 'running').length,
  stalled: list.filter((g) => state(g.latest) === 'stalled').length,
  done: all.filter((j) => j.status === 'done' && dayOf(j.finished_at) === today).length,
  failed: all.filter((j) => j.status === 'failed' && dayOf(j.finished_at ?? j.heartbeat_at) === today).length,
};
/* 创始人最关心 WorkBuddy 有没有停 → assistant-watch 单独放最上面大字 */
const watch = list.find((g) => g.latest.name.toLowerCase().includes('assistant'));   // 名字含 assistant 就当它(BohuiAssistantWatch / assistant-watch 都命中)
const ws = watch ? state(watch.latest) : '';
---

<AdminShell title="任务中心" active="jobs" email={c.sess.email} tenant={c.tenant}>
  <h1>任务中心</h1>
  <p class="lead">后台脚本每次跑都在 jobs 表登记并按分钟发心跳;运行中却超过 {STALL_MIN} 分钟没心跳,就标「疑似停了」。本页每 60 秒自动刷新。</p>

  <section class:list={['watch', ws === 'stalled' || ws === 'failed' ? 'bad' : ws ? 'ok' : 'none']}>
    <div class="k">WorkBuddy 助手值守 · BohuiAssistantWatch</div>
    {watch ? (
      <>
        <div class="v">{STATE[ws]?.[0] ?? ws}<span class:list={['pill', STATE[ws]?.[1] ?? 'p-wait']}>心跳 {ago(watch.latest.heartbeat_at ?? watch.latest.started_at)}</span></div>
        <div class="s">开始 {(watch.latest.started_at ?? '').slice(0, 16)} · 已跑 {dur(watch.latest)} · 历史 {watch.n} 次{watch.latest.note ? ` · ${watch.latest.note}` : ''}{watch.latest.error ? ` · ${watch.latest.error.slice(0, 120)}` : ''}</div>
      </>
    ) : (
      <div class="v">{rows === null ? '数据准备中' : '还没有心跳记录'}</div>
    )}
  </section>

  <div class="cards">
    <div class="card"><div class="k">运行中</div><div class="v">{stats.running}</div></div>
    <div class:list={['card', stats.stalled > 0 && 'bad']}><div class="k">疑似停了</div><div class="v">{stats.stalled}</div></div>
    <div class="card ok"><div class="k">今日完成</div><div class="v">{stats.done}</div></div>
    <div class:list={['card', stats.failed > 0 && 'bad']}><div class="k">今日失败</div><div class="v">{stats.failed}</div></div>
  </div>

  {rows === null ? (
    <div class="empty">数据准备中 —— jobs 表还没建(迁移 0087),建好后脚本一跑这里就有记录。</div>
  ) : list.length === 0 ? (
    <div class="empty">还没有任务登记。脚本接上 jobs 心跳后这里会出现第一条。</div>
  ) : (
    <table>
      <thead><tr><th>任务</th><th>状态</th><th style="width:11rem">进度</th><th>心跳</th><th>开始</th><th>耗时</th><th>备注</th><th>错误</th></tr></thead>
      <tbody>{list.map(({ latest: j, n }) => { const st = state(j), p = pct(j); return (
        <tr>
          <td><b>{j.name}</b><div class="dim">{[j.job_type, j.host].filter(Boolean).join(' · ')}{n > 1 ? ` · 历史 ${n} 条` : ''}</div></td>
          <td><span class:list={['pill', STATE[st]?.[1] ?? 'p-wait']}>{STATE[st]?.[0] ?? st}</span></td>
          <td>{p === null ? <span class="dim">{j.progress ?? '—'}</span> : (
            <><span class="num">{j.progress ?? 0} / {j.total} · {p}%</span><div class="prog"><i style={'width:' + p + '%'}></i></div></>
          )}</td>
          <td class:list={[st === 'stalled' && 'warn']}>{ago(j.heartbeat_at ?? j.started_at)}</td>
          <td class="dim">{(j.started_at ?? '').slice(0, 16)}</td>
          <td class="num">{dur(j)}</td>
          <td class="dim">{j.note ?? ''}</td>
          <td class="err">{(j.error ?? '').slice(0, 120)}</td>
        </tr>
      ); })}</tbody>
    </table>
  )}

  <h2>计划任务(本机 Windows)</h2>
  <p class="lead">Worker 看不到 Windows 计划任务,下面是写死的排程;有没有真的在跑,看上表心跳。</p>
  <table class="plan">
    <thead><tr><th>计划任务</th><th>频率</th><th>做什么</th></tr></thead>
    <tbody>
      <tr><td><b>BohuiAssistantWatch</b></td><td>每 2 小时</td><td>盯 WorkBuddy 等助手进度,记 _进度.md</td></tr>
      <tr><td><b>Bohui-FollowWorkBuddy</b></td><td>每 30 分钟</td><td>跟进 WorkBuddy 交付,把结果入库</td></tr>
      <tr><td><b>BohuiMarketDaily</b></td><td>每天 06:30</td><td>抓 15 个美妆畅销榜,生成爆款周报快照</td></tr>
    </tbody>
  </table>

  <style>
    .watch{border:1px solid var(--ad-line);border-radius:9px;padding:1.125rem 1.375rem;margin-bottom:1rem;background:var(--ad-panel)}
    .watch.bad{border-color:var(--ad-bad);background:var(--ad-bad-soft)} .watch.ok{border-color:var(--ad-ok)}
    .watch .k{font-size:.75rem;letter-spacing:.08em;color:var(--ad-faint);text-transform:uppercase}
    .watch .v{font-size:2.25rem;font-weight:700;margin:.25rem 0;display:flex;gap:.75rem;align-items:center}
    .watch.bad .v{color:var(--ad-bad)} .watch.ok .v{color:var(--ad-ok)} .watch .v .pill{font-size:.8125rem}
    .watch .s{font-size:.8125rem;color:var(--ad-soft)}
    .dim{color:var(--ad-faint);font-size:.75rem} .warn{color:var(--ad-bad);font-weight:600}
    .err{color:var(--ad-bad);font-size:.75rem;max-width:22rem;word-break:break-word}
    .prog{height:.375rem;background:var(--ad-sunk);border-radius:999px;margin-top:.25rem;overflow:hidden} .prog i{display:block;height:100%;background:var(--ad-ok)}
    h2{font-size:1rem;margin:1.75rem 0 .375rem} table.plan{max-width:60rem}
  </style>
  <script is:inline>setTimeout(() => location.reload(), 60000);</script>
</AdminShell>
