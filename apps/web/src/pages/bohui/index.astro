---
/**
 * 后台首页 —— 仪表盘。
 *
 * 对照 WordPress 的「概览」与企业后台的 Dashboard:
 * 第一屏该回答三个问题 —— 现在有多少东西、哪里出了问题、下一步该做什么。
 * 之前只放了一张站点表,回答不了后两个,所以显得简陋。
 *
 * 「待办」区不是装饰:缺译文、缺 key、未收录这些状态如果不主动推到眼前,
 * 就会一直烂在那里 —— 多语站最常见的烂尾方式就是没人知道哪里缺。
 */
import { env } from 'cloudflare:workers';
import AdminShell from '../../layouts/AdminShell.astro';
import { readSession, readCookie, COOKIE } from '../../lib/auth';
import { getMissingTranslations } from '../../lib/db';
import { SITES, type SiteDef } from '@cosmetic/core/registry';

export const prerender = false;

const db = (env as any).DB as D1Database | undefined;
const secret = (env as any).AUTH_SECRET as string | undefined;
const sess = await readSession(readCookie(Astro.request.headers.get('cookie'), COOKIE), secret ?? '');

/** 未登录 → 独立登录页。登录表单不该混在仪表盘里,那会让未登录态也加载全部查询 */
if (!sess) return Astro.redirect('/bohui/login/');

const one = async (sql: string) => {
  try { return (await db!.prepare(sql).first<{ n: number }>())?.n ?? 0; } catch { return 0; }
};

const [nSites, nPages, nBlocks, nFormulas, nMedia, nInquiries, nStudio, nProviders, nProvKeys] = await Promise.all([
  one(`SELECT COUNT(*) n FROM sites`),
  one(`SELECT COUNT(*) n FROM pages`),
  one(`SELECT COUNT(*) n FROM blocks`),
  one(`SELECT COUNT(*) n FROM formulas`),
  one(`SELECT COUNT(*) n FROM media`),
  one(`SELECT COUNT(*) n FROM inquiries WHERE status='new'`),
  one(`SELECT COUNT(*) n FROM studio_sessions`),
  one(`SELECT COUNT(*) n FROM providers WHERE enabled=1`),
  one(`SELECT COUNT(*) n FROM providers WHERE enabled=1 AND api_keys<>''`),
]);

// 站点表 + 每站缺译文数
type Row = { id: string; variant: string; is_live: number; contact_email: string | null; contact_whatsapp: string | null; contact_wechat: string | null; pages: number; missing: number };
let rows: Row[] = [];
if (db) {
  const { results } = await db
    .prepare(`SELECT s.id, s.variant, s.is_live, s.contact_email, s.contact_whatsapp, s.contact_wechat,
                     (SELECT COUNT(*) FROM pages p WHERE p.site_id=s.id) AS pages
                FROM sites s ORDER BY s.sort_order`)
    .all<Omit<Row, 'missing'>>();
  for (const r of results ?? []) {
    rows.push({ ...r, missing: (await getMissingTranslations(db, r.id)).length });
  }
}
const byId = new Map(SITES.map((s) => [s.id, s]));
const totalMissing = rows.reduce((n, r) => n + r.missing, 0);
const notLive = rows.filter((r) => !r.is_live).length;

/* ── 经营数据(对标平台看板的最小闭环)────────────────────────
 * 三问:线索来得怎么样(趋势)、从哪来(来源页)、谁刚改了什么(修订)。
 * 全部服务端渲染,不引图表库 —— 14 根柱子一段 SVG 就够,
 * 后台加一个 chart.js 换来的是 200KB 依赖和一个新的供应链面。 */
const days: { d: string; n: number }[] = [];
{
  const byDay = new Map<string, number>();
  if (db) {
    const { results } = await db.prepare(
      `SELECT substr(created_at, 1, 10) d, COUNT(*) n FROM inquiries
        WHERE created_at >= datetime('now', '-14 days') GROUP BY d`,
    ).all<{ d: string; n: number }>().catch(() => ({ results: [] as any[] }));
    for (const r of results ?? []) byDay.set(r.d, r.n);
  }
  for (let i = 13; i >= 0; i--) {
    const d = new Date(Date.now() - i * 86400_000).toISOString().slice(0, 10);
    days.push({ d, n: byDay.get(d) ?? 0 });
  }
}
const trendMax = Math.max(1, ...days.map((x) => x.n));
const trendTotal = days.reduce((a, x) => a + x.n, 0);

const topSources = db
  ? ((await db.prepare(
      `SELECT source_path, COUNT(*) n FROM inquiries
        WHERE created_at >= datetime('now', '-30 days') AND source_path IS NOT NULL AND source_path <> ''
        GROUP BY source_path ORDER BY n DESC LIMIT 5`,
    ).all<{ source_path: string; n: number }>().catch(() => ({ results: [] as any[] }))).results ?? [])
  : [];

/* 行业资讯运营三数:总量 / 本周新增 / 浏览 Top3(热度排序的数据源同一处) */
const newsStat = {
  total: db ? ((await db.prepare(`SELECT COUNT(*) n FROM news WHERE is_published=1`).first<{ n: number }>().catch(() => null))?.n ?? 0) : 0,
  week: db ? ((await db.prepare(`SELECT COUNT(*) n FROM news WHERE is_published=1 AND published_at >= datetime('now','-7 days')`).first<{ n: number }>().catch(() => null))?.n ?? 0) : 0,
  top: db ? (((await db.prepare(`SELECT title_zh, views FROM news WHERE is_published=1 AND views>0 ORDER BY views DESC LIMIT 3`).all<any>().catch(() => ({ results: [] }))).results) ?? []) : [],
};

/* rl:* 是限流器借这张表记的访客 IP —— 不是内容修订,更不该在看板上展示 IP */
const recentRevs = db
  ? ((await db.prepare(
      `SELECT r.entity, r.entity_id, r.lang, r.created_at, u.email
         FROM revisions r LEFT JOIN users u ON u.id = r.user_id
        WHERE r.entity NOT LIKE 'rl:%' AND r.entity <> 'login_fail'
        ORDER BY r.id DESC LIMIT 5`,
    ).all<{ entity: string; entity_id: string; lang: string | null; created_at: string; email: string | null }>()
      .catch(() => ({ results: [] as any[] }))).results ?? [])
  : [];
const ENTITY_ZH: Record<string, string> = {
  blocks: '版块', block_i18n: '版块译文', pages: '页面', products: '产品',
  media: '媒体', sites: '站点', users: '账号', gateway_keys: 'AI 网关 Key',
  providers: '模型服务商', formulas: '配方', inquiries: '询盘',
  formula_projects: '配方需求单', formula_versions: '配方版本', formula_feedback: '打版结果',
};

/** 待办 —— 按「拦住业务的程度」排序,不按类型排 */
const todos: { level: 'bad' | 'warn'; text: string; href: string; cta: string }[] = [];
if (nProvKeys === 0) todos.push({ level: 'bad', text: `模型舰队 ${nProviders} 家都没配 API Key,AI 功能全部不可用`, href: '/bohui/models/', cta: '去配置' });
if (nFormulas > 0) todos.push({ level: 'warn', text: `配方库 ${nFormulas} 条全是样例数据,上线前必须替换为真实配方`, href: '/bohui/formulas/', cta: '查看' });
if (totalMissing > 0) todos.push({ level: 'warn', text: `${totalMissing} 个版块缺少部分语种译文,访客会看到英文回退`, href: '/bohui/pages/', cta: '去补齐' });
if (nMedia === 0) todos.push({ level: 'warn', text: '媒体库为空,页面用的还是占位素材', href: '/bohui/media/', cta: '去上传' });
if (notLive > 0) todos.push({ level: 'warn', text: `${notLive} 个站未开放收录(内容核实前的保护,核实后再开)`, href: '#', cta: '' });
---

<AdminShell title="仪表盘" active="sites" email={sess.email} badges={{ inquiries: nInquiries }}>
  <h1>仪表盘</h1>
  <p class="lead">帛卉化妆品 5 站矩阵 · 内容、配方、模型、线索都在这里管。</p>

  <div class="cards">
    <div class="card"><div class="k">站点</div><div class="v num">{nSites}</div><div class="s">共 {nPages} 个页面</div></div>
    <div class="card"><div class="k">内容版块</div><div class="v num">{nBlocks}</div><div class="s">跨全部语种</div></div>
    <div class="card"><div class="k">配方库</div><div class="v num">{nFormulas}</div><div class="s">AI 检索的依据</div></div>
    <div class="card"><div class="k">媒体</div><div class="v num">{nMedia}</div><div class="s">图片与视频</div></div>
    <div class:list={['card', nInquiries > 0 && 'ok']}><div class="k">待处理询盘</div><div class="v num">{nInquiries}</div><div class="s">共 {nStudio} 次 AI 共创</div></div>
    <div class:list={['card', nProvKeys === 0 && 'warn']}><div class="k">可用模型</div><div class="v num">{nProvKeys}<span style="font-size:.9rem;color:var(--ad-faint)"> / {nProviders}</span></div><div class="s">已配 key / 已启用</div></div>
  </div>

  <div class="panels">
    <section class="panel">
      <h2>询盘 · 近 14 天 <span class="hnum">{trendTotal} 条</span></h2>
      {/* 14 根柱子,当天在最右。0 条也画满灰底柱 —— 空白面板比 0 更让人疑心坏了 */}
      <svg viewBox="0 0 280 64" role="img" aria-label={`近 14 天询盘趋势,共 ${trendTotal} 条`} class="trend">
        {days.map((x, i) => {
          const h = Math.max(2, Math.round((x.n / trendMax) * 56));
          return <rect x={i * 20 + 3} y={62 - h} width="14" height={h}
                       rx="2" class={x.n > 0 ? 'bar on' : 'bar'}>
                   <title>{x.d}:{x.n} 条</title>
                 </rect>;
        })}
      </svg>
      <div class="axis"><span>{days[0].d.slice(5)}</span><span>今天</span></div>
      {trendTotal === 0 && <p class="empty">近 14 天暂无询盘 —— 站点刚开放收录,属正常冷启动期。</p>}
    </section>

    <section class="panel">
      <h2>询盘来源页 · 近 30 天</h2>
      {topSources.length ? (
        <table class="mini">
          <tbody>
            {topSources.map((s) => (
              <tr><td class="mono">{s.source_path}</td><td class="num" style="width:3.5rem">{s.n}</td></tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="empty">还没有带来源的询盘。哪个页面在带来生意,以后从这里看。</p>
      )}
    </section>

    <section class="panel">
      <h2>行业资讯 <a class="btn" style="float:right" href="/bohui/news/">管理</a></h2>
      {(() => { return null; })()}
      <table class="mini">
        <tbody>
          <tr><td>在线文章</td><td class="num" style="width:5rem">{newsStat.total}</td></tr>
          <tr><td>近 7 天新增</td><td class="num">{newsStat.week}</td></tr>
          {newsStat.top.map((n: any) => (
            <tr><td style="color:var(--ad-faint)">🔥 {n.title_zh}</td><td class="num">{n.views}</td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="panel">
      <h2>最近修订 <a class="btn" style="float:right" href="/bohui/log/">全部</a></h2>
      {recentRevs.length ? (
        <table class="mini">
          <tbody>
            {recentRevs.map((r) => (
              <tr>
                <td>{ENTITY_ZH[r.entity] ?? r.entity} <span class="mono">#{r.entity_id}</span>{r.lang && <span class="mono"> · {r.lang}</span>}</td>
                <td style="width:9.5rem;color:var(--ad-faint);font-size:.75rem">{(r.email ?? '系统').replace(/@.*$/, '')} · {r.created_at.slice(5, 16)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="empty">还没有内容修订记录。</p>
      )}
    </section>
  </div>

  {todos.length > 0 && (
    <>
      <h2 style="font-size:1rem;margin:0 0 .75rem">待办</h2>
      <table style="margin-bottom:1.75rem">
        <tbody>
          {todos.map((t) => (
            <tr>
              <td style="width:4.5rem">
                <span class:list={['pill', t.level === 'bad' ? 'p-bad' : 'p-warn']}>
                  {t.level === 'bad' ? '阻塞' : '待办'}
                </span>
              </td>
              <td>{t.text}</td>
              <td style="width:6rem;text-align:right">
                {t.cta && <a class="btn" href={t.href}>{t.cta}</a>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <h2 style="font-size:1rem;margin:0 0 .75rem">站点</h2>
  <table>
    <thead><tr>
      <th>站点</th><th style="width:13rem">模板 / 风格</th><th style="width:14rem">联系邮箱</th><th style="width:5rem">页面</th>
      <th style="width:6rem">缺译文</th><th style="width:6rem">收录</th><th style="width:11rem"></th>
    </tr></thead>
    <tbody>
      {rows.map((r) => {
        const def = byId.get(r.id) as SiteDef | undefined;
        return (
          <tr>
            <td>
              <div style="font-weight:600">{def?.name ?? r.id}</div>
              <div style="color:var(--ad-faint);font-size:.75rem;font-family:ui-monospace,monospace">{def?.domain}</div>
            </td>
            <td>
              <select data-site={r.id} class="tpl">
                {(def?.variants ?? []).map((v) => (
                  <option value={v.id} selected={v.id === r.variant}>{v.name}</option>
                ))}
              </select>
            </td>
            <td>
              {/* 全局联系方式后台化(创始人 2026-09-01):改完回车或点空白即存,
                  页脚/联系页/JSON-LD 全站跟着变;清空 = 回落 inquiry@域名 */}
              <input class="cmail" data-site={r.id} data-k="email" type="email" value={r.contact_email ?? ''}
                     placeholder={`inquiry@${def?.domain ?? ''}`} spellcheck="false"
                     style="width:100%;font-size:.8125rem;font-family:ui-monospace,monospace" />
              {/* WhatsApp / 微信:填了页脚就出 wa.me 链接和微信号,Organization schema 同步带 telephone(2026-09-16) */}
              <input class="cmail" data-site={r.id} data-k="whatsapp" type="tel" value={r.contact_whatsapp ?? ''}
                     placeholder="WhatsApp 带国家码,如 +60 12 345 6789" spellcheck="false"
                     style="width:100%;font-size:.8125rem;font-family:ui-monospace,monospace;margin-top:.25rem" />
              <input class="cmail" data-site={r.id} data-k="wechat" type="text" value={r.contact_wechat ?? ''}
                     placeholder="微信号(页脚显示 WeChat: xxx)" spellcheck="false"
                     style="width:100%;font-size:.8125rem;font-family:ui-monospace,monospace;margin-top:.25rem" />
            </td>
            <td class="num">{r.pages}</td>
            <td class="num" style={r.missing ? 'color:var(--ad-warn);font-weight:600' : 'color:var(--ad-ok)'}>
              {r.missing || '齐全'}
            </td>
            <td>{r.is_live ? <span class="pill p-ok">已开放</span> : <span class="pill p-wait">未收录</span>}</td>
            <td style="text-align:right">
              <a class="btn" href={`/zh-cn/?site=${r.id}`} target="_blank">前台</a>
              <a class="btn" href={`/bohui/pages/?site=${r.id}`}>编辑内容</a>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>

  <script is:inline>
    document.querySelectorAll('input.cmail').forEach((inp) => {
      inp.addEventListener('change', async () => {
        inp.disabled = true;
        const r = await fetch('/api/admin/site-contact', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ site: inp.dataset.site, [inp.dataset.k || 'email']: inp.value.trim() }),
        }).then((x) => x.json()).catch(() => ({ ok: false }));
        inp.disabled = false;
        if (!r.ok) alert(r.msg || '保存失败,请重试');
        else { inp.style.borderColor = 'var(--ad-ok, #2e7d32)'; setTimeout(() => (inp.style.borderColor = ''), 1500); }
      });
    });
    document.querySelectorAll('select.tpl').forEach((s) => {
      s.addEventListener('change', async () => {
        s.disabled = true;
        const r = await fetch('/api/admin/site-variant', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ site: s.dataset.site, variant: s.value }),
        });
        s.disabled = false;
        if (!r.ok) alert('保存失败,请重试');
      });
    });
  </script>
</AdminShell>

<style>
  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .panel {
    background: var(--ad-panel);
    border: 1px solid var(--ad-line);
    border-radius: var(--ad-r);
    box-shadow: var(--ad-shadow);
    padding: 1rem 1.125rem 1.125rem;
  }
  .panel h2 { font-size: 0.9375rem; margin: 0 0 0.75rem; }
  .hnum { color: var(--ad-faint); font-weight: 400; font-size: max(0.8125rem, 14px); }
  .trend { width: 100%; height: auto; display: block; }
  .bar { fill: var(--ad-line); }
  .bar.on { fill: var(--ad-accent); }
  .axis {
    display: flex; justify-content: space-between;
    font-size: max(0.6875rem, 14px); color: var(--ad-faint); margin-top: 0.25rem;
  }
  .empty { color: var(--ad-faint); font-size: max(0.8125rem, 14px); margin: 0.5rem 0 0; }
  table.mini { width: 100%; border-collapse: collapse; }
  table.mini td { padding: 0.375rem 0; border-bottom: 1px solid var(--ad-line-soft); font-size: max(0.8125rem, 14px); }
  table.mini tr:last-child td { border-bottom: 0; }
  .mono { font-family: ui-monospace, monospace; font-size: max(0.75rem, 14px); color: var(--ad-faint); }
</style>
