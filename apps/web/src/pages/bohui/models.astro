---
/**
 * 后台 · 模型舰队(可自行配置)
 *
 * 设计要点:
 *  · 数据来自 D1 的 providers 表,不是环境变量 —— 加一家模型不必改代码重部署;
 *  · **key 只写不读**:表格里只显示"配了几个",不提供查看原值的路径;
 *  · 第一屏就是体检 —— 古方线曾因配错 base 整批 0 产出却无人察觉,空转很久才发现。
 */
import { env } from 'cloudflare:workers';
import AdminShell from '../../layouts/AdminShell.astro';
import { readSession, readCookie, COOKIE } from '../../lib/auth';

export const prerender = false;

const db = (env as any).DB as D1Database | undefined;
const secret = (env as any).AUTH_SECRET as string | undefined;
const sess = await readSession(readCookie(Astro.request.headers.get('cookie'), COOKIE), secret ?? '');
if (!sess) return Astro.redirect('/bohui/login/');

type Row = {
  id: string; label: string; base_url: string; model: string; tier: number;
  can_image: number; can_video: number; is_free: number; enabled: number; nkeys: number;
};
let rows: Row[] = [];
if (db) {
  const { results } = await db
    .prepare(
      `SELECT id,label,base_url,model,tier,can_image,can_video,is_free,enabled,
              CASE WHEN api_keys='' THEN 0
                   ELSE LENGTH(api_keys)-LENGTH(REPLACE(api_keys,',',''))+1 END AS nkeys
         FROM providers ORDER BY tier, id`,
    )
    .all<Row>();
  rows = results ?? [];
}
const ready = rows.filter((r) => r.enabled && r.nkeys > 0);
const imageReady = ready.filter((r) => r.can_image).length;
---

<AdminShell title="模型舰队" active="models" email={sess.email}>
    <h1>模型舰队</h1>
    <p class="lead">
      共 <strong>{rows.length}</strong> 家,其中 <strong>{ready.length}</strong> 家已配 key 可用。
      分档降级:档位小的先用,失败自动切下一档,业务代码不感知。
      同一家可填多个 key(逗号分隔)轮询使用。
      <strong>加一家新模型不需要改代码</strong> —— 在下方表单里填完即生效。
    </p>

    {ready.length > 0 && imageReady < 2 && (
      <div class="warnbox">
        <strong>单点风险:</strong>具备出图能力且已配 key 的只有 {imageReady} 家。
        文本已有 {ready.length} 档冗余,图像链路一旦这家限流就整体中断 —— 建议尽快再接一家出图源。
      </div>
    )}
    {ready.length === 0 && (
      <div class="warnbox">还没有任何一家配了 key。在下面填上 key 后,AI 功能才会启用。</div>
    )}

    <table>
      <thead><tr>
        <th style="width:5rem">档位</th><th style="width:9rem">名称</th><th>接口地址</th>
        <th style="width:12rem">模型</th><th style="width:12rem">API Key</th>
        <th style="width:7rem">能力</th><th style="width:11rem">操作</th>
      </tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr class={r.enabled ? '' : 'off'} data-row={r.id}>
            <td><input class="num" name="tier" type="number" value={r.tier} /></td>
            <td><input name="label" value={r.label} /></td>
            <td><input name="base_url" value={r.base_url} /></td>
            <td><input name="model" value={r.model} /></td>
            <td>
              <input class="k" name="api_keys" type="password" autocomplete="off"
                     placeholder={r.nkeys ? `已配 ${r.nkeys} 个 · 留空不改` : '未配置'} />
            </td>
            <td>
              {r.is_free ? <span class="pill p-free">免费</span> : null}
              {r.can_image ? <span class="pill p-free">图</span> : null}
              {r.can_video ? <span class="pill p-free">视频</span> : null}
            </td>
            <td>
              <button class="btn pri" data-save={r.id}>保存</button>
              <button class="btn" data-toggle={r.id}>{r.enabled ? '停用' : '启用'}</button>
              <button class="btn" data-ping={r.id}>体检</button>
              <span data-res={r.id}></span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <section class="add">
      <strong>新增供应商</strong>
      <p class="lead" style="margin:.5rem 0 0">
        任何兼容 OpenAI 接口的厂商都能加。<code>接口地址</code>填到 <code>/v1</code> 为止 ——
        <strong>不要再往后拼版本号</strong>,拼了会变成双路径 404、整批空转。
      </p>
      <div class="grid">
        <label class="fld"><span>id(小写)</span><input id="n-id" placeholder="moonshot" /></label>
        <label class="fld"><span>名称</span><input id="n-label" placeholder="月之暗面" /></label>
        <label class="fld"><span>接口地址</span><input id="n-base" placeholder="https://api.moonshot.cn/v1" /></label>
        <label class="fld"><span>模型</span><input id="n-model" placeholder="moonshot-v1-8k" /></label>
        <label class="fld"><span>API Key</span><input id="n-keys" type="password" autocomplete="off" /></label>
        <label class="fld"><span>档位</span><input id="n-tier" type="number" value="10" /></label>
      </div>
      <p style="margin-top:.75rem;display:flex;gap:1rem;align-items:center;flex-wrap:wrap">
        <label><input type="checkbox" id="n-free" /> 免费</label>
        <label><input type="checkbox" id="n-img" /> 可出图</label>
        <label><input type="checkbox" id="n-vid" /> 可出视频</label>
        <button class="btn pri" id="n-add">新增</button>
        <span id="n-msg" style="color:var(--faint);font-size:.8125rem"></span>
      </p>
    </section>

  <style>
    .warnbox{margin:1.25rem 0;padding:.875rem 1.125rem;border:1px dashed var(--warn);border-radius:8px;
             color:var(--warn);font-size:.875rem;background:#fffdf7}
    input.k{font-family:ui-monospace,monospace}
    tr.off{opacity:.45}
    .p-free{background:#e8eff6;color:var(--accent)}
    code{background:#f1f2f4;padding:.0625rem .3125rem;border-radius:4px;font-size:.8125rem}
    .add{margin-top:1.5rem;padding:1.25rem;background:var(--panel);border:1px solid var(--line);border-radius:10px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.75rem;margin-top:.75rem}
    .fld{display:grid;gap:.25rem} .fld span{font-size:.75rem;color:var(--faint)}
    .add label input[type=checkbox]{width:auto;margin-right:.25rem}
  </style>

  <script is:inline>
    const post = (b) => fetch('/api/admin/provider', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(b),
    }).then((r) => r.json());

    document.querySelectorAll('[data-save]').forEach((b) => b.addEventListener('click', async () => {
      const id = b.dataset.save;
      const tr = document.querySelector(`[data-row="${id}"]`);
      const v = (n) => tr.querySelector(`[name="${n}"]`).value;
      b.disabled = true;
      const d = await post({ id, label: v('label'), base_url: v('base_url'), model: v('model'),
                             api_keys: v('api_keys'), tier: Number(v('tier')) });
      b.disabled = false;
      if (d.ok) { tr.querySelector('[name=api_keys]').value = ''; location.reload(); }
      else alert(d.msg || '保存失败');
    }));

    document.querySelectorAll('[data-toggle]').forEach((b) => b.addEventListener('click', async () => {
      await post({ id: b.dataset.toggle, action: 'toggle' }); location.reload();
    }));

    document.querySelectorAll('[data-ping]').forEach((b) => b.addEventListener('click', async () => {
      const id = b.dataset.ping, out = document.querySelector(`[data-res="${id}"]`);
      b.disabled = true; out.textContent = ' 检测中…';
      try {
        const d = await (await fetch('/api/admin/fleet-health?id=' + encodeURIComponent(id))).json();
        const x = (d.list || []).find((y) => y.id === id);
        out.innerHTML = x ? ` <span class="pill ${x.ok ? 'p-ok' : 'p-bad'}">${x.note}</span> <span class="num" style="color:var(--faint)">${x.ms}ms</span>`
                          : ' <span class="pill p-bad">未配 key</span>';
      } catch { out.innerHTML = ' <span class="pill p-bad">请求失败</span>'; }
      b.disabled = false;
    }));

    document.getElementById('n-add').addEventListener('click', async () => {
      const g = (i) => document.getElementById(i).value.trim();
      const c = (i) => document.getElementById(i).checked;
      const msg = document.getElementById('n-msg');
      const d = await post({ id: g('n-id'), label: g('n-label'), base_url: g('n-base'), model: g('n-model'),
                             api_keys: g('n-keys'), tier: Number(g('n-tier') || 10),
                             is_free: c('n-free'), can_image: c('n-img'), can_video: c('n-vid') });
      if (d.ok) location.reload(); else msg.textContent = d.msg || '新增失败';
    });
  </script>
</AdminShell>
