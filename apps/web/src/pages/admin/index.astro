---
/**
 * 帛卉后台 —— 纯中文界面。
 *
 * 与创始人评价「惨不忍睹」的那个原型的区别,在于结构而不是皮肤:
 *  · 那个只有一张扁平 content 表,所以后台只能改字;
 *  · 这里是 站点 → 页面(两级) → 版块 → 多语言 四层,所以能管页面、管版块顺序、管译文完整度。
 *
 * 本页只做「总览 + 换模板」,编辑器在 /admin/page/[id]。
 * 刻意不做单页大而全:一屏塞满反而找不到东西 —— 这正是原型难用的地方。
 */
import { env } from 'cloudflare:workers';
import { readSession, readCookie, COOKIE } from '../../lib/auth';
import { LANGS, LANG_LABEL, getMissingTranslations } from '../../lib/db';
import { SITES, type SiteDef } from '@cosmetic/core/registry';

export const prerender = false;

const db = (env as any).DB as D1Database | undefined;
const secret = (env as any).AUTH_SECRET as string | undefined;
const sess = await readSession(readCookie(Astro.request.headers.get('cookie'), COOKIE), secret ?? '');

let rows: { id: string; variant: string; is_live: number; pages: number; missing: number }[] = [];
if (sess && db) {
  const { results } = await db
    .prepare(
      `SELECT s.id, s.variant, s.is_live,
              (SELECT COUNT(*) FROM pages p WHERE p.site_id = s.id) AS pages
         FROM sites s ORDER BY s.sort_order`,
    )
    .all<{ id: string; variant: string; is_live: number; pages: number }>();
  for (const r of results ?? []) {
    const miss = await getMissingTranslations(db, r.id);
    rows.push({ ...r, missing: miss.length });
  }
}

const byId = new Map(SITES.map((s) => [s.id, s]));
---

<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>帛卉后台</title>
  <style>
    :root {
      --bg: #f6f7f9; --panel: #fff; --ink: #10131a; --soft: #5b6472; --faint: #858d99;
      --line: #e3e7ec; --accent: #1f4e79; --ok: #197a4b; --warn: #9a5b00;
      font-family: system-ui, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); font-size: 15px; }
    .top { background: var(--panel); border-bottom: 1px solid var(--line); }
    .wrap { max-width: 76rem; margin: auto; padding: 0 1.5rem; }
    .bar { display: flex; align-items: center; gap: 1rem; height: 3.75rem; }
    .logo { font-weight: 700; letter-spacing: .04em; }
    .sp { flex: 1; }
    .btn { font: inherit; cursor: pointer; border: 1px solid var(--line); background: var(--panel);
           padding: .5rem .875rem; border-radius: 6px; color: var(--ink); text-decoration: none; }
    .btn.pri { background: var(--accent); color: #fff; border-color: var(--accent); }
    main { padding: 2rem 0 4rem; }
    h1 { font-size: 1.375rem; margin: 0 0 .375rem; }
    .lead { color: var(--soft); margin: 0 0 1.75rem; font-size: .9375rem; }
    table { width: 100%; border-collapse: collapse; background: var(--panel);
            border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
    th, td { text-align: left; padding: .875rem 1rem; border-bottom: 1px solid var(--line); }
    th { font-size: .75rem; color: var(--faint); font-weight: 600; letter-spacing: .06em; background: #fafbfc; }
    tr:last-child td { border-bottom: 0; }
    .name { font-weight: 600; }
    .dom { color: var(--faint); font-size: .8125rem; font-family: ui-monospace, monospace; }
    select { font: inherit; padding: .4375rem .5rem; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
    .pill { display: inline-block; padding: .125rem .5rem; border-radius: 999px; font-size: .75rem; }
    .pill.live { background: #e6f4ec; color: var(--ok); }
    .pill.draft { background: #fdf1e0; color: var(--warn); }
    .num { font-variant-numeric: tabular-nums; }
    .miss0 { color: var(--ok); }
    .missN { color: var(--warn); font-weight: 600; }

    /* 登录 */
    .login { max-width: 22rem; margin: 12vh auto; background: var(--panel);
             border: 1px solid var(--line); border-radius: 12px; padding: 2rem; }
    .fld { display: grid; gap: .375rem; margin-bottom: 1rem; }
    .fld span { font-size: .8125rem; color: var(--soft); }
    .fld input { font: inherit; padding: .625rem .75rem; border: 1px solid var(--line); border-radius: 6px; }
    .err { color: #b3261e; font-size: .8125rem; min-height: 1.2em; margin-bottom: .5rem; }
  </style>
</head>
<body>

{!sess ? (
  <div class="login">
    <h1>帛卉后台</h1>
    <p class="lead">请登录</p>
    <form id="f">
      <label class="fld"><span>邮箱</span><input name="email" type="email" required autocomplete="username" /></label>
      <label class="fld"><span>口令</span><input name="password" type="password" required autocomplete="current-password" /></label>
      <p class="err" id="err"></p>
      <button class="btn pri" style="width:100%" type="submit">登录</button>
    </form>
    <script is:inline>
      document.getElementById('f').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const r = await fetch('/api/admin/login', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: fd.get('email'), password: fd.get('password') }),
        });
        const d = await r.json().catch(() => ({}));
        if (d.ok) location.reload();
        else document.getElementById('err').textContent = d.msg || '登录失败';
      });
    </script>
  </div>
) : (
  <>
    <header class="top"><div class="wrap bar">
      <span class="logo">帛卉后台</span>
      <span class="sp"></span>
      <span style="color:var(--faint);font-size:.8125rem">{sess.email}</span>
      <button class="btn" id="out">退出</button>
    </div></header>

    <main class="wrap">
      <h1>站点总览</h1>
      <p class="lead">
        共 {rows.length} 个站点。「缺译文」列显示还有多少个版块没有全部语种 ——
        这是四语以上站点最容易烂尾的地方,所以放在第一屏。
      </p>

      <table>
        <thead><tr>
          <th>站点</th><th>模板 / 风格</th><th>页面</th><th>缺译文</th><th>收录</th><th></th>
        </tr></thead>
        <tbody>
          {rows.map((r) => {
            const def = byId.get(r.id) as SiteDef | undefined;
            return (
              <tr>
                <td>
                  <div class="name">{def?.name ?? r.id}</div>
                  <div class="dom">{def?.domain}</div>
                </td>
                <td>
                  <select data-site={r.id} class="tpl">
                    {(def?.variants ?? []).map((v) => (
                      <option value={v.id} selected={v.id === r.variant}>{v.name} · {v.ref.split('/')[0].trim()}</option>
                    ))}
                  </select>
                </td>
                <td class="num">{r.pages}</td>
                <td class={r.missing ? 'missN' : 'miss0'}>{r.missing ? `${r.missing} 处` : '齐全'}</td>
                <td>
                  {r.is_live ? <span class="pill live">已开放</span> : <span class="pill draft">未收录</span>}
                </td>
                <td><a class="btn" href={`/zh-cn/?site=${r.id}`} target="_blank">查看前台</a></td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <p class="lead" style="margin-top:1.25rem">
        换模板即时生效:选中即写入数据库,前台刷新就是新风格,不需要重新构建。
      </p>
    </main>

    <script is:inline>
      document.getElementById('out').addEventListener('click', async () => {
        await fetch('/api/admin/login', { method: 'DELETE' });
        location.reload();
      });
      document.querySelectorAll('select.tpl').forEach((s) => {
        s.addEventListener('change', async () => {
          s.disabled = true;
          const r = await fetch('/api/admin/site-variant', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ site: s.dataset.site, variant: s.value }),
          });
          s.disabled = false;
          if (!r.ok) alert('保存失败,请重试');
        });
      });
    </script>
  </>
)}

</body>
</html>
