const db = (env as any)?.DB as D1Database | undefined;

/* ── 解析语言与路径 ───────────────────────────────────────────── */
const raw = (Astro.params.path ?? '').replace(/^\/+|\/+$/g, '');
const segs = raw ? raw.split('/') : [];
/*
 * 这里判的是 isLocale(**已上线**的 6 种)而不是 isLang(库里能存的 36 种)。
 * 两张表各管一件事,不该混:
 *   i18n/LOCALES —— 对外公布哪几种语言:决定下拉里有谁、hreflang 指向谁、地区自动跳到谁。
 *   db.ts/LANGS  —— 库里允许存哪几种译文:后台可以提前把德语翻好再决定上不上线。
 * 混用的后果是实打实的:/de/ 会渲染出一个没有 hreflang、UI 骨架取不到词条的半成品页,
 * 既让搜索引擎收进重复内容,又直接 500(ui['de'] 是 undefined)。
 * 判 isLocale 之后,/de/ 会被当成普通路径,查无此页 → 正常 404,这才是对的。
 */
const lang: Lang = isLocale(segs[0]) ? (segs.shift() as Lang) : DEFAULT_LANG;
/** 无障碍跳转链接的文案 —— 以前写死中文,外语版第一个 Tab 停在一句中文上 */
const tSkip = uiT(lang as any)('a11y.skip');
const slug = segs.join('/');

/* ── 解析站点:线上按域名;预览域名/本地按 ?site= 回退 ───────────
 *
 * ?site= 必须**粘住**,不能只作用于当前这一次请求。
 * 原因是实测踩出来的:在预览域名上带 ?site=biosphere-ai 打开首页没问题,
 * 但页面里所有链接的 href 都是 /zh-cn/about/ —— 不带参数。
 * 一点导航,Worker 就退回按域名判站,而预览域名不属于任何站,
 * 于是掉进兜底的 beauty2oem。用户看到的是「点一下就跳到别的网站」。
 *
 * 解法是把选择记进 cookie:域名能判出站时**永远以域名为准**(线上不受影响),
 * 判不出来时才读 cookie。所以这段逻辑只在预览域名和本地生效。
 */
const hostname = Astro.url.hostname;
const COOKIE = 'bohui_site';
const override = Astro.url.searchParams.get('site') ?? Astro.cookies.get(COOKIE)?.value ?? null;
if (Astro.url.searchParams.get('site')) {
  Astro.cookies.set(COOKIE, Astro.url.searchParams.get('site')!, {
    path: '/', httpOnly: true, sameSite: 'lax', maxAge: 60 * 60 * 24,
  });
}

let bundle = null;
let dbError: string | null = null;
/* 额度用尽和「没绑数据库」是两码事,给客户看的话也完全不同 —— 分开判 */
let quotaHit = false;

if (!db) {
  dbError = 'D1 未绑定(本地开发请用 wrangler pages dev,或在 Pages 项目里绑定 DB)';
} else {
  try {
    // 域名优先。cookie 只在域名判不出站时才用得上 ——
    // 否则一个访客在预览域名选过 biosphere-ai,再去 beauty2oem.com
    // 就会看到错的站,那是比"点击跳站"严重得多的故障。
    const byHost = await getSiteByHost(db, hostname, lang);
    const site = byHost
      ?? (override ? await getSiteById(db, override, lang) : null)
      /* 兜底按域名回到本站,绝不硬编码别的站(2026-09-07 跨站串标题事故) */
      ?? (siteIdForHost(Astro.url.hostname) ? await getSiteById(db, siteIdForHost(Astro.url.hostname)!, lang) : null);
    /* A9 草稿预览:只有带 ?draft= 且已登录后台的人才看草稿(draft 不进边缘缓存键,不会漏给访客) */
    const withDraft = Astro.url.searchParams.has('draft')
      && !!(await readSession(readCookie(Astro.request.headers.get('cookie'), ADMIN_COOKIE), (env as any)?.AUTH_SECRET ?? '').catch(() => null));
    if (site) bundle = await getPageBundle(db, site.id, slug, lang, { withDraft });
  } catch (e) {
    dbError = e instanceof Error ? e.message : String(e);
    quotaHit = /daily row read limit|exceeded .*limit|7500/i.test(dbError);
    /* 503 而不是 200:错误页以 200 返回时会被边缘缓存整整一小时,
       一次十分钟的抖动因此变成一个多小时的「整站坏掉」——
       2026-09-07 就是这么让创始人看到坏页面而我这边一切正常的。
       503 + Retry-After 也告诉搜索引擎「稍后再来」,而不是把错误页当正文收录。 */
    Astro.response.status = 503;
    Astro.response.headers.set('x-bh-degraded', '1');
    Astro.response.headers.set('Cache-Control', 'no-store');
    Astro.response.headers.set('Retry-After', '1800');
  }
}

if (!bundle && !dbError) {
  return new Response(null, { status: 404, headers: { 'x-bohui-reason': `no page: ${slug || '(home)'}` } });
}

/* ── 渲染参数 ─────────────────────────────────────────────────── */
