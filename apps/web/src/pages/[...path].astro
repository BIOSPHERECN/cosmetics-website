/**
 * 界面文案回退 —— 文案表只覆盖部分语种(内容可以逐步翻译,界面不能等)。
 * 直接 TEXT[lang] 在未覆盖的语种上会取到 undefined,随后 .title 抛错整页 500。
 * 这类错误只在小语种访客身上出现,最难被发现,所以统一走这个函数。
 */
const pick = <T,>(m: Record<string, T>, l: string): T => m[l] ?? m.en ?? m['zh-cn'];

/* 缓存由中间件统一接管(21600s = 6h):省钱第一。整改后要即时生效就走 CF 后台清缓存,
   绝不在路由里写短 TTL —— 短 TTL = AI 爬虫高频回源 = D1 烧钱(用户 2026-10-23 明确否决)。 */

/* ── 剂型清单 ──────────────────────────────────────────────
 * 这份清单原来是**硬编码**在本文件里的中文常量,后果很具体:
 * 英文访客打开产品页,看到的是「精华液 / 水感或油感基质 / MOQ 3,000 支起」——
 * 整段中文。翻译管线只处理数据库里的内容,碰不到代码里的字符串。
 * 而那些 MOQ 数字还是编的:公司资料写的是「柔性起订量」,没有具体值。
 *
 * 改成从版块读:运营能在后台改,翻译能自动跟上,数字也回到资料的口径。
 * 版块缺失时才退回本文件顶部的兜底常量(至少不是空白页)。
 */
/* ── 真实产品目录 ──────────────────────────────────────────
 * 后台的产品管理写的是 products 表,而这一页原来只渲染「可做剂型」——
 * 结果运营辛苦录进去的产品在前台一个都看不到,那个功能等于死路。
 *
 * 两者是不同的东西,所以并列展示而不是二选一:
 *   剂型  = 我们能做什么(询盘车按这个下单)
 *   产品  = 具体的成品 SKU,有图有规格
 * 产品表为空时这一段整个不出现 —— 空标题下面顶着一片留白最难看。
 */
/* 品类筛选:首页品类卡点进来带 ?cat=,这一页就只显示那个品类。
   「要可以点进去,看到更多的产品」—— 点进来还是全量列表的话,
   点击就没有意义了。筛选放在 SQL 里而不是渲染层,列表大了也不用改。 */
const catFilterRaw = (Astro.url.searchParams.get('cat') ?? '').trim().slice(0, 24);
/* 旧大类 skincare 已拆成 6 个细分(2026-10-23),老链接视同全部 */
const catFilter = catFilterRaw === 'skincare' ? '' : catFilterRaw;
const catalog = bundle?.page.template === 'products' && db && site
  ? ((await db.prepare(
      /* 列必须显式写死,**不要改成 p.*** ——
         products 表里有 internal_note 一列,存的是「哪些话不能对外说」的合规提醒
         和未经第三方验证的内部研发数字(SPF 提升 64%、修复 +19.07% 之类)。
         写成 p.* 就等于把它们送进渲染层,只差有人加一行显示。 */
      `SELECT p.id, p.slug, p.moq, p.cover_media, p.category,
              (SELECT x.name    FROM product_i18n x WHERE x.product_id=p.id
                ORDER BY CASE x.lang WHEN ? THEN 0 WHEN 'en' THEN 1 ELSE 2 END LIMIT 1) AS name,
              (SELECT x.summary FROM product_i18n x WHERE x.product_id=p.id
                ORDER BY CASE x.lang WHEN ? THEN 0 WHEN 'en' THEN 1 ELSE 2 END LIMIT 1) AS summary
         FROM products p
        WHERE p.site_id = ? AND p.status = 'published'
          AND (? = '' OR p.category = ?)
        ORDER BY p.is_featured DESC, p.sort_order, p.id LIMIT 60`,
    ).bind(lang, lang, site.id, catFilter, catFilter).all<any>().catch(() => ({ results: [] }))).results ?? [])
  : [];

/* 品类项圈(chips):只列**真有产品**的品类并带数量 ——
   点下去是空结果的筛选项,没人会用第二次。 */
/* 原来只在产品页查(筛选条用);创始人:「导航栏产品品类也下拉分类!」——
   顶部导航每页都在,品类清单改为全页可用(一条 GROUP BY,开销可忽略) */
const catCounts = db && site
  ? await memo(`prod-cats5:${site.id}`, 3600, async () => {
      /* C1 纪律:访客路由不写 COUNT/GROUP BY。取品类列在 JS 里聚合(行数有限,已 memo 1h) */
      const rows = ((await db.prepare(
        `SELECT category FROM products WHERE site_id = ? AND status = 'published'`,
      ).bind(site.id).all<any>().catch(() => ({ results: [] }))).results ?? []) as any[];
      const m = new Map<string, number>();
      for (const r of rows) m.set(r.category, (m.get(r.category) ?? 0) + 1);
      return [...m.entries()].map(([category, n]) => ({ category, n })).sort((a, b) => b.n - a.n);
    })
  : [];
/* 首页产品展示:跨品类轮取+去重(同一基础产品只取1款),避免单调;查60个JS端去重后取14+判断 */
const showcaseData = (!slug && db && site && site.id === 'biosphere-ai')
  ? await memo(`showcase10:${site.id}:${lang}`, 3600, async () => {
      const raw = ((await db.prepare(
        `SELECT id, slug, cover_media, category, name, rn FROM (
            SELECT p.id, p.slug, p.cover_media, p.category,
                   ROW_NUMBER() OVER (PARTITION BY p.category ORDER BY p.sort_order) as rn,
                   (SELECT x.name FROM product_i18n x WHERE x.product_id=p.id
                    ORDER BY CASE x.lang WHEN ? THEN 0 WHEN 'en' THEN 1 ELSE 2 END LIMIT 1) AS name
              FROM products p
             WHERE p.site_id = ? AND p.status = 'published' AND p.is_showcase = 1
          ) WHERE rn <= 10 ORDER BY rn, category LIMIT 60`
      ).bind(lang, site.id).all<any>().catch(() => ({ results: [] }))).results ?? []);
      /* JS 端按基础 slug 去重:循环剥掉所有尾部纯数字段(-2,-3,-7-2 等),
         100g/25g/4x 等带字母的不动,同款只留1个 */
      const seen = new Set<string>();
      const items = raw.filter((p: any) => {
        let base = String(p.slug);
        while (/-\d+$/.test(base)) base = base.replace(/-\d+$/, '');
        if (seen.has(base)) return false;
        seen.add(base);
        return true;
      }).slice(0, 15);
      return { items, hasMore: items.length > 14 };
    })
  : { items: [], hasMore: false };

const CAT_LABEL: Record<string, Record<string, string>> = {
  'zh-cn': { skincare: '护肤', makeup: '彩妆', oral: '口腔护理', kids: '儿童护肤', body: '身体护理', hair: '洗护', haircare: '洗护', cleansing: '洁护', suncare: '防晒', fragrance: '香氛', cleanser: '洁面', toner: '爽肤水', serum: '精华', cream: '面霜乳液', mask: '面膜', 'special-care': '特护', pet: '宠物护理', all: '全部' },
  en: { skincare: 'Skincare', makeup: 'Makeup', oral: 'Oral care', kids: 'Kids', body: 'Body care', hair: 'Hair', haircare: 'Hair care', cleansing: 'Cleansing', suncare: 'Suncare', fragrance: 'Fragrance', cleanser: 'Cleansers', toner: 'Toners', serum: 'Serums', cream: 'Creams & Lotions', mask: 'Masks', 'special-care': 'Special care', pet: 'Pet care', all: 'All' },
};
const catLabel = (c: string) => (CAT_LABEL[lang] ?? CAT_LABEL.en)[c] ?? c;

/* 顶部导航版:给「产品品类」挂品类下拉(有产品的品类才进菜单,空筛选没人点第二次)。
   子项 slug 带查询串(portfolio/?cat=x),SiteHeader 对含 ? 的 slug 走免尾斜杠直链。 */
const navForHeader = (bundle?.nav ?? []).map((n: any) =>
  (n.slug === 'products' || n.slug === 'portfolio') && !(n.children?.length) && catCounts.length
    ? { ...n, children: catCounts.slice(0, 6).map((c) => ({ slug: `portfolio/?cat=${encodeURIComponent(c.category)}`, label: catLabel(c.category) })) }
    : n);

/* ── 产品集模式 ────────────────────────────────────────────
 * 带 ?cat= 进来 = 访客刚点了品类卡,他要的是**这个品类的产品**。
 * 原来点进来落在页面顶部,又是同一套「可做品类 + 时效 + FAQ」营销块,
 * 真正的目录埋在半页之下 ——「点击品类,要进入产品集」说的就是这个。
 * 所以带 ?cat 时营销版块整体让位,页面只剩:
 *   品类页头(h1)→ 品类项圈 → 产品目录 → 可做剂型(询盘车)→ 询盘带。
 * 询盘带单独捞出来是因为它是转化出口,砍营销块不能把它一起砍掉。 */
const collectionMode = bundle?.page.template === 'products' && !!catFilter;
/* 09-21 22:3x 工厂版首页改成七种 fx_* 版块(见 packages/core/src/blocks.ts family='factory'),首页每一行都在后台加 / 删 / 排 / 换图;整体组件 HomeFactory 已退役。 */
const inquiryBlock = collectionMode
  ? bundle?.blocks.find((b) => b.type === 'inquiry')
  : undefined;

const formatBlock = bundle?.blocks.find((b) => b.type === 'formats');
const formatItems = Array.isArray((formatBlock?.data as any)?.items) && (formatBlock!.data as any).items.length
  ? (formatBlock!.data as any).items
  : DEMO_PRODUCTS;

/* ── 结构化数据 ────────────────────────────────────────────
   给搜索引擎出富摘要,也给 AI 答案引擎取事实。
   只放页面上真实存在的内容 —— 结构化数据和正文对不上会被判为 spam。 */
const base0 = `https://${site?.domain ?? 'bohui.group'}`;
const trail = slug
  ? slug.split('/').map((seg, i, arr) => {
      const href = `/${lang}/${arr.slice(0, i + 1).join('/')}/`;
      const node = bundle?.nav.find((n) => n.slug === arr[i])
        ?? bundle?.nav.flatMap((n) => n.children).find((c) => c.slug === arr[i]);
      return { label: node?.label ?? seg, href };
    })
  : [];
/* FAQ 来自页面上真实存在的「开头直答」版块 —— 不凭空造。
   结构化数据里写页面上没有的内容,搜索引擎判为 spam,得不偿失。 */
const zhPage = lang.startsWith('zh');
const complyA = (a: string) => rewriteHeldCertAnswer(a, zhPage);
const faqItems = (bundle?.blocks ?? [])
  .filter((b) => b.type === 'answer')
  .flatMap((b) => {
    const d = b.data as any;
    const own = d?.question && d?.answer ? [{ q: String(d.question), a: complyA(String(d.answer)) }] : [];
    const more = Array.isArray(d?.faqs)
      ? d.faqs.filter((f: any) => f?.q && f?.a).map((f: any) => ({ q: String(f.q), a: complyA(String(f.a)) }))
      : [];
    return [...own, ...more];
  });

/* 首页 title/description:CMS 里已经写明工厂/代工的语种保持原句。
   仍是「AI platform」的译文换成与 /llms.txt、Organization 同一口径的 OEM 句。 */
const pageSeo = (site?.id === 'biosphere-ai' && !slug && bundle)
  ? homeSeo(lang, bundle.page.title, bundle.page.seo_desc)
  : { title: bundle?.page.title ?? '', description: bundle?.page.seo_desc ?? '' };

/* Organization 由 BaseLayout 发一份(带联络方式)。这里再塞一份会让首页出现两个相同 @id。 */
const jsonLd = [
  siteJsonLd(base0, site?.name ?? 'BIOSPHERE'),
  breadcrumbJsonLd(base0, lang, path, uiT(lang as any)('nav.home'), trail),
  faqJsonLd(faqItems),
  /* 产品结构化数据。AI 引擎回答「有没有能做草本精华的中国工厂」时,
     靠的是它能确定的事实 —— 页面上的产品名对机器是字符串,
     放进 Product schema 才是一条可引用的数据。价格刻意不写:代工按单报价。 */
  ...(catalog.length
    ? [itemListJsonLd(base0, lang, catalog.map((p: any) => ({ slug: p.slug, name: catalogLabel(p.name ?? p.slug, zhPage).name }))),
       ...catalog.slice(0, 24).map((p: any) => productJsonLd(base0, lang, {
         slug: p.slug, name: catalogLabel(p.name ?? p.slug, zhPage).name, summary: p.summary,
         category: p.category, moq: '',
         image: p.cover_media ? `/media/${p.cover_media}` : null,
       }))]
    : []),
].filter(Boolean) as Record<string, unknown>[];

/* 分享缩略图:优先用本页第一张通栏/店招图,没有就退回厂区外观 */
const ogImage = (() => {
  for (const b of bundle?.blocks ?? []) {
    const img = (b.data as any)?.image;
    if (typeof img === 'string' && img.startsWith('/media/')) return img;
  }
  return '/media/57';
})();

/* 读 KV 失败时的垫底，与种子一致：信任带开，展会/货架/成品关，紧凑瓶图开。
   线上以 show_home:biosphere-ai 为准（lib/show-home.ts）。JSON 缺键缺省 true。
   整键还不存在时按种子渲染。#47 误藏的信任带在此收回（D）。
   硬序 Hero → BioTrustStrip → Funnel；无 showcase 时信任带夹在中间（E）。
   漏斗不在这五键里。Cosmopack / showcase 保持关。 */
const SHOW_HOME_TRUST_STRIP = true;
const SHOW_HOME_COSMOPACK = false;
const SHOW_HOME_HOT_SHELF = false;
const SHOW_HOME_SHOWCASE = false;  /* Product showcase / .showcase-grid */
const SHOW_HOME_HERO_CARD = true;
let showHome = {
  TRUST: SHOW_HOME_TRUST_STRIP,
  COSMOPACK: SHOW_HOME_COSMOPACK,
  HOT_SHELF: SHOW_HOME_HOT_SHELF,
  SHOWCASE: SHOW_HOME_SHOWCASE,
  HERO_CARD: SHOW_HOME_HERO_CARD,
};
if (site?.id === 'biosphere-ai' && !slug) {
  const fromMw = (Astro.locals as any).showHome?.flags;
  if (fromMw) showHome = fromMw;
  else {
    try {
      const kv = resolveHomeFlagsKv(env as any, homeFlagsAllowMemory(hostname, env as any));
      showHome = (await readShowHome(kv, { absentAsSeed: true })).flags;
    } catch { /* 垫底用上面的硬编码 */ }
  }
}
