---
/**
 * 全站唯一入口 —— 按「域名 → 站点」「路径 → 语言 + 页面」从 D1 取内容并渲染。
 *
 * 为什么用一个 catch-all 而不是给每个页面建文件:
 * 页面结构存在数据库里(85 个页面 × 4 语),运营在后台加一个页面就该立刻能访问,
 * 不该需要程序员加一个 .astro 文件再发版。所以路由必须是数据驱动的。
 *
 * 路径形状:/{lang}/{slug...}/    例:/zh-cn/  ·  /en/about/history/
 */
import BaseLayout from '@cosmetic/core/layouts/BaseLayout.astro';
import SiteHeader from '@cosmetic/core/components/SiteHeader.astro';
import SiteFooter from '@cosmetic/core/components/SiteFooter.astro';
import Hero from '@cosmetic/core/components/Hero.astro';
import WorkshopProof from '@cosmetic/core/components/WorkshopProof.astro';
import CertWall from '@cosmetic/core/components/CertWall.astro';
import CategoryMatrix from '@cosmetic/core/components/CategoryMatrix.astro';
import ProcessSteps from '@cosmetic/core/components/ProcessSteps.astro';
import EvidenceGrid from '@cosmetic/core/components/EvidenceGrid.astro';
import ProductionBases from '@cosmetic/core/components/ProductionBases.astro';
import SocialProof from '@cosmetic/core/components/SocialProof.astro';
import InquiryForm from '@cosmetic/core/components/InquiryForm.astro';
import InquiryBand from '@cosmetic/core/components/InquiryBand.astro';
import Motion from '../components/Motion.astro';
import BrandEcosystem from '../components/BrandEcosystem.astro';
import ProductGrid from '../components/ProductGrid.astro';
import InquiryCart from '../components/InquiryCart.astro';
import { getSiteByHost, getSiteById, getPageBundle, getEcosystem, isLang, DEFAULT_LANG, type Lang } from '../lib/db';
import { getVariant, getSite as getStaticSite } from '@cosmetic/core/registry';
// Astro v6 起 Astro.locals.runtime.env 已移除,绑定改从 cloudflare:workers 取
import { env } from 'cloudflare:workers';

export const prerender = false;

const db = (env as any)?.DB as D1Database | undefined;

/* ── 解析语言与路径 ───────────────────────────────────────────── */
const raw = (Astro.params.path ?? '').replace(/^\/+|\/+$/g, '');
const segs = raw ? raw.split('/') : [];
const lang: Lang = isLang(segs[0]) ? (segs.shift() as Lang) : DEFAULT_LANG;
const slug = segs.join('/');

/* ── 解析站点:线上按域名;预览域名/本地按 ?site= 回退 ─────────── */
const hostname = Astro.url.hostname;
const override = Astro.url.searchParams.get('site');

let bundle = null;
let dbError: string | null = null;

if (!db) {
  dbError = 'D1 未绑定(本地开发请用 wrangler pages dev,或在 Pages 项目里绑定 DB)';
} else {
  try {
    const site = override
      ? await getSiteById(db, override, lang)
      : (await getSiteByHost(db, hostname, lang)) ?? (await getSiteById(db, 'beauty2oem', lang));
    if (site) bundle = await getPageBundle(db, site.id, slug, lang);
  } catch (e) {
    dbError = e instanceof Error ? e.message : String(e);
  }
}

if (!bundle && !dbError) {
  return new Response(null, { status: 404, headers: { 'x-bohui-reason': `no page: ${slug || '(home)'}` } });
}

/* ── 渲染参数 ─────────────────────────────────────────────────── */
const site = bundle?.site;
const staticSite = site ? (() => { try { return getStaticSite(site.id); } catch { return null; } })() : null;
const variant = staticSite ? getVariant(staticSite, site!.variant) : null;
const email = `inquiry@${site?.domain ?? 'bohui.group'}`;
const path = `/${lang}/${slug ? slug + '/' : ''}`;

const PENDING: Record<Lang, string> = {
  'zh-cn': '出处待补充', 'zh-tw': '出處待補充', en: 'source pending', ja: '出典未記載',
};
const SHOT_PENDING: Record<Lang, string> = {
  'zh-cn': '车间实拍待补', 'zh-tw': '車間實拍待補', en: 'footage pending', ja: '現場映像は準備中',
};

/**
 * demo 阶段的占位实拍图与质地类型。
 * 目的只有一个:证明「图片进版式」这条路是通的 —— 真图入库后由 block 数据里的
 * d.image 覆盖,这两张表就可以删掉,版式一行不动。
 * 质地类型按各站产品语言分配:护肤=流体、彩妆代工=乳霜、口腔=凝胶、AI=粉体。
 */
const DEMO_SHOT: Record<string, string> = {
  // 暂时全部留空 —— 见上方说明。有了可信的实拍图再逐个填回来。
};
const DEMO_TEXTURE: Record<string, 'cream' | 'fluid' | 'powder' | 'gel'> = {
  beauty2oem: 'cream',
  skin2oem: 'fluid',
  'biosphere-ai': 'powder',
  medierba: 'cream',
  'biosphere-oralcare': 'gel',
};

/** 集团生态(大脑 + 四平台),页脚前渲染 */
const eco = db && bundle ? await getEcosystem(db, lang).catch(() => null) : null;

/**
 * demo 用剂型数据 —— 证明「逛→选规格→加入询盘→攒车→提交」这条动线通。
 * 真产品入库后从 products 表读,这张表即可删除。
 */
const DEMO_PRODUCTS = [
  { id: 'serum', name: '精华液', summary: '水感或油感基质,活性物浓度可定制', image: '/media/shots/skin-02.jpg', moq: '3,000 支起',
    options: { 容量: ['30ml', '50ml'], 包材: ['玻璃滴管瓶', '真空泵瓶'] } },
  { id: 'cream', name: '面霜', summary: '真空乳化,常温与冷制工艺可选', image: '/media/shots/texture-02.jpg', moq: '3,000 罐起',
    options: { 容量: ['30g', '50g'], 包材: ['玻璃罐', 'PP 罐'] } },
  { id: 'mask', name: '面膜', summary: '水洗式与贴片式,精华液配比可调', image: '/media/shots/life-01.jpg', moq: '10,000 片起',
    options: { 规格: ['单片装', '盒装 5 片'], 基布: ['天丝', '生物纤维'] } },
  { id: 'cleanser', name: '洁面', summary: '氨基酸与皂基两条路线', image: '/media/shots/skin-03.jpg', moq: '5,000 支起',
    options: { 容量: ['100ml', '150ml'], 形态: ['膏状', '慕斯'] } },
  { id: 'toothpaste', name: '牙膏', summary: '低研磨配方,益生菌可添加', image: '/media/shots/oral-02.jpg', moq: '10,000 支起',
    options: { 容量: ['100g', '120g'], 管材: ['铝塑复合管', '可回收单材质管'] } },
  { id: 'powder', name: '粉体彩妆', summary: '压粉与散粉,色号按 Pantone 打样', image: '/media/shots/makeup-01.jpg', moq: '5,000 盒起',
    options: { 形态: ['压粉饼', '散粉'], 盘型: ['单色', '四色'] } },
  { id: 'oil', name: '精华油', summary: '植物基油相,冷压原料可溯源', image: '/media/shots/botany-02.jpg', moq: '3,000 支起',
    options: { 容量: ['20ml', '30ml'], 包材: ['滴管瓶', '按压瓶'] } },
  { id: 'balm', name: '膏体唇部', summary: '润唇与有色唇膏,蜡体配比可调', image: '/media/shots/makeup-02.jpg', moq: '8,000 支起',
    options: { 形态: ['管状', '罐装'], 色号: ['单色', '定制'] } },
];

const CART_LABELS: Record<Lang, any> = {
  'zh-cn': { open: '询盘车', empty: '还没有选择剂型', remove: '移除', submit: '提交整车询盘', count: '已选', hint: '提交后我们在两个工作日内书面回复。' },
  'zh-tw': { open: '詢價車', empty: '尚未選擇劑型', remove: '移除', submit: '送出整車詢價', count: '已選', hint: '送出後我們於兩個工作日內書面回覆。' },
  en: { open: 'Inquiry list', empty: 'No formats selected yet', remove: 'Remove', submit: 'Send the whole list', count: 'Selected', hint: 'We reply in writing within two working days.' },
  ja: { open: 'お問い合わせリスト', empty: 'まだ剤形が選ばれていません', remove: '削除', submit: 'リストをまとめて送信', count: '選択中', hint: '2 営業日以内に書面でご回答します。' },
};
const ECO_TEXT: Record<Lang, { title: string; intro: string }> = {
  'zh-cn': { title: '集团品牌生态', intro: '以 BIOSPHERE-AI 为科技大脑,构建美妆与口腔健康产业生态;通过智能制造平台赋能全球品牌,以自有品牌传递草本科技之美。' },
  en: { title: 'Brand ecosystem', intro: 'BIOSPHERE-AI serves as the technology core, powering global brands through our manufacturing platforms and expressing herbal science through our own brand.' },
};

const GRID_TEXT: Record<Lang, { title: string; intro: string; add: string; moq: string }> = {
  'zh-cn': { title: '可做剂型', intro: '选好规格直接加入询盘车,逛完一次性提交 —— 不用每个剂型都填一遍表。', add: '加入询盘', moq: 'MOQ' },
  'zh-tw': { title: '可做劑型', intro: '選好規格直接加入詢價車,逛完一次送出 —— 不必每個劑型都填一次表。', add: '加入詢價', moq: 'MOQ' },
  en: { title: 'Formats we make', intro: 'Pick a spec, add it to your list, and send everything at once — no form per item.', add: 'Add to inquiry', moq: 'MOQ' },
  ja: { title: '対応剤形', intro: '仕様を選んでリストに追加し、最後にまとめて送信できます。剤形ごとに入力する必要はありません。', add: 'リストに追加', moq: 'MOQ' },
};

/**
 * 界面文案回退 —— 文案表只覆盖部分语种(内容可以逐步翻译,界面不能等)。
 * 直接 TEXT[lang] 在未覆盖的语种上会取到 undefined,随后 .title 抛错整页 500。
 * 这类错误只在小语种访客身上出现,最难被发现,所以统一走这个函数。
 */
const pick = <T,>(m: Record<string, T>, l: string): T => m[l] ?? m.en ?? m['zh-cn'];

/** 内容改完即时生效,但同一秒内的重复请求走边缘缓存,避免每次都打 D1 */
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=30, stale-while-revalidate=300');
---

{dbError ? (
  <html lang="zh-CN"><head><meta charset="utf-8" /><title>数据源未就绪</title></head>
  <body style="font-family:system-ui;padding:3rem;max-width:44rem;margin:auto;line-height:1.7">
    <h1 style="font-size:1.5rem">数据源未就绪</h1>
    <p style="color:#555">{dbError}</p>
    <p style="color:#888;font-size:.875rem">这是配置问题,不是代码问题。绑定 D1 后刷新即可。</p>
  </body></html>
) : (
<BaseLayout
  locale={lang}
  school={variant?.school ?? 'factory-b2b'}
  variant={site!.variant}
  brand={site!.id}
  siteName={site!.name}
  siteUrl={`https://${site!.domain}`}
  path={path}
  title={bundle!.page.title}
  description={bundle!.page.seo_desc ?? ''}
  indexable={site!.is_live === 1}
  brandColor={site!.brand_color}
>
  <a class="ck-skip-link" href="#main">跳到主内容</a>
  <SiteHeader locale={lang} path={path} siteName={site!.name} siteNameZh={site!.tagline ?? ''} nav={bundle!.nav} />

  <main id="main">
    {bundle!.blocks.map((b) => {
      const d = b.data as any;
      switch (b.type) {
        case 'hero':
          // demo 阶段:每站取一张占位实拍图证明图片管线通;真图入库后由 d.image 覆盖
          return (
            <Hero
              hero={d}
              ctaHref={`/${lang}/contact/`}
              highlights={d.stats ?? []}
              image={d.image ?? DEMO_SHOT[site!.id]}
              imageAlt={d.imageAlt ?? ''}
              texture={DEMO_TEXTURE[site!.id] ?? 'cream'}
            />
          );
        case 'workshop':
          return <WorkshopProof title={d.title} intro={d.intro} clips={d.clips ?? []} pendingLabel={pick(SHOT_PENDING, lang)} />;
        case 'certs':
          return <CertWall title={d.title} note={d.note} items={d.items ?? []} />;
        case 'matrix':
          return <CategoryMatrix title={d.title} intro={d.intro} items={d.items ?? []} />;
        case 'process':
          return <ProcessSteps title={d.title} intro={d.intro} steps={d.steps ?? []} />;
        case 'evidence':
          return <EvidenceGrid title={d.title} intro={d.intro} items={d.items ?? []} pendingLabel={pick(PENDING, lang)} />;
        case 'bases':
          // 生产基地 —— 从种植端到成品端,是帛卉区别于普通代工厂的地方
          return (
            <ProductionBases
              eyebrow={d.eyebrow} title={d.title} intro={d.intro}
              items={d.items ?? []} labels={d.labels} footnote={d.footnote}
            />
          );
        case 'proof':
          return <SocialProof title={d.title} intro={d.intro} stats={d.stats ?? []} testimonials={d.testimonials ?? []} />;
        case 'form':
          return <InquiryForm title={d.title} intro={d.intro} labels={d.labels} email={email} subject={`[${site!.name}] ${d.title}`} />;
        case 'prose':
          // 正文段落 —— 内页的主体。行宽收在 68 字符内,超过就不好读了
          return (
            <section class="ck-section" style="background:var(--ck-bg)">
              <div class="ck-wrap">
                <div style="max-width:44rem;display:grid;gap:1.25rem" data-reveal="stagger">
                  {(d.paragraphs ?? []).map((t: string) => (
                    <p style="font-size:1.0625rem;line-height:1.75;color:var(--ck-ink-soft)">{t}</p>
                  ))}
                </div>
              </div>
            </section>
          );
        case 'inquiry':
          return <InquiryBand inquiry={d} href={`/${lang}/contact/`} email={email} />;
        default:
          return null;
      }
    })}
    {/* 产品页:剂型网格 —— 逛→选规格→就地加入询盘车 */}
    {bundle!.page.template === 'products' && (
      <ProductGrid
        title={pick(GRID_TEXT, lang).title}
        intro={pick(GRID_TEXT, lang).intro}
        items={DEMO_PRODUCTS}
        addLabel={pick(GRID_TEXT, lang).add}
        moqLabel={pick(GRID_TEXT, lang).moq}
      />
    )}
  </main>

  {eco?.hub && (
    <BrandEcosystem
      hub={eco.hub}
      children={eco.children}
      currentId={site!.id}
      title={pick(ECO_TEXT, lang).title}
      intro={pick(ECO_TEXT, lang).intro}
    />
  )}

  <InquiryCart labels={pick(CART_LABELS, lang)} submitHref={`/${lang}/contact/`} />

  <SiteFooter locale={lang} path={path} site={{ ...staticSite!, name: site!.name }} siblings={[]} email={email} nav={bundle!.nav} />
  <Motion />
</BaseLayout>
)}
