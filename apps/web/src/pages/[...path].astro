          <ul class="showcase-grid">
            {showcaseData.items.slice(0, 14).map((p: any) => {
              const shown = catalogLabel(p.name ?? p.slug, zhPage);
              return (
              <li><a class="showcase-card" href={`/${lang}/product/${p.slug}/`}>
                {p.cover_media ? <img src={`/media/${p.cover_media}`} alt={shown.name} loading="lazy" /> : <div class="showcase-ph"></div>}
                <h3>{shown.name}</h3>
              </a></li>
              );
            })}
            {showcaseData.hasMore && (
              <li><a class="showcase-card showcase-more" href={`/${lang}/portfolio/`}>
                <div class="showcase-more-body">
                  <span class="more-arrow">→</span>
                  <h3>{({ 'zh-cn': '查看全部', 'zh-tw': '查看全部', jp: 'すべて見る', kr: '전체 보기', id: 'Lihat semua', ar: 'عرض الكل' } as Record<string, string>)[lang] ?? 'See all'}</h3>
                </div>
              </a></li>
            )}
          </ul>
          {showcaseData.items.slice(0, 14).some((p: any) => catalogLabel(p.name ?? p.slug, zhPage).claim) && (
            <p class="showcase-claim">{claimNote(zhPage)}</p>
          )}
        </div>
      </section>
    )}

    {(collectionMode ? [] : bodyBlocks).map((b) => {
      const d = b.data as any;
      /* 首页已渲染漏斗。CMS 的 hero / banner 自带 h1,留着会把未翻译的英文标题露在 id / ar / jp / kr 上。 */
      if ((b.type === 'fx_hero' || b.type === 'hero' || b.type === 'banner') && site.id === 'biosphere-ai' && !slug) return null;
      /* 10-22 创始人:「看到一个产品就交给工厂做」先隐藏 */
      if (b.type === 'fx_latest' && site.id === 'biosphere-ai' && !slug) return null;
      /* 首页爆款货架。KV 键 HOT_SHELF 为 false 时整块不下。类名 dtc-sec shelf，标题来自 CMS，现网为「爆款产品」。 */
      if (b.type === 'shelf' && site.id === 'biosphere-ai' && !slug && !showHome.HOT_SHELF) return null;
      switch (b.type) {
        case 'hero':
          // demo 阶段:每站取一张占位实拍图证明图片管线通;真图入库后由 d.image 覆盖
          //
          // 标题为空时回落到页面标题 —— 实测发现 5 站 × 5 个内页的 hero 都是
          // "title":"",于是渲染出 <h1></h1>:标签在、字没有。
          // 对搜索引擎和读屏器来说这等于没标题,而这条线的打法正是 SEO/GEO。
          // 数据侧已回填,但兜底留在代码里:以后任何人清空标题都不会再漏出空 h1。
          return (
            <Hero
              /* 字段映射,不是多余的一行:块里存的是 body / ctaText,
                 而 Hero 组件读的是 lead / ctaPrimary —— 名字对不上就渲染成空。
                 表现是导语整段消失、CTA 变成一个没有字的蓝方块
                 (2026-09-09 创始人在种植基地页截图指出)。 */
              hero={{
                ...d,
                title: (d.title ?? '').trim() || pageSeo.title,
                lead: d.lead ?? d.body ?? '',
                ctaPrimary: d.ctaPrimary ?? d.ctaText ?? '',
              }}
              ctaHref={d.ctaHref ?? `/${lang}/contact/`}
              highlights={d.stats ?? []}
              image={d.image ?? DEMO_SHOT[site!.id]}
              imageAlt={d.imageAlt ?? ''}
              texture={DEMO_TEXTURE[site!.id] ?? 'cream'}
            />
          );
        case 'workshop':
          return <WorkshopProof title={d.title} intro={d.intro} clips={d.clips ?? []} pendingLabel={pick(SHOT_PENDING, lang)} />;
        case 'certs':
          return isCertWall(String(d.title ?? ''), d.items ?? [])
            ? <CertSplit items={d.items ?? []} zh={zhPage} />
            : <CertWall title={d.title} note={d.note} items={d.items ?? []} />;
        case 'matrix':
          return <CategoryMatrix title={d.title} intro={d.intro} items={d.items ?? []} />;
        case 'process':
          return <ProcessSteps title={d.title} intro={d.intro} steps={d.steps ?? []} />;
        case 'evidence':
          return <EvidenceGrid title={d.title} intro={d.intro} items={d.items ?? []} pendingLabel={pick(PENDING, lang)} />;
        case 'banner':
          // 超大首屏 banner —— 图从媒体库来,创始人自己换
          return (
            <BigBanner
              image={d.image} imageAlt={d.imageAlt}
              eyebrow={d.eyebrow} title={d.title} lead={d.lead}
              ctaPrimary={d.ctaPrimary} ctaHref={`/${lang}/contact/`}
              ctaSecondary={d.ctaSecondary} ctaSecondaryHref={`/${lang}/portfolio/`}
              height={d.height}
            />
          );
        case 'stages':
          // 叙事流程 —— 六道工序是一条链,不是六个并列卖点
          return (
            <NarrativeStages
              eyebrow={d.eyebrow} title={d.title} intro={d.intro}
              stages={d.stages ?? []}
              ctaLabel={d.ctaLabel} ctaHref={d.ctaLabel ? `/${lang}/contact/` : undefined}
            />
          );
        case 'bases':
          // 生产基地 —— 从种植端到成品端,是帛卉区别于普通代工厂的地方
          return (
            <ProductionBases
              locale={lang}
              eyebrow={d.eyebrow} title={d.title} intro={d.intro}
              items={d.items ?? []} labels={d.labels} footnote={d.footnote}
              summary={d.summary !== false}
            />
          );
        case 'proof':
          return <SocialProof title={d.title} intro={d.intro} stats={d.stats ?? []} testimonials={d.testimonials ?? []} />;
        case 'form':
          return <InquiryForm title={d.title} intro={d.intro} labels={d.labels} email={email} subject={`[${site!.name}] ${d.title}`} />;
        case 'prose':
          // 正文段落 —— 内页的主体。窄屏单栏(行宽 44rem 内保可读);
          // 宽屏改双栏杂志流:版心 1800 是铁令(创始人),一根窄文字柱
          // 杵在宽画布左边就是「这么大的空白处」—— 双栏让文字填满轴线,
          // 每栏行宽仍在可读范围内。
          return (
            <section class="ck-section" style="background:var(--ck-bg)">
              <div class="ck-wrap">
                <div class="prose-flow" data-reveal="stagger">
                  {(d.paragraphs ?? []).map((t: string) => (
                    <p>{t}</p>
                  ))}
                </div>
              </div>
            </section>
          );
        case 'legal':
          /* 法务文档:编号分节 + 段落/条目。创始人拿古方 AI 星图的隐私政策对比后
             点名重做(「太不专业了」)—— 两段话确实撑不起一份隐私政策。
             结构上对齐那边的成熟版式:生效日期、编号章节、条目列表。 */
          return (
            <section class="ck-section" style="background:var(--ck-bg)">
              <div class="ck-wrap">
                <div class="legaldoc" data-reveal>
                  {d.effective && <p class="ld-date">{d.effective}</p>}
                  {(d.sections ?? []).map((s: any, i: number) => (
                    <section class="ld-sec">
                      {s.h && <h2>{i + 1}. {s.h}</h2>}
                      {(s.ps ?? []).map((t: string) => <p>{t}</p>)}
                      {Array.isArray(s.items) && s.items.length > 0 && (
                        <ul>{s.items.map((t: string) => <li>{t}</li>)}</ul>
                      )}
                      {(s.tail ?? []).map((t: string) => <p>{t}</p>)}
                    </section>
                  ))}
                </div>
              </div>
            </section>
          );
        case 'inquiry':
          return <InquiryBand inquiry={d} href={`/${lang}/contact/`} email={email} />;

        /* ── DTC 品牌版式(自有品牌站)────────────────────────
           这一族与上面的 B2B 版块并存而不互斥:同一个渲染器,
           站点用哪一族由内容决定,不需要第二套路由或第二个应用。 */
        case 'slideshow':
          return <Slideshow slides={d.slides ?? []} eyebrow={d.eyebrow} title={d.title ?? ''}
                            lead={d.lead} ctaText={d.ctaText} ctaHref={d.ctaHref ?? `/${lang}/portfolio/`}
                            interval={d.interval ?? 6000} />;
        case 'centercta':
          return <CenterCta title={d.title ?? ''} body={d.body} ctaText={d.ctaText}
                            ctaHref={d.ctaHref ?? `/${lang}/skin/`} tone={d.tone} />;
        case 'bandimg':
          return <BandImage image={d.image} alt={d.alt} display={d.display} title={d.title ?? ''}
                            ctaText={d.ctaText} ctaHref={d.ctaHref ?? `/${lang}/portfolio/`} />;
        case 'shelf':
          return <Shelf title={d.title ?? ''} moreText={d.moreText} moreHref={d.moreHref ?? `/${lang}/portfolio/`}
                        items={d.items ?? []} tone={d.tone} />;
        case 'split':
          return <SplitFeature image={d.image} alt={d.alt} eyebrow={d.eyebrow} title={d.title ?? ''}
                               body={d.body} ctaText={d.ctaText} ctaHref={d.ctaHref ?? `/${lang}/portfolio/`}
                               flip={!!d.flip} tone={d.tone} />;
        case 'statement':
          return <Statement eyebrow={d.eyebrow} title={d.title ?? ''} body={d.body} tone={d.tone} />;
        case 'perks':
          return <Perks image={d.image} items={d.items ?? []} veil={d.veil} />;
        case 'social':
          return <SocialWall title={d.title ?? ''} handle={d.handle} items={d.items ?? []} tone={d.tone} />;
        case 'storehero':
          return <StoreHero image={d.image} alt={d.alt} company={d.company ?? ''} tagline={d.tagline}
                            badges={d.badges ?? []} ctaText={d.ctaText} ctaHref={d.ctaHref ?? `/${lang}/contact/`}
                            secondText={d.secondText} secondHref={d.secondHref ?? `/${lang}/portfolio/`}
                            cardRight={!!d.cardRight} />;
        case 'statsband':
          return <StatsBand items={d.items ?? []} tone={d.tone} />;
        case 'procgrid': {
          /* 2026-09-25: /media/155 is a HALAL certificate issued to a different company (Bloomage), so it is never shown.
             Cert grids are split to match /services/: held factory certs vs filings. */
          const gridItems = (d.items ?? []).filter((it: any) => !['/media/155'].includes(String(it?.image ?? '')));
          return isCertWall(String(d.title ?? ''), gridItems)
            ? <CertSplit items={gridItems} zh={zhPage} />
            : <ProcGrid eyebrow={d.eyebrow} title={d.title ?? ''} intro={d.intro}
                        items={gridItems} cols={d.cols ?? 3} tone={d.tone} />;
        }
        case 'answer':
          return <AnswerBlock question={d.question ?? ''} answer={complyA(String(d.answer ?? ''))}
                              faqs={(d.faqs ?? []).map((f: any) => ({ ...f, a: complyA(String(f?.a ?? '')) }))} tone={d.tone} />;
        case 'procribbon':
          return <ProcRibbon eyebrow={d.eyebrow} title={d.title ?? ''} intro={d.intro}
                             steps={d.steps ?? []} tone={d.tone} />;
        case 'fx_hero': case 'fx_six': case 'fx_opps': case 'fx_latest': case 'fx_bases': case 'fx_steps': case 'fx_contact': case 'fx_cards': case 'fx_ledger': case 'fx_brief':
          /* BEAUTY2OEM 走图文版(B2oBlock,版式与配图);工厂站等其它站照旧 FactoryBlock */
          return cnOnly
            ? <B2oBlock type={b.type} data={d} lang={lang} db={db} siteName={site!.name} email={fxEmail} whatsapp={contactWa} wechat={contactWx}
                        page={slug} pageTitle={pageSeo.title} pageDesc={pageSeo.description} />
            : <FactoryBlock type={b.type} data={d} lang={lang} db={db} siteName={site!.name} email={fxEmail} whatsapp={contactWa} wechat={contactWx} />;
        case 'funnel':
          /* 首页漏斗已在信任带之后单独渲染。CMS 再出一次就是第二张大白互动卡。 */
          if (site.id === 'biosphere-ai' && !slug) return null;
          return <Funnel locale={lang} heading="h1" />;
        case 'signup':
          return <Signup title={d.title ?? ''} body={d.body} placeholder={d.placeholder ?? 'Email'}
                         button={d.button ?? 'OK'} note={d.note} siteId={site!.id} tone={d.tone} />;
        default:
          return null;
      }
    })}
    {/* 产品页:品类项圈 → 真实产品目录 → 可做剂型(询盘车)。
        项圈只列真有产品的品类并带数量,点空结果的筛选项没人会用第二次。 */}
    {bundle!.page.template === 'products' && catCounts.length > 0 && (
      <nav class="catbar" aria-label={catLabel('all')}>
        <div class="ck-wrap">
          <a class:list={['chip', { on: !catFilter }]} href={`/${lang}/portfolio/`}>
            {catLabel('all')}（{catCounts.reduce((a, c) => a + c.n, 0)}）
          </a>
          {catCounts.map((c) => (
            <a class:list={['chip', { on: catFilter === c.category }]}
               href={`/${lang}/portfolio/?cat=${c.category}`}>
              {catLabel(c.category)}（{c.n}）
            </a>
          ))}
        </div>
      </nav>
    )}
    {catalog.length > 0 && (
      <ProductGrid
        dense
        {/* 品类名已在产品集模式的 h1 里,这里再带前缀就是同屏重复 */}
        title={pick(CATALOG_TEXT, lang).title}
        intro={collectionMode ? undefined : pick(CATALOG_TEXT, lang).intro}
        items={catalog.map((p: any) => ({
          id: p.slug, name: catalogLabel(p.name ?? p.slug, zhPage).name,
          summary: softenClaims(p.summary ?? ''),
          image: p.cover_media ? `/media/${p.cover_media}` : '',
          /* 卡片不渲染库内点值 MOQ（含 3000）。口径与 /services/ 一致：区间 + 书面确认。 */
          moq: publicMoq(zhPage),
          options: {},
          /* 图和名字点进详情页 —— 访客看到产品卡的第一反应就是点它 */
          href: `/${lang}/product/${p.slug}/`,
        }))}
        addLabel={pick(GRID_TEXT, lang).add}
        moqLabel=""
      />
    )}
    {/* 筛到空品类:说清楚为什么空、下一步去哪 —— 半屏空白是最伤的收尾 */}
    {bundle!.page.template === 'products' && catFilter && catalog.length === 0 && (
      <section class="catempty">
        <div class="ck-wrap">
          <p>{lang === 'zh-cn'
            ? `「${catLabel(catFilter)}」的在售清单整理中 —— 该品类可做,剂型能力见下方,或直接发起询盘。`
            : `The "${catLabel(catFilter)}" catalogue is being prepared — we do make this category. See the formats below, or start an inquiry.`}</p>
          <a class="chip" href={`/${lang}/portfolio/`}>{catLabel('all')}</a>
        </div>
      </section>
    )}
    {/* 产品页:剂型网格 —— 逛→选规格→就地加入询盘车 */}
    {bundle!.page.template === 'products' && (
      <ProductGrid
        title={pick(GRID_TEXT, lang).title}
        intro={pick(GRID_TEXT, lang).intro}
        items={formatItems}
        addLabel={pick(GRID_TEXT, lang).add}
        moqLabel={pick(GRID_TEXT, lang).moq}
      />
    )}
    {/* 产品集模式砍掉了营销版块,但询盘带是转化出口,单独补回收尾 */}
    {collectionMode && inquiryBlock && (
      <InquiryBand inquiry={inquiryBlock.data as any} href={`/${lang}/contact/`} email={email} />
    )}

    {/* 联系页必须有一张真表单 —— 这一页是「发起询盘」「发送这套方案」的落点,
        以前只有一个 mailto 链接,手机上点了多半什么都不发生,线索就这么丢了。 */}
    {bundle!.page.template === 'contact' && (
      <InquiryFormLite lang={lang} email={email} whatsapp={contactWa} source={bundle!.page.slug ?? 'contact'} />
    )}
  </main>

  {showCart && <InquiryCart labels={pick(CART_LABELS, lang)} submitHref={cartHref} />}

  {((site as any)!.theme ?? 'noir') === 'noir' ? (
    <StatementFooter
      locale={lang} path={path} siteName={site!.name}
      statement={site!.tagline ?? site!.name}
      email={email} nav={bundle!.nav}
      siblings={[]}
    />
  ) : (
    <SiteFooter locale={lang} path={path} site={{ ...staticSite!, name: site!.name }} siblings={[]} email={email} nav={bundle!.nav} showLocaleSwitch={!cnOnly} cnOnly={cnOnly} />
  )}
  <Motion />
</BaseLayout>
)}

<style>
  /* 法务文档:行宽 42rem(约 65 字符),法律文本更要克制行宽 */
  .legaldoc { max-width: 42rem; display: grid; gap: 2rem; }
  .legaldoc .ld-date { color: var(--ck-ink-faint); font-size: var(--ck-small); margin: 0; }
  .legaldoc .ld-sec { display: grid; gap: 0.75rem; }
  .legaldoc h2 { font-size: 1.1875rem; margin: 0; }
  .legaldoc p { margin: 0; line-height: 1.8; color: var(--ck-ink-soft); }
  .legaldoc ul { margin: 0; padding-inline-start: 1.25rem; display: grid; gap: 0.5rem; }
  .legaldoc li { line-height: 1.7; color: var(--ck-ink-soft); }

  /* 内页页头。上下留白比常规版块小 —— 它是引子不是内容,
     占太多屏会把真正的内容推下去。 */
  .pagehead {
    padding-block: calc(var(--ck-section-py) * 0.62) calc(var(--ck-section-py) * 0.38);
    background: var(--ck-bg);
  }
  .pagehead h1 {
    margin: 0;
    max-width: 20ch;
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .pagehead .ph-lead {
    margin: 1.125rem 0 0;
    max-width: var(--ck-maxw-prose);
    color: var(--ck-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  /* prose 版块:窄屏单栏,宽屏双栏杂志流(版心 1800 铁令下填满轴线) */
  .prose-flow { max-width: 44rem; display: grid; gap: 1.25rem; }
  .prose-flow p { margin: 0; font-size: 1.0625rem; line-height: 1.75; color: var(--ck-ink-soft); }
  @media (min-width: 78rem) {
    .prose-flow { max-width: none; display: block; columns: 2; column-gap: 4rem;  /* 09-17 「太多空余」 */ }
    .prose-flow p { break-inside: avoid; margin: 0 0 1.25rem; }
  }

  /* 首页成品网格：图优先，圆角阴影走 --bio-*，悬停只抬 2px。缺图用 .showcase-ph，不把空卡撑破。 */
  .showcase-sec {
    padding-block: var(--bio-gap-lg, 64px);
    background: #f6f5f2;
    color: var(--bio-fg, #1c1b19);
  }
  .showcase-sec h2 { margin: 0; color: var(--bio-fg, #1c1b19); }
  .showcase-grid {
    list-style: none;
    padding: 0;
    margin: var(--bio-gap-md, 48px) 0 0;
    min-width: 0;
    display: grid;
    gap: var(--bio-gap-sm, 32px);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10.5rem), 1fr));
  }
  .showcase-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-decoration: none;
    color: var(--bio-fg, #1c1b19);
    border-radius: var(--bio-radius, 14px);
    overflow: hidden;
    background: var(--bio-bg, #fff);
    box-shadow: var(--bio-shadow);
    transition: transform 0.2s ease;
  }
  .showcase-card:hover { transform: translateY(-2px); }
  .showcase-card img, .showcase-ph { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; background: #f6f5f2; }
  .showcase-card h3 { margin: 0; padding: 0.625rem 0.75rem 0.75rem; font-size: 0.8125rem; font-weight: 600; line-height: 1.35; }
  .showcase-claim { margin: var(--bio-gap-sm, 32px) 0 0; font-size: .8125rem; line-height: 1.6; color: var(--bio-muted, #5e5a53); }
  .showcase-more { display: flex; align-items: center; justify-content: center; background: var(--bio-bg, #fff); border-radius: var(--bio-radius, 14px); }
  .showcase-more .showcase-more-body { text-align: center; padding: 1rem; }
  .showcase-more .more-arrow { font-size: 1.5rem; display: block; }
  .showcase-more h3 { margin: 0.5rem 0 0; padding: 0; font-size: 0.8125rem; }
  @media (prefers-reduced-motion: reduce) {
    .showcase-card, .showcase-card:hover { transform: none; transition: none; }
  }
</style>
