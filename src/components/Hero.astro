---
export interface Props {
  t: Record<string, any>;
  locale: string;
}
const { t, locale } = Astro.props;
---

<section class="relative min-h-screen bg-gradient-to-br from-brand-cream via-white to-primary-50 pt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="text-center lg:text-left">
        <span class="inline-block px-4 py-1.5 bg-primary-100 text-primary-700 text-sm font-medium rounded-full mb-6">
          14+ Years of Excellence
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-brand-dark leading-tight">
          {t.hero.title}
        </h1>
        <p class="mt-6 text-lg md:text-xl text-gray-600 leading-relaxed">
          {t.hero.subtitle}
        </p>
        <div class="mt-8 flex flex-wrap gap-4 justify-center lg:justify-start">
          <a href={`/${locale}/contact`} class="btn-primary text-base px-8 py-4">
            {t.hero.cta}
          </a>
          <a href={`/${locale}/about`} class="btn-outline text-base px-8 py-4">
            {t.hero.learnMore}
          </a>
        </div>
      </div>

      <div class="hidden lg:block">
        <div class="relative">
          <div class="w-full aspect-square bg-gradient-to-br from-primary-200 to-primary-400 rounded-2xl overflow-hidden shadow-2xl">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center text-white p-8">
                <svg class="w-24 h-24 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                </svg>
                <p class="text-2xl font-serif font-bold">Premium Quality</p>
                <p class="mt-2 opacity-80">Cosmetics Manufacturing</p>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-brand-gold rounded-full opacity-20"></div>
          <div class="absolute -top-6 -left-6 w-24 h-24 bg-primary-300 rounded-full opacity-20"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="relative bg-white border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-3xl md:text-4xl font-bold text-primary-600">14+</div>
          <div class="text-sm text-gray-500 mt-1">{t.stats.years}</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-primary-600">500+</div>
          <div class="text-sm text-gray-500 mt-1">{t.stats.products}</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-primary-600">200+</div>
          <div class="text-sm text-gray-500 mt-1">{t.stats.clients}</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-primary-600">15+</div>
          <div class="text-sm text-gray-500 mt-1">{t.stats.countries}</div>
        </div>
      </div>
    </div>
  </div>
</section>
