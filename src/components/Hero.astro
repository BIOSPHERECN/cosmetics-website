---
export interface Props {
  t: Record<string, any>;
  locale: string;
}
const { t, locale } = Astro.props;
const stats = [
  { value: '14+', key: t.stats.years },
  { value: '500+', key: t.stats.products },
  { value: '200+', key: t.stats.clients },
  { value: '15+', key: t.stats.countries },
  { value: '4+', key: t.stats.halal, isHalal: true },
];
---

<section class="relative min-h-screen hero-gradient overflow-hidden pt-20">
  <canvas id="hero-particles" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

  <div class="absolute top-20 right-[-10%] w-96 h-96 bg-primary-300/20 rounded-full blur-3xl animate-float"></div>
  <div class="absolute bottom-20 left-[-5%] w-80 h-80 bg-brand-gold/10 rounded-full blur-3xl" style="animation: float 6s ease-in-out infinite reverse;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">
    <div class="grid lg:grid-cols-2 gap-12 items-center min-h-[70vh]">
      <div class="text-center lg:text-left" data-reveal>
        <div class="flex flex-wrap gap-2 mb-6">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/80 backdrop-blur-sm text-primary-700 text-sm font-medium rounded-full shadow-sm border border-primary-100">
            <span class="w-2 h-2 bg-primary-500 rounded-full animate-pulse"></span>
            <span data-i18n="hero.badge">14+ Years of Excellence</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-emerald-50/90 backdrop-blur-sm text-emerald-700 text-sm font-medium rounded-full shadow-sm border border-emerald-200">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            <span>4+ Years Halal Certified</span>
          </div>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-brand-dark leading-tight" data-i18n="hero.title">
          {t.hero.title}
        </h1>

        <p class="mt-6 text-lg md:text-xl text-gray-600 leading-relaxed max-w-xl lg:mx-0" data-reveal data-reveal-delay="150" data-i18n="hero.subtitle">
          {t.hero.subtitle}
        </p>

        <div class="mt-10 flex flex-wrap gap-4 justify-center lg:justify-start" data-reveal data-reveal-delay="300">
          <a href={`/${locale}/contact`} class="btn-primary text-base px-8 py-4 shadow-lg shadow-primary-600/25 hover:shadow-primary-600/40 animate-glow">
            <span class="relative z-10" data-i18n="hero.cta">{t.hero.cta}</span>
          </a>
          <a href={`/${locale}/about`} class="btn-outline text-base px-8 py-4 group">
            <span data-i18n="hero.learnMore">{t.hero.learnMore}</span>
            <svg class="w-4 h-4 ml-2 inline group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <div class="hidden lg:flex items-center justify-center" data-reveal="scale" data-reveal-delay="200">
        <div class="relative">
          <div class="w-96 h-96 rounded-full bg-gradient-to-br from-primary-400/30 via-primary-200/20 to-brand-gold/10 animate-float flex items-center justify-center">
            <div class="w-72 h-72 rounded-full bg-gradient-to-br from-primary-500/20 to-primary-300/10 backdrop-blur-sm border border-white/30 flex items-center justify-center shadow-2xl">
              <div class="text-center p-8">
                <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-emerald-600/90 flex items-center justify-center shadow-lg">
                  <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                  </svg>
                </div>
                <p class="text-2xl font-serif font-bold text-emerald-800" data-i18n="hero.circleTitle">Halal Certified</p>
                <p class="mt-2 text-emerald-600/80" data-i18n="hero.circleDesc">Cosmetics Manufacturing</p>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-4 -right-4 w-28 h-28 bg-brand-gold/20 rounded-full blur-xl"></div>
          <div class="absolute -top-4 -left-4 w-20 h-20 bg-primary-300/30 rounded-full blur-xl"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-10 bg-white/80 backdrop-blur-sm border-t border-gray-100" data-reveal>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8 text-center">
        {stats.map((s, i) => (
          <div class="group" data-reveal data-reveal-delay={i * 100}>
            {s.isHalal
              ? <div class="text-3xl md:text-4xl font-bold text-emerald-600 group-hover:scale-110 transition-transform duration-300 flex items-center justify-center gap-1"><span data-count={parseInt(s.value)} data-count-suffix="+">{s.value}</span><svg class="w-6 h-6 text-emerald-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg></div>
              : <div class="text-3xl md:text-4xl font-bold text-primary-600 group-hover:scale-110 transition-transform duration-300"><span data-count={parseInt(s.value)} data-count-suffix={s.value.includes('+') ? '+' : ''}>{s.value}</span></div>
            }
            <div class="text-sm text-gray-500 mt-1" data-i18n={"_stat_" + i}>{s.key}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
