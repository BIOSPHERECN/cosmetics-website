---
import { type Locale } from '../i18n/utils';

export interface Props {
  t: Record<string, any>;
  locale: Locale;
}
const { t, locale } = Astro.props;
---

<footer class="bg-brand-dark text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-1">
        <a href={`/${locale}/`} class="flex items-center space-x-2 text-xl font-serif font-bold text-white">
          <span class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center text-white text-xs font-sans font-bold">C</span>
          <span>Cosmo<span class="text-primary-400">Care</span></span>
        </a>
        <p class="mt-4 text-sm text-gray-400">
          14+ years of excellence in cosmetic manufacturing.
        </p>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4">{t.footer.quickLinks}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`/${locale}/`} class="hover:text-primary-400 transition-colors">{t.nav.home}</a></li>
          <li><a href={`/${locale}/about`} class="hover:text-primary-400 transition-colors">{t.nav.about}</a></li>
          <li><a href={`/${locale}/products`} class="hover:text-primary-400 transition-colors">{t.footer.products}</a></li>
          <li><a href={`/${locale}/services`} class="hover:text-primary-400 transition-colors">{t.footer.services}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4">{t.footer.contactUs}</h4>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start space-x-2">
            <svg class="w-4 h-4 mt-0.5 text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>info@cosmocare.com</span>
          </li>
          <li class="flex items-start space-x-2">
            <svg class="w-4 h-4 mt-0.5 text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>+62-xxx-xxxx-xxxx</span>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4">{t.contact.followUs}</h4>
        <div class="flex space-x-4">
          <a href="#" class="w-10 h-10 bg-gray-700 hover:bg-primary-600 rounded-full flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-gray-700 hover:bg-primary-600 rounded-full flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-gray-700 hover:bg-primary-600 rounded-full flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.237 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.182-.78 1.172-4.97 1.172-4.97s-.299-.6-.299-1.486c0-1.39.806-2.428 1.81-2.428.852 0 1.264.64 1.264 1.408 0 .858-.546 2.14-.828 3.33-.236.995.5 1.807 1.48 1.807 1.776 0 3.143-1.873 3.143-4.577 0-2.394-1.719-4.067-4.176-4.067-2.845 0-4.514 2.134-4.514 4.338 0 .858.331 1.779.744 2.281.082.1.094.186.069.287-.076.315-.245.985-.278 1.122-.043.183-.145.222-.334.133-1.249-.582-2.03-2.408-2.03-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.473 6.165 5.776 0 3.447-2.173 6.225-5.19 6.225-1.013 0-1.965-.527-2.29-1.148l-.623 2.378c-.225.868-.833 1.958-1.242 2.62.935.288 1.926.444 2.96.444 5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-700 text-center text-sm text-gray-500">
      &copy; {new Date().getFullYear()} CosmoCare. {t.footer.rights}
    </div>
  </div>
</footer>
