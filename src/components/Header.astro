---
import { locales, type Locale } from '../i18n/utils';

export interface Props {
  t: Record<string, any>;
  locale: Locale;
}

const { t, locale } = Astro.props;
const navItems = [
  { key: 'home', href: `/${locale}/` },
  { key: 'about', href: `/${locale}/about` },
  { key: 'products', href: `/${locale}/products` },
  { key: 'services', href: `/${locale}/services` },
  { key: 'contact', href: `/${locale}/contact` },
];
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-lg border-b border-gray-100/50 transition-all duration-300">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href={`/${locale}/`} class="flex items-center space-x-2 text-xl font-serif font-bold text-brand-dark group">
        <span class="w-8 h-8 bg-gradient-to-br from-primary-500 to-primary-700 rounded-lg flex items-center justify-center text-white text-xs font-sans font-bold group-hover:scale-110 transition-transform duration-300">C</span>
        <span data-i18n="brandName">Cosmo<span class="text-primary-600">Care</span></span>
        <span class="ml-1.5 px-1.5 py-0.5 bg-emerald-50 text-emerald-600 text-[10px] font-sans font-semibold rounded border border-emerald-200 tracking-wider">HALAL</span>
      </a>

      <div class="hidden md:flex items-center space-x-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 ${
              currentPath === item.href
                ? 'bg-primary-50 text-primary-600'
                : 'text-gray-600 hover:text-primary-600 hover:bg-gray-50'
            }`}
          >
            <span data-i18n={t.nav[item.key]}>{t.nav[item.key]}</span>
          </a>
        ))}
      </div>

      <div class="flex items-center space-x-3">
        <div class="relative group">
          <button class="flex items-center space-x-1.5 text-sm text-gray-600 hover:text-primary-600 transition-colors px-3 py-1.5 rounded-lg hover:bg-gray-50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M3 12h18M3 19h6"/></svg>
            <span class="hidden sm:inline">{locales.find(l => l.code === locale)?.label}</span>
          </button>
          <div class="absolute right-0 mt-2 w-44 bg-white/95 backdrop-blur-lg rounded-xl shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0">
            {locales.map((l) => (
              <a
                href={currentPath.replace(`/${locale}`, `/${l.code}`)}
                class={`block px-4 py-2.5 text-sm hover:bg-gray-50 transition-colors first:rounded-t-xl last:rounded-b-xl ${
                  l.code === locale ? 'text-primary-600 font-medium bg-primary-50/50' : 'text-gray-700'
                }`}
              >
                {l.label}
              </a>
            ))}
          </div>
        </div>

        <a href={`/${locale}/contact`} class="hidden md:inline-flex btn-primary text-sm">
          {t.hero.cta}
        </a>

        <button id="mobile-menu-btn" aria-expanded="false" class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors" aria-label="Menu">
          <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-menu" class="md:hidden bg-white/95 backdrop-blur-lg border-b border-gray-100">
    <div class="px-4 py-4 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`block px-4 py-3 rounded-lg text-sm font-medium transition-colors ${
            currentPath === item.href
              ? 'bg-primary-50 text-primary-600'
              : 'text-gray-600 hover:bg-gray-50 hover:text-primary-600'
          }`}
        >
          {t.nav[item.key]}
        </a>
      ))}
      <a href={`/${locale}/contact`} class="block px-4 py-3 mt-2 btn-primary text-sm text-center">
        {t.hero.cta}
      </a>
    </div>
  </div>
</header>
