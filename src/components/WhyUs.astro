---
export interface Props {
  t: Record<string, any>;
}
const { t } = Astro.props;

const features = [
  { icon: 'globe', title: t.whyUs.indonesia, desc: t.whyUs.indonesiaDesc },
  { icon: 'shield', title: t.whyUs.quality, desc: t.whyUs.qualityDesc },
  { icon: 'flexible', title: t.whyUs.flexible, desc: t.whyUs.flexibleDesc },
  { icon: 'flask', title: t.whyUs.rnd, desc: t.whyUs.rndDesc },
  { icon: 'halal', title: t.whyUs.halal, desc: t.whyUs.halalDesc },
];

const icons: Record<string, string> = {
  globe: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  flexible: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  flask: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  halal: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z',
};
---

<section class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-reveal>
      <h2 class="section-title">{t.whyUs.title}</h2>
      <p class="section-subtitle">{t.whyUs.subtitle}</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-6" data-stagger data-reveal>
      {features.map((f) => (
        <div class="group bg-gradient-to-br from-brand-cream to-white rounded-2xl p-8 text-center hover:shadow-2xl hover:shadow-primary-600/10 transition-all duration-500 hover:-translate-y-1 border border-transparent hover:border-primary-100">
          <div class="w-14 h-14 bg-gradient-to-br from-primary-100 to-primary-50 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 group-hover:from-primary-200 group-hover:to-primary-100 transition-all duration-300">
            <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icons[f.icon]} />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-brand-dark mb-3 group-hover:text-primary-700 transition-colors">{f.title}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
