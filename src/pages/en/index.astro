---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import WhyUs from '../../components/WhyUs.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'en';
const t = useTranslations(locale);
const cats = [
  { name: t.products.categories[0].name, desc: t.products.categories[0].desc, emoji: '✨' },
  { name: t.products.categories[1].name, desc: t.products.categories[1].desc, emoji: '💇' },
  { name: t.products.categories[2].name, desc: t.products.categories[2].desc, emoji: '🧴' },
  { name: t.products.categories[3].name, desc: t.products.categories[3].desc, emoji: '💄' },
  { name: t.products.categories[4].name, desc: t.products.categories[4].desc, emoji: '☀️' },
  { name: t.products.categories[5].name, desc: t.products.categories[5].desc, emoji: '🧼' },
];
---

<Layout title="CosmoCare - Your Trusted OEM/ODM Partner for Premium Cosmetics" description={t.hero.subtitle} locale={locale}>
  <Header {t} {locale} />
  <main>
    <Hero {t} {locale} />
    <WhyUs {t} />

    <section class="py-16 md:py-24 bg-gradient-to-b from-brand-cream to-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16" data-reveal>
          <h2 class="section-title">{t.products.title}</h2>
          <p class="section-subtitle">{t.products.subtitle}</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-stagger data-reveal>
          {cats.map((cat) => (
            <div class="group bg-white rounded-2xl p-6 border border-gray-100 hover:border-primary-100 hover:shadow-2xl hover:shadow-primary-600/5 transition-all duration-500 hover:-translate-y-1">
              <div class="text-3xl mb-4 group-hover:scale-110 transition-transform duration-300 inline-block">{cat.emoji}</div>
              <h3 class="text-lg font-semibold text-brand-dark mb-2 group-hover:text-primary-700 transition-colors">{cat.name}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{cat.desc}</p>
            </div>
          ))}
        </div>
        <div class="text-center mt-12" data-reveal>
          <a href={`/${locale}/products`} class="btn-outline group">
            <span>{t.hero.learnMore}</span>
            <svg class="w-4 h-4 ml-2 inline group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-gradient-to-r from-primary-600 to-primary-700 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(255,255,255,0.1),transparent_50%)]"></div>
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-white mb-6">
          Ready to Bring Your Cosmetic Brand to Life?
        </h2>
        <p class="text-primary-100 text-lg mb-10 max-w-2xl mx-auto leading-relaxed">
          Partner with us and leverage our 14+ years of manufacturing expertise.
          From concept to delivery, we are here to help you succeed.
        </p>
        <a href={`/${locale}/contact`} class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary-700 font-semibold rounded-lg hover:bg-primary-50 transition-all duration-300 text-lg shadow-xl hover:shadow-2xl hover:-translate-y-0.5">
          {t.hero.cta}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </section>
  </main>
  <Footer {t} {locale} />
</Layout>
