---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';
const locale = 'zh';
const t = useTranslations(locale);
const categories = [
  { ...t.products.categories[0], emoji: '✨', items: ['面部精华', '保湿霜', '洁面乳', '爽肤水', '眼霜', '面膜'] },
  { ...t.products.categories[1], emoji: '💇', items: ['洗发水', '护发素', '发膜', '护发油', '造型啫喱', '发胶'] },
  { ...t.products.categories[2], emoji: '🧴', items: ['身体乳', '身体磨砂', '身体黄油', '护手霜', '沐浴露', '沐浴啫喱'] },
  { ...t.products.categories[3], emoji: '💄', items: ['粉底', '口红', '眼影', '腮红', '睫毛膏', '定妆喷雾'] },
  { ...t.products.categories[4], emoji: '☀️', items: ['防晒霜', '防晒喷雾', '晒后凝胶', 'BB霜SPF', '防晒唇膏', '防晒棒'] },
  { ...t.products.categories[5], emoji: '🧼', items: ['除臭剂', '免洗洗手液', '湿巾', '洗手液', '足霜', '润唇膏'] },
];
---

<Layout title={`${t.nav.products} - CosmoCare`} description={t.products.subtitle} locale={locale}>
  <Header {t} {locale} />
  <main class="pt-20">
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16" data-reveal>
          <span class="inline-block px-4 py-1.5 bg-primary-100 text-primary-700 text-sm font-medium rounded-full mb-4">{t.nav.products}</span>
          <h1 class="section-title">{t.products.title}</h1><p class="section-subtitle">{t.products.subtitle}</p>
        </div>
        <div class="space-y-12">
          {categories.map((cat, i) => (
            <div class="bg-white rounded-2xl border border-gray-100 p-8 hover:shadow-xl hover:border-primary-100 transition-all duration-500" data-reveal data-reveal-delay={i * 100}>
              <div class="flex items-start gap-6">
                <div class="text-4xl">{cat.emoji}</div>
                <div class="flex-1">
                  <h2 class="text-2xl font-semibold text-brand-dark mb-2">{cat.name}</h2>
                  <p class="text-gray-600 mb-4">{cat.desc}</p>
                  <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
                    {cat.items.map((item: string) => (<span class="inline-flex items-center px-3 py-1.5 bg-brand-cream text-gray-700 text-sm rounded-lg hover:bg-primary-50 hover:text-primary-700 transition-colors">{item}</span>))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="py-16 md:py-24 bg-gradient-to-b from-brand-cream to-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
        <h2 class="text-3xl font-serif font-bold text-brand-dark mb-6">{t.products.oem}</h2>
        <p class="text-gray-600 text-lg mb-8">{t.products.oemDesc}</p>
        <a href={`/${locale}/services`} class="btn-primary text-lg px-8 py-4">{t.hero.learnMore}</a>
      </div>
    </section>
  </main>
  <Footer {t} {locale} />
</Layout>
